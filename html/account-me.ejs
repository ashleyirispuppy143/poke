  startImportBtn.addEventListener('click', async () => {
    if (!parsedImportChannels.length || isImporting) return;

    isImporting = true;
    importFinishedInBg = false;
    startImportBtn.disabled = true;
    startImportBtn.textContent = 'Importing...';
    runInBgImportBtn.style.display = 'inline-flex';
    importProgressBar.classList.add('visible');
    bgImportPillActionBtn.textContent = 'Show';

    let done = 0;
    let failed = 0;
    const total = parsedImportChannels.length;

    for (const ch of parsedImportChannels) {
      const pendingLabel = `Fetching ${ch.name || ch.id} (${done + 1} / ${total})...`;
      importPreviewText.textContent = pendingLabel;
      bgImportPillText.textContent = pendingLabel;

      try {
        let subInfo = null;
        if (ch.avatar && ch.name && ch.name !== ch.id) {
          const params = new URLSearchParams({
            ID: USER_ID,
            channelName: ch.name,
            avatar: ch.avatar,
            channelID: ch.id
          });
          subInfo = {
            alreadySubbed: false,
            url: `/api/set-channel-subs?${params.toString()}`,
            avatar: ch.avatar,
            name: ch.name
          };
        } else {
          subInfo = await resolveChannelSubViaIframe(ch, false);
        }

        if (subInfo) {
          setImportVisualAvatar(subInfo.avatar, subInfo.name || ch.name || ch.id);
        }

        if (subInfo && subInfo.alreadySubbed) {
          // already subscribed
        } else if (subInfo && subInfo.url) {
          const res = await fetch(subInfo.url, { credentials: 'same-origin' });
          if (!res.ok) failed++;
        } else {
          failed++;
        }
      } catch {
        failed++;
      }

      done++;
      const pct = `${Math.round((done / total) * 100)}%`;
      importProgressFill.style.width = pct;
      bgImportPillFill.style.width = pct;
      const progressMsg = `Imported ${done} / ${total}${failed ? ` (${failed} failed)` : ''}...`;
      importPreviewText.textContent = progressMsg;
      bgImportPillText.textContent = progressMsg;
    }

    isImporting = false;
    runInBgImportBtn.style.display = 'none';
    startImportBtn.textContent = 'Done!';
    const doneMsg = `Imported ${done - failed} / ${total} channels${failed ? ` (${failed} failed)` : ''}!`;
    importPreviewText.textContent = doneMsg;

    if (importOverlay.classList.contains('open')) {
      bgImportPill.classList.remove('visible');
      setTimeout(() => window.location.reload(), 600);
    } else {
      importFinishedInBg = true;
      bgImportPillText.textContent = doneMsg;
      bgImportPillActionBtn.textContent = 'Reload';
      bgImportPill.classList.add('visible');
    }
  });

