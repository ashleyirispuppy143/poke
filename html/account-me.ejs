      jsonOutput.textContent = 'Loading...';
      const url = viewJsonBtn.getAttribute('href');
      const data = await fetchJsonData(url);
      jsonOutput.textContent = JSON.stringify(data, null, 2);
    });
  }

  if (closeJsonViewer) {
    closeJsonViewer.addEventListener('click', () => {
      jsonOverlay.classList.remove('open');
    });
  }

  if (jsonOverlay) {
    jsonOverlay.addEventListener('click', (e) => {
      if (e.target === jsonOverlay) jsonOverlay.classList.remove('open');
    });
  }

  if (downloadJsonBtn) {
    downloadJsonBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      const url = downloadJsonBtn.getAttribute('href');
      const data = await fetchJsonData(url);

      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const blobUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = blobUrl;
      a.download = 'subscriptions.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(blobUrl);
    });
  }

  const confirmUnsubModal = document.getElementById('confirmUnsubModal');
  const confirmUnsubText = document.getElementById('confirmUnsubText');
  const confirmUnsubCancel = document.getElementById('confirmUnsubCancel');
  const confirmUnsubConfirm = document.getElementById('confirmUnsubConfirm');
  let currentUnsubUrl = "";

  feedUnsubBtn.addEventListener('click', () => {
    if (!selectedChannelUnsubUrl) return;
    currentUnsubUrl = selectedChannelUnsubUrl;
    confirmUnsubText.textContent = `Unsubscribe from ${selectedChannelName}?`;
    confirmUnsubModal.classList.add('open');
  });

  confirmUnsubCancel.addEventListener('click', () => {
    confirmUnsubModal.classList.remove('open');
    currentUnsubUrl = "";
  });

  confirmUnsubConfirm.addEventListener('click', () => {
    if (currentUnsubUrl) {
      window.location.href = currentUnsubUrl;
    }
  });

  confirmUnsubModal.addEventListener('click', (e) => {
    if (e.target === confirmUnsubModal) {
      confirmUnsubModal.classList.remove('open');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      overlay.classList.remove('open');
      confirmUnsubModal.classList.remove('open');
      if (jsonOverlay) jsonOverlay.classList.remove('open');
      notifOverlay.classList.remove('open');
      if (importOverlay.classList.contains('open')) {
        if (isImporting) {
          minimizeImportToBackground();
        } else {
          importOverlay.classList.remove('open');
        }
      }
    }
  });

  function filterChannels() {
    const term = searchInput.value.toLowerCase();
    clearBtn.classList.toggle('visible', term.length > 0);

    channels.forEach(ch => {
      if (ch.dataset.name.includes(term)) {
        ch.style.display = 'flex';
      } else {
        ch.style.display = 'none';
      }
    });
    setTimeout(updateScrollButtons, 50);
  }

  searchInput.addEventListener('input', filterChannels);
  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    filterChannels();
    searchInput.focus();
  });

  sortBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sortBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const dir = btn.dataset.sort;
      Array.from(channels)
        .sort((a, b) => dir === 'asc'
          ? a.dataset.name.localeCompare(b.dataset.name)
          : b.dataset.name.localeCompare(a.dataset.name))
        .forEach(node => channelList.appendChild(node));

      channelList.scrollLeft = 0;
      updateScrollButtons();
    });
  });

  scrollLeftBtn.addEventListener('click', () => {
    channelList.scrollBy({ left: -300, behavior: 'smooth' });
  });
  scrollRightBtn.addEventListener('click', () => {
    channelList.scrollBy({ left: 300, behavior: 'smooth' });
  });

  channels.forEach(ch => {
    ch.addEventListener('click', (e) => {
      if (e.target.closest('.js-channel-notif-btn')) return;

      e.preventDefault();

      channels.forEach(c => c.classList.remove('selected'));
      ch.classList.add('selected');

      const id = ch.dataset.id;
      const realName = ch.dataset.realName || ch.querySelector('.channel-title').textContent;
      selectedChannelId = id;
      selectedChannelName = realName;
      selectedChannelUnsubUrl = ch.dataset.unsubUrl || `/api/remove-channel-sub?ID=${encodeURIComponent(USER_ID)}&channelID=${encodeURIComponent(id)}`;

      toolbarTitle.textContent = realName;
      openChannelBtn.href = `/channel?id=${encodeURIComponent(id)}`;
      openChannelBtn.style.display = 'inline-flex';
      feedUnsubBtn.style.display = 'inline-flex';
      closeViewer.style.display = 'inline-flex';
      updateFeedNotifButtonUI();

      emptyState.style.display = 'none';
      iframe.classList.remove('active');
      loadingState.style.display = 'flex';

      iframe.src = `/channel?id=${encodeURIComponent(id)}&embedchannelsubsfeed=true`;
    });
  });

  closeViewer.addEventListener('click', () => {
    iframe.src = '';
    iframe.classList.remove('active');
    loadingState.style.display = 'none';
    emptyState.style.display = 'flex';
    toolbarTitle.textContent = 'Select a channel to view content';
    openChannelBtn.style.display = 'none';
    feedUnsubBtn.style.display = 'none';
    closeViewer.style.display = 'none';
    selectedChannelId = null;
    selectedChannelName = '';
    selectedChannelUnsubUrl = '';
    updateFeedNotifButtonUI();
    channels.forEach(c => c.classList.remove('selected'));
  });

  iframe.addEventListener("load", () => {
    if (iframe.src && iframe.src !== window.location.href && iframe.src !== 'about:blank') {
      loadingState.style.display = 'none';
      iframe.classList.add('active');
    }

    try {
      const doc = iframe.contentDocument || iframe.contentWindow.document;
      doc.querySelectorAll("a").forEach(a => a.setAttribute("target", "_blank"));
    } catch(e) {}
  });
});
</script>
</body>
</html>