        <button class="ribbon-scroll-btn right" id="scrollRight">›</button>
      </div>

      <div class="feed-header">
        <div class="feed-title-wrapper">
          <h2 class="feed-title" id="toolbarTitle">Select a channel to view content</h2>
          <a href="#" id="openChannelBtn" class="open-channel-link" target="_blank" title="Open actual channel page">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
            </svg>
          </a>
        </div>
        <div class="feed-header-actions">
          <button class="feed-notif-btn" id="feedNotifToggle" type="button"></button>
          <button class="feed-unsub-btn" id="feedUnsubBtn" type="button">
            <svg viewBox="0 0 24 24"><path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
            <span>Unsubscribe</span>
