                        type="button"
                        data-id="<%= c.id %>"
                        title="Toggle notifications">
                </button>
              </div>
              <a class="channel-title" href="/channel?id=<%= encodeURIComponent(c.id) %>" title="<%= c.name %>"><%= c.name %></a>
            </div>
          <% }) %>
