        </div>

        <div class="empty-state" id="emptyState">
          <div class="empty-state-icon">
            <svg viewBox="0 0 24 24" width="40" height="40">
              <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z"/>
            </svg>
          </div>
          <p>Your subscription feed will appear here!! How cool is that :o</p>
        </div>
        <iframe id="mainFrame" sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
      </div>
    </main>
  </div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const USER_ID = (document.body.dataset.userid || '').trim();
  const NOTIF_PREFS_KEY = `poke_notif_prefs_${USER_ID}`;
  const NOTIF_READ_KEY = `poke_notif_read_${USER_ID}`;
  const NOTIF_ALERTED_KEY = `poke_notif_alerted_${USER_ID}`;
  const NOTIF_DISMISSED_KEY = `poke_notif_dismissed_${USER_ID}`;
  const NOTIF_KNOWN_CHANNELS_KEY = `poke_notif_known_channels_${USER_ID}`;
  const NOTIF_BASELINE_MS_KEY = `poke_notif_channel_baseline_${USER_ID}`;
  const NOTIF_INTERVAL_KEY = `poke_notif_interval_mins_${USER_ID}`;
  const META_SYNC_LAST_KEY = `poke_channel_meta_sync_${USER_ID}`;
  const META_SYNC_INTERVAL_MS = 60 * 60 * 1000;

  const SW_URL = '/poke-notifs-sw.js';
  const IDB_NAME = 'poke_notifs_db';
  const IDB_STORE = 'state';

  const BELL_ON_SVG = '<svg viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4a2 2 0 0 0 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 0 0-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>';
  const BELL_OFF_SVG = '<svg viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4a2 2 0 0 0 2 2zm6-6v-5c0-2.79-1.4-5.16-3.78-6.06L12 2.72V4a1.5 1.5 0 0 0-3 0v.68c-.28.07-.56.16-.82.27L3.27 2 2 3.27l4.17 4.17A6.47 6.47 0 0 0 6 11v5l-2 2v1h13.73l2 2L21 19.73 18 16.73V16z"/></svg>';

  const searchInput = document.getElementById('searchInput');
  const clearBtn = document.getElementById('clearSearch');
  const sortBtns = document.querySelectorAll('.sort-chip');
  const channelList = document.getElementById('channelList');
  const channels = document.querySelectorAll('.channel-card');
  const iframe = document.getElementById('mainFrame');
  const emptyState = document.getElementById('emptyState');
  const loadingState = document.getElementById('loadingState');
  const toolbarTitle = document.getElementById('toolbarTitle');
  const closeViewer = document.getElementById('closeViewer');
  const openChannelBtn = document.getElementById('openChannelBtn');
  const feedNotifToggle = document.getElementById('feedNotifToggle');
  const feedUnsubBtn = document.getElementById('feedUnsubBtn');
  const scrollLeftBtn = document.getElementById('scrollLeft');
  const scrollRightBtn = document.getElementById('scrollRight');
  const swStatusPill = document.getElementById('swStatusPill');

  let selectedChannelId = null;
  let selectedChannelName = '';
  let selectedChannelUnsubUrl = '';
  let swRegistration = null;
  let isImporting = false;
  let isSyncingMeta = false;

  function openNotifDb() {
    return new Promise((resolve, reject) => {
      if (!('indexedDB' in window)) return reject(new Error('No IndexedDB'));
      const req = indexedDB.open(IDB_NAME, 1);
      req.onupgradeneeded = () => {
        const db = req.result;
        if (!db.objectStoreNames.contains(IDB_STORE)) {
          db.createObjectStore(IDB_STORE);
        }
      };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }

  async function idbGet(key) {
    try {
      const db = await openNotifDb();
      return await new Promise((resolve, reject) => {
        const tx = db.transaction(IDB_STORE, 'readonly');
        const req = tx.objectStore(IDB_STORE).get(key);
        req.onsuccess = () => resolve(req.result ?? null);
        req.onerror = () => reject(req.error);
      });
    } catch {
      return null;
    }
  }

  async function idbSet(key, value) {
    try {
      const db = await openNotifDb();
      await new Promise((resolve, reject) => {
        const tx = db.transaction(IDB_STORE, 'readwrite');
        tx.objectStore(IDB_STORE).put(value, key);
        tx.oncomplete = () => resolve();
        tx.onerror = () => reject(tx.error);
      });
    } catch {}
  }

  function loadJsonStorage(key, fallback) {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : fallback;
    } catch {
      return fallback;
    }
  }

  function saveJsonStorage(key, value) {
    try {
      localStorage.setItem(key, JSON.stringify(value));
    } catch {}
  }

  function mergeAndSaveSet(key, localSet, maxLen = 3000) {
    const stored = loadJsonStorage(key, []);
    if (Array.isArray(stored)) {
      stored.forEach(id => localSet.add(id));
    }
    const merged = Array.from(localSet).slice(-maxLen);
    localSet.clear();
    merged.forEach(id => localSet.add(id));
    saveJsonStorage(key, merged);
  }

  function mergeAndSaveBaselines(localMap) {
    const stored = loadJsonStorage(NOTIF_BASELINE_MS_KEY, {});
    if (stored && typeof stored === 'object') {
      Object.entries(stored).forEach(([chId, ms]) => {
        if (currentSubIds.has(chId) && typeof ms === 'number' && ms > (localMap[chId] || 0)) {
          localMap[chId] = ms;
        }
      });
    }
    const pruned = {};
    Object.entries(localMap).forEach(([chId, ms]) => {
      if (currentSubIds.has(chId) && typeof ms === 'number' && ms > 0) {
        pruned[chId] = ms;
      }
    });
    Object.keys(localMap).forEach(k => delete localMap[k]);
    Object.assign(localMap, pruned);
    saveJsonStorage(NOTIF_BASELINE_MS_KEY, localMap);
  }

  function getSavedIntervalMinutes() {
    const val = parseInt(localStorage.getItem(NOTIF_INTERVAL_KEY), 10);
    return Number.isFinite(val) && val >= 1 && val <= 1440 ? val : 30;
  }

  let checkIntervalMinutes = getSavedIntervalMinutes();
  let checkIntervalTimer = null;

  const currentSubIds = new Set(Array.from(channels).map(c => c.dataset.id));
  let notifPrefs = loadJsonStorage(NOTIF_PREFS_KEY, {});
  let readVideoIds = new Set(loadJsonStorage(NOTIF_READ_KEY, []));
  let alertedVideoIds = new Set(loadJsonStorage(NOTIF_ALERTED_KEY, []));
  let dismissedVideoIds = new Set(loadJsonStorage(NOTIF_DISMISSED_KEY, []));
  let knownChannelIds = new Set(
    loadJsonStorage(NOTIF_KNOWN_CHANNELS_KEY, []).filter(id => currentSubIds.has(id))
  );
  let channelBaselineMs = {};
  const storedBaselines = loadJsonStorage(NOTIF_BASELINE_MS_KEY, {});
  if (storedBaselines && typeof storedBaselines === 'object') {
    Object.entries(storedBaselines).forEach(([chId, ms]) => {
      if (currentSubIds.has(chId) && typeof ms === 'number' && ms > 0) {
        channelBaselineMs[chId] = ms;
      }
    });
  }
  saveJsonStorage(NOTIF_KNOWN_CHANNELS_KEY, Array.from(knownChannelIds));
  saveJsonStorage(NOTIF_BASELINE_MS_KEY, channelBaselineMs);

  const sessionAlertedIds = new Set();
  let cachedNotifications = [];
  let isCheckingFeeds = false;

  function buildSwConfigSnapshot(lastCheckMs = 0) {
    return {
      userId: USER_ID,
      origin: window.location.origin,
      checkIntervalMinutes,
      channels: getSubscribedChannelsInfo(),
      notifPrefs,
      readVideoIds: Array.from(readVideoIds).slice(-3000),
      alertedVideoIds: Array.from(alertedVideoIds).slice(-3000),
      dismissedVideoIds: Array.from(dismissedVideoIds).slice(-3000),
      knownChannelIds: Array.from(knownChannelIds).filter(id => currentSubIds.has(id)),
      channelBaselineMs,
      lastCheckMs
    };
  }

  async function pullSwStateIntoLocal() {
    const swCfg = await idbGet('config');
    if (!swCfg || swCfg.userId !== USER_ID) return;

    if (Array.isArray(swCfg.readVideoIds)) {
      swCfg.readVideoIds.forEach(id => readVideoIds.add(id));
    }
    if (Array.isArray(swCfg.alertedVideoIds)) {
      swCfg.alertedVideoIds.forEach(id => {
        alertedVideoIds.add(id);
        sessionAlertedIds.add(id);
      });
    }
    if (Array.isArray(swCfg.knownChannelIds)) {
      swCfg.knownChannelIds.forEach(id => {
        if (currentSubIds.has(id)) knownChannelIds.add(id);
      });
    }
    if (swCfg.channelBaselineMs && typeof swCfg.channelBaselineMs === 'object') {
      Object.entries(swCfg.channelBaselineMs).forEach(([chId, ms]) => {
        if (currentSubIds.has(chId) && typeof ms === 'number' && ms > (channelBaselineMs[chId] || 0)) {
          channelBaselineMs[chId] = ms;
        }
      });
    }
    persistNotifState(false);
  }

  async function pushStateToSw(lastCheckMs = 0) {
    const snapshot = buildSwConfigSnapshot(lastCheckMs);
    const activeWorker = swRegistration?.active || navigator.serviceWorker?.controller;
    if (activeWorker) {
      try {
        activeWorker.postMessage({ type: 'SYNC_CONFIG', config: snapshot });
        return;
      } catch {}
    }
    await idbSet('config', snapshot);
  }

  async function registerPeriodicSyncIfAvailable(reg) {
    if (!reg || !('periodicSync' in reg)) return false;
    try {
      const status = await navigator.permissions.query({ name: 'periodic-background-sync' });
      if (status.state === 'granted') {
        await reg.periodicSync.register('poke-check-feeds', {
          minInterval: Math.max(5, checkIntervalMinutes) * 60 * 1000
        });
        return true;
      }
    } catch {}
    return false;
  }

  async function initBackgroundServiceWorker() {
    if (!('serviceWorker' in navigator)) {
      swStatusPill.textContent = 'Background worker unavailable in this browser';
      return;
    }
    try {
      const reg = await navigator.serviceWorker.register(SW_URL, { scope: '/' });
      swRegistration = await navigator.serviceWorker.ready;
      const periodicOk = await registerPeriodicSyncIfAvailable(swRegistration || reg);
      await pullSwStateIntoLocal();
      await pushStateToSw();

      swStatusPill.classList.add('ready');
      swStatusPill.textContent = periodicOk
        ? 'Background worker active (works even when tabs are closed!)'
        : 'Background worker active (checks on any Poke page & keeps test timers alive if u close this tab!)';
    } catch {
      swStatusPill.textContent = 'Background worker needs /poke-notifs-sw.js hosted at root (/)';
    }
  }

  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.addEventListener('message', async (event) => {
      const msg = event.data || {};
      if (msg.type === 'SW_STATE_UPDATED') {
        await pullSwStateIntoLocal();
        renderNotifications();
      } else if (msg.type === 'TEST_NOTIF_DELIVERED' && msg.item) {
        clearPendingTestNotification(false);
        testNotifStatusBox.className = 'test-status-box visible success';
        testNotifStatusBox.textContent = `Donesie! delivered desktop notification for "${msg.item.title}" (${msg.item.channelName})!`;
      }
    });
  }

  function syncStateFromStorage() {
    const storedRead = loadJsonStorage(NOTIF_READ_KEY, []);
    if (Array.isArray(storedRead)) storedRead.forEach(id => readVideoIds.add(id));

    const storedAlerted = loadJsonStorage(NOTIF_ALERTED_KEY, []);
    if (Array.isArray(storedAlerted)) storedAlerted.forEach(id => alertedVideoIds.add(id));

    const storedDismissed = loadJsonStorage(NOTIF_DISMISSED_KEY, []);
    if (Array.isArray(storedDismissed)) {
      dismissedVideoIds = new Set(storedDismissed);
    }

    const storedKnown = loadJsonStorage(NOTIF_KNOWN_CHANNELS_KEY, []);
    if (Array.isArray(storedKnown)) {
      storedKnown.forEach(id => {
        if (currentSubIds.has(id)) knownChannelIds.add(id);
      });
    }

    const latestBaselines = loadJsonStorage(NOTIF_BASELINE_MS_KEY, {});
    if (latestBaselines && typeof latestBaselines === 'object') {
      Object.entries(latestBaselines).forEach(([chId, ms]) => {
        if (currentSubIds.has(chId) && typeof ms === 'number' && ms > (channelBaselineMs[chId] || 0)) {
          channelBaselineMs[chId] = ms;
        }
      });
    }
  }

  function persistNotifState(alsoSyncSw = true, lastCheckMs = 0) {
    mergeAndSaveSet(NOTIF_READ_KEY, readVideoIds);
    mergeAndSaveSet(NOTIF_ALERTED_KEY, alertedVideoIds);
    const knownPruned = Array.from(knownChannelIds).filter(id => currentSubIds.has(id));
    knownChannelIds = new Set(knownPruned);
    saveJsonStorage(NOTIF_KNOWN_CHANNELS_KEY, knownPruned);
    mergeAndSaveBaselines(channelBaselineMs);
    if (alsoSyncSw) pushStateToSw(lastCheckMs);
  }

  function baselineChannelEntries(channelId, allEntries, ok) {
    if (!ok) return false;
    const isNewChannel = !knownChannelIds.has(channelId);
    const needsBaseline = !channelBaselineMs[channelId];
    if (!isNewChannel && !needsBaseline) return false;

    let maxPubMs = 0;
    allEntries.forEach(item => {
      alertedVideoIds.add(item.videoId);
      sessionAlertedIds.add(item.videoId);
      if (isNewChannel) {
        readVideoIds.add(item.videoId);
      }
      if (item.publishedMs > maxPubMs) {
        maxPubMs = item.publishedMs;
      }
    });

    channelBaselineMs[channelId] = maxPubMs > 0 ? maxPubMs : Date.now();
    knownChannelIds.add(channelId);
    return true;
  }

  function isOlderThanChannelBaseline(item) {
    const baseline = channelBaselineMs[item.channelId];
    return Boolean(baseline && item.publishedMs > 0 && item.publishedMs <= baseline);
  }

  function isItemUnread(item) {
    if (readVideoIds.has(item.videoId)) return false;
    if (isOlderThanChannelBaseline(item)) return false;
    return true;
  }

  function shouldDesktopAlertItem(item) {
    if (sessionAlertedIds.has(item.videoId)) return false;
    if (alertedVideoIds.has(item.videoId)) return false;
    if (readVideoIds.has(item.videoId)) return false;
    if (dismissedVideoIds.has(item.videoId)) return false;
    if (isOlderThanChannelBaseline(item)) return false;
    return true;
  }

  window.addEventListener('storage', (e) => {
    if (
      e.key === NOTIF_READ_KEY ||
      e.key === NOTIF_ALERTED_KEY ||
      e.key === NOTIF_DISMISSED_KEY ||
      e.key === NOTIF_KNOWN_CHANNELS_KEY ||
      e.key === NOTIF_BASELINE_MS_KEY
    ) {
      syncStateFromStorage();
      cachedNotifications = cachedNotifications.filter(n => !dismissedVideoIds.has(n.videoId));
      renderNotifications();
    }
  });

  function isChannelNotifEnabled(channelId) {
    return notifPrefs[channelId] !== false;
  }

  function updateChannelNotifButtonUI(btn, enabled) {
    btn.classList.toggle('enabled', enabled);
    btn.innerHTML = enabled ? BELL_ON_SVG : BELL_OFF_SVG;
    btn.title = enabled ? 'Notifications: ON (click to turn off)' : 'Notifications: OFF (click to turn on)';
  }

  function updateFeedNotifButtonUI() {
    if (!selectedChannelId) {
      feedNotifToggle.style.display = 'none';
      return;
    }
    const enabled = isChannelNotifEnabled(selectedChannelId);
    feedNotifToggle.style.display = 'inline-flex';
    feedNotifToggle.classList.toggle('enabled', enabled);
    feedNotifToggle.innerHTML = `${enabled ? BELL_ON_SVG : BELL_OFF_SVG}<span>${enabled ? 'Notifications On' : 'Notifications Off'}</span>`;
  }

  function setChannelNotif(channelId, enabled) {
    notifPrefs[channelId] = enabled;
    saveJsonStorage(NOTIF_PREFS_KEY, notifPrefs);

    const cardBtn = document.querySelector(`.js-channel-notif-btn[data-id="${CSS.escape(channelId)}"]`);
    if (cardBtn) updateChannelNotifButtonUI(cardBtn, enabled);
    if (selectedChannelId === channelId) updateFeedNotifButtonUI();

    if (!enabled) {
      cachedNotifications = cachedNotifications.filter(n => n.channelId !== channelId);
      pushStateToSw();
      renderNotifications();
    } else {
      fetchChannelFeedResult(channelId).then(({ ok, allEntries, entries }) => {
        syncStateFromStorage();
        if (baselineChannelEntries(channelId, allEntries, ok)) {
          persistNotifState(true);
        } else {
          pushStateToSw();
        }
        const visibleEntries = entries.filter(e => !dismissedVideoIds.has(e.videoId));
        if (visibleEntries.length) {
          const existingMap = new Map(cachedNotifications.map(n => [n.videoId, n]));
          visibleEntries.forEach(e => existingMap.set(e.videoId, e));
          cachedNotifications = Array.from(existingMap.values())
            .sort((a, b) => b.publishedMs - a.publishedMs)
            .slice(0, 60);
          renderNotifications();
        }
      });
    }
    updateNotifCountsHeader();
  }

  document.querySelectorAll('.js-channel-notif-btn').forEach(btn => {
    const id = btn.dataset.id;
    updateChannelNotifButtonUI(btn, isChannelNotifEnabled(id));
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      setChannelNotif(id, !isChannelNotifEnabled(id));
    });
  });

  feedNotifToggle.addEventListener('click', () => {
    if (!selectedChannelId) return;
    setChannelNotif(selectedChannelId, !isChannelNotifEnabled(selectedChannelId));
  });

  function rewriteVideoLink(href, videoId) {
    const origin = window.location.origin;
    if (href) {
      if (/^https?:\/\/(www\.|m\.)?youtube\.com\/watch/i.test(href)) {
        return href.replace(/^https?:\/\/(www\.|m\.)?youtube\.com/i, origin);
      }
      const shortsMatch = href.match(/^https?:\/\/(www\.|m\.)?youtube\.com\/shorts\/([^/?&#]+)/i);
      if (shortsMatch) {
        return `${origin}/watch?v=${encodeURIComponent(shortsMatch[2])}`;
      }
      if (/^https?:\/\/(www\.|m\.)?youtube\.com\//i.test(href)) {
        return href.replace(/^https?:\/\/(www\.|m\.)?youtube\.com/i, origin);
      }
    }
    return videoId ? `${origin}/watch?v=${encodeURIComponent(videoId)}` : '#';
  }

  function getXmlTagText(parent, localName) {
    const nsNodes = parent.getElementsByTagNameNS('*', localName);
    if (nsNodes && nsNodes.length > 0) return (nsNodes[0].textContent || '').trim();
    const nodes = parent.getElementsByTagName(localName);
    if (nodes && nodes.length > 0) return (nodes[0].textContent || '').trim();
    return '';
  }

  function getXmlThumbnail(entry) {
    const nsNodes = entry.getElementsByTagNameNS('*', 'thumbnail');
    if (nsNodes && nsNodes.length > 0) return nsNodes[0].getAttribute('url') || '';
    const nodes = entry.getElementsByTagName('media:thumbnail');
    if (nodes && nodes.length > 0) return nodes[0].getAttribute('url') || '';
    return '';
  }

  function getSubscribedChannelsInfo() {
    return Array.from(channels).map(ch => ({
      id: ch.dataset.id,
      name: ch.dataset.realName || ch.querySelector('.channel-title')?.textContent || 'Unknown Channel',
      avatar: ch.dataset.avatar || ch.querySelector('.channel-avatar-link img')?.getAttribute('src') || ''
    }));
  }

  async function fetchChannelFeedResult(channelId) {
    try {
      const res = await fetch(`/feeds/videos.xml?channel_id=${encodeURIComponent(channelId)}`);
      if (!res.ok) return { ok: false, feedTitle: '', allEntries: [], entries: [] };
      const xmlText = await res.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(xmlText, 'text/xml');
      if (doc.querySelector('parsererror')) return { ok: false, feedTitle: '', allEntries: [], entries: [] };

      const feedTitle = (doc.querySelector('feed > title')?.textContent || '').trim();
      const rawEntries = Array.from(doc.getElementsByTagName('entry'));
      const subCard = document.querySelector(`.channel-card[data-id="${CSS.escape(channelId)}"]`);
      const fallbackName = subCard?.dataset.realName || feedTitle || 'Unknown Channel';

      const allParsed = rawEntries.map(entry => {
        const rawId = getXmlTagText(entry, 'id');
        const videoId = (getXmlTagText(entry, 'videoId') || rawId.replace(/^yt:video:/, '')).trim();
        const title = (entry.querySelector('title')?.textContent || 'Untitled Video').trim();
        const authorName = (entry.querySelector('author > name')?.textContent || fallbackName).trim();
        const linkEl = entry.querySelector('link[rel="alternate"]') || entry.querySelector('link');
        const rawHref = linkEl ? (linkEl.getAttribute('href') || '').trim() : '';
        const publishedStr = (entry.querySelector('published')?.textContent || entry.querySelector('updated')?.textContent || '').trim();
        const publishedMs = publishedStr ? Date.parse(publishedStr) : 0;
        const thumbnail = getXmlThumbnail(entry);

        return {
          videoId,
          channelId,
          channelName: authorName,
          title,
          url: rewriteVideoLink(rawHref, videoId),
          publishedStr,
          publishedMs: Number.isNaN(publishedMs) ? 0 : publishedMs,
          thumbnail
        };
      }).filter(item => item.videoId);

      return { ok: true, feedTitle, allEntries: allParsed, entries: allParsed.slice(0, 5) };
    } catch {
      return { ok: false, feedTitle: '', allEntries: [], entries: [] };
    }
  }

  async function fetchChannelFeed(channelId) {
    const result = await fetchChannelFeedResult(channelId);
    return result.entries;
  }

  function formatRelativeTime(ms) {
    if (!ms) return '';
    const diffSec = Math.floor((Date.now() - ms) / 1000);
    if (diffSec < 60) return 'just now';
    const diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) return `${diffMin}m ago`;
    const diffHr = Math.floor(diffMin / 60);
    if (diffHr < 24) return `${diffHr}h ago`;
    const diffDay = Math.floor(diffHr / 24);
    if (diffDay < 30) return `${diffDay}d ago`;
    return new Date(ms).toLocaleDateString();
  }

  const notifBellBtn = document.getElementById('notifBellBtn');
  const notifBadge = document.getElementById('notifBadge');
  const notifOverlay = document.getElementById('notifOverlay');
  const closeNotifModal = document.getElementById('closeNotifModal');
  const notifList = document.getElementById('notifList');
  const notifStatusText = document.getElementById('notifStatusText');
  const notifCountText = document.getElementById('notifCountText');
  const refreshNotifBtn = document.getElementById('refreshNotifBtn');
  const markAllReadBtn = document.getElementById('markAllReadBtn');
  const clearInboxBtn = document.getElementById('clearInboxBtn');
  const enableDesktopNotifBtn = document.getElementById('enableDesktopNotifBtn');

  const notifSegBtns = document.querySelectorAll('[data-notif-tab]');
  const notifTabFeed = document.getElementById('notifTabFeed');
  const notifTabSettings = document.getElementById('notifTabSettings');

  notifSegBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      notifSegBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tab = btn.dataset.notifTab;
      notifTabFeed.classList.toggle('active', tab === 'feed');
      notifTabSettings.classList.toggle('active', tab === 'settings');
    });
  });

  function markVisibleInboxAsAlerted() {
    if (!cachedNotifications.length) return;
    cachedNotifications.forEach(n => {
      alertedVideoIds.add(n.videoId);
      sessionAlertedIds.add(n.videoId);
    });
    mergeAndSaveSet(NOTIF_ALERTED_KEY, alertedVideoIds);
    pushStateToSw();
  }

  function updateDesktopAlertButton() {
    if (!('Notification' in window)) {
      enableDesktopNotifBtn.style.display = 'none';
      return;
    }
    if (Notification.permission === 'granted') {
      enableDesktopNotifBtn.classList.add('active');
      enableDesktopNotifBtn.textContent = 'Desktop Alerts: On';
    } else if (Notification.permission === 'denied') {
      enableDesktopNotifBtn.classList.remove('active');
      enableDesktopNotifBtn.textContent = 'Desktop Alerts: Blocked';
    } else {
      enableDesktopNotifBtn.classList.remove('active');
      enableDesktopNotifBtn.textContent = 'Enable Desktop Alerts';
    }
  }

  enableDesktopNotifBtn.addEventListener('click', async () => {
    if (!('Notification' in window)) return;
    if (Notification.permission === 'default') {
      const perm = await Notification.requestPermission();
      updateDesktopAlertButton();
      if (perm === 'granted') {
        markVisibleInboxAsAlerted();
        if (swRegistration) registerPeriodicSyncIfAvailable(swRegistration);
      }
    }
  });
  updateDesktopAlertButton();

  function updateNotifCountsHeader() {
    const allSubs = getSubscribedChannelsInfo();
    const enabledCount = allSubs.filter(c => isChannelNotifEnabled(c.id)).length;
    notifCountText.textContent = `${enabledCount}/${allSubs.length} channels (auto checks every ${checkIntervalMinutes}m)`;
  }

  function updateUnreadBadge() {
    const unreadCount = cachedNotifications.filter(n => isItemUnread(n)).length;
    if (unreadCount > 0) {
      notifBadge.textContent = unreadCount > 99 ? '99+' : String(unreadCount);
      notifBadge.classList.add('visible');
    } else {
      notifBadge.classList.remove('visible');
    }
  }

  function renderNotifications() {
    updateUnreadBadge();
    updateNotifCountsHeader();

    if (!cachedNotifications.length) {
      notifList.innerHTML = '';
      const emptyBox = document.createElement('div');
      emptyBox.className = 'notif-empty';
      const msg = document.createElement('span');
      msg.textContent = "Nothing new in here right now!! Either everyone's quiet or you're all caught up :>";
      emptyBox.appendChild(msg);

      if (dismissedVideoIds.size > 0) {
        const restoreBtn = document.createElement('button');
        restoreBtn.type = 'button';
        restoreBtn.className = 'small-btn';
        restoreBtn.textContent = 'Bring back cleared uploads';
        restoreBtn.addEventListener('click', () => {
          dismissedVideoIds.clear();
          saveJsonStorage(NOTIF_DISMISSED_KEY, []);
          pushStateToSw();
          checkAllNotificationFeeds(false);
        });
        emptyBox.appendChild(restoreBtn);
      }

      notifList.appendChild(emptyBox);
      return;
    }

    notifList.innerHTML = '';
    cachedNotifications.forEach(item => {
      const isUnread = isItemUnread(item);
      const a = document.createElement('a');
      a.className = `notif-item${isUnread ? ' unread' : ''}`;
      a.href = item.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';

      const dot = document.createElement('span');
      dot.className = 'notif-unread-dot';

      const img = document.createElement('img');
      img.className = 'notif-thumb';
      img.src = item.thumbnail || '';
      img.alt = '';
      img.loading = 'lazy';

      const info = document.createElement('div');
      info.className = 'notif-info';

      const title = document.createElement('div');
      title.className = 'notif-video-title';
      title.textContent = item.title;

      const meta = document.createElement('div');
      meta.className = 'notif-channel-meta';
      meta.textContent = `${item.channelName}${item.publishedMs ? ' • ' + formatRelativeTime(item.publishedMs) : ''}`;

      info.appendChild(title);
      info.appendChild(meta);
      a.appendChild(dot);
      a.appendChild(img);
      a.appendChild(info);

      a.addEventListener('click', () => {
        readVideoIds.add(item.videoId);
        alertedVideoIds.add(item.videoId);
        sessionAlertedIds.add(item.videoId);
        mergeAndSaveSet(NOTIF_READ_KEY, readVideoIds);
        mergeAndSaveSet(NOTIF_ALERTED_KEY, alertedVideoIds);
        pushStateToSw();
        a.classList.remove('unread');
        updateUnreadBadge();
      });

      notifList.appendChild(a);
    });
  }

  async function fireDesktopNotification(item, isTest = false) {
    const tag = isTest ? `poke-test-${Date.now()}` : `poke-video-${item.videoId}`;
    const icon = item.thumbnail || '/css/poke-icon-logo.svg?v=6';

    if (swRegistration && swRegistration.showNotification) {
      try {
        await swRegistration.showNotification(item.channelName, {
          body: item.title,
          icon,
          tag,
          data: { url: item.url, videoId: item.videoId, isTest }
        });
        return;
      } catch {}
    }

    const n = new Notification(item.channelName, {
      body: item.title,
      icon,
      tag
    });
    n.onclick = () => {
      window.focus();
      window.open(item.url, '_blank', 'noopener,noreferrer');
      n.close();
    };
  }

  function triggerDesktopNotifications(items) {
    if (!('Notification' in window) || Notification.permission !== 'granted') return;

    syncStateFromStorage();

    const fresh = items.filter(item => shouldDesktopAlertItem(item));
    if (!fresh.length) return;

    fresh.forEach(item => {
      alertedVideoIds.add(item.videoId);
      sessionAlertedIds.add(item.videoId);
      if (item.publishedMs > (channelBaselineMs[item.channelId] || 0)) {
        channelBaselineMs[item.channelId] = item.publishedMs;
      }
    });
    mergeAndSaveSet(NOTIF_ALERTED_KEY, alertedVideoIds);
    mergeAndSaveBaselines(channelBaselineMs);
    pushStateToSw(Date.now());

    fresh.slice(0, 3).forEach(item => fireDesktopNotification(item, false));
  }

  async function checkAllNotificationFeeds(isInitialLoad = false) {
    if (isCheckingFeeds) return;
    isCheckingFeeds = true;
    notifStatusText.textContent = 'Checking feeds...';

    syncStateFromStorage();
    await pullSwStateIntoLocal();

    const enabledChannels = getSubscribedChannelsInfo().filter(c => isChannelNotifEnabled(c.id));
    if (!enabledChannels.length) {
      cachedNotifications = [];
      notifStatusText.textContent = 'All channel notifications are off';
      renderNotifications();
      isCheckingFeeds = false;
      return;
    }

    const collected = [];
    let baselinedAny = false;
    const batchSize = 5;
    for (let i = 0; i < enabledChannels.length; i += batchSize) {
      const batch = enabledChannels.slice(i, i + batchSize);
      const results = await Promise.all(
        batch.map(async ch => ({ channelId: ch.id, ...(await fetchChannelFeedResult(ch.id)) }))
      );
      syncStateFromStorage();
      results.forEach(({ channelId, ok, allEntries, entries }) => {
        if (baselineChannelEntries(channelId, allEntries, ok)) {
          baselinedAny = true;
        }
        collected.push(...entries);
      });
    }

    const nowMs = Date.now();
    if (baselinedAny) {
      persistNotifState(true, nowMs);
    } else {
      pushStateToSw(nowMs);
    }

    const dedup = new Map();
    collected.forEach(item => {
      if (!dismissedVideoIds.has(item.videoId) && !dedup.has(item.videoId)) {
        dedup.set(item.videoId, item);
      }
    });

    cachedNotifications = Array.from(dedup.values())
      .sort((a, b) => b.publishedMs - a.publishedMs)
      .slice(0, 60);

    if (notifOverlay.classList.contains('open')) {
      markVisibleInboxAsAlerted();
    } else {
      triggerDesktopNotifications(cachedNotifications);
    }

    const nowTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    notifStatusText.textContent = `Last checked at ${nowTime}!`;
    renderNotifications();
    isCheckingFeeds = false;
  }

  function startAutoCheckSchedule() {
    if (checkIntervalTimer) clearInterval(checkIntervalTimer);
    checkIntervalTimer = setInterval(() => checkAllNotificationFeeds(false), checkIntervalMinutes * 60 * 1000);
    updateNotifCountsHeader();
  }

  const intervalPresetChips = document.querySelectorAll('#intervalPresetChips .m3-chip');
  const customIntervalInput = document.getElementById('customIntervalInput');
  const saveIntervalBtn = document.getElementById('saveIntervalBtn');
  const intervalStatusBox = document.getElementById('intervalStatusBox');

  function syncIntervalUI() {
    customIntervalInput.value = String(checkIntervalMinutes);
    intervalPresetChips.forEach(chip => {
      chip.classList.toggle('active', parseInt(chip.dataset.mins, 10) === checkIntervalMinutes);
    });
  }

  function applyNewInterval(mins) {
    const parsed = parseInt(mins, 10);
    if (!Number.isFinite(parsed) || parsed < 1 || parsed > 1440) {
      intervalStatusBox.className = 'test-status-box visible error';
      intervalStatusBox.textContent = 'Enter a valid interval between 1 and 1440 minutes.';
      return;
    }
    checkIntervalMinutes = parsed;
    try { localStorage.setItem(NOTIF_INTERVAL_KEY, String(parsed)); } catch {}
    syncIntervalUI();
    startAutoCheckSchedule();
    pushStateToSw();
    if (swRegistration) registerPeriodicSyncIfAvailable(swRegistration);
    intervalStatusBox.className = 'test-status-box visible success';
    intervalStatusBox.textContent = `Auto-check interval updated to every...... ${parsed} minute${parsed === 1 ? '' : 's'}!`;
  }

  intervalPresetChips.forEach(chip => {
    chip.addEventListener('click', () => applyNewInterval(chip.dataset.mins));
  });

  saveIntervalBtn.addEventListener('click', () => applyNewInterval(customIntervalInput.value));
  customIntervalInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') applyNewInterval(customIntervalInput.value);
  });
  syncIntervalUI();

  const testChannelSelect = document.getElementById('testChannelSelect');
  const testDelayInput = document.getElementById('testDelayInput');
  const delayPresetChips = document.querySelectorAll('#delayPresetChips .m3-chip');
  const sendTestNotifBtn = document.getElementById('sendTestNotifBtn');
  const cancelTestNotifBtn = document.getElementById('cancelTestNotifBtn');
  const testNotifStatusBox = document.getElementById('testNotifStatusBox');

  getSubscribedChannelsInfo().forEach(ch => {
    const opt = document.createElement('option');
    opt.value = ch.id;
    opt.textContent = ch.name;
    testChannelSelect.appendChild(opt);
  });

  function syncDelayChips() {
    const current = parseInt(testDelayInput.value, 10);
    delayPresetChips.forEach(chip => {
      chip.classList.toggle('active', parseInt(chip.dataset.delay, 10) === current);
    });
  }

  delayPresetChips.forEach(chip => {
    chip.addEventListener('click', () => {
      testDelayInput.value = chip.dataset.delay;
      syncDelayChips();
    });
  });
  testDelayInput.addEventListener('input', syncDelayChips);

  let activeTestCountdown = null;
  let activeTestTimeout = null;
  let activeTestInSw = false;

  function clearPendingTestNotification(cancelSw = true) {
    if (activeTestCountdown) {
      clearInterval(activeTestCountdown);
      activeTestCountdown = null;
    }
    if (activeTestTimeout) {
      clearTimeout(activeTestTimeout);
      activeTestTimeout = null;
    }
    if (cancelSw && activeTestInSw) {
      const worker = swRegistration?.active || navigator.serviceWorker?.controller;
      if (worker) {
        try { worker.postMessage({ type: 'CANCEL_TEST_NOTIF' }); } catch {}
      }
    }
    activeTestInSw = false;
    cancelTestNotifBtn.style.display = 'none';
    sendTestNotifBtn.disabled = false;
  }

  cancelTestNotifBtn.addEventListener('click', () => {
    clearPendingTestNotification(true);
    testNotifStatusBox.className = 'test-status-box visible';
    testNotifStatusBox.textContent = 'Scheduled test notification canceled... :< sad';
  });

  async function resolveTestRssItem(selectedVal) {
    if (selectedVal !== '__latest__') {
      const entries = await fetchChannelFeed(selectedVal);
      if (entries.length) return entries[0];
      return null;
    }
    if (cachedNotifications.length) {
      const liveEntries = await fetchChannelFeed(cachedNotifications[0].channelId);
      return liveEntries[0] || cachedNotifications[0];
    }
    const allSubs = getSubscribedChannelsInfo();
    const candidates = allSubs.filter(c => isChannelNotifEnabled(c.id));
    const pool = candidates.length ? candidates : allSubs;
    for (const ch of pool.slice(0, 5)) {
      const entries = await fetchChannelFeed(ch.id);
      if (entries.length) return entries[0];
    }
    return null;
  }

  sendTestNotifBtn.addEventListener('click', async () => {
    clearPendingTestNotification(true);

    if (!('Notification' in window)) {
      testNotifStatusBox.className = 'test-status-box visible error';
      testNotifStatusBox.textContent = 'Desktop notifications are not supported by this browser...somehow...';
      return;
    }

    if (Notification.permission === 'default') {
      testNotifStatusBox.className = 'test-status-box visible';
      testNotifStatusBox.textContent = 'Requesting desktop notification permission...!';
      const perm = await Notification.requestPermission();
      updateDesktopAlertButton();
      if (perm === 'granted') {
        markVisibleInboxAsAlerted();
        if (swRegistration) registerPeriodicSyncIfAvailable(swRegistration);
      }
    }

    if (Notification.permission !== 'granted') {
      testNotifStatusBox.className = 'test-status-box visible error';
      testNotifStatusBox.textContent = 'Desktop notifications are blocked... why... pls allow notifications for this site in your browser settings and try againe!';
      return;
    }

    const delaySec = Math.max(0, Math.min(120, parseInt(testDelayInput.value, 10) || 0));
    testDelayInput.value = String(delaySec);
    syncDelayChips();

    sendTestNotifBtn.disabled = true;
    testNotifStatusBox.className = 'test-status-box visible';
    testNotifStatusBox.textContent = 'Fetching live RSS feed entry...';

    const rssItem = await resolveTestRssItem(testChannelSelect.value);
    if (!rssItem) {
      sendTestNotifBtn.disabled = false;
      testNotifStatusBox.className = 'test-status-box visible error';
      testNotifStatusBox.textContent = 'Could not fetch any RSS video from the selected channel... Make sure you are subscribed to at least one channel with an active feed!';
      return;
    }

    const activeWorker = swRegistration?.active || navigator.serviceWorker?.controller;

    if (activeWorker) {
      activeTestInSw = true;
      activeWorker.postMessage({
        type: 'SCHEDULE_TEST_NOTIF',
        item: rssItem,
        delayMs: delaySec * 1000
      });

      if (delaySec === 0) {
        testNotifStatusBox.className = 'test-status-box visible success';
        testNotifStatusBox.textContent = `Donesie! delivered desktop notification for "${rssItem.title}" (${rssItem.channelName})!`;
        sendTestNotifBtn.disabled = false;
        activeTestInSw = false;
        return;
      }

      let remaining = delaySec;
      cancelTestNotifBtn.style.display = 'inline-flex';
      testNotifStatusBox.className = 'test-status-box visible';
      testNotifStatusBox.textContent = `Sending notification for "${rssItem.title}" (${rssItem.channelName}) in ${remaining}s (safe to close this tab!)...`;

      activeTestCountdown = setInterval(() => {
        remaining -= 1;
        if (remaining > 0) {
          testNotifStatusBox.textContent = `Sending notification for "${rssItem.title}" (${rssItem.channelName}) in ${remaining}s (safe to close this tab!)...`;
        } else {
          clearInterval(activeTestCountdown);
          activeTestCountdown = null;
        }
      }, 1000);
      return;
    }

    const deliverNow = () => {
      clearPendingTestNotification(false);
      fireDesktopNotification(rssItem, true);
      testNotifStatusBox.className = 'test-status-box visible success';
      testNotifStatusBox.textContent = `Donesie! delivered desktop notification for "${rssItem.title}" (${rssItem.channelName})!`;
    };

    if (delaySec === 0) {
      deliverNow();
      return;
    }

    let remaining = delaySec;
    cancelTestNotifBtn.style.display = 'inline-flex';
    testNotifStatusBox.className = 'test-status-box visible';
    testNotifStatusBox.textContent = `Sending notification for "${rssItem.title}" (${rssItem.channelName}) in ${remaining}s...`;

    activeTestCountdown = setInterval(() => {
      remaining -= 1;
      if (remaining > 0) {
        testNotifStatusBox.textContent = `Sending notification for "${rssItem.title}" (${rssItem.channelName}) in ${remaining}s...`;
      }
    }, 1000);

    activeTestTimeout = setTimeout(deliverNow, delaySec * 1000);
  });

