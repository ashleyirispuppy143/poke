  function isLikelyChannelAvatarUrl(url) {
    if (!url || typeof url !== 'string') return false;
    const trimmed = url.trim();
    if (!trimmed) return false;
    return /yt3\.(ggpht|googleusercontent)\.com/i.test(trimmed);
  }

  function findChannelAvatarInDoc(doc) {
    const imgs = Array.from(doc.querySelectorAll('img'));
    for (const img of imgs) {
      const src = (img.getAttribute('src') || img.src || '').trim();
      if (isLikelyChannelAvatarUrl(src)) return src;
    }
    const ogImg = doc.querySelector('meta[property="og:image"]')?.getAttribute('content') || '';
    if (isLikelyChannelAvatarUrl(ogImg)) return ogImg.trim();
    const fallbackImg = doc.querySelector('.channel-avatar img, .avatar img');
    return fallbackImg ? (fallbackImg.getAttribute('src') || fallbackImg.src || '').trim() : '';
  }

  function resolveChannelSubViaIframe(ch, allowAlreadySubbedMeta = false) {
    return new Promise((resolve) => {
      const bgFrame = document.createElement('iframe');
      bgFrame.style.cssText = 'position:fixed;width:1px;height:1px;left:-9999px;top:-9999px;opacity:0;pointer-events:none;border:0;';
      bgFrame.setAttribute('aria-hidden', 'true');
      bgFrame.tabIndex = -1;

      let finished = false;
      let pollTimer = null;
      let timeoutTimer = null;

      const cleanup = (result) => {
        if (finished) return;
        finished = true;
        if (pollTimer) clearInterval(pollTimer);
        if (timeoutTimer) clearTimeout(timeoutTimer);
        try { bgFrame.src = 'about:blank'; } catch {}
        bgFrame.remove();
        resolve(result);
      };

      const extractTitleFromDoc = (doc) => {
        const ogTitle = (doc.querySelector('meta[property="og:title"]')?.getAttribute('content') || '').trim();
        const heading = (doc.querySelector('.channel-name, .channel-header h1, h1')?.textContent || '').trim();
        const docTitle = (doc.title || '').replace(/\s*[-|]\s*Poke.*$/i, '').trim();
        return heading || ogTitle || docTitle || '';
      };

      const inspectDoc = () => {
        try {
          const doc = bgFrame.contentDocument || bgFrame.contentWindow?.document;
          if (!doc) return false;

          const subEl = doc.getElementById('sub');
          const rawHref = subEl ? (subEl.getAttribute('href') || '').trim() : '';

          if (rawHref && rawHref !== '#' && !rawHref.startsWith('javascript:')) {
            const parsedUrl = new URL(rawHref, window.location.origin);

            if (parsedUrl.pathname.includes('remove-channel-sub')) {
              const avatar = findChannelAvatarInDoc(doc) || ch.avatar || '';
              const docName = extractTitleFromDoc(doc);
              const name = docName || ch.name || ch.id;
              if (allowAlreadySubbedMeta) {
                const params = new URLSearchParams({
                  ID: USER_ID,
                  channelName: name,
                  avatar,
                  channelID: ch.id
                });
                cleanup({
                  alreadySubbed: true,
                  url: `/api/set-channel-subs?${params.toString()}`,
                  avatar,
                  name
                });
              } else {
                cleanup({ alreadySubbed: true, url: null, avatar, name });
              }
              return true;
            }

            if (parsedUrl.pathname.includes('set-channel-subs')) {
              if (USER_ID) parsedUrl.searchParams.set('ID', USER_ID);
              if (!parsedUrl.searchParams.get('channelID')) parsedUrl.searchParams.set('channelID', ch.id);

              const foundName = (parsedUrl.searchParams.get('channelName') || extractTitleFromDoc(doc) || ch.name || ch.id).trim();
              parsedUrl.searchParams.set('channelName', foundName);

              let foundAvatar = (parsedUrl.searchParams.get('avatar') || '').trim();
              if (!foundAvatar) {
                foundAvatar = findChannelAvatarInDoc(doc) || ch.avatar || '';
                if (foundAvatar) parsedUrl.searchParams.set('avatar', foundAvatar);
              }

              cleanup({
                alreadySubbed: false,
                url: `${parsedUrl.pathname}?${parsedUrl.searchParams.toString()}`,
                avatar: foundAvatar,
                name: foundName
              });
              return true;
            }
          }
        } catch {}
        return false;
      };

      bgFrame.addEventListener('load', () => {
        if (inspectDoc()) return;
        pollTimer = setInterval(() => {
          inspectDoc();
        }, 150);
      });

      bgFrame.addEventListener('error', () => cleanup(null));

      timeoutTimer = setTimeout(() => {
        try {
          const doc = bgFrame.contentDocument || bgFrame.contentWindow?.document;
          if (doc) {
            const foundAvatar = findChannelAvatarInDoc(doc) || ch.avatar || '';
            const titleText = extractTitleFromDoc(doc);
            const foundName = titleText || ch.name || ch.id;
            const params = new URLSearchParams({
              ID: USER_ID,
              channelName: foundName,
              avatar: foundAvatar,
              channelID: ch.id
            });
            cleanup({
              alreadySubbed: false,
              url: `/api/set-channel-subs?${params.toString()}`,
              avatar: foundAvatar,
              name: foundName
            });
            return;
          }
        } catch {}
        cleanup(null);
      }, 10000);

      document.body.appendChild(bgFrame);
      bgFrame.src = `/channel?id=${encodeURIComponent(ch.id)}`;
    });
  }

  async function syncChannelMetadataToDb(force = false) {
    if (isSyncingMeta || isImporting || !USER_ID) return;

    const lastSyncMs = parseInt(localStorage.getItem(META_SYNC_LAST_KEY), 10) || 0;
    if (!force && (Date.now() - lastSyncMs) < META_SYNC_INTERVAL_MS) return;

    isSyncingMeta = true;
    const allSubs = getSubscribedChannelsInfo();

    for (const ch of allSubs) {
      if (isImporting) break;
      try {
        const [meta, feedRes] = await Promise.all([
          resolveChannelSubViaIframe(ch, true),
          fetchChannelFeedResult(ch.id)
        ]);

        const freshName = (feedRes.feedTitle || meta?.name || '').trim();
        const freshAvatar = (meta?.avatar || '').trim();

        const nextName = freshName && freshName !== ch.id ? freshName : ch.name;
        const nextAvatar = isLikelyChannelAvatarUrl(freshAvatar) ? freshAvatar : ch.avatar;

        const nameChanged = Boolean(nextName && nextName !== ch.name);
        const avatarChanged = Boolean(nextAvatar && nextAvatar !== ch.avatar);

        if (nameChanged || avatarChanged) {
          const params = new URLSearchParams({
            ID: USER_ID,
            channelName: nextName,
            avatar: nextAvatar,
            channelID: ch.id
          });
          const res = await fetch(`/api/set-channel-subs?${params.toString()}`, {
            credentials: 'same-origin'
          });

          if (res.ok) {
            const card = document.querySelector(`.channel-card[data-id="${CSS.escape(ch.id)}"]`);
            if (card) {
              if (nameChanged) {
                card.dataset.realName = nextName;
                card.dataset.name = nextName.toLowerCase();
                const titleLink = card.querySelector('.channel-title');
                if (titleLink) {
                  titleLink.textContent = nextName;
                  titleLink.title = nextName;
                }
                if (selectedChannelId === ch.id) {
                  selectedChannelName = nextName;
                  toolbarTitle.textContent = nextName;
                }
              }
              if (avatarChanged) {
                card.dataset.avatar = nextAvatar;
                const img = card.querySelector('.channel-avatar-link img');
                if (img) img.src = nextAvatar;
              }
            }
          }
        }
      } catch {}

      await new Promise((r) => setTimeout(r, 350));
    }

    if (!isImporting) {
      try { localStorage.setItem(META_SYNC_LAST_KEY, String(Date.now())); } catch {}
      pushStateToSw();
    }
    isSyncingMeta = false;
  }

