  function extractChannelId(str) {
    if (!str) return null;
    const trimmed = str.trim();
    const urlMatch = trimmed.match(/channel\/(UC[a-zA-Z0-9_-]{22})/);
    if (urlMatch) return urlMatch[1];
    const feedMatch = trimmed.match(/channel_id=(UC[a-zA-Z0-9_-]{22})/);
    if (feedMatch) return feedMatch[1];
    const directMatch = trimmed.match(/\b(UC[a-zA-Z0-9_-]{22})\b/);
    if (directMatch) return directMatch[1];
    return null;
  }

  function parseCsvLine(line) {
    const fields = [];
    let current = '';
    let inQuotes = false;
    for (let i = 0; i < line.length; i++) {
      const ch = line[i];
      if (ch === '"') {
        if (inQuotes && line[i + 1] === '"') {
          current += '"';
          i++;
        } else {
          inQuotes = !inQuotes;
        }
      } else if (ch === ',' && !inQuotes) {
        fields.push(current);
        current = '';
      } else {
        current += ch;
      }
    }
    fields.push(current);
    return fields;
  }

  function parseImportContent(text) {
    const found = new Map();
    const trimmed = text.trim();
    if (!trimmed) return [];

    if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
      try {
        const data = JSON.parse(trimmed);
        if (Array.isArray(data)) {
          data.forEach(item => {
            if (typeof item === 'string') {
              const id = extractChannelId(item);
              if (id) found.set(id, { id, name: id, avatar: '' });
            } else if (item && typeof item === 'object') {
              const id = extractChannelId(item.id || item.channelId || item.url || '');
              if (id) found.set(id, { id, name: item.name || item.channelName || item.title || id, avatar: item.avatar || '' });
            }
          });
        } else if (data && Array.isArray(data.subscriptions)) {
          data.subscriptions.forEach(item => {
            if (typeof item === 'string') {
              const id = extractChannelId(item);
              if (id) found.set(id, { id, name: id, avatar: '' });
            } else if (item && typeof item === 'object') {
              const id = extractChannelId(item.url || item.id || item.channelId || '');
              if (id) found.set(id, { id, name: item.name || item.channelName || id, avatar: item.avatar || '' });
            }
          });
        } else if (data && typeof data === 'object') {
          Object.entries(data).forEach(([key, val]) => {
            const id = extractChannelId(key);
            if (id) {
              found.set(id, {
                id,
                name: (val && (val.channelName || val.name)) || id,
                avatar: (val && val.avatar) || ''
              });
            }
          });
        }
        if (found.size > 0) return Array.from(found.values());
      } catch {}
    }

    if (trimmed.startsWith('<')) {
      try {
        const doc = new DOMParser().parseFromString(trimmed, 'text/xml');
        doc.querySelectorAll('outline').forEach(outline => {
          const xmlUrl = outline.getAttribute('xmlUrl') || outline.getAttribute('htmlUrl') || '';
          const id = extractChannelId(xmlUrl);
          if (id) {
            const name = outline.getAttribute('title') || outline.getAttribute('text') || id;
            found.set(id, { id, name, avatar: '' });
          }
        });
        if (found.size > 0) return Array.from(found.values());
      } catch {}
    }

    const lines = trimmed.split(/\r?\n/);
    lines.forEach((line, idx) => {
      if (!line.trim()) return;
      const cols = parseCsvLine(line);
      if (idx === 0 && /channel\s*id/i.test(cols[0])) return;
      const id = extractChannelId(cols[0]) || extractChannelId(cols[1]) || extractChannelId(line);
      if (id) {
        const name = (cols[2] && cols[2].trim()) || (cols[1] && !/youtube\.com/i.test(cols[1]) ? cols[1].trim() : '') || id;
        found.set(id, { id, name, avatar: '' });
      }
    });

    return Array.from(found.values());
  }

  function updateImportPreview(channelsArr) {
    const existingIds = new Set(Array.from(channels).map(c => c.dataset.id));
    const newOnes = channelsArr.filter(c => !existingIds.has(c.id));
    parsedImportChannels = newOnes;

    if (!channelsArr.length) {
      importPreview.classList.remove('visible');
      startImportBtn.disabled = true;
      return;
    }

    const skipped = channelsArr.length - newOnes.length;
    importPreview.classList.add('visible');
    importPreviewBg.classList.remove('visible');
    importCurrentRow.classList.remove('visible');
    importProgressBar.classList.remove('visible');
    importProgressFill.style.width = '0%';
    importPreviewText.textContent = newOnes.length
      ? `Found ${newOnes.length} new channel${newOnes.length === 1 ? '' : 's'} to import${skipped ? ` (${skipped} already subscribed)` : ''}.`
      : `All ${channelsArr.length} detected channels are already in your subscriptions!`;
    startImportBtn.disabled = newOnes.length === 0;
  }

