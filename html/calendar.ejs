<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" href="css/yt-ukraine.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#161114" media="(prefers-color-scheme: dark)" />
  <meta name="description" content="Poke! Calendar — zero-JS calendar" />
  <meta property="og:title" content="Poke! Calendar" />
  <meta property="og:description" content="Navigate months without JavaScript needed" />
  <meta property="og:image" content="/static/poke.webp" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Poke! Calendar" />
  <meta name="twitter:image" content="/static/poke-embed.webp" />
  <title>Poke! Calendar</title>

  <style>
    :root {
      --md-sys-color-background: #161114;
      --md-sys-color-surface: #161114;
      --md-sys-color-surface-container-lowest: #110c0f;
      --md-sys-color-surface-container-low: #1f191c;
      --md-sys-color-surface-container: #231d20;
      --md-sys-color-surface-container-high: #2e272b;
      --md-sys-color-surface-container-highest: #393236;
      --md-sys-color-on-surface: #ecdfe4;
      --md-sys-color-on-surface-variant: #d5c2c9;
      --md-sys-color-primary: #ffabcc;
      --md-sys-color-on-primary: #541434;
      --md-sys-color-primary-container: #702b4b;
      --md-sys-color-on-primary-container: #ffd8e6;
      --md-sys-color-secondary-container: #593e4a;
      --md-sys-color-on-secondary-container: #ffd8e6;
      --md-sys-color-outline: #9e8c93;
      --md-sys-color-outline-variant: #514349;
      --font-body: "Google Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      --radius-xs: 8px;
      --radius-sm: 12px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --radius-xl: 28px;
      --radius-full: 9999px;
      --spring-easing: cubic-bezier(0.2, 0, 0, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--md-sys-color-background);
      color: var(--md-sys-color-on-surface);
      font-family: var(--font-body);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    .navbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      padding: 16px 32px;
      background: var(--md-sys-color-surface);
      gap: 16px;
    }

    .brand {
      display: flex;
      align-items: center;
      padding: 8px 16px 8px 8px;
      border-radius: var(--radius-full);
      transition: background 0.2s var(--spring-easing);
    }

    .brand:hover {
      background: var(--md-sys-color-surface-container-high);
    }

    .brand img {
      height: 32px;
      width: auto;
      display: block;
    }

    .year-info {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 0.85rem;
    }

    .year-info span {
      background: var(--md-sys-color-surface-container-high);
      color: var(--md-sys-color-on-surface-variant);
      padding: 8px 16px;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 500;
      letter-spacing: 0.2px;
    }

    .year-info span strong {
      color: var(--md-sys-color-primary);
      font-weight: 600;
    }

    .main-wrapper {
      width: 100%;
      max-width: 1600px;
      margin: 0 auto;
      padding: 8px 32px 32px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      background: var(--md-sys-color-surface-container-low);
      padding: 16px 24px;
      border-radius: var(--radius-xl);
      gap: 16px;
    }

    .toolbar-left {
      display: flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .month-title {
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 500;
      margin: 0;
      color: var(--md-sys-color-on-surface);
      letter-spacing: -0.5px;
      line-height: 1.2;
    }

    .nav-arrows {
      display: flex;
      gap: 4px;
      background: var(--md-sys-color-surface-container-high);
      padding: 4px;
      border-radius: var(--radius-full);
    }

    .btn-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full);
      text-decoration: none;
      color: var(--md-sys-color-on-surface);
      transition: all 0.2s var(--spring-easing);
      font-size: 0.95rem;
      user-select: none;
    }

    .btn-icon:hover {
      background: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
      transform: scale(1.05);
    }

    .btn-icon:active {
      transform: scale(0.95);
    }

    .date-form {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .picker-input {
      background: var(--md-sys-color-surface-container-high);
      border: 1px solid transparent;
      color: var(--md-sys-color-on-surface);
      padding: 10px 20px;
      border-radius: var(--radius-full);
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 500;
      outline: none;
      transition: all 0.2s var(--spring-easing);
      color-scheme: dark;
      cursor: pointer;
    }

    .picker-input:hover {
      background: var(--md-sys-color-surface-container-highest);
    }

    .picker-input:focus {
      border-color: var(--md-sys-color-primary);
      background: var(--md-sys-color-surface-container-highest);
      box-shadow: 0 0 0 3px rgba(255, 171, 204, 0.2);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 24px;
      height: 44px;
      border-radius: var(--radius-full);
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      border: none;
      font-size: 0.9rem;
      font-family: inherit;
      letter-spacing: 0.2px;
      transition: all 0.2s var(--spring-easing);
      white-space: nowrap;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn-primary {
      background: var(--md-sys-color-primary);
      color: var(--md-sys-color-on-primary) !important;
    }

    .btn-primary:hover {
      background: #ffc2da;
      box-shadow: 0 4px 12px rgba(255, 171, 204, 0.25);
    }

    .btn-secondary {
      background: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
    }

    .btn-secondary:hover {
      background: #6b4c5a;
    }

    .calendar-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 8px;
      table-layout: fixed;
      flex: 1;
      background: var(--md-sys-color-surface-container-low);
      padding: 16px;
      border-radius: var(--radius-xl);
    }

    .calendar-table th {
      padding: 8px 0 12px 0;
      color: var(--md-sys-color-on-surface-variant);
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-align: center;
    }

    .calendar-table td {
      height: clamp(95px, 13vh, 160px);
      vertical-align: top;
      background: var(--md-sys-color-surface-container-high);
      border-radius: var(--radius-md);
      padding: 10px;
      transition: all 0.2s var(--spring-easing);
      position: relative;
      overflow: hidden;
    }

    .calendar-table td:empty {
      background: var(--md-sys-color-surface-container);
      opacity: 0.35;
      pointer-events: none;
    }

    .calendar-table td:not(:empty) {
      cursor: pointer;
    }

    .calendar-table td:not(:empty):hover {
      background: var(--md-sys-color-surface-container-highest);
      border-radius: var(--radius-lg);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
    }

    .calendar-table td:not(:empty):focus-visible {
      outline: 2px solid var(--md-sys-color-primary);
      outline-offset: 2px;
    }

    .day-header {
      display: flex;
      justify-content: flex-start;
      margin-bottom: 8px;
    }

    .day-num {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 32px;
      height: 32px;
      padding: 0 8px;
      border-radius: var(--radius-full);
      font-weight: 500;
      font-size: 0.9rem;
      color: var(--md-sys-color-on-surface);
      transition: all 0.2s var(--spring-easing);
    }

    .calendar-table td.today {
      background: var(--md-sys-color-surface-container-highest);
      box-shadow: inset 0 0 0 2px var(--md-sys-color-primary);
    }

    .calendar-table td.today .day-num {
      background: var(--md-sys-color-primary);
      color: var(--md-sys-color-on-primary);
      font-weight: 600;
    }

    .note-indicator {
      display: none;
      background-color: var(--md-sys-color-primary-container);
      color: var(--md-sys-color-on-primary-container);
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      font-size: 0.8rem;
      font-weight: 500;
      text-align: left;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      letter-spacing: 0.1px;
      transition: transform 0.2s var(--spring-easing);
    }

    .calendar-table td.has-note .note-indicator {
      display: block;
    }

    #note-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(6px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s var(--spring-easing);
      padding: 16px;
    }

    #note-modal.open {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-content {
      background: var(--md-sys-color-surface-container-high);
      padding: 28px;
      border-radius: var(--radius-xl);
      width: min(100%, 480px);
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
      transform: scale(0.92) translateY(16px);
      transition: transform 0.3s var(--spring-easing);
    }

    #note-modal.open .modal-content {
      transform: scale(1) translateY(0);
    }

    .modal-header {
      font-size: 1.5rem;
      font-weight: 500;
      margin-bottom: 20px;
      color: var(--md-sys-color-on-surface);
      letter-spacing: -0.3px;
    }

    .modal-textarea {
      width: 100%;
      height: 150px;
      background: var(--md-sys-color-surface-container-highest);
      border: 2px solid transparent;
      color: var(--md-sys-color-on-surface);
      padding: 16px;
      border-radius: var(--radius-md);
      margin-bottom: 24px;
      resize: none;
      font-family: inherit;
      font-size: 1rem;
      line-height: 1.5;
      transition: all 0.2s var(--spring-easing);
    }

    .modal-textarea::placeholder {
      color: var(--md-sys-color-on-surface-variant);
    }

    .modal-textarea:focus {
      outline: none;
      border-color: var(--md-sys-color-primary);
      background: var(--md-sys-color-surface-container-low);
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }

    @media (max-width: 1024px) {
      .navbar {
        padding: 16px 20px;
      }
      .main-wrapper {
        padding: 8px 20px 24px;
      }
      .calendar-table {
        border-spacing: 6px;
        padding: 12px;
      }
    }

    @media (max-width: 768px) {
      .navbar {
        padding: 12px 16px;
      }
      .years {
        width: 100%;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .years::-webkit-scrollbar {
        display: none;
      }
      .year-info {
        flex-wrap: nowrap;
        width: max-content;
      }
      .main-wrapper {
        padding: 4px 12px 16px;
        gap: 12px;
      }
      .toolbar {
        flex-direction: column;
        align-items: stretch;
        padding: 16px;
        border-radius: var(--radius-lg);
        gap: 12px;
      }
      .toolbar-left {
        justify-content: space-between;
        width: 100%;
      }
      .date-form {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
      }
      .picker-input {
        width: 100%;
      }
      .calendar-table {
        border-spacing: 4px;
        padding: 8px;
        border-radius: var(--radius-lg);
      }
      .calendar-table th {
        font-size: 0.7rem;
        padding: 4px 0 8px 0;
        letter-spacing: 0.5px;
      }
      .calendar-table td {
        height: clamp(68px, 11vh, 95px);
        padding: 6px;
        border-radius: var(--radius-sm);
      }
      .calendar-table td:not(:empty):hover {
        transform: none;
        border-radius: var(--radius-sm);
      }
      .day-header {
        justify-content: center;
        margin-bottom: 4px;
      }
      .day-num {
        min-width: 24px;
        height: 24px;
        font-size: 0.75rem;
        padding: 0 4px;
      }
      .note-indicator {
        font-size: 0.65rem;
        padding: 3px 6px;
        border-radius: 6px;
        text-align: center;
      }
      #note-modal {
        align-items: flex-end;
        padding: 0;
      }
      .modal-content {
        width: 100%;
        border-radius: var(--radius-xl) var(--radius-xl) 0 0;
        padding: 24px 20px 32px;
        transform: translateY(100%);
      }
      #note-modal.open .modal-content {
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>

  <nav class="navbar">
    <a href="/" class="brand">
      <img src="/css/logo-poke.svg?v=5" alt="Poke Calendar Logo">
    </a>
    <div class="years">
      <div class="year-info">
        <span>Gregorian <strong><%= year %></strong></span>
        <span>Islamic <strong><%= islamicYear %></strong></span>
        <span>Persian <strong><%= persianYear %></strong></span>
      </div>
    </div>
  </nav>

  <div class="main-wrapper">
    <div class="toolbar">
      <div class="toolbar-left">
        <h2 class="month-title">
          <%= queryDate.toLocaleString('default', { month: 'long' }) %> <%= year %>
        </h2>
        <div class="nav-arrows">
          <a href="/calendar?date=<%= new Date(year, month - 1, 1).toISOString() %>" class="btn-icon" title="Previous month" aria-label="Previous month">
            &#10094;
          </a>
          <a href="/calendar?date=<%= new Date(year, month + 1, 1).toISOString() %>" class="btn-icon" title="Next month" aria-label="Next month">
            &#10095;
          </a>
        </div>
      </div>
      
      <form action="/calendar" method="get" class="date-form">
        <input 
          type="month" 
          name="date" 
          value="<%= currentDate.toISOString().slice(0,7) %>" 
          class="picker-input" 
          aria-label="Select Month"
        />
        <button type="submit" class="btn btn-secondary">Jump to Date</button>
      </form>
    </div>

    <table class="calendar-table" role="grid" aria-label="Monthly calendar">
      <thead>
        <tr>
          <th scope="col" abbr="Sunday">Sun</th>
          <th scope="col" abbr="Monday">Mon</th>
          <th scope="col" abbr="Tuesday">Tue</th>
          <th scope="col" abbr="Wednesday">Wed</th>
          <th scope="col" abbr="Thursday">Thu</th>
          <th scope="col" abbr="Friday">Fri</th>
          <th scope="col" abbr="Saturday">Sat</th>
        </tr>
      </thead>
      <tbody>
        <% days.forEach((day, idx) => { %>
          <% if (idx % 7 === 0) { %><tr><% } %>
            
            <% 
              const today = new Date();
              const isToday = day &&
                day.getDate() === today.getDate() &&
                day.getMonth() === today.getMonth() &&
                day.getFullYear() === today.getFullYear();
              
              const dateStr = day ? 
                 day.getFullYear() + '-' + 
                 String(day.getMonth() + 1).padStart(2, '0') + '-' + 
                 String(day.getDate()).padStart(2, '0') 
                 : '';
            %>

            <td 
              class="<%= isToday ? 'today' : '' %>" 
              data-date="<%= dateStr %>"
              <% if (day) { %> tabindex="0" role="gridcell" <% } %>
            >
              <% if (day) { %>
                <div class="day-header">
                  <span class="day-num"><%= day.getDate() %></span>
                </div>
                <div class="note-indicator"></div>
              <% } %>
            </td>

          <% if (idx % 7 === 6) { %></tr><% } %>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div id="note-modal" aria-hidden="true">
    <div class="modal-content">
      <div class="modal-header" id="modal-date-display">Date</div>
      <textarea id="note-text" class="modal-textarea" placeholder="Add title or note..."></textarea>
      <div class="modal-actions">
        <button id="close-modal" class="btn btn-secondary">Cancel</button>
        <button id="save-note" class="btn btn-primary">Save</button>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('note-modal');
      const textarea = document.getElementById('note-text');
      const dateDisplay = document.getElementById('modal-date-display');
      const saveBtn = document.getElementById('save-note');
      const closeBtn = document.getElementById('close-modal');
      let activeDateKey = null;

      const updateIndicators = () => {
        document.querySelectorAll('td[data-date]').forEach(td => {
          const date = td.getAttribute('data-date');
          if (!date) return;
          
          const note = localStorage.getItem('poke_note_' + date);
          const indicator = td.querySelector('.note-indicator');
          
          if (note && note.trim() !== "") {
            td.classList.add('has-note');
            if (indicator) indicator.textContent = note; 
          } else {
            td.classList.remove('has-note');
            if (indicator) indicator.textContent = '';
          }
        });
      };
      
      updateIndicators();

      document.querySelector('.calendar-table tbody').addEventListener('click', (e) => {
        const td = e.target.closest('td');
        if (!td || !td.getAttribute('data-date')) return;

        activeDateKey = td.getAttribute('data-date');
        
        const existingNote = localStorage.getItem('poke_note_' + activeDateKey) || '';
        textarea.value = existingNote;
        
        const dateObj = new Date(activeDateKey);
        const localDateObj = new Date(dateObj.getTime() + dateObj.getTimezoneOffset() * 60000);
        
        dateDisplay.textContent = localDateObj.toLocaleDateString(undefined, { 
          weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' 
        });

        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
        textarea.focus();
      });

      saveBtn.addEventListener('click', () => {
        if (activeDateKey) {
          const text = textarea.value;
          if (text.trim() === "") {
            localStorage.removeItem('poke_note_' + activeDateKey);
          } else {
            localStorage.setItem('poke_note_' + activeDateKey, text);
          }
          updateIndicators();
          closeModal();
        }
      });

      const closeModal = () => {
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
        activeDateKey = null;
      };

      closeBtn.addEventListener('click', closeModal);
      
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('open')) {
          closeModal();
        }
      });
      
      document.querySelectorAll('td[data-date]').forEach(td => {
        td.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') td.click();
        });
      });
    });
  </script>
</body>
</html>