                    <div class="metadata-section-label">Tags</div>
                    <div class="modal-tags-list" id="modal-tags"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const MEDIA_PROXY = "<%= mediaproxy %>";
        const FAVS_STORAGE_KEY = "gifs_favs";
        
        let currentSearchTerm = "<%= query %>".replace(/&#34;/g, '"').replace(/&#39;/g, "'");
        let currentSearchMode = currentSearchTerm ? "search" : "trending";
        let nextPosition = "<%= next %>";
        let isFetching = false;
        let favoriteGifs = [];
        let currentModalGif = null;
        let currentModalTitle = "";
        let currentGifQualities = {};

        let masonryColumns = [];
        let masonryHeights = [];
        let currentColumnCount = 0;

        let lazyImageObserver = null;
        
        function upgradeImage(img) {
            const med = img.getAttribute('data-med');
            if(!med) return;
            img.removeAttribute('data-med');
            const temp = new Image();
            temp.onload = () => {
                img.src = med;
            };
            temp.src = med;
        }

        function setupLazyObserver() {
            if ('IntersectionObserver' in window) {
                lazyImageObserver = new IntersectionObserver((entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const img = entry.target;
                            const src = img.getAttribute('data-src');
                            if (src) {
                                img.src = src;
                                img.removeAttribute('data-src');
                            }
                            lazyImageObserver.unobserve(img);
                        }
                    });
                }, { rootMargin: '200px 0px' });
            }
        }

        function observeImages() {
            if (!lazyImageObserver) setupLazyObserver();
            if (lazyImageObserver) {
                document.querySelectorAll('img.lazy-gif[data-src]').forEach(img => {
                    lazyImageObserver.observe(img);
                });
            } else {
                document.querySelectorAll('img.lazy-gif[data-src]').forEach(img => {
                    img.src = img.getAttribute('data-src');
                    img.removeAttribute('data-src');
                });
            }
        }

        function handleModalOpenEncoded(e, gifEncoded, titleEncoded) {
            if (e) e.preventDefault();
            let gif, title;
            try {
                gif = JSON.parse(decodeURIComponent(gifEncoded));
                title = decodeURIComponent(titleEncoded);
            } catch (err) {
                return false;
            }
            return handleModalOpen(e, gif, title);
        }
        
        function toggleFavoriteEncoded(gifEncoded, event) {
            try {
                const gif = JSON.parse(decodeURIComponent(gifEncoded));
                toggleFavorite(gif, event);
            } catch (err) {}
        }

        function getDesiredColumns() {
            if (window.innerWidth <= 860) return 2;
            if (window.innerWidth <= 1200) return 3;
            return 4;
        }

        function setupMasonry(preserveExisting = false) {
            const container = document.getElementById('gif_container');
            if (!container) return;

            const desiredCols = getDesiredColumns();
            const existingCards = preserveExisting ? Array.from(container.querySelectorAll('.gif-card')) : [];
            const emptyBox = preserveExisting ? container.querySelector('.empty-state-box') : null;

            container.innerHTML = '';
            container.classList.add('masonry-ready');
            masonryColumns = [];
            masonryHeights = [];
            currentColumnCount = desiredCols;

            if (emptyBox && existingCards.length === 0) {
                container.appendChild(emptyBox);
                return;
            }

            for (let i = 0; i < desiredCols; i++) {
                const col = document.createElement('div');
                col.className = 'masonry-col';
                container.appendChild(col);
                masonryColumns.push(col);
                masonryHeights.push(0);
            }

            existingCards.forEach(card => {
                const img = card.querySelector('img');
                if (img && (img.complete || !img.getAttribute('data-src'))) card.classList.add('is-loaded');
                appendCardToShortestColumn(card);
            });
            observeImages();
        }

        function appendCardToShortestColumn(card) {
            const container = document.getElementById('gif_container');
            if (!masonryColumns.length || !container.querySelector('.masonry-col')) {
                setupMasonry(false);
            }
            let minIndex = 0;
            for (let i = 1; i < masonryHeights.length; i++) {
                if (masonryHeights[i] < masonryHeights[minIndex]) {
                    minIndex = i;
                }
            }
            masonryColumns[minIndex].appendChild(card);
            const aspect = parseFloat(card.getAttribute('data-aspect')) || 0.75;
            masonryHeights[minIndex] += aspect + 0.08;
        }

        let resizeTimer;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                if (getDesiredColumns() !== currentColumnCount) {
                    setupMasonry(true);
                }
            }, 150);
        });

        const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting && !isFetching && currentSearchMode !== "favs" && nextPosition && nextPosition !== "0") {
                fetchMoreGifs();
            }
        }, { root: null, rootMargin: '800px', threshold: 0.1 });

        window.addEventListener('DOMContentLoaded', () => {
            setupLazyObserver();
            setupMasonry(true);
            loadFavoritesFromStorage();
            updateFavButtonsInDOM();
            
            const sentinel = document.getElementById('scroll-sentinel');
            if (sentinel) observer.observe(sentinel);
        });

        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('main-navbar');
            const heroSection = document.getElementById('hero-section');
            if (window.scrollY > heroSection.offsetHeight - 60) navbar.classList.add('scrolled');
            else navbar.classList.remove('scrolled');

            closePrideDropdown();
        }, { passive: true });

        function togglePrideDropdown(e) {
            e.stopPropagation();
            const dropdown = document.getElementById('pride-dropdown');
            const btn = document.getElementById('pride-dropdown-btn');
            const menu = document.getElementById('pride-dropdown-menu');
            const isOpen = dropdown.classList.toggle('open');
            btn.setAttribute('aria-expanded', isOpen);

            if (isOpen) {
                if (window.innerWidth <= 768) {
                    const rect = btn.getBoundingClientRect();
                    menu.style.position = 'fixed';
                    menu.style.top = `${rect.bottom + 8}px`;
                    menu.style.left = `${Math.max(12, Math.min(rect.left, window.innerWidth - 232))}px`;
                } else {
                    menu.style.position = '';
                    menu.style.top = '';
                    menu.style.left = '';
                }
            }
        }

        function closePrideDropdown() {
            const dropdown = document.getElementById('pride-dropdown');
            const btn = document.getElementById('pride-dropdown-btn');
            if (dropdown && dropdown.classList.contains('open')) {
                dropdown.classList.remove('open');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
        }

        document.addEventListener('click', (e) => {
            const dropdown = document.getElementById('pride-dropdown');
            if (dropdown && !dropdown.contains(e.target)) {
                closePrideDropdown();
            }
        });

        function performSearch(query, updateUrl = true) {
            currentSearchTerm = query;
            currentSearchMode = query ? "search" : "trending";
            nextPosition = "";
            closePrideDropdown();

            if (updateUrl) {
                const url = query ? `/gifs?q=${encodeURIComponent(query)}` : '/gifs';
                history.pushState({ query }, '', url);
            }

            const newTitle = query ? `Results for "${query}"` : 'Trending GIFs';
            document.getElementById('search_input').value = query;
            document.getElementById('nav_search_input').value = query;
            document.getElementById('page-title').innerText = newTitle;
            document.title = `PokeGif - ${newTitle}`;
            
            document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
            if (!query) document.getElementById('chip-trending').classList.add('active');
            else {
                const prideTerms = ['pride','lesbian','gay','transgender','bisexual','pansexual','asexual','non-binary','queer','lgbtq+'];
                if (prideTerms.includes(query.toLowerCase())) {
                    document.getElementById('pride-dropdown-btn').classList.add('active');
                }
                Array.from(document.querySelectorAll('.chip')).forEach(c => {
                    if (c.textContent.trim().toLowerCase() === query.toLowerCase()) c.classList.add('active');
                });
            }
            document.getElementById('nav-fav-btn').classList.remove('active');

            setupMasonry(false);
            document.getElementById('scroll-sentinel').style.display = "block";
            
            fetchMoreGifs();
        }

        document.getElementById('navbar-search').addEventListener('submit', function(e) {
            e.preventDefault();
            performSearch(this.q.value.trim());
        });
        document.getElementById('hero-search-container').addEventListener('submit', function(e) {
            e.preventDefault();
            performSearch(this.q.value.trim());
        });

        document.querySelectorAll('a.chip, .dropdown-content a').forEach(a => {
            a.addEventListener('click', function(e) {
                e.preventDefault();
                closePrideDropdown();
                const href = this.getAttribute('href');
                if (href) {
                    const urlObj = new URL(href, window.location.origin);
                    const q = urlObj.searchParams.get('q') || "";
                    performSearch(q);
                }
            });
        });

        window.addEventListener('popstate', function(e) {
            const urlObj = new URL(window.location.href);
            const q = urlObj.searchParams.get('q') || "";
            performSearch(q, false);
        });

        function getHeartSVG(isFav) {
            if (isFav) return `<svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
            return `<svg class="svg-icon" viewBox="0 0 24 24"><path d="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z"/></svg>`;
        }

        function loadFavoritesFromStorage() {
            try {
                const raw = localStorage.getItem(FAVS_STORAGE_KEY);
                favoriteGifs = raw ? JSON.parse(raw) : [];
            } catch (e) { favoriteGifs = []; }
            document.getElementById("fav-count-badge").innerText = favoriteGifs.length;
        }

        function saveFavoritesToStorage() {
            try { localStorage.setItem(FAVS_STORAGE_KEY, JSON.stringify(favoriteGifs)); } catch (e) {}
            document.getElementById("fav-count-badge").innerText = favoriteGifs.length;
        }

        function isGifFavorited(gifId) {
            return favoriteGifs.some(item => String(item.id) === String(gifId));
        }

        function updateFavButtonsInDOM() {
            document.querySelectorAll('.card-fav-btn').forEach(btn => {
                const id = btn.getAttribute('data-gif-id');
                const isFav = isGifFavorited(id);
                btn.classList.toggle('is-fav', isFav);
                btn.innerHTML = getHeartSVG(isFav);
            });
        }

        function toggleFavorite(gifData, event) {
            if (event) event.stopPropagation();
            if (event && event.preventDefault) event.preventDefault();
            if (!gifData || !gifData.id) return;
            const idx = favoriteGifs.findIndex(item => String(item.id) === String(gifData.id));
            let nowFav = false;
            if (idx > -1) {
                favoriteGifs.splice(idx, 1);
                showToast("Removed from Favs");
            } else {
                favoriteGifs.unshift(gifData);
                nowFav = true;
                showToast("Added to Favs");
            }
            saveFavoritesToStorage();
            updateFavButtonsInDOM();
            if (currentModalGif && String(currentModalGif.id) === String(gifData.id)) {
                updateModalFavButtonState(nowFav);
            }
            if (currentSearchMode === "favs" && !nowFav) showFavs();
        }

        function showFavs() {
            currentSearchMode = "favs";
            document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
            document.getElementById('nav-fav-btn').classList.add('active');
            const newTitle = `Favorite GIFs (${favoriteGifs.length})`;
            document.getElementById('page-title').innerText = newTitle;
            document.title = `PokeGif - ${newTitle}`;
            
            const container = document.getElementById("gif_container");
            document.getElementById("scroll-sentinel").style.display = "none";
            
            if (favoriteGifs.length === 0) {
                masonryColumns = [];
                masonryHeights = [];
                container.innerHTML = `<div class="empty-state-box" style="margin-top: 40px; grid-column: 1/-1;"><svg class="svg-icon svg-icon-xl" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg><p>No favorite GIFs yet.</p></div>`;
                return;
            }
            
            setupMasonry(false);
            favoriteGifs.forEach(gif => {
                if(!gif.media || !gif.media[0]) return;
                appendCardToShortestColumn(createGifCard(gif));
            });
            updateFavButtonsInDOM();
        }

         function getTitleJS(gif) {
            if (gif.title && gif.title.trim()) return gif.title.trim();
            if (gif.h1_title && gif.h1_title.trim()) return gif.h1_title.trim();
            if (gif.itemurl) {
                const match = gif.itemurl.match(/\/view\/(.+?)(?:-gif)?-\d+$/i);
                if (match && match[1]) {
                    return decodeURIComponent(match[1]).replace(/-/g, ' ');
                }
            }
            if (gif.content_description && gif.content_description.trim()) return gif.content_description.trim();
            return "Untitled GIF";
        }

        function fetchMoreGifs() {
            if (isFetching) return;
            isFetching = true;
            document.getElementById("loading").style.display = "block";
            
            let searchUrl = `/api/tenor?endpoint=${currentSearchMode === "trending" ? "trending" : "search"}&limit=30`;
            if (currentSearchMode === "search") searchUrl += `&q=${encodeURIComponent(currentSearchTerm)}`;
            if (nextPosition) searchUrl += `&pos=${nextPosition}`;

            fetch(searchUrl)
                .then(res => res.json())
                .then(data => {
                    const container = document.getElementById("gif_container");
                    const existingEmpty = container.querySelector('.empty-state-box');
                    if (existingEmpty) existingEmpty.remove();

                    const results = data.results || [];
                    if (results.length === 0 && !nextPosition) {
                        masonryColumns = [];
                        masonryHeights = [];
                        container.innerHTML = `<div class="empty-state-box" style="margin-top: 40px; grid-column: 1/-1;"><svg class="svg-icon svg-icon-xl" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm4.18-12.24l-1.06 1.06-1.06-1.06L13 8.82l1.06 1.06L15.12 11l1.06-1.06 1.06 1.06 1.06-1.06-1.12-1.12zM7.76 8.82l-1.06-1.06L5.64 8.82 4.58 7.76l1.06-1.06 1.06 1.06 1.06-1.06 1.06 1.06-1.06 1.06zM12 13.5c-2.33 0-4.31 1.46-5.11 3.5h10.22c-.8-2.04-2.78-3.5-5.11-3.5z"/></svg><p>No GIFs found. Try another search!</p></div>`;
                    } else {
                        results.forEach(gif => {
                            if(!gif.media || !gif.media[0]) return;
                            appendCardToShortestColumn(createGifCard(gif));
                        });
                    }

                    nextPosition = data.next || "";
                    if (!nextPosition || nextPosition === "0" || results.length === 0) document.getElementById("scroll-sentinel").style.display = "none";
                    else document.getElementById("scroll-sentinel").style.display = "block";
                    
                    updateFavButtonsInDOM();
                    observeImages();
                    isFetching = false;
                    document.getElementById("loading").style.display = "none";
                })
                .catch(() => {
                    isFetching = false;
                    document.getElementById("loading").style.display = "none";
                });
        }

        function createGifCard(gif) {
            const title = getTitleJS(gif);
            const altText = (gif.content_description && gif.content_description.trim()) ? gif.content_description.trim() : title;
            
            const fullObj = gif.media[0].gif || gif.media[0].tinygif;
            const mediumObj = gif.media[0].mediumgif || fullObj;
            const tinyObj = gif.media[0].tinygif || mediumObj;
            
            const dims = (mediumObj && Array.isArray(mediumObj.dims) && mediumObj.dims.length === 2) ? mediumObj.dims : [220, 165];
            const w = dims[0] || 220;
            const h = dims[1] || 165;

            const div = document.createElement("div");
            div.className = "gif-card";
            div.setAttribute("data-aspect", h / w);
            
            const a = document.createElement("a");
            a.href = fullObj.url;
            a.target = "_blank";
            a.className = "gif-link js-main-link";
            a.style.aspectRatio = `${w} / ${h}`;
            
            const gifJsonStr = encodeURIComponent(JSON.stringify(gif));
            const titleStr = encodeURIComponent(title);
            a.setAttribute('data-gif', gifJsonStr);
            a.setAttribute('data-title', titleStr);
            a.onclick = function(e) {
                return handleModalOpenEncoded(e, this.dataset.gif, this.dataset.title);
            };
            
            const img = document.createElement("img");
            img.setAttribute('data-src', MEDIA_PROXY + tinyObj.url);
            img.setAttribute('data-med', MEDIA_PROXY + mediumObj.url);
            img.alt = altText;
            img.width = w;
            img.height = h;
            img.decoding = "async";
            img.className = "lazy-gif";
            img.onload = function() {
                div.classList.add("is-loaded");
                upgradeImage(this);
            };
            img.onerror = () => div.classList.add("is-loaded");
            
            const overlay = document.createElement("div");
            overlay.className = "gif-overlay";
            overlay.innerText = title;
            
            const badgesWrap = document.createElement("div");
            badgesWrap.className = "nojs-res-badges";
            const sdb = document.createElement("a");
            sdb.className = "nojs-badge";
            sdb.href = tinyObj.url;
            sdb.target = "_blank";
            sdb.innerText = "SD";
            const hdb = document.createElement("a");
            hdb.className = "nojs-badge";
            hdb.href = fullObj.url;
            hdb.target = "_blank";
            hdb.innerText = "HD";
            badgesWrap.appendChild(sdb);
            badgesWrap.appendChild(hdb);
            
            const btn = document.createElement("button");
            btn.className = "card-fav-btn js-only";
            btn.setAttribute("data-gif-id", gif.id);
            btn.innerHTML = getHeartSVG(false);
            btn.onclick = (e) => toggleFavorite(gif, e);
            
            a.appendChild(img);
            a.appendChild(overlay);
            div.appendChild(a);
            div.appendChild(badgesWrap);
            div.appendChild(btn);
            return div;
        }

        function formatBytes(bytes) {
            if (!bytes || isNaN(bytes)) return "Unknown";
            const kb = bytes / 1024;
            if (kb < 1024) return `${Math.round(kb)} KB`;
            return `${(kb / 1024).toFixed(2)} MB`;
        }

        function deriveTags(gif, title) {
            const set = new Set();
            if (Array.isArray(gif.tags)) gif.tags.forEach(t => { if(t) set.add(t.trim().toLowerCase()); });
            if (currentSearchTerm) set.add(currentSearchTerm.toLowerCase());
            if (title) title.toLowerCase().replace(/[^a-z0-9\s]/g, ' ').split(/\s+/).forEach(w => {
                if (w.length >= 3 && !["gif","the","and","for","with","untitled"].includes(w) && set.size < 8) set.add(w);
            });
            if (set.size === 0) set.add("trending");
            return Array.from(set).slice(0, 8);
        }

        function handleModalOpen(e, gif, title) {
            if (e) e.preventDefault();
            const cleanTitle = getTitleJS(gif) || title;
            currentModalGif = gif;
            currentModalTitle = cleanTitle;
            
            const fullObj = gif.media[0].gif || gif.media[0].tinygif;
            const mediumObj = gif.media[0].mediumgif || fullObj;
            const tinyObj = gif.media[0].tinygif || mediumObj;
            
            currentGifQualities = {
                sd: tinyObj.url,
                md: mediumObj.url,
                hd: fullObj.url
            };
            
            const modalImg = document.getElementById("modal-img");
            const loadingOverlay = document.getElementById("modal-loading");
            
            if (Array.isArray(fullObj.dims) && fullObj.dims.length === 2) {
                modalImg.style.aspectRatio = `${fullObj.dims[0]} / ${fullObj.dims[1]}`;
            } else {
                modalImg.style.aspectRatio = "";
            }

            modalImg.src = "";
            loadingOverlay.classList.remove("hidden");
            
            const temp = new Image();
            temp.onload = () => {
                modalImg.src = temp.src;
                loadingOverlay.classList.add("hidden");
            };
            temp.src = MEDIA_PROXY + fullObj.url;

            document.getElementById("modal-title").innerText = cleanTitle;
            modalImg.alt = (gif.content_description && gif.content_description.trim()) ? gif.content_description.trim() : cleanTitle;
            document.getElementById("meta-size").innerText = formatBytes(fullObj.size);
            document.getElementById("meta-dims").innerText = (Array.isArray(fullObj.dims) && fullObj.dims.length === 2) ? `${fullObj.dims[0]} × ${fullObj.dims[1]}` : "Auto";
            
            updateModalFavButtonState(isGifFavorited(gif.id));
            
            const tagsCont = document.getElementById("modal-tags");
            tagsCont.innerHTML = "";
            deriveTags(gif, cleanTitle).forEach(tag => {
                const b = document.createElement("button");
                b.className = "tag-chip";
                b.innerHTML = `#${tag}`;
                b.onclick = () => {
                    closeModal();
                    performSearch(tag);
                };
                tagsCont.appendChild(b);
            });
            
            document.getElementById("gif-modal").classList.add("show");
            document.body.style.overflow = "hidden";
            return false;
        }

        function updateModalFavButtonState(isFav) {
            const btn = document.getElementById("modal-fav-btn");
            btn.classList.toggle("is-fav", isFav);
            btn.querySelector('svg').outerHTML = getHeartSVG(isFav);
            document.getElementById("modal-fav-label").innerText = isFav ? "Favorited" : "Favorite";
        }

        function toggleFavFromModal() {
            if (currentModalGif) toggleFavorite(currentModalGif, { preventDefault: () => {}, stopPropagation: () => {} });
        }

        function closeModal() {
            document.getElementById("gif-modal").classList.remove("show");
            document.body.style.overflow = "scroll";
            setTimeout(() => {
                document.getElementById("modal-img").src = "";
                document.getElementById("modal-loading").classList.add("hidden");
            }, 250);
        }

        function handleModalClick(e) {
            if (e.target.id === 'gif-modal') closeModal();
        }

        function copyDirectGifFromModal() {
            if (!currentModalGif) return;
            const url = (currentModalGif.media && currentModalGif.media[0] && currentModalGif.media[0].gif) ? currentModalGif.media[0].gif.url : currentModalGif.url;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(() => showToast("Copied original link!")).catch(() => fallbackCopy(url));
            } else fallbackCopy(url);
        }

        function copyProxiedGifFromModal() {
            if (!currentModalGif) return;
            const url = MEDIA_PROXY + ((currentModalGif.media && currentModalGif.media[0] && currentModalGif.media[0].gif) ? currentModalGif.media[0].gif.url : currentModalGif.url);
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(() => showToast("Copied proxy link!")).catch(() => fallbackCopy(url));
            } else fallbackCopy(url);
        }

        function copyDiscordLinkFromModal() {
            if (!currentModalGif) return;
            let url = "";
            if (currentModalGif.itemurl && currentModalGif.itemurl.includes("tenor.com/view/")) {
                url = currentModalGif.itemurl;
            } else if (currentModalGif.url && currentModalGif.url.includes("tenor.com/view/")) {
                url = currentModalGif.url;
            } else {
                const slug = (currentModalTitle || "gif").toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || "gif";
                url = `https://tenor.com/view/${slug}-gif-${currentModalGif.id}`;
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(() => showToast("Copied Discord link!")).catch(() => fallbackCopy(url));
            } else fallbackCopy(url);
        }

        function fallbackCopy(text) {
            const temp = document.createElement("textarea");
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            try { document.execCommand("copy"); showToast("Copied link!"); } catch (e) {}
            document.body.removeChild(temp);
        }

        async function downloadGifQuality(qual) {
            if (!currentModalGif || !currentGifQualities[qual]) return;
            const url = MEDIA_PROXY + currentGifQualities[qual];
            const slug = (currentModalTitle || "gif").toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || "gif";
            showToast("Downloading...");
            try {
                const res = await fetch(url);
                const blob = await res.blob();
                const bUrl = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = bUrl;
                a.download = `${slug}-${qual}.gif`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                setTimeout(() => URL.revokeObjectURL(bUrl), 4000);
            } catch (err) {
                try {
                    const a = document.createElement("a");
                    a.href = url;
                    a.download = `${slug}-${qual}.gif`;
                    a.target = "_blank";
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                } catch (e) {
                    window.open(url, "_blank");
                }
            }
        }

        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById("toast");
            document.getElementById("toast-text").innerText = msg;
            toast.classList.add("show");
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove("show"), 2800);
        }

        document.addEventListener('keydown', (e) => { if (e.key === "Escape") closeModal(); });
    </script>
</body> 
</html>