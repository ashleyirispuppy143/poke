    </div>

    <% 
    function getTitle(gif) {
        if (gif.title && gif.title.trim()) return gif.title.trim();
        if (gif.h1_title && gif.h1_title.trim()) return gif.h1_title.trim();
        if (gif.itemurl) {
            const match = gif.itemurl.match(/\/view\/(.+?)(?:-gif)?-\d+$/i);
            if (match && match[1]) {
                return decodeURIComponent(match[1]).replace(/-/g, ' ');
            }
        }
        if (gif.content_description && gif.content_description.trim()) return gif.content_description.trim();
        return "Untitled GIF";
    }
    %>

    <div id="gif_container">
        <% if (results && results.length > 0) { %>
            <% results.forEach(function(gif) { 
                if(!gif.media || !gif.media[0]) return;
                const title = getTitle(gif);
                const altText = (gif.content_description && gif.content_description.trim()) ? gif.content_description.trim() : title;
                
                const fullObj = gif.media[0].gif || gif.media[0].tinygif;
                const mediumObj = gif.media[0].mediumgif || fullObj;
                const tinyObj = gif.media[0].tinygif || mediumObj;
                
                const dims = (mediumObj && Array.isArray(mediumObj.dims) && mediumObj.dims.length === 2) ? mediumObj.dims : [220, 165];
                const w = dims[0] || 220;
                const h = dims[1] || 165;
            %>
                <div class="gif-card" data-aspect="<%= h / w %>">
                    <a href="<%= fullObj.url %>" target="_blank" class="gif-link js-main-link" style="aspect-ratio: <%= w %> / <%= h %>;" data-gif="<%= encodeURIComponent(JSON.stringify(gif)) %>" data-title="<%= encodeURIComponent(title) %>" onclick="return handleModalOpenEncoded(event, this.dataset.gif, this.dataset.title)">
                        <img data-src="<%= mediaproxy %><%= tinyObj.url %>" data-med="<%= mediaproxy %><%= mediumObj.url %>" alt="<%= altText %>" width="<%= w %>" height="<%= h %>" decoding="async" class="lazy-gif" onerror="this.closest('.gif-card').classList.add('is-loaded')">
                        <div class="gif-overlay"><%= title %></div>
                    </a>
                    <div class="nojs-res-badges">
                        <a href="<%= tinyObj.url %>" target="_blank" class="nojs-badge">SD</a>
                        <a href="<%= fullObj.url %>" target="_blank" class="nojs-badge">HD</a>
                    </div>
                    <button class="card-fav-btn js-only" data-gif-id="<%= gif.id %>" data-gif="<%= encodeURIComponent(JSON.stringify(gif)) %>" onclick="toggleFavoriteEncoded(this.dataset.gif, event)">
                        <svg class="svg-icon" viewBox="0 0 24 24"><path d="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z"/></svg>
                    </button>
                </div>
            <% }); %>
