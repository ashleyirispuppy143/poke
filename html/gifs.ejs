                            <span class="meta-card-value" id="meta-size">--</span>
                        </div>
                        <div class="meta-card">
                            <span class="meta-card-label"><svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-7-9h5V8h-5v2zm-5 5h5v-2H7v2z"/></svg>Dimensions</span>
                            <span class="meta-card-value" id="meta-dims">--</span>
