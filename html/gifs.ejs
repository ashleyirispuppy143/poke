<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PokeGif - <%= query ? `Results for "${query}"` : 'Trending GIFs' %></title>
    <link href="/css/yt-ukraine.svg?v=9" rel="icon">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="PokeGif!">
    <meta property="og:description" content="Search all the Gifs u want! in a private way!">
    <meta property="og:image" content="/static/poke-embed.webp">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content="PokeGif!">
    <meta property="twitter:description" content="Search all the Gifs u want! in a private way!">
    <meta name="twitter:image" content="/static/poke-embed.webp">
    
    <script>document.documentElement.classList.add('js-enabled');</script>
    <style>
    
:root {
  --md-bg: #161113;
  --md-surface: #22191c;
  --md-surface-low: #1d1518;
  --md-surface-container: #2b2124;
  --md-surface-high: #362a2e;
  --md-surface-highest: #423539;
  --md-primary: #ffb1c4;
  --md-on-primary: #541d2e;
  --md-primary-container: #703344;
  --md-on-primary-container: #ffd9e1;
  --md-secondary-container: #432c33;
  --md-on-secondary-container: #f9dbe2;
  --md-text-main: #eedfe2;
  --md-text-sub: #d5c2c6;
  --md-outline: #9e8c90;
  --md-outline-variant: #524346;
  --radius-xl: 28px;
  --radius-lg: 24px;
  --radius-md: 16px;
  --radius-pill: 100px;
  --ease-expressive: cubic-bezier(0.2, 0, 0, 1);
  --rainbow-grad: linear-gradient(
    90deg,
    #ff3b30,
    #ff9500,
    #ffcc00,
    #4cd964,
    #5ac8fa,
    #007aff,
    #5856d6,
    #ff2d55
  );
}

@font-face {
  font-family: "PokeTube Flex";
  src: url("/static/robotoflex.ttf");
  font-style: normal;
  font-stretch: 1% 800%;
  font-display: swap;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}
::-webkit-scrollbar {
  width: 8px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: var(--md-bg);
}
::-webkit-scrollbar-thumb {
  background: var(--md-surface-highest);
  border-radius: var(--radius-pill);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--md-outline);
}
body {
  font-family: "PokeTube Flex", system-ui, -apple-system, sans-serif;
  background-color: var(--md-bg);
  color: var(--md-text-main);
  overflow-y: scroll;
  -webkit-font-smoothing: antialiased;
}
a {
  text-decoration: none;
  color: inherit;
}
.js-only {
  display: none !important;
}
.js-enabled .js-only {
  display: inline-flex !important;
}
.js-enabled .no-js-pagination {
  display: none !important;
}

.svg-icon {
  width: 20px;
  height: 20px;
  fill: currentColor;
  display: inline-block;
  vertical-align: middle;
  flex-shrink: 0;
}
.svg-icon-large {
  width: 24px;
  height: 24px;
}
.svg-icon-xl {
  width: 40px;
  height: 40px;
}

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 76px;
  background-color: rgba(22, 17, 19, 0.82);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 0 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  z-index: 1000;
  transition: background-color 0.25s var(--ease-expressive),
    box-shadow 0.25s var(--ease-expressive);
}
.navbar.scrolled {
  background-color: rgba(34, 25, 28, 0.94);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
}
.navbar-brand {
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border-radius: var(--radius-pill);
  transition: background-color 0.2s var(--ease-expressive);
  flex-shrink: 0;
}
.navbar-brand:hover {
  background-color: var(--md-surface-container);
}
.navbar-brand img {
  height: 34px;
  display: block;
}
#navbar-search {
  display: flex;
  align-items: center;
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px) scale(0.98);
  transition: all 0.3s var(--ease-expressive);
  background: var(--md-surface-container);
  border-radius: var(--radius-pill);
  padding: 4px 6px 4px 16px;
  width: 100%;
  max-width: 460px;
  border: 1px solid transparent;
}
#navbar-search:focus-within {
  background: var(--md-surface-high);
  border-color: var(--md-primary);
}
.navbar.scrolled #navbar-search {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0) scale(1);
}
#navbar-search .search-icon {
  color: var(--md-text-sub);
  margin-right: 10px;
}
#navbar-search input {
  background: transparent;
  border: none;
  color: var(--md-text-main);
  padding: 8px 0;
  font-size: 14px;
  font-family: inherit;
  width: 100%;
  outline: none;
}
.navbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  min-width: fit-content;
  white-space: nowrap;
}
.fav-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  height: 44px;
  padding: 0 18px;
  border-radius: var(--radius-pill);
  background-color: var(--md-surface-container);
  color: var(--md-text-main);
  border: 1px solid var(--md-outline-variant);
  font-family: inherit;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s var(--ease-expressive);
  flex-shrink: 0;
  white-space: nowrap;
}
.fav-nav-btn:hover {
  background-color: var(--md-surface-high);
}
.fav-nav-btn.active {
  background-color: var(--md-primary-container);
  color: var(--md-on-primary-container);
  border-color: transparent;
}
.fav-nav-btn .svg-icon {
  color: var(--md-primary);
}
.fav-nav-btn.active .svg-icon {
  color: var(--md-on-primary-container);
}
.fav-badge {
  background-color: var(--md-primary);
  color: var(--md-on-primary);
  font-size: 12px;
  font-weight: 700;
  padding: 1px 8px;
  border-radius: var(--radius-pill);
  min-width: 22px;
  text-align: center;
}
.hero-section {
  padding: 108px 24px 28px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 820px;
  margin: 0 auto;
}
.hero-title {
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 700;
  font-stretch: 200%; 
  margin-bottom: 20px;
  letter-spacing: -0.5px;
  color: var(--md-text-main);
}
#hero-search-container {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 680px;
  height: 60px;
  background: var(--md-surface-container);
  border-radius: var(--radius-pill);
  padding: 6px 8px 6px 22px;
  transition: all 0.25s var(--ease-expressive);
  border: 2px solid transparent;
}
#hero-search-container:hover {
  background: var(--md-surface-high);
}
#hero-search-container:focus-within {
  background: var(--md-surface-high);
  border-color: var(--md-primary);
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
}
#hero-search-container .leading-icon {
  color: var(--md-text-sub);
  margin-right: 14px;
}
#hero-search-container input[type="text"] {
  flex-grow: 1;
  font-size: 16px;
  font-family: inherit;
  background: transparent;
  border: none;
  outline: none;
  color: var(--md-text-main);
  font-weight: 400;
  min-width: 0;
}
input::placeholder {
  color: var(--md-text-sub);
  opacity: 0.8;
}
.search-btn {
  height: 44px;
  padding: 0 24px;
  font-size: 14px;
  font-weight: 600;
  font-family: inherit;
  background: var(--md-primary);
  color: var(--md-on-primary);
  border: none;
  border-radius: var(--radius-pill);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s var(--ease-expressive);
  flex-shrink: 0;
}
.search-btn:hover {
  filter: brightness(1.06);
  box-shadow: 0 4px 12px rgba(255, 177, 196, 0.25);
}
.search-btn:active {
  transform: scale(0.96);
}
#navbar-search .search-btn {
  height: 36px;
  padding: 0 18px;
  font-size: 13px;
}

.categories-wrapper {
  padding: 8px 32px 16px;
  max-width: 1600px;
  margin: 0 auto;
}
#categories-container {
  display: flex;
  align-items: center;
  gap: 10px;
}
#static-categories {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}
#dynamic-categories {
  display: flex;
  align-items: center;
  gap: 10px;
  overflow-x: auto;
  scrollbar-width: none;
  flex-grow: 1;
  padding: 4px 16px 4px 2px;
}
#dynamic-categories::-webkit-scrollbar {
  display: none;
}
.chip {
  height: 40px;
  padding: 0 18px;
  background-color: var(--md-surface-low);
  color: var(--md-text-sub);
  border: 1px solid var(--md-outline-variant);
  border-radius: 12px;
  font-size: 14px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s var(--ease-expressive);
  display: inline-flex;
  align-items: center;
  gap: 8px;
  outline: none;
  user-select: none;
  text-decoration: none;
}
.chip:hover {
  background-color: var(--md-surface-container);
  color: var(--md-text-main);
}
.chip:active {
  transform: scale(0.96);
}
.chip.active {
  background-color: var(--md-secondary-container);
  color: var(--md-on-secondary-container);
  border-color: transparent;
  border-radius: var(--radius-pill);
  padding: 0 20px;
}
.dropdown {
  position: relative;
  display: inline-flex;
}
.dropdown-content {
  display: none;
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  background-color: var(--md-surface-high);
  min-width: 220px;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
  border-radius: 20px;
  border: 1px solid var(--md-outline-variant);
  z-index: 1200;
  max-height: 360px;
  overflow-y: auto;
  padding: 8px;
}
.dropdown-content a {
  color: var(--md-text-main);
  padding: 10px 16px;
  text-decoration: none;
  display: flex;
  align-items: center;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  border-radius: 12px;
  transition: background-color 0.15s ease;
}
.dropdown-content a:hover {
  background-color: var(--md-surface-highest);
  color: var(--md-primary);
}
@media (hover: hover) and (pointer: fine) {
  .dropdown:hover .dropdown-content {
    display: block;
    animation: menuAppear 0.2s var(--ease-expressive) forwards;
    transform-origin: top left;
  }
}
.dropdown.open .dropdown-content {
  display: block;
  animation: menuAppear 0.2s var(--ease-expressive) forwards;
  transform-origin: top left;
}
.dropdown.open .chip-pride svg {
  transform: rotate(180deg);
}
.chip-pride svg {
  transition: transform 0.2s var(--ease-expressive);
}
@keyframes menuAppear {
  from {
    opacity: 0;
    transform: scale(0.92) translateY(-6px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}
.chip-pride {
  position: relative;
  background-clip: padding-box;
  border: 1px solid transparent;
}
.chip-pride::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  margin: -1px;
  border-radius: inherit;
  background: var(--rainbow-grad);
  opacity: 0.65;
  transition: opacity 0.25s;
}
.chip-pride:hover::before,
.chip-pride.active::before,
.dropdown.open .chip-pride::before {
  opacity: 1;
}
.section-header {
  max-width: 1600px;
  margin: 8px auto 18px;
  padding: 0 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
#page-title {
  font-size: 20px;
  font-weight: 600;
  color: var(--md-text-main);
  letter-spacing: -0.2px;
  text-transform: capitalize;
}

#gif_container {
  column-count: 4;
  column-gap: 16px;
  padding: 0 32px 48px;
  max-width: 1600px;
  margin: 0 auto;
}

#gif_container.masonry-ready {
  column-count: unset;
  column-gap: unset;
  display: flex;
  align-items: flex-start;
  gap: 16px;
}
.masonry-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.masonry-col .gif-card {
  margin-bottom: 0;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.gif-card {
  position: relative;
  background-color: var(--md-surface-container);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: transform 0.28s var(--ease-expressive),
    box-shadow 0.28s var(--ease-expressive),
    border-radius 0.28s var(--ease-expressive);
  break-inside: avoid;
  margin-bottom: 16px;
  display: block;
  width: 100%;
  border: 1px solid rgba(255, 255, 255, 0.04);
}
.js-enabled .gif-card {
  background-image: linear-gradient(
    90deg,
    var(--md-surface-container) 25%,
    var(--md-surface-high) 50%,
    var(--md-surface-container) 75%
  );
  background-size: 200% 100%;
  animation: shimmer 1.6s infinite linear;
}
.js-enabled .gif-card.is-loaded {
  animation: none;
  background-image: none;
}
.gif-link {
  display: block;
  cursor: pointer;
  width: 100%;
  position: relative;
}
.gif-card img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  color: transparent;
}
.js-enabled .gif-card img {
  opacity: 0;
  transition: opacity 0.28s ease;
}
.js-enabled .gif-card.is-loaded img {
  opacity: 1;
}
.gif-card:hover {
  transform: translateY(-4px) scale(1.01);
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.45);
  border-color: var(--md-outline-variant);
  z-index: 2;
}
.gif-card:hover {
  transform: scale(0.98);
}

html:not(.js-enabled) .js-main-link {
  pointer-events: none;
}

.nojs-res-badges {
  position: absolute;
  top: 10px;
  left: 10px;
  display: flex;
  gap: 6px;
  opacity: 0;
  z-index: 5;
  transition: opacity 0.25s;
}
.gif-card:hover .nojs-res-badges {
  opacity: 1;
}
.js-enabled .nojs-res-badges {
  display: none !important;
}
.nojs-badge {
  background: rgba(22, 17, 19, 0.85);
  color: #fff;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
  border: 1px solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  pointer-events: auto;
}
.nojs-badge:hover {
  background: var(--md-primary);
  color: var(--md-on-primary);
}
.card-fav-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(22, 17, 19, 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  transform: scale(0.85);
  transition: all 0.2s var(--ease-expressive);
  z-index: 4;
}
.gif-card:hover .card-fav-btn,
.card-fav-btn.is-fav {
  opacity: 1;
  transform: scale(1);
}
.card-fav-btn.is-fav {
  background: var(--md-primary-container);
  color: var(--md-primary);
  border-color: transparent;
}
.card-fav-btn:hover {
  transform: scale(1.1);
  background: var(--md-surface-high);
}
.card-fav-btn.is-fav:hover {
  background: var(--md-primary);
  color: var(--md-on-primary);
}
.gif-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(
    to top,
    rgba(22, 17, 19, 0.92) 0%,
    rgba(22, 17, 19, 0.45) 60%,
    transparent 100%
  );
  color: var(--md-text-main);
  padding: 36px 16px 14px;
  font-size: 13px;
  font-weight: 500;
  text-align: left;
  opacity: 0;
  transition: opacity 0.25s ease;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
  text-transform: capitalize;
}
.gif-card:hover .gif-overlay {
  opacity: 1;
}
@media (max-width: 1200px) {
  #gif_container {
    column-count: 3;
  }
}
@media (max-width: 860px) {
  #gif_container {
    column-count: 2;
    padding: 0 16px 32px;
    column-gap: 12px;
  }
  #gif_container.masonry-ready {
    gap: 12px;
  }
  .masonry-col {
    gap: 12px;
  }
  .gif-card {
    margin-bottom: 12px;
    border-radius: 20px;
  }
  .categories-wrapper,
  .section-header {
    padding-left: 16px;
    padding-right: 16px;
  }
  .navbar {
    padding: 0 16px;
    height: 68px;
  }
  #navbar-search {
    display: none;
  }
  .hero-section {
    padding-top: 88px;
  }
  .card-fav-btn {
    opacity: 1;
    transform: scale(1);
    width: 34px;
    height: 34px;
  }
}
@media (max-width: 520px) {
  #categories-container {
    overflow-x: auto;
    scrollbar-width: none;
  }
  #categories-container::-webkit-scrollbar {
    display: none;
  }
  #static-categories,
  #dynamic-categories {
    overflow-x: visible;
  }
}
#gif-modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(12, 8, 10, 0.78);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: 2000;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  transition: opacity 0.25s var(--ease-expressive);
}
#gif-modal.show {
  display: flex;
  opacity: 1;
}
.modal-content {
  background: var(--md-surface-container);
  border-radius: var(--radius-xl);
  max-width: 880px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.65);
  position: relative;
  transform: scale(0.92) translateY(20px);
  transition: transform 0.3s var(--ease-expressive);
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  border: 1px solid var(--md-outline-variant);
}
#gif-modal.show .modal-content {
  transform: scale(1) translateY(0);
}
.modal-image-container {
  background: #100b0d;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 360px;
  max-height: 82vh;
  padding: 24px;
  position: relative;
}
#modal-img {
  max-width: 100%;
  max-height: 68vh;
  object-fit: contain;
  border-radius: 16px;
  background-color: var(--md-surface-low);
  color: transparent;
}
.modal-loading-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(16, 11, 13, 0.85);
  z-index: 10;
  gap: 16px;
  color: var(--md-text-main);
  font-weight: 600;
  font-size: 15px;
  border-radius: 16px;
}
.modal-loading-overlay.hidden {
  display: none;
}
.modal-details-pane {
  padding: 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 22px;
  background: var(--md-surface-container);
}
.modal-top-bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
#modal-title {
  font-size: 20px;
  font-weight: 600;
  color: var(--md-text-main);
  line-height: 1.3;
  word-break: break-word;
  text-transform: capitalize;
}
.icon-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--md-surface-high);
  color: var(--md-text-main);
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
  transition: all 0.2s var(--ease-expressive);
}
.icon-btn:hover {
  background: var(--md-surface-highest);
  transform: scale(1.06);
}
.icon-btn:active {
  transform: scale(0.95);
}
.modal-actions-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.m3-btn {
  height: 48px;
  padding: 0 18px;
  border-radius: var(--radius-pill);
  font-family: inherit;
  font-size: 14px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s var(--ease-expressive);
  white-space: nowrap;
}
.m3-btn:active {
  transform: scale(0.97);
}
.m3-btn-span-2 {
  grid-column: 1 / -1;
}
.m3-btn-filled {
  background: var(--md-primary);
  color: var(--md-on-primary);
}
.m3-btn-filled:hover {
  filter: brightness(1.06);
  box-shadow: 0 4px 16px rgba(255, 177, 196, 0.25);
}
.m3-btn-discord {
  background: var(--md-secondary-container);
  color: var(--md-on-secondary-container);
  border: 1px solid var(--md-outline-variant);
}
.m3-btn-discord:hover {
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
  border-color: transparent;
}
.m3-btn-tonal {
  background: var(--md-surface-high);
  color: var(--md-text-main);
}
.m3-btn-tonal:hover {
  background: var(--md-surface-highest);
}
.m3-btn-tonal.is-fav {
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
}
.metadata-section-label {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  color: var(--md-text-sub);
  margin-bottom: 10px;
}
.metadata-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}
.meta-card {
  background: var(--md-surface-low);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 16px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.meta-card-label {
  font-size: 11px;
  color: var(--md-text-sub);
  display: flex;
  align-items: center;
  gap: 5px;
}
.meta-card-label .svg-icon {
  width: 16px;
  height: 16px;
  color: var(--md-primary);
}
.meta-card-value {
  font-size: 13px;
  font-weight: 600;
  color: var(--md-text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.modal-tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.tag-chip {
  height: 32px;
  padding: 0 14px;
  border-radius: 10px;
  background: var(--md-surface-low);
  border: 1px solid var(--md-outline-variant);
  color: var(--md-text-sub);
  font-size: 12px;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  cursor: pointer;
  transition: all 0.18s ease;
}
.tag-chip:hover {
  background: var(--md-secondary-container);
  color: var(--md-on-secondary-container);
  border-color: transparent;
}
@media (max-width: 780px) {
  .modal-content {
    grid-template-columns: 1fr;
    max-height: 92vh;
  }
  .modal-image-container {
    min-height: 240px;
    max-height: 45vh;
    padding: 16px;
  }
  #modal-img {
    max-height: 40vh;
  }
  .modal-details-pane {
    padding: 20px;
    gap: 18px;
  }
}
#scroll-sentinel {
  height: 40px;
  width: 100%;
}
#loading {
  display: none;
  text-align: center;
  color: var(--md-text-sub);
  font-size: 15px;
  padding: 40px 20px 80px;
  font-weight: 500;
}
.empty-state-box {
  max-width: 380px;
  margin: 0 auto;
  background: var(--md-surface-low);
  border: 1px solid var(--md-outline-variant);
  border-radius: var(--radius-lg);
  padding: 32px 24px;
  text-align: center;
}
.empty-state-box .svg-icon {
  color: var(--md-primary);
  margin-bottom: 12px;
}
.spinner {
  width: 38px;
  height: 38px;
  border: 4px solid var(--md-surface-high);
  border-left-color: var(--md-primary);
  border-radius: 50%;
  animation: spin 0.85s linear infinite;
  margin: 0 auto 14px;
}
@keyframes spin {
  100% {
    transform: rotate(360deg);
  }
}
#toast {
  visibility: hidden;
  min-width: 280px;
  max-width: 90vw;
  background: var(--md-text-main);
  color: var(--md-bg);
  border-radius: 14px;
  padding: 14px 22px;
  position: fixed;
  z-index: 3000;
  left: 50%;
  bottom: 24px;
  transform: translateX(-50%) translateY(20px);
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  opacity: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  transition: all 0.3s var(--ease-expressive);
}
#toast.show {
  visibility: visible;
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.no-js-pagination {
  text-align: center;
  padding: 40px;
}
.no-js-pagination a {
  display: inline-block;
  padding: 12px 24px;
  background: var(--md-primary);
  color: var(--md-on-primary);
  border-radius: var(--radius-pill);
  font-weight: 600;
  text-decoration: none;
}

    </style>
</head>
