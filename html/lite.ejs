<% try { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>410 Gone - PokeTube</title>
  <link rel="icon" href="/css/yt-ukraine.svg">
  
  <script>
    const videoid = "<%= videoid %>";
    const watchUrl = "/watch?v=" + videoid;
    const watchMediumUrl = "/watch?v=" + videoid + "&quality=medium";
    
    const redirectKey = "poke_auto_redirect_lite";
    const redirectMediumKey = "poke_auto_redirect_lite_medium";

    if (localStorage.getItem(redirectMediumKey) === "true") {
      window.location.replace(watchMediumUrl);
    } else if (localStorage.getItem(redirectKey) === "true") {
      window.location.replace(watchUrl);
    }
  </script>

  <style>
    :root {
      --bg: #f1f1f1;
      --text-main: #222;
      --text-muted: #555;
      --link: #065fd4;
      --btn-bg: #065fd4;
      --btn-text: #fff;
      --btn-outline: rgba(6, 95, 212, 0.3);
      --code-bg: #e2e2e2;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f0f0f;
        --text-main: #f1f1f1;
        --text-muted: #aaa;
        --link: #3ea6ff;
        --btn-bg: #3ea6ff;
        --btn-text: #0f0f0f;
        --btn-outline: rgba(62, 166, 255, 0.3);
        --code-bg: #272727;
      }
    }

    body {
      margin: 0;
      padding: 0;
      font-family: "Roboto", Arial, sans-serif;
      background: var(--bg);
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* Header / Logo Area */
    header {
      padding: 15px 25px;
      border-bottom: 1px solid rgba(0,0,0,0.1);
      display: flex;
      align-items: center;
    }
    
    .logo-img {
      height: 28px;
      width: auto;
      display: block;
    }

    /* Main Content */
    .main-wrap {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px 20px;
    }

    .container {
      display: flex;
      flex-direction: column-reverse;
      max-width: 800px;
      width: 100%;
      gap: 50px;
    }

    @media (min-width: 700px) {
      .container {
        flex-direction: row;
        align-items: center;
      }
    }

    .content-side {
      flex: 1;
    }

    .image-side {
      flex: 0 0 200px;
      display: flex;
      justify-content: center;
    }

    h1 {
      font-size: 24px;
      font-weight: 400;
      margin: 0 0 15px 0;
    }

    p {
      font-size: 15px;
      line-height: 1.5;
      color: var(--text-muted);
      margin-bottom: 20px;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-top: 25px;
    }

    .btn {
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 2px;
      font-size: 14px;
      font-weight: 500;
      text-transform: uppercase;
      transition: opacity 0.2s, background-color 0.2s;
      display: inline-block;
    }

    .btn-primary {
      background-color: var(--btn-bg);
      color: var(--btn-text);
    }

    .btn-outline {
      border: 1px solid var(--btn-outline);
      color: var(--link);
    }

    .btn-secondary {
      color: var(--link);
      padding-left: 8px;
      padding-right: 8px;
    }

    .btn:hover {
      opacity: 0.9;
    }

    .auto-redirect-group {
      margin-top: 25px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .auto-redirect-wrapper {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: var(--text-muted);
    }

    .auto-redirect-wrapper input[type="checkbox"] {
      accent-color: var(--link);
      width: 16px;
      height: 16px;
      cursor: pointer;
      margin: 0;
    }

    .auto-redirect-wrapper label {
      cursor: pointer;
      user-select: none;
    }

    code {
      font-family: monospace;
      background: var(--code-bg);
      padding: 2px 5px;
      border-radius: 3px;
    }

    .illustration {
      width: 100%;
      max-width: 180px;
      opacity: 0.8;
      color: var(--text-muted);
    }
    
    @media (prefers-color-scheme: dark) {
      header { border-bottom: 1px solid rgba(255,255,255,0.1); }
    }
  </style>
</head>
<body>

  <header>
    <a href="/">
      <img src="/css/logo-poke.svg?v=5" alt="PokeTube" class="logo-img">
    </a>
  </header>

  <main class="main-wrap">
    <div class="container">
      
      <div class="content-side">
        <h1>Lite mode discontinued</h1>
        <p>
          We've made significant performance updates to the main experience, making the separate Lite player unnecessary. You now get the same speed with better privacy and features.
        </p>
        
        <p class="small">
          <b>Please update your bookmarks:</b><br>
          Change <code>/lite?v=<%= videoid %></code> to <code>/watch?v=<%= videoid %></code><br>
          For older browsers, use <code>/watch?v=<%= videoid %>&quality=medium</code>
        </p>

        <div class="actions">
          <a class="btn btn-primary" href="/watch?v=<%= videoid %>">
            Watch Video
          </a>
          <a class="btn btn-outline" href="/watch?v=<%= videoid %>&quality=medium">
            Redirect to Medium Quality
          </a>
          <a class="btn btn-secondary" href="/">
            Return Home
          </a>
        </div>

        <div class="auto-redirect-group">
          <div class="auto-redirect-wrapper">
            <input type="checkbox" id="auto-redirect-check">
            <label for="auto-redirect-check">Always auto-redirect to main player</label>
          </div>
          <div class="auto-redirect-wrapper">
            <input type="checkbox" id="auto-redirect-medium-check">
            <label for="auto-redirect-medium-check">Always redirect to medium quality (for older browsers)</label>
          </div>
        </div>
      </div>

      <div class="image-side">
        <svg class="illustration" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <rect x="20" y="40" width="160" height="110" rx="10" fill="none" stroke="currentColor" stroke-width="4"/>
          <path d="M40 150 L30 170 H170 L160 150" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M70 95 H130 M100 95 V70 L130 95 L100 120 V95" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <circle cx="160" cy="55" r="3" fill="currentColor"/>
          <circle cx="150" cy="55" r="3" fill="currentColor"/>
        </svg>
      </div>

    </div>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const checkbox = document.getElementById("auto-redirect-check");
      const mediumCheckbox = document.getElementById("auto-redirect-medium-check");
      
      checkbox.addEventListener("change", (e) => {
        if (e.target.checked) {
          localStorage.setItem(redirectKey, "true");
          localStorage.removeItem(redirectMediumKey);
          window.location.replace(watchUrl);
        } else {
          localStorage.removeItem(redirectKey);
        }
      });

      mediumCheckbox.addEventListener("change", (e) => {
        if (e.target.checked) {
          localStorage.setItem(redirectMediumKey, "true");
          localStorage.removeItem(redirectKey);
          window.location.replace(watchMediumUrl);
        } else {
          localStorage.removeItem(redirectMediumKey);
        }
      });
    });
  </script>
</body>
</html>
<% } catch (error) { %>
  <%- error %>
<% } %>