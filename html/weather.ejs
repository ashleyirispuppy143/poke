    if (!appState.anonymousMode && appState.locations[0] && (appState.locations[0].name === 'My Location' || isCoordinateLabel(appState.locations[0].name))) {
      fetchReverseLocationName(appState.locations[0].lat, appState.locations[0].lon).then((resolved) => {
