<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>PokeWeather</title>
<meta name="theme-color" content="#111318" />
<meta name="color-scheme" content="dark light" />
<meta content="PokeWeather" property="og:title">
<meta content="View Weather info :3c" property="twitter:description">
<meta content="/static/poke-weather.png" property="og:image" />
<meta content="summary_large_image" name="twitter:card">
<style>
:root {
  --md-bg: #111318;
  --md-surface: #1d2026;
  --md-surface-high: #282a31;
  --md-surface-highest: #33353c;
  --md-primary: #a8c7fa;
  --md-on-primary: #062e6f;
  --md-primary-container: #284777;
  --md-on-primary-container: #d6e3ff;
  --md-text: #e2e2e9;
  --md-text-muted: #c4c6d0;
  --md-outline: #44474e;
  --md-danger: #ffb4ab;
  --radius-xl: 28px;
  --radius-lg: 20px;
  --radius-pill: 999px;
  --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --sky-opacity: 1;
  --mobile-sky-height: 760px;
}

[data-theme="light"] {
  --md-bg: #f8f9ff;
  --md-surface: #ecedf4;
  --md-surface-high: #e1e2e9;
  --md-surface-highest: #d5d7de;
  --md-primary: #2b5bb5;
  --md-on-primary: #ffffff;
  --md-primary-container: #d6e3ff;
  --md-on-primary-container: #001b3e;
  --md-text: #191c20;
  --md-text-muted: #44474e;
  --md-outline: #c4c6d0;
  --md-danger: #ba1a1a;
}

* {
  box-sizing: border-box;
}

html, body {
  min-height: 100%;
  margin: 0;
  background-color: var(--md-bg);
  color: var(--md-text);
  font-family: var(--font-sans);
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

.sky-layer {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  transition: background 0.6s ease, opacity 0.25s ease;
  overflow: hidden;
}

.mobile-sky {
  display: none;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--mobile-sky-height);
  opacity: var(--sky-opacity);
  mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
  -webkit-mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
}

.hero-sky {
  border-radius: inherit;
}

.sky-layer[data-sky="clear-day"] {
  background: linear-gradient(165deg, #1557b0 0%, #3b82f6 55%, #1e3a8a 100%);
}

.sky-layer[data-sky="clear-night"] {
  background: linear-gradient(165deg, #070b19 0%, #131f36 60%, #1e293b 100%);
}

.sky-layer[data-sky="cloudy-day"] {
  background: linear-gradient(165deg, #364961 0%, #566d87 55%, #2b394a 100%);
}

.sky-layer[data-sky="cloudy-night"] {
  background: linear-gradient(165deg, #111722 0%, #232e3f 60%, #161e2b 100%);
}

.sky-layer[data-sky="rain-day"],
.sky-layer[data-sky="rain-night"] {
  background: linear-gradient(165deg, #162030 0%, #27364b 55%, #151d2a 100%);
}

.sky-layer[data-sky="snow-day"],
.sky-layer[data-sky="snow-night"] {
  background: linear-gradient(165deg, #384961 0%, #61748f 55%, #2f3e52 100%);
}

.sky-layer[data-sky="storm-day"],
.sky-layer[data-sky="storm-night"] {
  background: linear-gradient(165deg, #11101d 0%, #29233a 60%, #151321 100%);
}

.sky-celestial {
  position: absolute;
  top: 42px;
  right: 12%;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  transition: all 0.6s ease;
}

.mobile-sky .sky-celestial {
  top: 76px;
  left: 50%;
  right: auto;
  transform: translateX(-50%);
  width: 130px;
  height: 130px;
}

.sky-layer[data-sky="clear-day"] .sky-celestial {
  background: radial-gradient(circle, #fff5c0 0%, #fde047 45%, rgba(251, 191, 36, 0) 72%);
  box-shadow: 0 0 90px 30px rgba(253, 224, 71, 0.38);
}

.sky-layer[data-sky="clear-night"] .sky-celestial {
  width: 84px;
  height: 84px;
  background: radial-gradient(circle, #f8fafc 0%, #cbd5e1 65%, rgba(203, 213, 225, 0) 72%);
  box-shadow: 0 0 60px 16px rgba(226, 232, 240, 0.22);
}

.sky-layer[data-sky="cloudy-day"] .sky-celestial {
  background: radial-gradient(circle, rgba(255, 255, 255, 0.65) 0%, rgba(226, 232, 240, 0) 70%);
  filter: blur(8px);
}

.sky-stars {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.6s ease;
  background-image:
    radial-gradient(1.5px 1.5px at 18% 14%, #ffffff 100%, transparent),
    radial-gradient(1px 1px at 76% 22%, #ffffff 100%, transparent),
    radial-gradient(2px 2px at 38% 8%, #ffffff 100%, transparent),
    radial-gradient(1.5px 1.5px at 84% 11%, #ffffff 100%, transparent),
    radial-gradient(1px 1px at 12% 32%, #ffffff 100%, transparent),
    radial-gradient(1.5px 1.5px at 62% 28%, #ffffff 100%, transparent);
}

.sky-layer[data-sky="clear-night"] .sky-stars,
.sky-layer[data-sky="cloudy-night"] .sky-stars {
  opacity: 0.75;
}

.sky-clouds {
  position: absolute;
  top: 30px;
  left: -10%;
  right: -10%;
  height: 180px;
  opacity: 0;
  transition: opacity 0.6s ease;
  background:
    radial-gradient(ellipse 160px 55px at 30% 60%, rgba(255, 255, 255, 0.22), transparent 70%),
    radial-gradient(ellipse 200px 65px at 70% 45%, rgba(255, 255, 255, 0.18), transparent 70%);
}

.sky-layer[data-sky^="cloudy"] .sky-clouds,
.sky-layer[data-sky^="rain"] .sky-clouds,
.sky-layer[data-sky^="storm"] .sky-clouds {
  opacity: 1;
}

.sky-precip {
  position: absolute;
  inset: -120px -20% 0 -20%;
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.sky-precip::before,
.sky-precip::after {
  content: "";
  position: absolute;
  inset: 0;
}

.sky-layer[data-sky^="rain"] .sky-precip,
.sky-layer[data-sky^="storm"] .sky-precip {
  opacity: 0.75;
  transform: rotate(13deg);
}

.sky-layer[data-sky^="rain"] .sky-precip::before,
.sky-layer[data-sky^="storm"] .sky-precip::before {
  background-image:
    radial-gradient(1.5px 24px at 18px 34px, rgba(186, 230, 253, 0.65), transparent),
    radial-gradient(1.5px 30px at 62px 105px, rgba(186, 230, 253, 0.55), transparent),
    radial-gradient(1px 22px at 108px 52px, rgba(186, 230, 253, 0.6), transparent),
    radial-gradient(1.5px 28px at 154px 145px, rgba(186, 230, 253, 0.5), transparent),
    radial-gradient(1px 26px at 192px 88px, rgba(186, 230, 253, 0.62), transparent);
  background-size: 210px 210px;
  animation: smoothRainA 0.52s linear infinite;
  will-change: background-position;
}

.sky-layer[data-sky^="rain"] .sky-precip::after,
.sky-layer[data-sky^="storm"] .sky-precip::after {
  background-image:
    radial-gradient(1px 18px at 36px 70px, rgba(186, 230, 253, 0.42), transparent),
    radial-gradient(1px 20px at 94px 18px, rgba(186, 230, 253, 0.36), transparent),
    radial-gradient(1px 16px at 142px 112px, rgba(186, 230, 253, 0.4), transparent);
  background-size: 160px 160px;
  animation: smoothRainB 0.74s linear infinite;
  will-change: background-position;
}

.sky-layer[data-sky^="snow"] .sky-precip {
  opacity: 0.7;
}

.sky-layer[data-sky^="snow"] .sky-precip::before {
  background-image:
    radial-gradient(3px 3px at 24px 36px, #ffffff 90%, transparent),
    radial-gradient(4px 4px at 105px 18px, #ffffff 90%, transparent),
    radial-gradient(2.5px 2.5px at 64px 115px, #ffffff 90%, transparent),
    radial-gradient(3.5px 3.5px at 136px 85px, #ffffff 90%, transparent);
  background-size: 160px 160px;
  animation: snowfall 3.2s linear infinite;
  will-change: background-position;
}

@keyframes smoothRainA {
  from { background-position: 0 0; }
  to { background-position: 0 210px; }
}

@keyframes smoothRainB {
  from { background-position: 0 0; }
  to { background-position: 0 160px; }
}

@keyframes snowfall {
  from { background-position: 0 0; }
  to { background-position: 24px 160px; }
}

header {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: color-mix(in srgb, var(--md-bg) 84%, transparent);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid color-mix(in srgb, var(--md-outline) 35%, transparent);
}

.header-inner {
  max-width: 1240px;
  margin: 0 auto;
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.brand-area {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand {
  font-weight: 700;
  font-size: 19px;
  letter-spacing: -0.02em;
  color: var(--md-text);
  text-decoration: none;
}

.hamburger-btn {
  display: none;
  background-color: color-mix(in srgb, var(--md-surface-high) 75%, transparent);
  backdrop-filter: blur(12px);
  border: none;
  color: var(--md-text);
  width: 42px;
  height: 42px;
  border-radius: 50%;
  cursor: pointer;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.hamburger-btn svg {
  width: 22px;
  height: 22px;
  fill: currentColor;
}

.search-wrap {
  flex: 1;
  max-width: 480px;
  min-width: 240px;
  position: relative;
}

.drawer-search-wrap {
  flex: 0 0 auto;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  position: relative;
}

.search-form {
  display: flex;
  align-items: center;
  background-color: var(--md-surface-high);
  border-radius: var(--radius-pill);
  padding: 4px 6px 4px 16px;
  border: 1px solid transparent;
  transition: background-color 0.2s, border-color 0.2s;
}

.search-form:focus-within {
  background-color: var(--md-surface-highest);
  border-color: var(--md-primary);
}

.search-form input[type="search"] {
  flex: 1;
  background: transparent;
  border: none;
  color: var(--md-text);
  padding: 8px 6px;
  font-size: 14px;
  outline: none;
  width: 100%;
}

.search-form input[type="search"]::placeholder {
  color: var(--md-text-muted);
}

.pill-btn {
  background-color: transparent;
  border: none;
  color: var(--md-text-muted);
  padding: 7px 13px;
  border-radius: var(--radius-pill);
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  transition: background-color 0.15s, color 0.15s;
}

.pill-btn:hover {
  background-color: var(--md-surface-highest);
  color: var(--md-text);
}

.suggest {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  right: 0;
  background-color: var(--md-surface-high);
  border-radius: var(--radius-lg);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  display: none;
  z-index: 120;
  max-height: 260px;
  overflow-y: auto;
  padding: 6px;
}

.suggest button {
  display: block;
  width: 100%;
  text-align: left;
  padding: 11px 14px;
  border: none;
  border-radius: 14px;
  background: transparent;
  color: var(--md-text);
  font-size: 14px;
  cursor: pointer;
  transition: background-color 0.15s;
}

.suggest button:hover {
  background-color: var(--md-surface-highest);
}

.controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn {
  background-color: var(--md-surface-high);
  border: none;
  color: var(--md-text);
  padding: 9px 15px;
  border-radius: var(--radius-pill);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  transition: background-color 0.15s;
}

.btn:hover {
  background-color: var(--md-surface-highest);
}

.desktop-loc-bar-wrap {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 24px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: thin;
}

.desktop-loc-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: var(--md-surface);
  color: var(--md-text-muted);
  border: 1px solid color-mix(in srgb, var(--md-outline) 45%, transparent);
  padding: 6px 14px;
  border-radius: var(--radius-pill);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.15s ease;
}

.desktop-loc-chip:hover {
  background-color: var(--md-surface-high);
  color: var(--md-text);
}

.desktop-loc-chip.active {
  background-color: var(--md-primary-container);
  color: var(--md-on-primary-container);
  border-color: var(--md-primary);
}

.desktop-loc-chip svg {
  width: 14px;
  height: 14px;
  fill: currentColor;
  flex-shrink: 0;
}

.desktop-loc-remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: none;
  background: transparent;
  color: inherit;
  opacity: 0.65;
  cursor: pointer;
  padding: 0;
  font-size: 14px;
  line-height: 1;
}

.desktop-loc-remove:hover {
  opacity: 1;
  background-color: rgba(0, 0, 0, 0.2);
}

.drawer-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(4px);
  z-index: 90;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.drawer-backdrop.open {
  opacity: 1;
  pointer-events: auto;
}

.mobile-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(88vw, 360px);
  background-color: var(--md-surface);
  z-index: 100;
  transform: translateX(100%);
  transition: transform 0.28s cubic-bezier(0.2, 0, 0, 1);
  display: flex;
  flex-direction: column;
  padding: 20px;
  gap: 20px;
  overflow-y: auto;
  border-top-left-radius: var(--radius-xl);
  border-bottom-left-radius: var(--radius-xl);
}

.mobile-drawer.open {
  transform: translateX(0);
}

.drawer-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 auto;
}

.drawer-title {
  font-size: 18px;
  font-weight: 700;
}

.drawer-section-label {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--md-text-muted);
  margin-bottom: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.drawer-locations-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.drawer-loc-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  background-color: var(--md-surface-high);
  border-radius: var(--radius-lg);
  padding: 12px 14px;
  cursor: pointer;
  border: 2px solid transparent;
  transition: background-color 0.15s, border-color 0.15s;
}

.drawer-loc-item.active {
  background-color: var(--md-primary-container);
  color: var(--md-on-primary-container);
  border-color: var(--md-primary);
}

.drawer-loc-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.drawer-loc-name {
  font-weight: 600;
  font-size: 14px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.drawer-loc-sub {
  font-size: 11px;
  opacity: 0.78;
}

.drawer-loc-remove {
  background: transparent;
  border: none;
  color: var(--md-danger);
  padding: 6px 8px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.drawer-loc-remove:hover {
  background-color: rgba(255, 255, 255, 0.08);
}

.drawer-controls {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
  margin-top: auto;
  padding-top: 12px;
  flex: 0 0 auto;
}

.container {
  position: relative;
  z-index: 1;
  max-width: 1240px;
  margin: 24px auto;
  padding: 0 24px;
  transition: transform 0.22s ease, opacity 0.22s ease;
}

.dashboard {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 22px;
  align-items: start;
}

.card {
  background-color: var(--md-surface);
  border-radius: var(--radius-xl);
  padding: 24px;
}

.card-header {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--md-text-muted);
  margin: 0 0 16px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col-main {
  grid-column: span 12;
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.col-side {
  grid-column: span 12;
  display: flex;
  flex-direction: column;
  gap: 22px;
}

@media (min-width: 960px) {
  .col-main {
    grid-column: span 8;
  }
  .col-side {
    grid-column: span 4;
  }
}

.hero-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 22px;
  color: #f8fafc;
  padding: 28px;
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.25);
}

.hero-card > *:not(.hero-sky) {
  position: relative;
  z-index: 1;
}

.hero-card .card-header {
  color: rgba(248, 250, 252, 0.78);
  margin-bottom: 0;
}

.hero-primary {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
}

.desktop-hero-loc {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 8px;
  color: #ffffff;
}

.desktop-hero-loc svg {
  width: 22px;
  height: 22px;
  fill: currentColor;
  opacity: 0.9;
}

.mobile-loc-title {
  display: none;
  font-size: 26px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.mobile-loc-tag {
  display: none;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 50%;
  color: #ffffff;
}

.mobile-loc-tag svg {
  width: 16px;
  height: 16px;
  fill: currentColor;
}

.temp-display {
  display: flex;
  align-items: center;
  gap: 18px;
}

.big-icon {
  font-size: 60px;
  line-height: 1;
}

.temp-value {
  font-size: 76px;
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: #ffffff;
}

.condition-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: right;
}

.condition-desc {
  font-size: 24px;
  font-weight: 600;
  color: #ffffff;
}

.condition-sub {
  font-size: 14px;
  color: rgba(248, 250, 252, 0.85);
}

.local-time-sub {
  font-size: 13px;
  color: rgba(248, 250, 252, 0.8);
  font-variant-numeric: tabular-nums;
}

.desktop-outlook-summary {
  font-size: 15px;
  font-weight: 600;
  color: rgba(248, 250, 252, 0.94);
  background-color: rgba(15, 23, 42, 0.34);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: var(--radius-lg);
  padding: 12px 16px;
}

.mobile-outlook-summary {
  display: none;
  font-size: 15px;
  font-weight: 600;
  color: var(--md-text);
  margin: 0 0 14px 0;
  padding-bottom: 12px;
  border-bottom: 1px solid color-mix(in srgb, var(--md-outline) 40%, transparent);
}

.mobile-insights-card {
  display: none;
  position: relative;
  overflow: hidden;
  background-color: var(--md-surface);
  border-radius: var(--radius-xl);
  padding: 18px 0 14px;
  user-select: none;
}

.insights-viewport {
  width: 100%;
  overflow: hidden;
}

.insights-track {
  display: flex;
  width: 100%;
  transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

.insight-page {
  width: 100%;
  min-width: 100%;
  flex: 0 0 100%;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.insight-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  min-width: 0;
}

.insight-title {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--md-primary);
}

.insight-sub {
  font-size: 15px;
  font-weight: 600;
  color: var(--md-text);
  line-height: 1.35;
}

.insight-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.insight-badge-val {
  font-size: 26px;
  font-weight: 700;
  color: var(--md-text);
  line-height: 1;
}

.insight-arrow {
  font-size: 20px;
  font-weight: 800;
  line-height: 1;
}

.insight-arrow.up {
  color: #fb923c;
}

.insight-arrow.down {
  color: #38bdf8;
}

.insight-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6px;
  margin-top: 12px;
  padding: 0 20px;
}

.insight-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  border: none;
  padding: 0;
  background-color: var(--md-text-muted);
  opacity: 0.35;
  cursor: pointer;
  transition: all 0.2s ease;
}

.insight-dot.active {
  width: 18px;
  border-radius: var(--radius-pill);
  background-color: var(--md-primary);
  opacity: 1;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

@media (min-width: 640px) {
  .metrics-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.metric-item {
  background-color: rgba(15, 23, 42, 0.42);
  backdrop-filter: blur(14px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-lg);
  padding: 15px 16px;
}

.metric-label {
  font-size: 12px;
  color: rgba(248, 250, 252, 0.75);
  font-weight: 500;
  margin-bottom: 6px;
}

.metric-val {
  font-size: 17px;
  font-weight: 700;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
}

.hourly-scroll {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding-bottom: 12px;
  scrollbar-width: thin;
  scrollbar-color: var(--md-outline) transparent;
}

.hour-item {
  min-width: 76px;
  flex: 0 0 auto;
  background-color: var(--md-surface-high);
  border-radius: var(--radius-pill);
  padding: 16px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  font-variant-numeric: tabular-nums;
}

.hour-time {
  font-size: 12px;
  color: var(--md-text-muted);
  font-weight: 500;
}

.hour-icon {
  font-size: 22px;
  line-height: 1;
}

.hour-temp {
  font-size: 15px;
  font-weight: 700;
}

.hour-pop {
  font-size: 11px;
  font-weight: 600;
  color: var(--md-primary);
}

.chart-wrap {
  margin-top: 14px;
  height: 120px;
  width: 100%;
  position: relative;
}

canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.daily-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.day-row {
  display: grid;
  grid-template-columns: 1.1fr 36px 1.2fr 0.9fr;
  align-items: center;
  gap: 8px;
  padding: 14px 16px;
  background-color: var(--md-surface-high);
  border-radius: var(--radius-lg);
  font-variant-numeric: tabular-nums;
}

.day-name {
  font-weight: 600;
  color: var(--md-text);
}

.day-icon {
  font-size: 20px;
  text-align: center;
}

.day-cond {
  font-size: 13px;
  color: var(--md-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.day-temps {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  font-size: 14px;
}

.day-hi {
  font-weight: 700;
}

.day-lo {
  color: var(--md-text-muted);
  min-width: 28px;
  text-align: right;
}

.location-dots-bar {
  display: none;
  position: fixed;
  bottom: 14px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 45;
  background-color: color-mix(in srgb, var(--md-surface-high) 85%, transparent);
  backdrop-filter: blur(16px);
  padding: 8px 14px;
  border-radius: var(--radius-pill);
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
}

.loc-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  padding: 0;
  background-color: var(--md-text-muted);
  opacity: 0.4;
  cursor: pointer;
  transition: all 0.2s ease;
}

.loc-dot.active {
  width: 22px;
  border-radius: var(--radius-pill);
  background-color: var(--md-primary);
  opacity: 1;
}

footer {
  position: relative;
  z-index: 1;
  max-width: 1240px;
  margin: 36px auto 64px;
  padding: 16px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--md-text-muted);
  font-size: 13px;
  flex-wrap: wrap;
  gap: 12px;
}

footer a {
  color: var(--md-text-muted);
  text-decoration: none;
}

footer a:hover {
  color: var(--md-text);
}

.hidden {
  display: none !important;
}

.loading {
  opacity: 0.6;
  pointer-events: none;
}

.ssr {
  display: none;
}

main {
  display: block;
}

@media (max-width: 768px) {
  .mobile-sky {
    display: block;
  }

  .hero-sky,
  .desktop-outlook-summary {
    display: none !important;
  }

  .mobile-outlook-summary {
    display: block;
  }

  header {
    background-color: transparent;
    backdrop-filter: none;
    border-bottom: none;
  }

  .desktop-search,
  .desktop-controls,
  .desktop-loc-bar-wrap,
  .desktop-hero-loc {
    display: none;
  }

  .hamburger-btn {
    display: inline-flex;
  }

  .location-dots-bar {
    display: inline-flex;
  }

  .container {
    padding: 0 16px;
    margin-top: 8px;
  }

  .col-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #now.hero-card {
    display: contents;
  }

  #now.hero-card > .card-header {
    display: none;
  }

  .hero-primary {
    order: 1;
    min-height: 36vh;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 8px;
    padding: 8px 4px 12px;
  }

  #hourly {
    order: 2;
    background-color: rgba(17, 19, 24, 0.48);
    backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }

  #hourly .card-header {
    display: none;
  }

  #hourly .mobile-outlook-summary {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.16);
  }

  #hourly .hour-item {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  #hourly .hour-time {
    color: rgba(255, 255, 255, 0.78);
  }

  #mobileInsightsCard {
    display: block;
    order: 3;
  }

  #metricsCard {
    order: 4;
  }

  .mobile-loc-title {
    display: block;
    color: #ffffff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .mobile-loc-tag {
    display: inline-flex;
  }

  .temp-display {
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }

  .big-icon {
    font-size: 64px;
  }

  .temp-value {
    font-size: 88px;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .condition-meta {
    text-align: center;
    align-items: center;
  }

  .metric-item {
    background-color: var(--md-surface);
    border: none;
    backdrop-filter: none;
  }

  .metric-label {
    color: var(--md-text-muted);
  }

  .metric-val {
    color: var(--md-text);
  }
}
</style>

<noscript>
  <style>
    .ssr { display: block !important; }
    main { display: none !important; }
    .no-js-hidden { display: none !important; }
    @media (max-width: 768px) {
      .desktop-search { display: block !important; flex: 1 1 100%; margin-top: 10px; }
      .hamburger-btn { display: none !important; }
    }
  </style>
</noscript>
</head>
<body class="<%= ssr && ssr.forceNoJS ? 'no-js' : '' %>">

  <div id="mobileSky" class="sky-layer mobile-sky" data-sky="clear-day" aria-hidden="true">
    <div class="sky-stars"></div>
    <div class="sky-celestial"></div>
    <div class="sky-clouds"></div>
    <div class="sky-precip"></div>
  </div>

  <header>
    <div class="header-inner">
      <div class="brand-area">
        <a href="/weather" class="brand">PokeWeather</a>
      </div>

      <div class="search-wrap desktop-search">
        <form class="search-form" role="search" aria-label="Search location" action="/weather" method="GET" id="searchForm">
          <input id="q" name="q" type="search" placeholder="Add city, place, or coordinates..." autocomplete="off" />
          <input type="hidden" name="units" id="unitsHidden" value="<%= (ssr && ssr.units) || 'metric' %>"/>
          <button id="btnGeo" class="pill-btn no-js-hidden" type="button" title="Use current location">Locate</button>
          <button id="btnSearch" class="pill-btn" type="submit" title="Add Location">Add</button>
        </form>
        <div id="suggest" class="suggest" role="listbox" aria-label="Suggestions"></div>
      </div>

      <div class="controls desktop-controls">
        <form id="unitForm" action="/weather" method="GET" style="display: none;">
          <input type="hidden" name="q" value="<%= (ssr && ssr.name) || '' %>" />
          <input type="hidden" name="units" value="<%= (ssr && ssr.units === 'metric') ? 'imperial' : 'metric' %>" />
        </form>
        <button form="unitForm" id="btnUnits" class="btn" title="Toggle °C/°F" type="submit"><%= (ssr && ssr.units === 'imperial') ? '°F' : '°C' %></button>
        <button id="btnTimeFormat" class="btn" title="Toggle 12h/24h">24h</button>
        <button id="btnTheme" class="btn" title="Toggle theme">Theme</button>
        <button id="btnInstall" class="btn hidden" title="Install App">Install</button>
        <a class="btn" href="#" id="btnShare" title="Share Forecast">Share</a>
      </div>

      <button id="btnHamburger" class="hamburger-btn" type="button" aria-label="Open menu and locations">
        <svg viewBox="0 0 24 24"><path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/></svg>
      </button>
    </div>

    <div id="desktopLocationsBar" class="desktop-loc-bar-wrap" role="tablist" aria-label="Saved Locations"></div>
  </header>

  <div id="drawerBackdrop" class="drawer-backdrop"></div>

  <aside id="mobileDrawer" class="mobile-drawer" aria-label="Locations and Settings">
    <div class="drawer-top">
      <span class="drawer-title">Locations</span>
      <button id="btnCloseDrawer" class="pill-btn" type="button">Close</button>
    </div>

    <div class="search-wrap drawer-search-wrap">
      <form class="search-form" role="search" id="mobileSearchForm" action="/weather" method="GET">
        <input id="mobileSearchInput" name="q" type="search" placeholder="Add city or place..." autocomplete="off" />
        <input type="hidden" name="units" value="<%= (ssr && ssr.units) || 'metric' %>"/>
        <button class="pill-btn" type="submit">Add</button>
      </form>
      <div id="mobileSuggest" class="suggest" role="listbox" aria-label="Mobile Search Suggestions"></div>
    </div>

    <div>
      <div class="drawer-section-label">
        <span>Saved Locations</span>
        <span id="locCounter">1 / 10</span>
      </div>
      <div id="drawerLocationsList" class="drawer-locations-list"></div>
    </div>

    <div class="drawer-controls">
      <button form="unitForm" id="btnMobileUnits" class="btn" type="submit"><%= (ssr && ssr.units === 'imperial') ? '°F' : '°C' %></button>
      <button id="btnMobileTimeFormat" class="btn" type="button">24h</button>
      <button id="btnMobileTheme" class="btn" type="button">Theme</button>
      <button id="btnMobileShare" class="btn" type="button">Share</button>
    </div>
  </aside>

  <section class="ssr container">
    <div class="dashboard">
      <div class="col-main">
        <article class="card hero-card" aria-live="polite">
          <div class="card-header">Current Weather - <%= (ssr && ssr.name) || 'Unknown' %></div>
          <% if (ssr && ssr.current) { %>
            <div class="hero-primary">
              <div class="temp-display">
                <div class="big-icon"><%= ssr.icon %></div>
                <div class="temp-value"><%= Math.round(ssr.current.temperature_2m) %>°</div>
              </div>
              <div class="condition-meta">
                <div class="condition-desc"><%= ssr.desc %></div>
                <div class="condition-sub">Feels like <%= Math.round(ssr.current.apparent_temperature) %>°</div>
              </div>
            </div>
            <div class="metrics-grid">
              <div class="metric-item"><div class="metric-label">Wind</div><div class="metric-val"><%= Math.round(ssr.current.wind_speed_10m) %> <%= ssr.windUnit %></div></div>
              <div class="metric-item"><div class="metric-label">Humidity</div><div class="metric-val"><%= Math.round(ssr.current.relative_humidity_2m) %>%</div></div>
              <div class="metric-item"><div class="metric-label">Pressure</div><div class="metric-val"><%= Math.round(ssr.current.pressure_msl) %> hPa</div></div>
              <div class="metric-item"><div class="metric-label">Precip Prob</div><div class="metric-val"><%= ssr.popNext ?? '-' %>%</div></div>
              <div class="metric-item"><div class="metric-label">Sunrise</div><div class="metric-val"><%= ssr.sunriseLocal %></div></div>
              <div class="metric-item"><div class="metric-label">Sunset</div><div class="metric-val"><%= ssr.sunsetLocal %></div></div>
              <div class="metric-item"><div class="metric-label">UV Index</div><div class="metric-val"><%= ssr.daily.uv_index_max?.[0] ?? '-' %></div></div>
              <div class="metric-item"><div class="metric-label">Feels Like</div><div class="metric-val"><%= Math.round(ssr.current.apparent_temperature) %>°</div></div>
            </div>
          <% } else { %>
            <p style="color:var(--md-text-muted);margin:0;">No weather data available.</p>
          <% } %>
        </article>
      </div>

      <div class="col-side">
        <article class="card">
          <h3 class="card-header">7-Day Forecast</h3>
          <% if (ssr && ssr.daily) { %>
            <div class="daily-list">
              <% for (let i=0; i<ssr.daily.time.length; i++) { %>
                <div class="day-row">
                  <div class="day-name"><%= ssr.dailyLabels[i] %></div>
                  <div class="day-icon"><%= ssr.dailyIcons[i] %></div>
                  <div class="day-cond"><%= ssr.dailyTexts[i] %></div>
                  <div class="day-temps">
                    <span class="day-hi"><%= Math.round(ssr.daily.temperature_2m_max[i]) %>°</span>
                    <span class="day-lo"><%= Math.round(ssr.daily.temperature_2m_min[i]) %>°</span>
                  </div>
                </div>
              <% } %>
            </div>
          <% } %>
        </article>
      </div>
    </div>
  </section>

  <main id="mainSwipeContainer" class="container">
    <div class="dashboard">
      <div class="col-main">
        <article id="now" class="card hero-card current" aria-live="polite">
          <div id="heroSky" class="sky-layer hero-sky" data-sky="clear-day" aria-hidden="true">
            <div class="sky-stars"></div>
            <div class="sky-celestial"></div>
            <div class="sky-clouds"></div>
            <div class="sky-precip"></div>
          </div>

          <div class="card-header">
            <span>Current Conditions</span>
            <span id="currFeelHeader"></span>
          </div>

          <div class="hero-primary">
            <div class="mobile-loc-tag" id="mobileLocTag" title="Default Location">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
            </div>
            <div class="mobile-loc-title" id="mobileLocTitle">Select Location</div>

            <div>
              <div class="desktop-hero-loc" id="desktopHeroLoc">
                <svg id="desktopHomeIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                <span id="locChip"><%= (ssr && ssr.name) || 'Select Location' %></span>
              </div>
              <div class="temp-display">
                <div class="big-icon" id="currIcon">-</div>
                <div class="temp-value" id="currTemp">-</div>
              </div>
            </div>

            <div class="condition-meta">
              <div class="condition-desc" id="currDesc">-</div>
              <div class="condition-sub">Feels like <span id="currFeels">-</span></div>
              <div class="local-time-sub hidden" id="currLocalTime"></div>
            </div>
          </div>

          <div id="desktopOutlookSummary" class="desktop-outlook-summary">-</div>

          <div id="metricsCard" class="metrics-grid">
            <div class="metric-item"><div class="metric-label">Wind</div><div class="metric-val" id="currWind">-</div></div>
            <div class="metric-item"><div class="metric-label">Humidity</div><div class="metric-val" id="currHum">-</div></div>
            <div class="metric-item"><div class="metric-label">Pressure</div><div class="metric-val" id="currPress">-</div></div>
            <div class="metric-item"><div class="metric-label">Precip (1h)</div><div class="metric-val" id="pop">-</div></div>
            <div class="metric-item"><div class="metric-label">Sunrise</div><div class="metric-val" id="sunrise">-</div></div>
            <div class="metric-item"><div class="metric-label">Sunset</div><div class="metric-val" id="sunset">-</div></div>
            <div class="metric-item"><div class="metric-label">Max UV</div><div class="metric-val" id="uv">-</div></div>
            <div class="metric-item"><div class="metric-label">Cycle</div><div class="metric-val" id="dayMode">-</div></div>
          </div>
        </article>

        <section id="hourly" class="card">
          <div id="outlookSummary" class="mobile-outlook-summary">-</div>
          <h3 class="card-header">24-Hour Outlook</h3>
          <div id="hours" class="hourly-scroll" aria-label="Hourly forecast"></div>
          <div class="chart-wrap">
            <canvas id="chart" aria-label="Temperature trend chart" role="img"></canvas>
          </div>
        </section>

        <section id="mobileInsightsCard" class="mobile-insights-card" aria-label="Smart Weather Highlights">
          <div class="insights-viewport">
            <div id="insightsTrack" class="insights-track"></div>
          </div>
          <div id="insightsDots" class="insight-dots"></div>
        </section>
      </div>

      <div class="col-side">
        <section id="daily" class="card">
          <h3 class="card-header">7-Day Forecast</h3>
          <div id="days" class="daily-list"></div>
        </section>
      </div>
    </div>
  </main>

  <nav id="locationDotsBar" class="location-dots-bar" aria-label="Saved Locations Pagination"></nav>

  <footer>
    <div>PokeWeather</div>
    <div style="display:flex;gap:16px;">
      <a href="/privacy">Privacy Policy</a>
      <a href="https://open-meteo.com/" target="_blank" rel="noopener">Data: Open-Meteo</a>
    </div>
  </footer>
   
