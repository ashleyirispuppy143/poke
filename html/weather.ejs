  padding: 16px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  font-variant-numeric: tabular-nums;
}

.hour-time {
  font-size: 12px;
  color: var(--md-text-muted);
  font-weight: 500;
}

.hour-icon {
  font-size: 22px;
  line-height: 1;
}

.hour-temp {
  font-size: 15px;
  font-weight: 700;
}

.hour-pop {
  font-size: 11px;
  font-weight: 600;
  color: var(--md-primary);
}

.chart-wrap {
  margin-top: 14px;
  height: 120px;
  width: 100%;
  position: relative;
}

canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.daily-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.day-row {
  display: grid;
  grid-template-columns: 1.1fr 36px 1.2fr 0.9fr;
  align-items: center;
  gap: 8px;
  padding: 14px 16px;
  background-color: var(--md-surface-high);
  border-radius: var(--radius-lg);
  font-variant-numeric: tabular-nums;
}

.day-name {
  font-weight: 600;
  color: var(--md-text);
}

.day-icon {
  font-size: 20px;
  text-align: center;
}

.day-cond {
  font-size: 13px;
  color: var(--md-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.day-temps {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  font-size: 14px;
}

.day-hi {
  font-weight: 700;
}

.day-lo {
  color: var(--md-text-muted);
  min-width: 28px;
  text-align: right;
}

.location-dots-bar {
  display: none;
  position: fixed;
  bottom: 14px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 45;
  background-color: color-mix(in srgb, var(--md-surface-high) 85%, transparent);
  backdrop-filter: blur(16px);
  padding: 8px 14px;
  border-radius: var(--radius-pill);
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
}

.loc-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  padding: 0;
  background-color: var(--md-text-muted);
  opacity: 0.4;
  cursor: pointer;
  transition: all 0.2s ease;
}

.loc-dot.active {
  width: 22px;
  border-radius: var(--radius-pill);
  background-color: var(--md-primary);
  opacity: 1;
}

footer {
  position: relative;
  z-index: 1;
  max-width: 1240px;
  margin: 36px auto 64px;
  padding: 16px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--md-text-muted);
  font-size: 13px;
  flex-wrap: wrap;
  gap: 12px;
}

footer a {
  color: var(--md-text-muted);
  text-decoration: none;
}

footer a:hover {
  color: var(--md-text);
}

.hidden {
  display: none !important;
}

.loading {
  opacity: 0.6;
  pointer-events: none;
}

main {
  display: block;
}

html[data-device="tablet"] .container {
  max-width: 1024px;
  padding: 0 20px;
}

html[data-device="tablet"] .dashboard {
  grid-template-columns: repeat(12, 1fr);
  gap: 18px;
}

html[data-device="tablet"] .col-main {
  grid-column: span 7;
}

html[data-device="tablet"] .col-side {
  grid-column: span 5;
}

html[data-device="tablet"] .metrics-grid {
  grid-template-columns: repeat(2, 1fr);
}

html[data-device="tablet"] #mobileInsightsCard {
  display: block;
}

html[data-device="tablet"] .location-dots-bar {
  display: inline-flex;
}

html[data-device="mobile"] .mobile-sky {
  display: block;
}

html[data-device="mobile"] .hero-sky,
html[data-device="mobile"] .desktop-outlook-summary {
  display: none !important;
}

html[data-device="mobile"] .mobile-outlook-summary {
  display: block;
}

html[data-device="mobile"] header {
  background-color: transparent;
  backdrop-filter: none;
  border-bottom: none;
}

html[data-device="mobile"] .desktop-search,
html[data-device="mobile"] .desktop-controls,
html[data-device="mobile"] .desktop-loc-bar-wrap,
html[data-device="mobile"] .desktop-hero-loc {
  display: none;
}

html[data-device="mobile"] .hamburger-btn {
  display: inline-flex;
}

html[data-device="mobile"] .location-dots-bar {
  display: inline-flex;
}

html[data-device="mobile"] .container {
  padding: 0 16px;
  margin-top: 8px;
}

html[data-device="mobile"] .col-main {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

html[data-device="mobile"] #now.hero-card {
  display: contents;
}

html[data-device="mobile"] #now.hero-card > .card-header {
  display: none;
}

html[data-device="mobile"] .hero-primary {
  order: 1;
  min-height: 36vh;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: 8px;
  padding: 8px 4px 12px;
}

html[data-device="mobile"] #hourly {
  order: 2;
  background-color: rgba(17, 19, 24, 0.48);
  backdrop-filter: blur(18px);
  border: 1px solid rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

html[data-device="mobile"] #hourly .card-header {
  display: none;
}

html[data-device="mobile"] #hourly .mobile-outlook-summary {
  color: #ffffff;
  border-bottom-color: rgba(255, 255, 255, 0.16);
}

html[data-device="mobile"] #hourly .hour-item {
  background-color: rgba(255, 255, 255, 0.1);
  color: #ffffff;
}

html[data-device="mobile"] #hourly .hour-time {
  color: rgba(255, 255, 255, 0.78);
}

html[data-device="mobile"] #mobileInsightsCard {
  display: block;
  order: 3;
}

html[data-device="mobile"] #metricsCard {
  order: 4;
  grid-template-columns: repeat(2, 1fr);
}

html[data-device="mobile"] #pollenCard {
  order: 5;
}

html[data-device="mobile"] #aqiBarCard {
  order: 6;
}

html[data-device="mobile"] .mobile-loc-title {
  display: block;
  color: #ffffff;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
}

html[data-device="mobile"] .mobile-loc-tag {
  display: inline-flex;
}

html[data-device="mobile"] .temp-display {
  flex-direction: column;
  justify-content: center;
  gap: 6px;
}

html[data-device="mobile"] #currIcon {
  display: none !important;
}

html[data-device="mobile"] .temp-value {
  font-size: 88px;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

html[data-device="mobile"] .condition-meta {
  text-align: center;
  align-items: center;
}

html[data-device="mobile"] .metric-item {
  background-color: var(--md-surface);
  border: none;
  backdrop-filter: none;
}

html[data-device="mobile"] .metric-label {
  color: var(--md-text-muted);
}

html[data-device="mobile"] .metric-val {
  color: var(--md-text);
}

@media (max-width: 768px) {
  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>

<noscript>
  <style>
    .no-js-hidden { display: none !important; }
    .chart-wrap { display: none !important; }
    @media (max-width: 768px) {
      .desktop-search { display: block !important; flex: 1 1 100%; margin-top: 10px; }
      .desktop-controls { display: flex !important; width: 100%; justify-content: flex-start; margin-top: 6px; }
      .hamburger-btn { display: none !important; }
      .location-dots-bar { display: none !important; }
      .insights-track { flex-direction: column !important; gap: 14px; }
      .insight-dots { display: none !important; }
    }
  </style>
</noscript>
</head>
<body class="<%= ssrSafe.forceNoJS ? 'no-js' : '' %>">

  <div id="mobileSky" class="sky-layer mobile-sky" data-sky="<%= ssrSkyVariant %>" aria-hidden="true">
    <div class="sky-stars"></div>
    <div class="sky-celestial"></div>
    <div class="sky-clouds"></div>
    <div class="sky-precip"></div>
  </div>

  <header>
    <div class="header-inner">
      <div class="brand-area">
        <a href="/weather" class="brand">PokeWeather</a>
      </div>

      <div class="search-wrap desktop-search">
        <form class="search-form" role="search" aria-label="Search location" action="/weather" method="GET" id="searchForm">
          <input id="q" name="q" type="search" value="<%= (!ssrAnon && ssrSafe.name) ? ssrSafe.name : '' %>" placeholder="Search city, place, or coordinates..." autocomplete="off" />
          <input type="hidden" name="units" id="unitsHidden" value="<%= ssrUnits %>"/>
          <button id="btnGeo" class="pill-btn no-js-hidden" type="button" title="Use current location">Locate</button>
          <button id="btnSearch" class="pill-btn" type="submit" title="Search or Add Location">Search</button>
        </form>
        <div id="suggest" class="suggest" role="listbox" aria-label="Suggestions"></div>
      </div>

      <div class="controls desktop-controls">
        <form id="unitForm" action="/weather" method="GET" style="display: none;">
          <input type="hidden" name="q" id="unitFormQ" value="<%= ssrSafe.name || '' %>" />
          <% if (typeof ssrSafe.lat === 'number' && typeof ssrSafe.lon === 'number') { %>
            <input type="hidden" name="lat" value="<%= ssrSafe.lat %>" />
            <input type="hidden" name="lon" value="<%= ssrSafe.lon %>" />
          <% } %>
          <input type="hidden" name="units" value="<%= ssrUnits === 'metric' ? 'imperial' : 'metric' %>" />
        </form>
        <button form="unitForm" id="btnUnits" class="btn" title="Toggle °C/°F" type="submit"><%= ssrTempSymbol %></button>
        <button id="btnSettings" class="btn no-js-hidden" title="General Settings" type="button">Settings</button>
        <button id="btnInstall" class="btn hidden" title="Install App" type="button">Install</button>
        <a class="btn no-js-hidden" href="#" id="btnShare" title="Share Forecast">Share</a>
      </div>

      <button id="btnHamburger" class="hamburger-btn" type="button" aria-label="Open menu and locations">
        <svg viewBox="0 0 24 24"><path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/></svg>
      </button>
    </div>

    <div id="desktopLocationsBar" class="desktop-loc-bar-wrap no-js-hidden" role="tablist" aria-label="Saved Locations"></div>
  </header>

  <div id="settingsBackdrop" class="settings-backdrop"></div>

  <div id="settingsModal" class="settings-modal" role="dialog" aria-labelledby="settingsModalTitle">
    <div class="drawer-top" style="margin-bottom: 16px;">
      <span id="settingsModalTitle" class="drawer-title">General Settings</span>
      <button id="btnCloseSettings" class="pill-btn" type="button">Close</button>
    </div>
    <div class="settings-list">
      <div class="setting-row">
        <div class="setting-info">
          <div class="setting-name">Temperature Units</div>
          <div class="setting-desc">Switch between Metric (°C) and Imperial (°F)</div>
        </div>
        <button id="btnModalUnits" class="btn" type="button"><%= ssrTempSymbol %></button>
      </div>
      <div class="setting-row">
        <div class="setting-info">
          <div class="setting-name">Time Format</div>
          <div class="setting-desc">24-hour or 12-hour clock display</div>
        </div>
        <button id="btnTimeFormat" class="btn" type="button"><%= ssrTimeFormat %></button>
      </div>
      <div class="setting-row">
        <div class="setting-info">
          <div class="setting-name">Appearance</div>
          <div class="setting-desc">Toggle dark or light color scheme</div>
        </div>
        <button id="btnTheme" class="btn" type="button">Theme</button>
      </div>
      <div class="setting-row">
        <div class="setting-info">
          <div class="setting-name">Anonymous Mode</div>
          <div class="setting-desc">Mask default location as "My Location"</div>
        </div>
        <button id="btnAnon" class="btn<%= ssrAnon ? ' active-toggle' : '' %>" type="button"><%= ssrAnon ? 'On' : 'Off' %></button>
      </div>
      <div class="setting-row-col">
        <div class="setting-info">
          <div class="setting-name">Displayed Pollens (Select 3)</div>
          <div class="setting-desc">Choose which 3 pollens appear on the Pollen card</div>
        </div>
        <div id="modalPollenPicker" class="pollen-picker-chips"></div>
      </div>
    </div>
  </div>

  <div id="drawerBackdrop" class="drawer-backdrop"></div>

  <aside id="mobileDrawer" class="mobile-drawer" aria-label="Locations and Settings">
    <div class="drawer-top">
      <span class="drawer-title">Locations</span>
      <button id="btnCloseDrawer" class="pill-btn" type="button">Close</button>
    </div>

    <div class="search-wrap drawer-search-wrap">
      <form class="search-form" role="search" id="mobileSearchForm" action="/weather" method="GET">
        <input id="mobileSearchInput" name="q" type="search" placeholder="Add city or place..." autocomplete="off" />
        <input type="hidden" name="units" value="<%= ssrUnits %>"/>
        <button class="pill-btn" type="submit">Add</button>
      </form>
      <div id="mobileSuggest" class="suggest" role="listbox" aria-label="Mobile Search Suggestions"></div>
    </div>

    <div>
      <div class="drawer-section-label">
        <span>Saved Locations</span>
        <span id="locCounter">1 / 10</span>
      </div>
      <div id="drawerLocationsList" class="drawer-locations-list"></div>
    </div>

    <div class="drawer-settings-section">
      <div class="drawer-section-label">
        <span>General Settings</span>
      </div>
      <div class="settings-list">
        <div class="setting-row">
          <div class="setting-info">
            <div class="setting-name">Temperature Units</div>
            <div class="setting-desc">Metric or Imperial</div>
          </div>
          <button form="unitForm" id="btnMobileUnits" class="btn" type="submit"><%= ssrTempSymbol %></button>
        </div>
        <div class="setting-row">
          <div class="setting-info">
            <div class="setting-name">Time Format</div>
            <div class="setting-desc">24-hour or 12-hour</div>
          </div>
          <button id="btnMobileTimeFormat" class="btn" type="button"><%= ssrTimeFormat %></button>
        </div>
        <div class="setting-row">
          <div class="setting-info">
            <div class="setting-name">Appearance</div>
            <div class="setting-desc">Dark or Light theme</div>
          </div>
          <button id="btnMobileTheme" class="btn" type="button">Theme</button>
        </div>
        <div class="setting-row">
          <div class="setting-info">
            <div class="setting-name">Anonymous Mode</div>
            <div class="setting-desc">Show "My Location"</div>
          </div>
          <button id="btnMobileAnon" class="btn<%= ssrAnon ? ' active-toggle' : '' %>" type="button"><%= ssrAnon ? 'On' : 'Off' %></button>
        </div>
        <div class="setting-row-col">
          <div class="setting-info">
            <div class="setting-name">Displayed Pollens (Select 3)</div>
            <div class="setting-desc">Customize your 3 tracked pollens</div>
          </div>
          <div id="drawerPollenPicker" class="pollen-picker-chips"></div>
        </div>
        <button id="btnMobileShare" class="btn" type="button" style="width: 100%; margin-top: 4px;">Share Forecast</button>
      </div>
    </div>
  </aside>

  <main id="mainSwipeContainer" class="container">
    <div class="dashboard">
      <div class="col-main">
        <article id="now" class="card hero-card current" aria-live="polite">
          <div id="heroSky" class="sky-layer hero-sky" data-sky="<%= ssrSkyVariant %>" aria-hidden="true">
            <div class="sky-stars"></div>
            <div class="sky-celestial"></div>
            <div class="sky-clouds"></div>
            <div class="sky-precip"></div>
          </div>

          <div class="card-header">
            <span>Current Conditions</span>
            <span id="currFeelHeader"></span>
          </div>

          <div class="hero-primary">
            <div class="mobile-loc-tag" id="mobileLocTag" title="Current Location">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            </div>
            <div class="mobile-loc-title" id="mobileLocTitle"><%= ssrDisplayName %></div>

            <div>
              <div class="desktop-hero-loc" id="desktopHeroLoc">
                <svg id="desktopHomeIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span id="locChip"><%= ssrDisplayName %></span>
              </div>
              <div class="temp-display">
                <div class="big-icon" id="currIcon"><%= ssrHeroIcon %></div>
                <div class="temp-value" id="currTemp"><%= ssrCurrent ? Math.round(ssrCurrent.temperature_2m) + '°' : '-' %></div>
              </div>
            </div>

            <div class="condition-meta">
              <div class="condition-desc" id="currDesc"><%= ssrHeroDesc %></div>
              <div class="condition-sub">Feels like <span id="currFeels"><%= ssrCurrent ? Math.round(ssrCurrent.apparent_temperature) + '°' : '-' %></span></div>
              <div class="local-time-sub hidden" id="currLocalTime"></div>
            </div>
          </div>

          <div id="desktopOutlookSummary" class="desktop-outlook-summary"><%= ssrOutlookSummary %></div>

          <div id="metricsCard" class="metrics-grid">
            <div class="metric-item"><div class="metric-label">Wind</div><div class="metric-val" id="currWind"><%= ssrCurrent ? Math.round(ssrCurrent.wind_speed_10m) + ' ' + ssrWindSymbol : '-' %></div></div>
            <div class="metric-item"><div class="metric-label">Humidity</div><div class="metric-val" id="currHum"><%= ssrCurrent ? Math.round(ssrCurrent.relative_humidity_2m) + '%' : '-' %></div></div>
            <div class="metric-item"><div class="metric-label">Pressure</div><div class="metric-val" id="currPress"><%= ssrCurrent ? Math.round(ssrCurrent.pressure_msl) + ' hPa' : '-' %></div></div>
            <div class="metric-item"><div class="metric-label">Precip (1h)</div><div class="metric-val" id="pop"><%= ssrSafe.popNext != null ? ssrSafe.popNext + '%' : '-' %></div></div>
            <div class="metric-item"><div class="metric-label">Sunrise</div><div class="metric-val" id="sunrise"><%= ssrSafe.sunriseLocal || (ssrDaily && ssrDaily.sunrise?.[0] ? formatSsrClock(ssrDaily.sunrise[0]) : '-') %></div></div>
            <div class="metric-item"><div class="metric-label">Sunset</div><div class="metric-val" id="sunset"><%= ssrSafe.sunsetLocal || (ssrDaily && ssrDaily.sunset?.[0] ? formatSsrClock(ssrDaily.sunset[0]) : '-') %></div></div>
            <div class="metric-item"><div class="metric-label">Max UV</div><div class="metric-val" id="uv"><%= (ssrDaily && ssrDaily.uv_index_max?.[0] != null) ? ssrDaily.uv_index_max[0] : '-' %></div></div>
            <div class="metric-item"><div class="metric-label">Cycle</div><div class="metric-val" id="dayMode"><%= ssrCurrent ? (ssrIsDay ? 'Day' : 'Night') : '-' %></div></div>
            <div class="metric-item"><div class="metric-label">Ozone</div><div class="metric-val" id="currOzone"><%= (ssrAq && ssrAq.o3 != null) ? Math.round(ssrAq.o3) + ' µg/m³' : '-' %></div></div>
            <div class="metric-item"><div class="metric-label">Dust</div><div class="metric-val" id="currDust"><%= (ssrAq && ssrAq.dust != null) ? Math.round(ssrAq.dust) + ' µg/m³' : '-' %></div></div>
          </div>
        </article>

        <section id="pollenCard" class="card pollen-card" aria-label="Pollen Levels">
          <div id="pollenGrid" class="pollen-three-grid">
            <% for (let i = 0; i < ssrTopPollens.length; i++) { %>
              <div class="pollen-col">
                <svg class="pollen-leaf-icon<%= ssrTopPollens[i].active ? ' active' : '' %>" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66l.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8Z"/>
                </svg>
                <div class="pollen-name"><%= ssrTopPollens[i].name %></div>
                <div class="pollen-status"><%= ssrTopPollens[i].stage %></div>
              </div>
            <% } %>
          </div>
        </section>

        <section id="aqiBarCard" class="card aqi-bar-card" aria-label="Air Quality Index">
          <div class="aqi-bar-top">
            <span id="currAqiText" class="aqi-bar-title" style="color: <%= ssrAqiColor %>;"><%= ssrAqiVal !== null ? `AQI(${ssrAqiShort})${ssrAqiVal}` : 'AQI(-)' %></span>
            <div id="currAqiPm" class="aqi-pm-right">
              <span>PM2.5: <%= (ssrAq && ssrAq.pm25 != null) ? Math.round(ssrAq.pm25) : '-' %></span>
              <span>PM10: <%= (ssrAq && ssrAq.pm10 != null) ? Math.round(ssrAq.pm10) : '-' %></span>
            </div>
          </div>
          <div class="aqi-track" aria-hidden="true">
            <div id="aqiFill" class="aqi-fill" style="width: <%= ssrAqiFillWidth %>%; background-color: <%= ssrAqiColor %>;"></div>
          </div>
        </section>

        <section id="hourly" class="card">
          <div id="outlookSummary" class="mobile-outlook-summary"><%= ssrOutlookSummary %></div>
          <h3 class="card-header">24-Hour Outlook</h3>
          <div id="hours" class="hourly-scroll" aria-label="Hourly forecast">
            <% if (ssrHourly && Array.isArray(ssrHourly.time)) { %>
              <% for (let i = ssrSliceStart; i < ssrSliceEnd; i++) { %>
                <div class="hour-item">
                  <div class="hour-time"><%= formatSsrClock(ssrHourly.time[i]) %></div>
                  <div class="hour-icon"><%= getSsrIcon(ssrHourly.weather_code?.[i] ?? 0, true) %></div>
                  <div class="hour-temp"><%= Math.round(ssrHourly.temperature_2m?.[i] ?? 0) %>°</div>
                  <div class="hour-pop"><%= ssrHourly.precipitation_probability?.[i] ?? 0 %>%</div>
                </div>
              <% } %>
            <% } %>
          </div>
          <div class="chart-wrap">
            <canvas id="chart" aria-label="Temperature trend chart" role="img"></canvas>
          </div>
        </section>

        <section id="mobileInsightsCard" class="mobile-insights-card" aria-label="Smart Weather Highlights">
          <div class="insights-viewport">
            <div id="insightsTrack" class="insights-track">
              <% for (let i = 0; i < ssrInsights.length; i++) { %>
                <div class="insight-page">
                  <div class="insight-left">
                    <div class="insight-title"><%= ssrInsights[i].title %></div>
                    <div class="insight-sub"><%= ssrInsights[i].sub %></div>
                  </div>
                  <div class="insight-right">
                    <span class="insight-badge-val"><%= ssrInsights[i].rightVal %></span>
                    <% if (ssrInsights[i].arrow === 'up') { %>
                      <span class="insight-arrow up" aria-hidden="true">↑</span>
                    <% } else if (ssrInsights[i].arrow === 'down') { %>
                      <span class="insight-arrow down" aria-hidden="true">↓</span>
                    <% } %>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
          <div id="insightsDots" class="insight-dots<%= ssrInsights.length <= 1 ? ' hidden' : '' %>">
            <% for (let i = 0; i < ssrInsights.length; i++) { %>
              <button type="button" class="insight-dot<%= i === 0 ? ' active' : '' %>" aria-label="Highlight page <%= i + 1 %>"></button>
            <% } %>
          </div>
        </section>
      </div>

      <div class="col-side">
        <section id="daily" class="card">
          <h3 class="card-header">7-Day Forecast</h3>
          <div id="days" class="daily-list">
            <% if (ssrDaily && Array.isArray(ssrDaily.time)) { %>
              <% for (let i = 0; i < ssrDaily.time.length; i++) { %>
                <div class="day-row">
                  <div class="day-name"><%= (ssrSafe.dailyLabels && ssrSafe.dailyLabels[i]) ? ssrSafe.dailyLabels[i] : (i === 0 ? 'Today' : ssrDaily.time[i]) %></div>
                  <div class="day-icon"><%= (ssrSafe.dailyIcons && ssrSafe.dailyIcons[i]) ? ssrSafe.dailyIcons[i] : getSsrIcon(ssrDaily.weather_code?.[i] ?? 0, true) %></div>
                  <div class="day-cond"><%= (ssrSafe.dailyTexts && ssrSafe.dailyTexts[i]) ? ssrSafe.dailyTexts[i] : getSsrDesc(ssrDaily.weather_code?.[i] ?? 0) %></div>
                  <div class="day-temps">
                    <span class="day-hi"><%= Math.round(ssrDaily.temperature_2m_max?.[i] ?? 0) %>°</span>
                    <span class="day-lo"><%= Math.round(ssrDaily.temperature_2m_min?.[i] ?? 0) %>°</span>
                  </div>
                </div>
              <% } %>
            <% } %>
          </div>
        </section>
      </div>
    </div>
  </main>

  <nav id="locationDotsBar" class="location-dots-bar" aria-label="Saved Locations Pagination"></nav>

  <footer>
    <div>PokeWeather</div>
    <div style="display:flex;gap:16px;">
      <a href="/privacy">Privacy Policy</a>
      <a href="https://open-meteo.com/" target="_blank" rel="noopener">Data: Open-Meteo</a>
    </div>
  </footer>
   
