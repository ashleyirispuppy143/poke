<script>
  window.__SSR__ = <%- JSON.stringify(ssr || {}) %>;
  window.__SSR_ROUTE__ = "/weather";
</script>

<script>
  const selectElement = (selector) => document.querySelector(selector);

  const MAX_LOCATIONS = 10;
  const LOCATIONS_STORAGE_KEY = 'pokeweather:locations';
  const ACTIVE_INDEX_STORAGE_KEY = 'pokeweather:activeIndex';
  const TIME_FORMAT_STORAGE_KEY = 'pokeweather:timeFormat';

  const storedUnits = JSON.parse(localStorage.getItem('pokeweather:units') || '{}');
  const storedTimeFormat = localStorage.getItem(TIME_FORMAT_STORAGE_KEY) || '24h';

  const appState = {
    lat: null,
    lon: null,
    name: null,
    units: storedUnits.units || '<%= (ssr && ssr.units) || "metric" %>',
    timeFormat: storedTimeFormat === '12h' ? '12h' : '24h',
    locations: [],
    activeIndex: 0
  };

  let latestWeatherData = null;
  let latestChartSeries = null;

  let insightTimerId = null;
  let insightCurrentPage = 0;
  let insightTotalPages = 0;
  let insightDirection = 1;
  let insightUserPaused = false;

  const unitsButton = selectElement('#btnUnits');
  const mobileUnitsButton = selectElement('#btnMobileUnits');
  const timeFormatButton = selectElement('#btnTimeFormat');
  const mobileTimeFormatButton = selectElement('#btnMobileTimeFormat');
  const themeButton = selectElement('#btnTheme');
  const mobileThemeButton = selectElement('#btnMobileTheme');
  const geoButton = selectElement('#btnGeo');
  const shareButton = selectElement('#btnShare');
  const mobileShareButton = selectElement('#btnMobileShare');

  const searchForm = selectElement('#searchForm');
  const searchInput = selectElement('#q');
  const suggestionsBox = selectElement('#suggest');

  const mobileSearchForm = selectElement('#mobileSearchForm');
  const mobileSearchInput = selectElement('#mobileSearchInput');
  const mobileSuggestionsBox = selectElement('#mobileSuggest');

  const hamburgerButton = selectElement('#btnHamburger');
  const closeDrawerButton = selectElement('#btnCloseDrawer');
  const mobileDrawer = selectElement('#mobileDrawer');
  const drawerBackdrop = selectElement('#drawerBackdrop');
  const drawerLocationsList = selectElement('#drawerLocationsList');
  const desktopLocationsBar = selectElement('#desktopLocationsBar');
  const locCounter = selectElement('#locCounter');
  const locationDotsBar = selectElement('#locationDotsBar');

  const hiddenUnitsInput = selectElement('#unitsHidden');
  const mobileSkyElement = selectElement('#mobileSky');
  const heroSkyElement = selectElement('#heroSky');

  const WEATHER_DESCRIPTIONS = {
    0: 'Clear sky',
    1: 'Mostly clear',
    2: 'Partly cloudy',
    3: 'Overcast',
    45: 'Fog',
    48: 'Rime fog',
    51: 'Light drizzle',
    53: 'Drizzle',
    55: 'Dense drizzle',
    56: 'Freezing drizzle',
    57: 'Heavy freezing drizzle',
    61: 'Slight rain',
    63: 'Rain',
    65: 'Heavy rain',
    66: 'Freezing rain',
    67: 'Heavy freezing rain',
    71: 'Slight snow',
    73: 'Snow',
    75: 'Heavy snow',
    77: 'Snow grains',
    80: 'Rain showers',
    81: 'Moderate showers',
    82: 'Heavy showers',
    85: 'Snow showers',
    86: 'Heavy snow showers',
    95: 'Thunderstorm',
    96: 'Storm with hail',
    99: 'Severe hailstorm'
  };

  function getWeatherDescription(code) {
    return WEATHER_DESCRIPTIONS[code] || '-';
  }

  function getWeatherIcon(code, isDay) {
    if (code === 0) return isDay ? '☀️' : '🌙';
    if (code === 1 || code === 2) return isDay ? '🌤️' : '☁️';
    if (code === 3) return '☁️';
    if (code === 45 || code === 48) return '🌫️';
    if ([51, 53, 55, 80, 81, 82].includes(code)) return '🌦️';
    if ([61, 63, 65].includes(code)) return '🌧️';
    if ([66, 67].includes(code)) return '🌧️❄️';
    if ([71, 73, 75, 77, 85, 86].includes(code)) return '❄️';
    if ([95, 96, 99].includes(code)) return '⛈️';
    return '☁️';
  }

  function getSkyVariant(code, isDay) {
    const timeSuffix = isDay ? 'day' : 'night';
    if (code === 0 || code === 1) return `clear-${timeSuffix}`;
    if ([2, 3, 45, 48].includes(code)) return `cloudy-${timeSuffix}`;
    if ([51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(code)) return `rain-${timeSuffix}`;
    if ([71, 73, 75, 77, 85, 86].includes(code)) return `snow-${timeSuffix}`;
    if ([95, 96, 99].includes(code)) return `storm-${timeSuffix}`;
    return `clear-${timeSuffix}`;
  }

  function isPrecipitationCode(code) {
    return [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 71, 73, 75, 77, 80, 81, 82, 85, 86, 95, 96, 99].includes(code);
  }

  function formatNumber(value, suffix = '') {
    if (value === null || value === undefined || Number.isNaN(value)) return '-';
    return `${Math.round(value)}${suffix}`;
  }

  function is12HourMode() {
    return appState.timeFormat === '12h';
  }

  function formatClockTime(isoString) {
    const use12Hr = is12HourMode();
    return new Date(isoString).toLocaleTimeString([], {
      hour: '2-digit',
      minute: '2-digit',
      hour12: use12Hr,
      hourCycle: use12Hr ? 'h12' : 'h23'
    });
  }

  function formatLocationLocalTime(timezoneName, utcOffsetSeconds) {
    const use12Hr = is12HourMode();
    const formatOptions = {
      hour: '2-digit',
      minute: '2-digit',
      hour12: use12Hr,
      hourCycle: use12Hr ? 'h12' : 'h23'
    };

    try {
      if (timezoneName) {
        return new Intl.DateTimeFormat([], {
          ...formatOptions,
          timeZone: timezoneName
        }).format(new Date());
      }
    } catch {}

    if (typeof utcOffsetSeconds === 'number') {
      const shiftedDate = new Date(Date.now() + utcOffsetSeconds * 1000);
      return new Intl.DateTimeFormat([], {
        ...formatOptions,
        timeZone: 'UTC'
      }).format(shiftedDate);
    }

    return new Date().toLocaleTimeString([], formatOptions);
  }

  function getLocationCurrentHour(timezoneName, utcOffsetSeconds) {
    try {
      if (timezoneName) {
        const hourStr = new Intl.DateTimeFormat('en-US', {
          hour: 'numeric',
          hour12: false,
          hourCycle: 'h23',
          timeZone: timezoneName
        }).format(new Date());
        return Number(hourStr);
      }
    } catch {}

    if (typeof utcOffsetSeconds === 'number') {
      const shiftedDate = new Date(Date.now() + utcOffsetSeconds * 1000);
      return shiftedDate.getUTCHours();
    }

    return new Date().getHours();
  }

  function buildOutlookSummaryText(weatherData, sliceStart) {
    const daily = weatherData.daily;
    const hourly = weatherData.hourly;
    const current = weatherData.current;
    const unitSymbol = appState.units === 'metric' ? '°C' : '°F';

    const currentCode = current.weather_code;
    const currentDesc = getWeatherDescription(currentCode);
    const next12Codes = hourly.weather_code.slice(sliceStart, sliceStart + 12);
    const next12Pops = (hourly.precipitation_probability || []).slice(sliceStart, sliceStart + 12);

    let conditionNarrative = '';

    if (isPrecipitationCode(currentCode)) {
      const dryOffset = next12Codes.findIndex((code, idx) => idx > 0 && !isPrecipitationCode(code));
      if (dryOffset !== -1 && dryOffset <= 6) {
        const clearTime = formatClockTime(hourly.time[sliceStart + dryOffset]);
        conditionNarrative = `${currentDesc} right now, tapering off around ${clearTime}`;
      } else {
        conditionNarrative = `${currentDesc} continuing for the next several hours`;
      }
    } else {
      const precipOffset = next12Codes.findIndex((code, idx) => idx > 0 && (isPrecipitationCode(code) || (next12Pops[idx] ?? 0) >= 60));
      if (precipOffset !== -1 && precipOffset <= 8) {
        const incomingCode = next12Codes[precipOffset];
        const incomingName = isPrecipitationCode(incomingCode)
          ? getWeatherDescription(incomingCode).toLowerCase()
          : 'scattered showers';
        const startTime = formatClockTime(hourly.time[sliceStart + precipOffset]);
        conditionNarrative = `${currentDesc} now, with ${incomingName} expected around ${startTime}`;
      } else {
        const clearHours = next12Codes.filter((c) => c === 0 || c === 1).length;
        const overcastHours = next12Codes.filter((c) => c === 3).length;
        const partlyHours = next12Codes.filter((c) => c === 2).length;

        if (currentCode === 0 && clearHours >= 9) {
          conditionNarrative = 'Generally clear skies ahead';
        } else if ((currentCode === 0 || currentCode === 1) && (partlyHours + overcastHours) >= 5) {
          conditionNarrative = `${currentDesc} now, becoming cloudier later`;
        } else if ((currentCode === 2 || currentCode === 3) && clearHours >= 6) {
          conditionNarrative = `${currentDesc} now, clearing up later`;
        } else if (overcastHours >= 8) {
          conditionNarrative = 'Overcast skies continuing';
        } else if (partlyHours >= 5) {
          conditionNarrative = 'Partly cloudy throughout the outlook';
        } else {
          conditionNarrative = `${currentDesc} conditions continuing`;
        }
      }
    }

    const todayMax = Math.round(daily.temperature_2m_max?.[0] ?? current.temperature_2m);
    const todayMin = Math.round(daily.temperature_2m_min?.[0] ?? current.temperature_2m);
    const tomorrowMin = Math.round(daily.temperature_2m_min?.[1] ?? todayMin);
    const localHour = getLocationCurrentHour(weatherData.timezone, weatherData.utc_offset_seconds);

    let tempClause = '';
    if (localHour >= 5 && localHour < 12) {
      tempClause = `Highs ${todayMax - 1} to ${todayMax + 1}${unitSymbol} and lows ${todayMin - 1} to ${todayMin + 1}${unitSymbol}.`;
    } else if (localHour >= 12 && localHour < 18) {
      tempClause = `High ${todayMax}${unitSymbol}, low ${tomorrowMin}${unitSymbol} tonight.`;
    } else {
      tempClause = `Low ${tomorrowMin}${unitSymbol}.`;
    }

    return `${conditionNarrative}. ${tempClause}`;
  }

  function generateMobileSmartInsights(weatherData, sliceStart) {
    const insights = [];
    const current = weatherData.current;
    const daily = weatherData.daily;
    const hourly = weatherData.hourly;
    const unitSymbol = appState.units === 'metric' ? '°C' : '°F';
    const windLabel = appState.units === 'metric' ? 'km/h' : 'mph';

    const todayMax = Math.round(daily.temperature_2m_max?.[0] ?? current.temperature_2m);
    const tomorrowMax = Math.round(daily.temperature_2m_max?.[1] ?? todayMax);
    const tempDelta = tomorrowMax - todayMax;
    const absDelta = Math.abs(tempDelta);

    const isImperial = appState.units === 'imperial';
    const bigShift = isImperial ? 9 : 5;
    const modShift = isImperial ? 4 : 2;

    let tempComparisonText = 'Temperatures tomorrow will feel nearly identical to today.';
    let arrowDir = 'none';
    if (tempDelta >= bigShift) {
      tempComparisonText = 'Temperatures are much higher than today.';
      arrowDir = 'up';
    } else if (tempDelta >= modShift) {
      tempComparisonText = 'Temperatures are a little higher than today.';
      arrowDir = 'up';
    } else if (tempDelta <= -bigShift) {
      tempComparisonText = 'Temperatures are much lower than today.';
      arrowDir = 'down';
    } else if (tempDelta <= -modShift) {
      tempComparisonText = 'Temperatures are a little lower than today.';
      arrowDir = 'down';
    }

    insights.push({
      title: "Tomorrow's temperature",
      sub: tempComparisonText,
      rightVal: `${absDelta}°`,
      arrow: arrowDir
    });

    const next8Codes = hourly.weather_code.slice(sliceStart, sliceStart + 8);
    const next8Pops = (hourly.precipitation_probability || []).slice(sliceStart, sliceStart + 8);
    const maxNextPop = Math.max(0, ...next8Pops);

    if (isPrecipitationCode(current.weather_code)) {
      insights.push({
        title: 'Grab an umbrella!',
        sub: `${getWeatherDescription(current.weather_code)} is active and likely to continue nearby.`,
        rightVal: '☂️',
        arrow: 'none'
      });
    } else if (maxNextPop >= 50 || next8Codes.some((c) => isPrecipitationCode(c))) {
      insights.push({
        title: 'Grab an umbrella!',
        sub: `Rain is likely in the coming hours (${maxNextPop}% peak chance).`,
        rightVal: `${maxNextPop}%`,
        arrow: 'none'
      });
    }

    const localHour = getLocationCurrentHour(weatherData.timezone, weatherData.utc_offset_seconds);
    const tomorrowCode = daily.weather_code?.[1] ?? 0;
    const tomorrowSunrise = daily.sunrise?.[1] ? formatClockTime(daily.sunrise[1]) : formatClockTime(daily.sunrise[0]);

    if ([0, 1, 2].includes(tomorrowCode) && (localHour >= 15 || localHour < 6)) {
      insights.push({
        title: "Don't miss tomorrow's sunrise",
        sub: `Sunrise is at ${tomorrowSunrise} tomorrow with clear viewing conditions.`,
        rightVal: '🌅',
        arrow: 'none'
      });
    }

    const todaySunset = daily.sunset?.[0] ? formatClockTime(daily.sunset[0]) : null;
    if (todaySunset && Boolean(current.is_day) && localHour >= 12 && localHour <= 19 && [0, 1, 2].includes(current.weather_code)) {
      insights.push({
        title: "Tonight's sunset",
        sub: `Golden hour ahead - sunset is at ${todaySunset} this evening.`,
        rightVal: '🌇',
        arrow: 'none'
      });
    }

    const maxUvToday = daily.uv_index_max?.[0] ?? 0;
    if (Boolean(current.is_day) && maxUvToday >= 6) {
      insights.push({
        title: 'High UV alert',
        sub: `UV index reaches ${Math.round(maxUvToday)} today. Sun protection is recommended.`,
        rightVal: `UV ${Math.round(maxUvToday)}`,
        arrow: 'none'
      });
    }

    const windThreshold = isImperial ? 18 : 28;
    if (current.wind_speed_10m >= windThreshold) {
      insights.push({
        title: 'Breezy conditions',
        sub: `Winds are gusting around ${Math.round(current.wind_speed_10m)} ${windLabel} right now.`,
        rightVal: '💨',
        arrow: 'none'
      });
    }

    const warmThreshold = isImperial ? 68 : 20;
    if (current.relative_humidity_2m >= 78 && current.temperature_2m >= warmThreshold) {
      insights.push({
        title: 'Muggy & humid',
        sub: `Humidity is at ${Math.round(current.relative_humidity_2m)}%, making it feel warmer outside.`,
        rightVal: `${Math.round(current.relative_humidity_2m)}%`,
        arrow: 'none'
      });
    }

    const freezeThreshold = isImperial ? 34 : 1;
    const minNext12Temp = Math.min(...hourly.temperature_2m.slice(sliceStart, sliceStart + 12));
    if (minNext12Temp <= freezeThreshold) {
      insights.push({
        title: 'Frost & freeze alert',
        sub: `Temperatures dip to ${Math.round(minNext12Temp)}${unitSymbol}. Bundle up and watch for ice.`,
        rightVal: '🥶',
        arrow: 'none'
      });
    }

    if (!current.is_day && [0, 1].includes(current.weather_code)) {
      insights.push({
        title: 'Great for stargazing',
        sub: 'Clear night skies right now offer great visibility of the moon and stars.',
        rightVal: '🌌',
        arrow: 'none'
      });
    }

    if (insights.length < 2 && todaySunset) {
      insights.push({
        title: 'Sun cycle',
        sub: `Sunrise at ${formatClockTime(daily.sunrise[0])} • Sunset at ${todaySunset}.`,
        rightVal: '☀️',
        arrow: 'none'
      });
    }

    return insights;
  }

  function renderMobileInsightsCarousel(weatherData, sliceStart) {
    const track = selectElement('#insightsTrack');
    const dotsContainer = selectElement('#insightsDots');
    if (!track || !dotsContainer) return;

    const pages = generateMobileSmartInsights(weatherData, sliceStart);
    insightTotalPages = pages.length;
    insightCurrentPage = 0;
    insightDirection = 1;

    track.innerHTML = '';
    dotsContainer.innerHTML = '';

    pages.forEach((item, index) => {
      const pageEl = document.createElement('div');
      pageEl.className = 'insight-page';

      let arrowMarkup = '';
      if (item.arrow === 'up') {
        arrowMarkup = '<span class="insight-arrow up" aria-hidden="true">↑</span>';
      } else if (item.arrow === 'down') {
        arrowMarkup = '<span class="insight-arrow down" aria-hidden="true">↓</span>';
      }

      pageEl.innerHTML = `
        <div class="insight-left">
          <div class="insight-title">${item.title}</div>
          <div class="insight-sub">${item.sub}</div>
        </div>
        <div class="insight-right">
          <span class="insight-badge-val">${item.rightVal}</span>
          ${arrowMarkup}
        </div>
      `;
      track.appendChild(pageEl);

      if (pages.length > 1) {
        const dotBtn = document.createElement('button');
        dotBtn.type = 'button';
        dotBtn.className = `insight-dot${index === 0 ? ' active' : ''}`;
        dotBtn.setAttribute('aria-label', `Highlight page ${index + 1}`);
        dotBtn.addEventListener('click', (event) => {
          event.stopPropagation();
          insightUserPaused = true;
          stopInsightAutoTimer();
          goToInsightPage(index);
        });
        dotsContainer.appendChild(dotBtn);
      }
    });

    dotsContainer.classList.toggle('hidden', pages.length <= 1);
    goToInsightPage(0);

    if (!insightUserPaused) {
      startInsightAutoTimer();
    }
  }

  function goToInsightPage(pageIndex) {
    const track = selectElement('#insightsTrack');
    const dotsContainer = selectElement('#insightsDots');
    if (!track || insightTotalPages === 0) return;

    insightCurrentPage = Math.max(0, Math.min(pageIndex, insightTotalPages - 1));
    track.style.transform = `translateX(-${insightCurrentPage * 100}%)`;

    if (dotsContainer) {
      const dots = dotsContainer.querySelectorAll('.insight-dot');
      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === insightCurrentPage);
      });
    }
  }

  function stopInsightAutoTimer() {
    if (insightTimerId) {
      clearInterval(insightTimerId);
      insightTimerId = null;
    }
  }

  function startInsightAutoTimer() {
    stopInsightAutoTimer();
    if (insightTotalPages <= 1 || insightUserPaused) return;

    insightTimerId = setInterval(() => {
      if (insightUserPaused || insightTotalPages <= 1) return;
      let nextIndex = insightCurrentPage + insightDirection;
      if (nextIndex >= insightTotalPages) {
        insightDirection = -1;
        nextIndex = insightCurrentPage - 1;
      } else if (nextIndex < 0) {
        insightDirection = 1;
        nextIndex = insightCurrentPage + 1;
      }
      goToInsightPage(nextIndex);
    }, 3000);
  }

  function setupInsightsCardInteraction() {
    const card = selectElement('#mobileInsightsCard');
    if (!card) return;

    let startX = 0;

    card.addEventListener('click', () => {
      insightUserPaused = true;
      stopInsightAutoTimer();
    });

    card.addEventListener('touchstart', (event) => {
      insightUserPaused = true;
      stopInsightAutoTimer();
      if (event.touches.length === 1) {
        startX = event.touches[0].clientX;
      }
    }, { passive: true });

    card.addEventListener('touchend', (event) => {
      if (event.changedTouches.length !== 1 || insightTotalPages <= 1) return;
      const diffX = event.changedTouches[0].clientX - startX;
      if (Math.abs(diffX) > 40) {
        if (diffX < 0 && insightCurrentPage < insightTotalPages - 1) {
          goToInsightPage(insightCurrentPage + 1);
        } else if (diffX > 0 && insightCurrentPage > 0) {
          goToInsightPage(insightCurrentPage - 1);
        }
      }
    }, { passive: true });
  }

  function updateMobileSkyHeight() {
    if (window.innerWidth > 768) return;
    const hourlySection = selectElement('#hourly');
    if (!hourlySection) return;
    const rect = hourlySection.getBoundingClientRect();
    const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
    const totalHeight = Math.max(480, Math.round(rect.bottom + scrollTop + 20));
    document.documentElement.style.setProperty('--mobile-sky-height', `${totalHeight}px`);
  }

  function formatShortDate(isoString) {
    return new Date(isoString).toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });
  }

  function formatPlaceLabel(displayName, maxParts = 2) {
    if (!displayName) return '';
    return displayName
      .split(',')
      .map((part) => part.trim())
      .filter(Boolean)
      .slice(0, maxParts)
      .join(', ');
  }

  function isCoordinateLabel(text) {
    if (!text) return true;
    return /^-?\d+(?:\.\d+)?\s*,\s*-?\d+(?:\.\d+)?$/.test(text.trim());
  }

  async function fetchPlaceSuggestions(value) {
    if (!value || !value.trim()) return [];
    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=6&q=${encodeURIComponent(value.trim())}`);
      if (!res.ok) return [];
      const data = await res.json();
      return Array.isArray(data) ? data : [];
    } catch {
      return [];
    }
  }

  async function fetchReverseLocationName(lat, lon) {
    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lon)}`);
      if (!res.ok) return null;
      const data = await res.json();
      if (data && data.address) {
        const locality = data.address.city || data.address.town || data.address.village || data.address.municipality || data.address.county;
        const country = data.address.state || data.address.country;
        if (locality && country) return `${locality}, ${country}`;
        if (locality) return locality;
      }
      if (data && data.display_name) {
        return formatPlaceLabel(data.display_name, 2);
      }
      return null;
    } catch {
      return null;
    }
  }

  function loadStoredLocations() {
    try {
      const rawList = JSON.parse(localStorage.getItem(LOCATIONS_STORAGE_KEY) || '[]');
      const savedIndex = Number(localStorage.getItem(ACTIVE_INDEX_STORAGE_KEY) || 0);
      if (Array.isArray(rawList) && rawList.length > 0) {
        appState.locations = rawList.slice(0, MAX_LOCATIONS);
        appState.locations[0].isCurrent = true;
      } else {
        appState.locations = [{
          lat: 40.7128,
          lon: -74.006,
          name: 'Current Location',
          isCurrent: true
        }];
      }
      appState.activeIndex = Math.min(Math.max(0, savedIndex), appState.locations.length - 1);
    } catch {
      appState.locations = [{
        lat: 40.7128,
        lon: -74.006,
        name: 'Current Location',
        isCurrent: true
      }];
      appState.activeIndex = 0;
    }
  }

  function saveLocationsToStorage() {
    try {
      localStorage.setItem(LOCATIONS_STORAGE_KEY, JSON.stringify(appState.locations));
      localStorage.setItem(ACTIVE_INDEX_STORAGE_KEY, String(appState.activeIndex));
    } catch {}
  }

  function renderLocationNavigation() {
    drawerLocationsList.innerHTML = '';
    locationDotsBar.innerHTML = '';
    desktopLocationsBar.innerHTML = '';
    locCounter.textContent = `${appState.locations.length} / ${MAX_LOCATIONS}`;

    appState.locations.forEach((locItem, index) => {
      const isSelected = index === appState.activeIndex;
      const cleanLabel = locItem.name || 'Unknown Location';

      const listRow = document.createElement('div');
      listRow.className = `drawer-loc-item${isSelected ? ' active' : ''}`;

      const infoBlock = document.createElement('div');
      infoBlock.className = 'drawer-loc-info';

      const titleSpan = document.createElement('div');
      titleSpan.className = 'drawer-loc-name';
      titleSpan.textContent = cleanLabel;

      const subSpan = document.createElement('div');
      subSpan.className = 'drawer-loc-sub';
      subSpan.textContent = index === 0 ? 'Default (Current Location)' : `${Number(locItem.lat).toFixed(2)}, ${Number(locItem.lon).toFixed(2)}`;

      infoBlock.appendChild(titleSpan);
      infoBlock.appendChild(subSpan);
      listRow.appendChild(infoBlock);

      listRow.addEventListener('click', () => {
        switchToLocationIndex(index);
        closeMobileDrawer();
      });

      if (index > 0) {
        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'drawer-loc-remove';
        removeButton.textContent = 'Remove';
        removeButton.addEventListener('click', (event) => {
          event.stopPropagation();
          removeLocationAtIndex(index);
        });
        listRow.appendChild(removeButton);
      }

      drawerLocationsList.appendChild(listRow);

      const dotButton = document.createElement('button');
      dotButton.type = 'button';
      dotButton.className = `loc-dot${isSelected ? ' active' : ''}`;
      dotButton.setAttribute('aria-label', `Switch to ${cleanLabel}`);
      dotButton.addEventListener('click', () => switchToLocationIndex(index));
      locationDotsBar.appendChild(dotButton);

      const desktopChip = document.createElement('div');
      desktopChip.className = `desktop-loc-chip${isSelected ? ' active' : ''}`;
      desktopChip.setAttribute('role', 'tab');
      desktopChip.setAttribute('aria-selected', String(isSelected));

      if (index === 0) {
        const homeSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        homeSvg.setAttribute('viewBox', '0 0 24 24');
        homeSvg.innerHTML = '<path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>';
        desktopChip.appendChild(homeSvg);
      }

      const chipText = document.createElement('span');
      chipText.textContent = cleanLabel;
      desktopChip.appendChild(chipText);

      if (index > 0) {
        const chipRemoveBtn = document.createElement('button');
        chipRemoveBtn.type = 'button';
        chipRemoveBtn.className = 'desktop-loc-remove';
        chipRemoveBtn.title = `Remove ${cleanLabel}`;
        chipRemoveBtn.textContent = '×';
        chipRemoveBtn.addEventListener('click', (event) => {
          event.stopPropagation();
          removeLocationAtIndex(index);
        });
        desktopChip.appendChild(chipRemoveBtn);
      }

      desktopChip.addEventListener('click', () => switchToLocationIndex(index));
      desktopLocationsBar.appendChild(desktopChip);
    });
  }

  function addOrSelectSavedLocation(lat, lon, name) {
    const numericLat = Number(lat);
    const numericLon = Number(lon);

    const existingIndex = appState.locations.findIndex((item, idx) => {
      if (idx === 0) return false;
      return Math.abs(item.lat - numericLat) < 0.02 && Math.abs(item.lon - numericLon) < 0.02;
    });

    if (existingIndex !== -1) {
      switchToLocationIndex(existingIndex);
      return;
    }

    if (appState.locations.length >= MAX_LOCATIONS) {
      alert(`You can save up to ${MAX_LOCATIONS} locations. Remove one first.`);
      return;
    }

    appState.locations.push({
      lat: numericLat,
      lon: numericLon,
      name: name || `${numericLat.toFixed(2)}, ${numericLon.toFixed(2)}`,
      isCurrent: false
    });

    appState.activeIndex = appState.locations.length - 1;
    saveLocationsToStorage();
    renderLocationNavigation();
    loadWeatherForCoordinates(numericLat, numericLon, name);
  }

  function removeLocationAtIndex(indexToRemove) {
    if (indexToRemove <= 0 || indexToRemove >= appState.locations.length) return;
    appState.locations.splice(indexToRemove, 1);

    if (appState.activeIndex >= appState.locations.length) {
      appState.activeIndex = appState.locations.length - 1;
    } else if (appState.activeIndex > indexToRemove) {
      appState.activeIndex -= 1;
    }

    saveLocationsToStorage();
    renderLocationNavigation();
    const targetLocation = appState.locations[appState.activeIndex];
    loadWeatherForCoordinates(targetLocation.lat, targetLocation.lon, targetLocation.name);
  }

  function switchToLocationIndex(targetIndex) {
    if (targetIndex < 0 || targetIndex >= appState.locations.length) return;
    appState.activeIndex = targetIndex;
    insightUserPaused = false;
    saveLocationsToStorage();
    renderLocationNavigation();

    const targetLocation = appState.locations[targetIndex];
    loadWeatherForCoordinates(targetLocation.lat, targetLocation.lon, targetLocation.name);
  }

  function refreshDefaultCurrentLocation(silentFallback = true) {
    if (!navigator.geolocation) {
      if (!silentFallback) alert('Geolocation is not supported by your browser.');
      return;
    }

    navigator.geolocation.getCurrentPosition(
      async (position) => {
        const { latitude, longitude } = position.coords;
        const resolvedPlaceName = await fetchReverseLocationName(latitude, longitude);
        appState.locations[0] = {
          lat: latitude,
          lon: longitude,
          name: resolvedPlaceName || 'Current Location',
          isCurrent: true
        };
        saveLocationsToStorage();
        renderLocationNavigation();

        if (appState.activeIndex === 0) {
          loadWeatherForCoordinates(latitude, longitude, appState.locations[0].name);
        }
      },
      () => {
        if (!silentFallback) alert('Location permission denied.');
      }
    );
  }

  function updateLocationHeading(name) {
    const cleanText = name || 'Unknown Location';
    selectElement('#locChip').textContent = cleanText;
    selectElement('#mobileLocTitle').textContent = cleanText;

    const isDefaultLocation = appState.activeIndex === 0;
    const tagElement = selectElement('#mobileLocTag');
    if (tagElement) {
      tagElement.classList.toggle('hidden', !isDefaultLocation);
    }

    const desktopHomeIcon = selectElement('#desktopHomeIcon');
    if (desktopHomeIcon) {
      desktopHomeIcon.classList.toggle('hidden', !isDefaultLocation);
    }
  }

  function syncUnitControls() {
    const unitLabel = appState.units === 'metric' ? '°C' : '°F';
    unitsButton.textContent = unitLabel;
    mobileUnitsButton.textContent = unitLabel;

    if (hiddenUnitsInput) {
      hiddenUnitsInput.value = appState.units === 'metric' ? 'metric' : 'imperial';
    }
    localStorage.setItem('pokeweather:units', JSON.stringify({ units: appState.units }));
    if (appState.lat !== null && appState.lon !== null) {
      loadWeatherForCoordinates(appState.lat, appState.lon, appState.name);
    }
  }

  function syncTimeFormatControls() {
    const formatLabel = appState.timeFormat === '12h' ? '12h' : '24h';
    timeFormatButton.textContent = formatLabel;
    mobileTimeFormatButton.textContent = formatLabel;
    localStorage.setItem(TIME_FORMAT_STORAGE_KEY, appState.timeFormat);

    if (latestWeatherData) {
      renderWeatherDashboard(latestWeatherData);
    }
  }

  async function loadWeatherForCoordinates(lat, lon, providedName) {
    const numericLat = Number(lat);
    const numericLon = Number(lon);
    appState.lat = numericLat;
    appState.lon = numericLon;

    let resolvedName = providedName || appState.name;
    if (!resolvedName || isCoordinateLabel(resolvedName)) {
      updateLocationHeading('Locating...');
      const lookedUpName = await fetchReverseLocationName(numericLat, numericLon);
      resolvedName = lookedUpName || `${numericLat.toFixed(2)}, ${numericLon.toFixed(2)}`;
    }

    appState.name = resolvedName;
    if (appState.locations[appState.activeIndex]) {
      appState.locations[appState.activeIndex].name = resolvedName;
      appState.locations[appState.activeIndex].lat = numericLat;
      appState.locations[appState.activeIndex].lon = numericLon;
      saveLocationsToStorage();
      renderLocationNavigation();
    }

    updateLocationHeading(resolvedName);

    const temperatureUnit = appState.units === 'metric' ? 'celsius' : 'fahrenheit';
    const windSpeedUnit = appState.units === 'metric' ? 'kmh' : 'mph';

    const requestUrl = new URL('/api/weather', location.origin);
    requestUrl.searchParams.set('latitude', numericLat);
    requestUrl.searchParams.set('longitude', numericLon);
    requestUrl.searchParams.set('current', 'temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m,wind_direction_10m,pressure_msl');
    requestUrl.searchParams.set('hourly', 'temperature_2m,apparent_temperature,precipitation_probability,precipitation,weather_code,wind_speed_10m');
    requestUrl.searchParams.set('daily', 'weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,uv_index_max');
    requestUrl.searchParams.set('timezone', 'auto');
    requestUrl.searchParams.set('forecast_days', '7');
    requestUrl.searchParams.set('temperature_unit', temperatureUnit);
    requestUrl.searchParams.set('windspeed_unit', windSpeedUnit);

    const currentCard = selectElement('.current');
    currentCard.classList.add('loading');

    try {
      let response = await fetch(requestUrl.toString());
      if (!response.ok) {
        const directOpenMeteoUrl = new URL('https://api.open-meteo.com/v1/forecast');
        directOpenMeteoUrl.search = requestUrl.searchParams.toString();
        response = await fetch(directOpenMeteoUrl.toString());
      }
      if (!response.ok) throw new Error('Failed to load weather data');

      const weatherData = await response.json();
      localStorage.setItem('pokeweather:last', JSON.stringify({
        when: Date.now(),
        state: {
          lat: appState.lat,
          lon: appState.lon,
          name: appState.name,
          units: appState.units
        },
        data: weatherData
      }));
      renderWeatherDashboard(weatherData);
    } catch {
      const cachedPayload = JSON.parse(localStorage.getItem('pokeweather:last') || 'null');
      if (cachedPayload && cachedPayload.data) {
        renderWeatherDashboard(cachedPayload.data);
      } else {
        alert('Could not load weather data.');
      }
    } finally {
      currentCard.classList.remove('loading');
    }
  }

  function renderWeatherDashboard(weatherData) {
    latestWeatherData = weatherData;
    const current = weatherData.current;
    const daily = weatherData.daily;
    const hourly = weatherData.hourly;

    const isDaytime = Boolean(current.is_day);
    const windUnitLabel = appState.units === 'metric' ? 'km/h' : 'mph';
    const skyVariant = getSkyVariant(current.weather_code, isDaytime);

    if (mobileSkyElement) {
      mobileSkyElement.setAttribute('data-sky', skyVariant);
    }
    if (heroSkyElement) {
      heroSkyElement.setAttribute('data-sky', skyVariant);
    }

    selectElement('#currIcon').textContent = getWeatherIcon(current.weather_code, isDaytime);
    selectElement('#currTemp').textContent = formatNumber(current.temperature_2m, '°');
    selectElement('#currDesc').textContent = getWeatherDescription(current.weather_code);
    selectElement('#currFeels').textContent = formatNumber(current.apparent_temperature, '°');
    selectElement('#currWind').textContent = `${formatNumber(current.wind_speed_10m)} ${windUnitLabel} (${current.wind_direction_10m ?? '-'}°)`;
    selectElement('#currHum').textContent = formatNumber(current.relative_humidity_2m, '%');
    selectElement('#currPress').textContent = formatNumber(current.pressure_msl, ' hPa');
    selectElement('#sunrise').textContent = formatClockTime(daily.sunrise[0]);
    selectElement('#sunset').textContent = formatClockTime(daily.sunset[0]);
    selectElement('#uv').textContent = daily.uv_index_max?.[0] ?? '-';
    selectElement('#dayMode').textContent = isDaytime ? 'Day' : 'Night';

    const localTimeElement = selectElement('#currLocalTime');
    if (localTimeElement) {
      if (appState.activeIndex > 0) {
        const formattedLocal = formatLocationLocalTime(weatherData.timezone, weatherData.utc_offset_seconds);
        localTimeElement.textContent = `Local time: ${formattedLocal}`;
        localTimeElement.classList.remove('hidden');
      } else {
        localTimeElement.textContent = '';
        localTimeElement.classList.add('hidden');
      }
    }

    const upcomingHourIndex = hourly.time.findIndex((timeValue) => Date.parse(timeValue) > Date.now());
    const nextHourPrecip = hourly.precipitation_probability?.[upcomingHourIndex] ?? hourly.precipitation_probability?.[0] ?? null;
    selectElement('#pop').textContent = nextHourPrecip === null ? '-' : `${nextHourPrecip}%`;

    const hourlyContainer = selectElement('#hours');
    hourlyContainer.innerHTML = '';
    const sliceStart = upcomingHourIndex > 0 ? upcomingHourIndex - 1 : 0;
    const sliceEnd = Math.min(sliceStart + 24, hourly.time.length);

    const summaryText = buildOutlookSummaryText(weatherData, sliceStart);
    const mobileSummaryElement = selectElement('#outlookSummary');
    const desktopSummaryElement = selectElement('#desktopOutlookSummary');
    if (mobileSummaryElement) mobileSummaryElement.textContent = summaryText;
    if (desktopSummaryElement) desktopSummaryElement.textContent = summaryText;

    renderMobileInsightsCarousel(weatherData, sliceStart);

    for (let index = sliceStart; index < sliceEnd; index++) {
      const hourCard = document.createElement('div');
      hourCard.className = 'hour-item';
      const timeLabel = formatClockTime(hourly.time[index]);
      const iconLabel = getWeatherIcon(hourly.weather_code[index], true);
      const tempLabel = formatNumber(hourly.temperature_2m[index], '°');
      const precipLabel = hourly.precipitation_probability?.[index] ?? 0;

      hourCard.innerHTML = `
        <div class="hour-time">${timeLabel}</div>
        <div class="hour-icon">${iconLabel}</div>
        <div class="hour-temp">${tempLabel}</div>
        <div class="hour-pop">${precipLabel}%</div>
    `;
      hourlyContainer.appendChild(hourCard);
    }

    latestChartSeries = {
      times: hourly.time.slice(sliceStart, sliceEnd).map((timeValue) => new Date(timeValue)),
      temps: hourly.temperature_2m.slice(sliceStart, sliceEnd)
    };
    drawTemperatureChart(selectElement('#chart'), latestChartSeries.times, latestChartSeries.temps);

    const dailyContainer = selectElement('#days');
    dailyContainer.innerHTML = '';

    for (let index = 0; index < daily.time.length; index++) {
      const dayRow = document.createElement('div');
      dayRow.className = 'day-row';
      const dayTitle = index === 0 ? 'Today' : formatShortDate(daily.time[index]);
      const maxTemp = formatNumber(daily.temperature_2m_max[index], '°');
      const minTemp = formatNumber(daily.temperature_2m_min[index], '°');
      const conditionIcon = getWeatherIcon(daily.weather_code[index], true);
      const conditionText = getWeatherDescription(daily.weather_code[index]);

      dayRow.innerHTML = `
        <div class="day-name">${dayTitle}</div>
        <div class="day-icon">${conditionIcon}</div>
        <div class="day-cond">${conditionText}</div>
        <div class="day-temps">
          <span class="day-hi">${maxTemp}</span>
          <span class="day-lo">${minTemp}</span>
        </div>
      `;
      dailyContainer.appendChild(dayRow);
    }

    requestAnimationFrame(updateMobileSkyHeight);
  }

  function drawTemperatureChart(canvas, timeValues, tempValues) {
    if (!tempValues || tempValues.length === 0) return;

    const context = canvas.getContext('2d');
    const pixelRatio = window.devicePixelRatio || 1;
    const width = canvas.clientWidth;
    const height = canvas.clientHeight;

    canvas.width = width * pixelRatio;
    canvas.height = height * pixelRatio;
    context.scale(pixelRatio, pixelRatio);

    const minTemp = Math.min(...tempValues);
    const maxTemp = Math.max(...tempValues);
    const horizontalPadding = 14;
    const verticalPadding = 20;
    const stepX = (width - 2 * horizontalPadding) / Math.max(1, tempValues.length - 1);

    const getYCoordinate = (temperature) => {
      if (maxTemp === minTemp) return height / 2;
      const normalized = (temperature - minTemp) / (maxTemp - minTemp);
      return height - verticalPadding - normalized * (height - 2 * verticalPadding);
    };

    context.clearRect(0, 0, width, height);

    const computedStyles = getComputedStyle(document.documentElement);
    const primaryColor = computedStyles.getPropertyValue('--md-primary').trim() || '#a8c7fa';
    const outlineColor = computedStyles.getPropertyValue('--md-outline').trim() || '#44474e';

    context.strokeStyle = outlineColor;
    context.lineWidth = 1;
    context.globalAlpha = 0.4;
    context.beginPath();
    context.moveTo(horizontalPadding, verticalPadding);
    context.lineTo(width - horizontalPadding, verticalPadding);
    context.moveTo(horizontalPadding, height - verticalPadding);
    context.lineTo(width - horizontalPadding, height - verticalPadding);
    context.stroke();
    context.globalAlpha = 1;

    context.lineWidth = 2.5;
    context.strokeStyle = primaryColor;
    context.beginPath();
    context.moveTo(horizontalPadding, getYCoordinate(tempValues[0]));

    for (let index = 1; index < tempValues.length; index++) {
      context.lineTo(horizontalPadding + index * stepX, getYCoordinate(tempValues[index]));
    }
    context.stroke();

    context.fillStyle = primaryColor;
    tempValues.forEach((temperature, index) => {
      context.beginPath();
      context.arc(horizontalPadding + index * stepX, getYCoordinate(temperature), 3, 0, Math.PI * 2);
      context.fill();
    });
  }

  function openMobileDrawer() {
    mobileDrawer.classList.add('open');
    drawerBackdrop.classList.add('open');
  }

  function closeMobileDrawer() {
    mobileDrawer.classList.remove('open');
    drawerBackdrop.classList.remove('open');
    mobileSuggestionsBox.style.display = 'none';
  }

  function handlePlaceSelection(placeItem, isFromMobileDrawer) {
    suggestionsBox.style.display = 'none';
    mobileSuggestionsBox.style.display = 'none';
    const formattedName = formatPlaceLabel(placeItem.display_name, 2);

    if (isFromMobileDrawer) {
      mobileSearchInput.value = '';
      addOrSelectSavedLocation(placeItem.lat, placeItem.lon, formattedName);
      closeMobileDrawer();
    } else {
      searchInput.value = '';
      addOrSelectSavedLocation(placeItem.lat, placeItem.lon, formattedName);
    }
  }

  async function executeLocationSearch(inputElement, isFromMobileDrawer) {
    const queryValue = inputElement.value.trim();
    if (!queryValue) return;

    suggestionsBox.style.display = 'none';
    mobileSuggestionsBox.style.display = 'none';

    const coordinateMatch = queryValue.match(/^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/);
    if (coordinateMatch) {
      const parsedLat = Number(coordinateMatch[1]);
      const parsedLon = Number(coordinateMatch[2]);
      const placeName = await fetchReverseLocationName(parsedLat, parsedLon);
      addOrSelectSavedLocation(parsedLat, parsedLon, placeName);
      inputElement.value = '';
      if (isFromMobileDrawer) {
        closeMobileDrawer();
      }
      return;
    }

    const matchingPlaces = await fetchPlaceSuggestions(queryValue);
    if (matchingPlaces.length > 0) {
      handlePlaceSelection(matchingPlaces[0], isFromMobileDrawer);
      return;
    }

    alert('No matching locations found.');
  }

  function bindAutocompleteInput(inputElement, dropdownElement, isMobileDrawer) {
    inputElement.addEventListener('input', createDebouncedFunction(async (event) => {
      const inputText = event.target.value.trim();
      if (!inputText) {
        dropdownElement.style.display = 'none';
        return;
      }

      const places = await fetchPlaceSuggestions(inputText);
      dropdownElement.innerHTML = '';

      places.forEach((placeItem) => {
        const optionButton = document.createElement('button');
        optionButton.type = 'button';
        optionButton.textContent = formatPlaceLabel(placeItem.display_name, 3);
        optionButton.addEventListener('click', () => handlePlaceSelection(placeItem, isMobileDrawer));
        dropdownElement.appendChild(optionButton);
      });

      dropdownElement.style.display = places.length > 0 ? 'block' : 'none';
    }, 260));
  }

  function createDebouncedFunction(callback, delayMs) {
    let timeoutId;
    return (...args) => {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => callback(...args), delayMs);
    };
  }

  function handleMobileSkyScrollFade() {
    const scrollDistance = window.scrollY || document.documentElement.scrollTop || 0;
    const fadeLimit = 340;
    const calculatedOpacity = Math.max(0, 1 - scrollDistance / fadeLimit);
    document.documentElement.style.setProperty('--sky-opacity', calculatedOpacity.toFixed(3));
  }

  function toggleThemePreference() {
    const isCurrentlyLight = document.documentElement.getAttribute('data-theme') === 'light';
    if (isCurrentlyLight) {
      document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('pokeweather:theme', 'dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'light');
      localStorage.setItem('pokeweather:theme', 'light');
    }
    if (latestChartSeries) {
      drawTemperatureChart(selectElement('#chart'), latestChartSeries.times, latestChartSeries.temps);
    }
  }

  function toggleTimeFormatPreference() {
    appState.timeFormat = appState.timeFormat === '24h' ? '12h' : '24h';
    syncTimeFormatControls();
  }

  async function triggerShareForecast(event) {
    if (event) event.preventDefault();
    const shareUrl = new URL(location.href);
    if (appState.lat !== null && appState.lon !== null) {
      shareUrl.searchParams.set('lat', appState.lat);
      shareUrl.searchParams.set('lon', appState.lon);
      shareUrl.searchParams.set('name', appState.name);
    }
    try {
      if (navigator.share) {
        await navigator.share({
          title: 'PokeWeather',
          text: `${appState.name || 'Weather'}: ${selectElement('#currTemp').textContent} ${selectElement('#currDesc').textContent}`,
          url: shareUrl.toString()
        });
      } else {
        await navigator.clipboard.writeText(shareUrl.toString());
        alert('Forecast link copied to clipboard.');
      }
    } catch {}
  }

  function setupMobileSwipeGesture() {
    let touchStartX = 0;
    let touchStartY = 0;
    let startedInsideHorizontalScroll = false;

    document.addEventListener('touchstart', (event) => {
      if (event.touches.length !== 1) return;
      startedInsideHorizontalScroll = Boolean(event.target.closest('.hourly-scroll, .mobile-drawer, .mobile-insights-card'));
      touchStartX = event.touches[0].clientX;
      touchStartY = event.touches[0].clientY;
    }, { passive: true });

    document.addEventListener('touchend', (event) => {
      if (startedInsideHorizontalScroll || event.changedTouches.length !== 1) return;
      if (window.innerWidth > 768 || appState.locations.length <= 1) return;

      const deltaX = event.changedTouches[0].clientX - touchStartX;
      const deltaY = event.changedTouches[0].clientY - touchStartY;

      if (Math.abs(deltaX) > 65 && Math.abs(deltaX) > Math.abs(deltaY) * 1.4) {
        if (deltaX < 0 && appState.activeIndex < appState.locations.length - 1) {
          switchToLocationIndex(appState.activeIndex + 1);
        } else if (deltaX > 0 && appState.activeIndex > 0) {
          switchToLocationIndex(appState.activeIndex - 1);
        }
      }
    }, { passive: true });
  }

  window.addEventListener('scroll', handleMobileSkyScrollFade, { passive: true });

  window.addEventListener('resize', () => {
    if (latestChartSeries) {
      drawTemperatureChart(selectElement('#chart'), latestChartSeries.times, latestChartSeries.temps);
    }
    updateMobileSkyHeight();
  });

  unitsButton.addEventListener('click', (e) => {
    e.preventDefault();
    appState.units = appState.units === 'metric' ? 'imperial' : 'metric';
    syncUnitControls();
  });

  mobileUnitsButton.addEventListener('click', (e) => {
    e.preventDefault();
    appState.units = appState.units === 'metric' ? 'imperial' : 'metric';
    syncUnitControls();
  });

  timeFormatButton.addEventListener('click', toggleTimeFormatPreference);
  mobileTimeFormatButton.addEventListener('click', toggleTimeFormatPreference);

  themeButton.addEventListener('click', toggleThemePreference);
  mobileThemeButton.addEventListener('click', toggleThemePreference);

  shareButton.addEventListener('click', triggerShareForecast);
  mobileShareButton.addEventListener('click', triggerShareForecast);

  hamburgerButton.addEventListener('click', openMobileDrawer);
  closeDrawerButton.addEventListener('click', closeMobileDrawer);
  drawerBackdrop.addEventListener('click', closeMobileDrawer);

  geoButton.addEventListener('click', () => {
    appState.activeIndex = 0;
    saveLocationsToStorage();
    renderLocationNavigation();
    refreshDefaultCurrentLocation(false);
  });

  bindAutocompleteInput(searchInput, suggestionsBox, false);
  bindAutocompleteInput(mobileSearchInput, mobileSuggestionsBox, true);

  document.addEventListener('click', (event) => {
    if (!event.target.closest('.search-wrap')) {
      suggestionsBox.style.display = 'none';
      mobileSuggestionsBox.style.display = 'none';
    }
  });

  searchForm.addEventListener('submit', (event) => {
    event.preventDefault();
    executeLocationSearch(searchInput, false);
  });

  mobileSearchForm.addEventListener('submit', (event) => {
    event.preventDefault();
    executeLocationSearch(mobileSearchInput, true);
  });

  (function initializeApp() {
    const savedTheme = localStorage.getItem('pokeweather:theme');
    if (savedTheme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    }

    const initialUnitText = appState.units === 'metric' ? '°C' : '°F';
    unitsButton.textContent = initialUnitText;
    mobileUnitsButton.textContent = initialUnitText;
    if (hiddenUnitsInput) {
      hiddenUnitsInput.value = appState.units;
    }

    const initialTimeFormatText = appState.timeFormat === '12h' ? '12h' : '24h';
    timeFormatButton.textContent = initialTimeFormatText;
    mobileTimeFormatButton.textContent = initialTimeFormatText;

    loadStoredLocations();
    setupMobileSwipeGesture();
    setupInsightsCardInteraction();

    const urlParams = new URLSearchParams(location.search);
    const paramLat = urlParams.get('lat');
    const paramLon = urlParams.get('lon');
    const paramName = urlParams.get('name');

    if (paramLat && paramLon) {
      addOrSelectSavedLocation(Number(paramLat), Number(paramLon), paramName);
      refreshDefaultCurrentLocation(true);
      return;
    }

    if (window.__SSR__ && typeof window.__SSR__.lat === 'number' && typeof window.__SSR__.lon === 'number') {
      appState.locations[0] = {
        lat: window.__SSR__.lat,
        lon: window.__SSR__.lon,
        name: window.__SSR__.name || 'Current Location',
        isCurrent: true
      };
      saveLocationsToStorage();
    }

    renderLocationNavigation();
    const initialLocation = appState.locations[appState.activeIndex] || appState.locations[0];
    loadWeatherForCoordinates(initialLocation.lat, initialLocation.lon, initialLocation.name);
    refreshDefaultCurrentLocation(true);
  })();
</script>
</body>
</html>