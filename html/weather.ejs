  (function initializeApp() {
    applyDeviceMode();

    const savedTheme = localStorage.getItem('pokeweather:theme');
    if (savedTheme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    }

    const initialUnitText = appState.units === 'metric' ? '°C' : '°F';
    unitsButton.textContent = initialUnitText;
    if (modalUnitsButton) modalUnitsButton.textContent = initialUnitText;
    mobileUnitsButton.textContent = initialUnitText;
    if (hiddenUnitsInput) {
      hiddenUnitsInput.value = appState.units;
    }

    const initialTimeFormatText = appState.timeFormat === '12h' ? '12h' : '24h';
    timeFormatButton.textContent = initialTimeFormatText;
    mobileTimeFormatButton.textContent = initialTimeFormatText;

    const anonText = appState.anonymousMode ? 'On' : 'Off';
    anonButton.textContent = anonText;
    mobileAnonButton.textContent = anonText;
    anonButton.classList.toggle('active-toggle', appState.anonymousMode);
    mobileAnonButton.classList.toggle('active-toggle', appState.anonymousMode);

    renderPollenPreferencePickers();
    loadStoredLocations();
    setupMobileSwipeGesture();
    setupInsightsCardInteraction();

    const urlParams = new URLSearchParams(location.search);
    const paramLat = urlParams.get('lat');
    const paramLon = urlParams.get('lon');
    const paramName = urlParams.get('name');
    const paramQuery = urlParams.get('q');

    if (paramLat && paramLon) {
      addOrSelectSavedLocation(Number(paramLat), Number(paramLon), paramName);
      refreshDefaultCurrentLocation(true);
      return;
    }

    if (window.__SSR__ && typeof window.__SSR__.lat === 'number' && typeof window.__SSR__.lon === 'number') {
      if (paramQuery) {
        addOrSelectSavedLocation(window.__SSR__.lat, window.__SSR__.lon, window.__SSR__.name || paramQuery);
      } else {
        appState.locations[0] = {
          lat: window.__SSR__.lat,
          lon: window.__SSR__.lon,
          name: window.__SSR__.name || 'My Location',
          isCurrent: true
        };
        saveLocationsToStorage();
        renderLocationNavigation();
      }

      if (window.__SSR__.current && window.__SSR__.daily && window.__SSR__.hourly) {
        const activeLoc = appState.locations[appState.activeIndex] || appState.locations[0];
        appState.lat = activeLoc.lat;
        appState.lon = activeLoc.lon;
        appState.name = activeLoc.name;
        updateLocationHeading(activeLoc.name);
        renderWeatherDashboard(window.__SSR__, window.__SSR__.airQuality || null);
        if (!window.__SSR__.airQuality) {
          fetchAirQualityForCoordinates(activeLoc.lat, activeLoc.lon).then((aq) => {
            if (aq) renderWeatherDashboard(window.__SSR__, aq);
          });
        }
        refreshDefaultCurrentLocation(true);
        return;
      }
    }

    if (paramQuery) {
      fetchPlaceSuggestions(paramQuery).then((matches) => {
        if (matches.length > 0) {
          const best = matches[0];
          const label = formatPlaceLabel(best.display_name, 2);
          addOrSelectSavedLocation(best.lat, best.lon, label);
        }
      });
      refreshDefaultCurrentLocation(true);
      return;
    }

    renderLocationNavigation();
    const initialLocation = appState.locations[appState.activeIndex] || appState.locations[0];
    updateLocationHeading(initialLocation.name);
    loadWeatherForCoordinates(initialLocation.lat, initialLocation.lon, initialLocation.name, appState.activeIndex);
    refreshDefaultCurrentLocation(true);
  })();
</script>
</body>
</html>