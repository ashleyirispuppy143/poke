<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>PokeWeather</title>
<meta name="theme-color" content="#090d16" />
<meta name="color-scheme" content="dark light" />
<meta content="PokeWeather" property="og:title">
<meta content="View Weather info :3c" property="twitter:description">
<meta content="/static/poke-weather.png" property="og:image" />
<meta content="summary_large_image" name="twitter:card">
<style>
:root {
  --bg: #090d16;
  --surface: #111827;
  --surface-hover: #1f2937;
  --surface-sub: #0d131f;
  --border: #1e293b;
  --text: #f8fafc;
  --text-muted: #94a3b8;
  --accent: #38bdf8;
  --accent-dim: rgba(56, 189, 248, 0.12);
  --radius: 12px;
  --radius-sm: 8px;
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, Helvetica, Arial, sans-serif;
}

[data-theme="light"] {
  --bg: #f1f5f9;
  --surface: #ffffff;
  --surface-hover: #f8fafc;
  --surface-sub: #f8fafc;
  --border: #e2e8f0;
  --text: #0f172a;
  --text-muted: #64748b;
  --accent: #0284c7;
  --accent-dim: rgba(2, 132, 199, 0.1);
}

* {
  box-sizing: border-box;
}

html, body {
  height: 100%;
  margin: 0;
  background-color: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

header {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: var(--bg);
  border-bottom: 1px solid var(--border);
}

.header-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 12px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.brand-area {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 16px;
  letter-spacing: -0.02em;
  color: var(--text);
  text-decoration: none;
}

.brand-icon {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background-color: var(--accent-dim);
  color: var(--accent);
  display: grid;
  place-items: center;
  font-size: 15px;
}

.divider {
  width: 1px;
  height: 20px;
  background-color: var(--border);
}

.loc-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
  font-size: 14px;
  color: var(--text);
  max-width: 260px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-wrap {
  flex: 1;
  max-width: 440px;
  min-width: 240px;
  position: relative;
}

.search-form {
  display: flex;
  align-items: center;
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 2px;
  transition: border-color 0.15s;
}

.search-form:focus-within {
  border-color: var(--accent);
}

.search-form input[type="search"] {
  flex: 1;
  background: transparent;
  border: none;
  color: var(--text);
  padding: 8px 12px;
  font-size: 14px;
  outline: none;
  width: 100%;
}

.search-form input[type="search"]::placeholder {
  color: var(--text-muted);
}

.icon-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  padding: 6px 10px;
  border-radius: 6px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  transition: color 0.15s, background-color 0.15s;
}

.icon-btn:hover {
  color: var(--text);
  background-color: var(--surface-hover);
}

.suggest {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  right: 0;
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
  display: none;
  z-index: 100;
  max-height: 280px;
  overflow-y: auto;
}

.suggest button {
  display: block;
  width: 100%;
  text-align: left;
  padding: 10px 14px;
  border: none;
  border-bottom: 1px solid var(--border);
  background: transparent;
  color: var(--text);
  font-size: 13px;
  cursor: pointer;
}

.suggest button:last-child {
  border-bottom: none;
}

.suggest button:hover {
  background-color: var(--surface-hover);
}

.controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn {
  background-color: var(--surface);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 7px 12px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: background-color 0.15s, border-color 0.15s;
}

.btn:hover {
  background-color: var(--surface-hover);
}

.container {
  max-width: 1200px;
  margin: 24px auto;
  padding: 0 20px;
}

.dashboard {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 20px;
}

.card {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
}

.card-header {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  margin: 0 0 16px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col-main {
  grid-column: span 12;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.col-side {
  grid-column: span 12;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

@media (min-width: 960px) {
  .col-main {
    grid-column: span 8;
  }
  .col-side {
    grid-column: span 4;
  }
}

.hero-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 24px;
}

.hero-primary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}

.temp-display {
  display: flex;
  align-items: center;
  gap: 16px;
}

.big-icon {
  font-size: 56px;
  line-height: 1;
}

.temp-value {
  font-size: 64px;
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.condition-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: right;
}

.condition-desc {
  font-size: 20px;
  font-weight: 600;
  color: var(--text);
}

.condition-sub {
  font-size: 14px;
  color: var(--text-muted);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

@media (min-width: 640px) {
  .metrics-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.metric-item {
  background-color: var(--surface-sub);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
}

.metric-label {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 500;
  margin-bottom: 4px;
}

.metric-val {
  font-size: 16px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.hourly-scroll {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 12px;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

.hourly-scroll::-webkit-scrollbar {
  height: 6px;
}

.hourly-scroll::-webkit-scrollbar-thumb {
  background-color: var(--border);
  border-radius: 3px;
}

.hour-item {
  min-width: 72px;
  flex: 0 0 auto;
  background-color: var(--surface-sub);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  font-variant-numeric: tabular-nums;
}

.hour-time {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 500;
}

.hour-icon {
  font-size: 22px;
  line-height: 1;
}

.hour-temp {
  font-size: 15px;
  font-weight: 700;
}

.hour-pop {
  font-size: 11px;
  font-weight: 600;
  color: var(--accent);
}

.chart-wrap {
  margin-top: 12px;
  height: 120px;
  width: 100%;
  position: relative;
}

canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.daily-list {
  display: flex;
  flex-direction: column;
}

.day-row {
  display: grid;
  grid-template-columns: 1.1fr 36px 1.2fr 0.9fr;
  align-items: center;
  gap: 8px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
  font-variant-numeric: tabular-nums;
}

.day-row:first-child {
  padding-top: 0;
}

.day-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.day-name {
  font-weight: 600;
  color: var(--text);
}

.day-icon {
  font-size: 20px;
  text-align: center;
}

.day-cond {
  font-size: 13px;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.day-temps {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  font-size: 14px;
}

.day-hi {
  font-weight: 700;
}

.day-lo {
  color: var(--text-muted);
  min-width: 28px;
  text-align: right;
}

footer {
  max-width: 1200px;
  margin: 40px auto 20px;
  padding: 20px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--text-muted);
  font-size: 13px;
  flex-wrap: wrap;
  gap: 12px;
}

footer a {
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.15s;
}

footer a:hover {
  color: var(--text);
}

.hidden {
  display: none !important;
}

.loading {
  opacity: 0.6;
  pointer-events: none;
}

.ssr {
  display: none;
}

main {
  display: block;
}
</style>

<noscript>
  <style>
    .ssr { display: block !important; }
    main { display: none !important; }
  </style>
</noscript>
</head>
<body class="<%= ssr && ssr.forceNoJS ? 'no-js' : '' %>">

  <header>
    <div class="header-inner">
      <div class="brand-area">
        <a href="/weather" class="brand">
          <div class="brand-icon" aria-hidden="true">☁️</div>
          <span>PokeWeather</span>
        </a>
        <div class="divider"></div>
        <div class="loc-badge" id="locChip"><%= (ssr && ssr.name) || 'Select Location' %></div>
      </div>

      <div class="search-wrap">
        <form class="search-form" role="search" aria-label="Search location" action="/weather" method="GET" id="searchForm">
          <input id="q" name="q" type="search" placeholder="Search city, postal code, or lat,lon..." autocomplete="off" />
          <input type="hidden" name="units" id="unitsHidden" value="<%= (ssr && ssr.units) || 'metric' %>"/>
          <button id="btnGeo" class="icon-btn" type="button" title="Use current location">📍</button>
          <button id="btnSearch" class="icon-btn" type="submit" title="Search">Search</button>
        </form>
        <div id="suggest" class="suggest" role="listbox" aria-label="Suggestions"></div>
      </div>

      <div class="controls">
        <button id="btnUnits" class="btn" title="Toggle °C/°F">°C</button>
        <button id="btnTheme" class="btn" title="Toggle theme">🌗</button>
        <button id="btnInstall" class="btn hidden" title="Install App">Install</button>
        <a class="btn" href="#" id="btnShare" title="Share Forecast">Share</a>
      </div>
    </div>
  </header>

  <section class="ssr container">
    <div class="dashboard">
      <div class="col-main">
        <article class="card hero-card" aria-live="polite">
          <div class="card-header">Current Weather — <%= (ssr && ssr.name) || 'Unknown' %></div>
          <% if (ssr && ssr.current) { %>
            <div class="hero-primary">
              <div class="temp-display">
                <div class="big-icon"><%= ssr.icon %></div>
                <div class="temp-value"><%= Math.round(ssr.current.temperature_2m) %>°</div>
              </div>
              <div class="condition-meta">
                <div class="condition-desc"><%= ssr.desc %></div>
                <div class="condition-sub">Feels like <%= Math.round(ssr.current.apparent_temperature) %>°</div>
              </div>
            </div>
            <div class="metrics-grid">
              <div class="metric-item"><div class="metric-label">Wind</div><div class="metric-val"><%= Math.round(ssr.current.wind_speed_10m) %> <%= ssr.windUnit %></div></div>
              <div class="metric-item"><div class="metric-label">Humidity</div><div class="metric-val"><%= Math.round(ssr.current.relative_humidity_2m) %>%</div></div>
              <div class="metric-item"><div class="metric-label">Pressure</div><div class="metric-val"><%= Math.round(ssr.current.pressure_msl) %> hPa</div></div>
              <div class="metric-item"><div class="metric-label">Precip Prob</div><div class="metric-val"><%= ssr.popNext ?? '—' %>%</div></div>
              <div class="metric-item"><div class="metric-label">Sunrise</div><div class="metric-val"><%= ssr.sunriseLocal %></div></div>
              <div class="metric-item"><div class="metric-label">Sunset</div><div class="metric-val"><%= ssr.sunsetLocal %></div></div>
              <div class="metric-item"><div class="metric-label">UV Index</div><div class="metric-val"><%= ssr.daily.uv_index_max?.[0] ?? '—' %></div></div>
              <div class="metric-item"><div class="metric-label">Feels Like</div><div class="metric-val"><%= Math.round(ssr.current.apparent_temperature) %>°</div></div>
            </div>
          <% } else { %>
            <p style="color:var(--text-muted);margin:0;">No weather data available.</p>
          <% } %>
        </article>
      </div>

      <div class="col-side">
        <article class="card">
          <h3 class="card-header">7-Day Forecast</h3>
          <% if (ssr && ssr.daily) { %>
            <div class="daily-list">
              <% for (let i=0; i<ssr.daily.time.length; i++) { %>
                <div class="day-row">
                  <div class="day-name"><%= ssr.dailyLabels[i] %></div>
                  <div class="day-icon"><%= ssr.dailyIcons[i] %></div>
                  <div class="day-cond"><%= ssr.dailyTexts[i] %></div>
                  <div class="day-temps">
                    <span class="day-hi"><%= Math.round(ssr.daily.temperature_2m_max[i]) %>°</span>
                    <span class="day-lo"><%= Math.round(ssr.daily.temperature_2m_min[i]) %>°</span>
                  </div>
                </div>
              <% } %>
            </div>
          <% } %>
        </article>
      </div>
    </div>
  </section>

  <main class="container">
    <div class="dashboard">
      <div class="col-main">
        <article id="now" class="card hero-card current" aria-live="polite">
          <div class="card-header">
            <span>Current Conditions</span>
            <span id="currFeelHeader"></span>
          </div>
          <div class="hero-primary">
            <div class="temp-display">
              <div class="big-icon" id="currIcon">—</div>
              <div class="temp-value" id="currTemp">—</div>
            </div>
            <div class="condition-meta">
              <div class="condition-desc" id="currDesc">—</div>
              <div class="condition-sub">Feels like <span id="currFeels">—</span></div>
            </div>
          </div>
          <div class="metrics-grid">
            <div class="metric-item"><div class="metric-label">Wind</div><div class="metric-val" id="currWind">—</div></div>
            <div class="metric-item"><div class="metric-label">Humidity</div><div class="metric-val" id="currHum">—</div></div>
            <div class="metric-item"><div class="metric-label">Pressure</div><div class="metric-val" id="currPress">—</div></div>
            <div class="metric-item"><div class="metric-label">Precip (Next Hr)</div><div class="metric-val" id="pop">—</div></div>
            <div class="metric-item"><div class="metric-label">Sunrise</div><div class="metric-val" id="sunrise">—</div></div>
            <div class="metric-item"><div class="metric-label">Sunset</div><div class="metric-val" id="sunset">—</div></div>
            <div class="metric-item"><div class="metric-label">Max UV Index</div><div class="metric-val" id="uv">—</div></div>
            <div class="metric-item"><div class="metric-label">Visibility / Mode</div><div class="metric-val" id="dayMode">—</div></div>
          </div>
        </article>

        <section id="hourly" class="card">
          <h3 class="card-header">Hourly Forecast (24h)</h3>
          <div id="hours" class="hourly-scroll" aria-label="Hourly forecast"></div>
          <div class="chart-wrap">
            <canvas id="chart" aria-label="Temperature trend chart" role="img"></canvas>
          </div>
        </section>
      </div>

      <div class="col-side">
        <section id="daily" class="card">
          <h3 class="card-header">7-Day Forecast</h3>
          <div id="days" class="daily-list"></div>
        </section>
      </div>
    </div>
  </main>

  <footer>
    <div>PokeWeather</div>
    <div style="display:flex;gap:16px;">
      <a href="/privacy">Privacy Policy</a>
      <a href="https://open-meteo.com/" target="_blank" rel="noopener">Weather data by Open-Meteo</a>
    </div>
  </footer>
    
