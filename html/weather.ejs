<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>PokeWeather</title>
<meta name="theme-color" content="#111318" />
<meta name="color-scheme" content="dark light" />
<meta content="PokeWeather" property="og:title">
<meta content="View Weather info :3c" property="twitter:description">
<meta content="/static/poke-weather.png" property="og:image" />
<meta content="summary_large_image" name="twitter:card">
<style>
:root {
  --md-bg: #111318;
  --md-surface: #1d2026;
  --md-surface-high: #282a31;
  --md-surface-highest: #33353c;
  --md-primary: #a8c7fa;
  --md-on-primary: #062e6f;
  --md-primary-container: #284777;
  --md-on-primary-container: #d6e3ff;
  --md-text: #e2e2e9;
  --md-text-muted: #c4c6d0;
  --md-outline: #44474e;
  --radius-xl: 28px;
  --radius-lg: 20px;
  --radius-pill: 999px;
  --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --sky-opacity: 1;
}

[data-theme="light"] {
  --md-bg: #f8f9ff;
  --md-surface: #ecedf4;
  --md-surface-high: #e1e2e9;
  --md-surface-highest: #d5d7de;
  --md-primary: #2b5bb5;
  --md-on-primary: #ffffff;
  --md-primary-container: #d6e3ff;
  --md-on-primary-container: #001b3e;
  --md-text: #191c20;
  --md-text-muted: #44474e;
  --md-outline: #c4c6d0;
}

* {
  box-sizing: border-box;
}

html, body {
  min-height: 100%;
  margin: 0;
  background-color: var(--md-bg);
  color: var(--md-text);
  font-family: var(--font-sans);
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.mobile-sky {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: var(--sky-opacity);
  transition: background 0.6s ease;
  overflow: hidden;
}

.mobile-sky[data-sky="clear-day"] {
  background: linear-gradient(180deg, #1b65c4 0%, #5899e2 55%, var(--md-bg) 100%);
}

.mobile-sky[data-sky="clear-night"] {
  background: linear-gradient(180deg, #070b19 0%, #162238 60%, var(--md-bg) 100%);
}

.mobile-sky[data-sky="cloudy-day"] {
  background: linear-gradient(180deg, #3d526b 0%, #637994 55%, var(--md-bg) 100%);
}

.mobile-sky[data-sky="cloudy-night"] {
  background: linear-gradient(180deg, #121824 0%, #242f40 60%, var(--md-bg) 100%);
}

.mobile-sky[data-sky="rain-day"],
.mobile-sky[data-sky="rain-night"] {
  background: linear-gradient(180deg, #182334 0%, #2b394f 55%, var(--md-bg) 100%);
}

.mobile-sky[data-sky="snow-day"],
.mobile-sky[data-sky="snow-night"] {
  background: linear-gradient(180deg, #3a4b63 0%, #6b7d96 55%, var(--md-bg) 100%);
}

.mobile-sky[data-sky="storm-day"],
.mobile-sky[data-sky="storm-night"] {
  background: linear-gradient(180deg, #11101d 0%, #2a243b 60%, var(--md-bg) 100%);
}

.sky-celestial {
  position: absolute;
  top: 76px;
  left: 50%;
  transform: translateX(-50%);
  width: 130px;
  height: 130px;
  border-radius: 50%;
  transition: all 0.6s ease;
}

.mobile-sky[data-sky="clear-day"] .sky-celestial {
  background: radial-gradient(circle, #fff5c0 0%, #fde047 45%, rgba(251, 191, 36, 0) 72%);
  box-shadow: 0 0 90px 30px rgba(253, 224, 71, 0.38);
}

.mobile-sky[data-sky="clear-night"] .sky-celestial {
  width: 88px;
  height: 88px;
  top: 88px;
  background: radial-gradient(circle, #f8fafc 0%, #cbd5e1 65%, rgba(203, 213, 225, 0) 72%);
  box-shadow: 0 0 60px 16px rgba(226, 232, 240, 0.22);
}

.mobile-sky[data-sky="cloudy-day"] .sky-celestial {
  background: radial-gradient(circle, rgba(255, 255, 255, 0.65) 0%, rgba(226, 232, 240, 0) 70%);
  filter: blur(8px);
}

.sky-stars {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.6s ease;
  background-image:
    radial-gradient(1.5px 1.5px at 18% 14%, #ffffff 100%, transparent),
    radial-gradient(1px 1px at 76% 22%, #ffffff 100%, transparent),
    radial-gradient(2px 2px at 38% 8%, #ffffff 100%, transparent),
    radial-gradient(1.5px 1.5px at 84% 11%, #ffffff 100%, transparent),
    radial-gradient(1px 1px at 12% 32%, #ffffff 100%, transparent),
    radial-gradient(1.5px 1.5px at 62% 28%, #ffffff 100%, transparent);
}

.mobile-sky[data-sky="clear-night"] .sky-stars,
.mobile-sky[data-sky="cloudy-night"] .sky-stars {
  opacity: 0.75;
}

.sky-clouds {
  position: absolute;
  top: 60px;
  left: -10%;
  right: -10%;
  height: 180px;
  opacity: 0;
  transition: opacity 0.6s ease;
  background:
    radial-gradient(ellipse 160px 55px at 30% 60%, rgba(255, 255, 255, 0.22), transparent 70%),
    radial-gradient(ellipse 200px 65px at 70% 45%, rgba(255, 255, 255, 0.18), transparent 70%);
}

.mobile-sky[data-sky^="cloudy"] .sky-clouds,
.mobile-sky[data-sky^="rain"] .sky-clouds,
.mobile-sky[data-sky^="storm"] .sky-clouds {
  opacity: 1;
}

.sky-precip {
  position: absolute;
  inset: -40px 0 0 0;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.mobile-sky[data-sky^="rain"] .sky-precip,
.mobile-sky[data-sky^="storm"] .sky-precip {
  opacity: 0.45;
  background-image: repeating-linear-gradient(
    105deg,
    transparent 0px,
    transparent 28px,
    rgba(186, 230, 253, 0.45) 28px,
    rgba(186, 230, 253, 0.45) 30px
  );
  background-size: 120px 120px;
  animation: rainfall 0.65s linear infinite;
}

.mobile-sky[data-sky^="snow"] .sky-precip {
  opacity: 0.65;
  background-image:
    radial-gradient(3px 3px at 20% 30%, #ffffff 90%, transparent),
    radial-gradient(4px 4px at 70% 10%, #ffffff 90%, transparent),
    radial-gradient(2.5px 2.5px at 40% 70%, #ffffff 90%, transparent),
    radial-gradient(3.5px 3.5px at 85% 55%, #ffffff 90%, transparent);
  background-size: 160px 160px;
  animation: snowfall 3.5s linear infinite;
}

@keyframes rainfall {
  from { transform: translateY(0); }
  to { transform: translateY(40px); }
}

@keyframes snowfall {
  from { transform: translateY(0); }
  to { transform: translateY(160px); }
}

header {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: color-mix(in srgb, var(--md-bg) 82%, transparent);
  backdrop-filter: blur(16px);
}

.header-inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 12px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
}

.brand-area {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand {
  font-weight: 700;
  font-size: 18px;
  letter-spacing: -0.02em;
  color: var(--md-text);
  text-decoration: none;
}

.loc-badge {
  background-color: var(--md-primary-container);
  color: var(--md-on-primary-container);
  padding: 6px 14px;
  border-radius: var(--radius-pill);
  font-weight: 600;
  font-size: 13px;
  max-width: 240px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-wrap {
  flex: 1;
  max-width: 460px;
  min-width: 240px;
  position: relative;
}

.search-form {
  display: flex;
  align-items: center;
  background-color: var(--md-surface-high);
  border-radius: var(--radius-pill);
  padding: 4px 6px 4px 16px;
  border: 1px solid transparent;
  transition: background-color 0.2s, border-color 0.2s;
}

.search-form:focus-within {
  background-color: var(--md-surface-highest);
  border-color: var(--md-primary);
}

.search-form input[type="search"] {
  flex: 1;
  background: transparent;
  border: none;
  color: var(--md-text);
  padding: 8px 6px;
  font-size: 14px;
  outline: none;
  width: 100%;
}

.search-form input[type="search"]::placeholder {
  color: var(--md-text-muted);
}

.pill-btn {
  background-color: transparent;
  border: none;
  color: var(--md-text-muted);
  padding: 7px 13px;
  border-radius: var(--radius-pill);
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  transition: background-color 0.15s, color 0.15s;
}

.pill-btn:hover {
  background-color: var(--md-surface-highest);
  color: var(--md-text);
}

.suggest {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  background-color: var(--md-surface-high);
  border-radius: var(--radius-lg);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.38);
  display: none;
  z-index: 100;
  max-height: 300px;
  overflow-y: auto;
  padding: 6px;
}

.suggest button {
  display: block;
  width: 100%;
  text-align: left;
  padding: 11px 14px;
  border: none;
  border-radius: 14px;
  background: transparent;
  color: var(--md-text);
  font-size: 14px;
  cursor: pointer;
  transition: background-color 0.15s;
}

.suggest button:hover {
  background-color: var(--md-surface-highest);
}

.controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn {
  background-color: var(--md-surface-high);
  border: none;
  color: var(--md-text);
  padding: 9px 16px;
  border-radius: var(--radius-pill);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: background-color 0.15s;
}

.btn:hover {
  background-color: var(--md-surface-highest);
}

.container {
  position: relative;
  z-index: 1;
  max-width: 1180px;
  margin: 20px auto;
  padding: 0 20px;
}

.dashboard {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 20px;
}

.card {
  background-color: var(--md-surface);
  border-radius: var(--radius-xl);
  padding: 24px;
}

.card-header {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--md-text-muted);
  margin: 0 0 18px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col-main {
  grid-column: span 12;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.col-side {
  grid-column: span 12;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

@media (min-width: 940px) {
  .col-main {
    grid-column: span 8;
  }
  .col-side {
    grid-column: span 4;
  }
}

.hero-card {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.hero-primary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}

.mobile-loc-title {
  display: none;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.temp-display {
  display: flex;
  align-items: center;
  gap: 18px;
}

.big-icon {
  font-size: 56px;
  line-height: 1;
}

.temp-value {
  font-size: 72px;
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.condition-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: right;
}

.condition-desc {
  font-size: 22px;
  font-weight: 600;
  color: var(--md-text);
}

.condition-sub {
  font-size: 14px;
  color: var(--md-text-muted);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

@media (min-width: 640px) {
  .metrics-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.metric-item {
  background-color: var(--md-surface-high);
  border-radius: var(--radius-lg);
  padding: 16px;
}

.metric-label {
  font-size: 12px;
  color: var(--md-text-muted);
  font-weight: 500;
  margin-bottom: 6px;
}

.metric-val {
  font-size: 17px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.hourly-scroll {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding-bottom: 12px;
  scrollbar-width: thin;
  scrollbar-color: var(--md-outline) transparent;
}

.hour-item {
  min-width: 76px;
  flex: 0 0 auto;
  background-color: var(--md-surface-high);
  border-radius: var(--radius-pill);
  padding: 16px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  font-variant-numeric: tabular-nums;
}

.hour-time {
  font-size: 12px;
  color: var(--md-text-muted);
  font-weight: 500;
}

.hour-icon {
  font-size: 22px;
  line-height: 1;
}

.hour-temp {
  font-size: 15px;
  font-weight: 700;
}

.hour-pop {
  font-size: 11px;
  font-weight: 600;
  color: var(--md-primary);
}

.chart-wrap {
  margin-top: 14px;
  height: 120px;
  width: 100%;
  position: relative;
}

canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.daily-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.day-row {
  display: grid;
  grid-template-columns: 1.1fr 36px 1.2fr 0.9fr;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background-color: var(--md-surface-high);
  border-radius: var(--radius-lg);
  font-variant-numeric: tabular-nums;
}

.day-name {
  font-weight: 600;
  color: var(--md-text);
}

.day-icon {
  font-size: 20px;
  text-align: center;
}

.day-cond {
  font-size: 13px;
  color: var(--md-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.day-temps {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  font-size: 14px;
}

.day-hi {
  font-weight: 700;
}

.day-lo {
  color: var(--md-text-muted);
  min-width: 28px;
  text-align: right;
}

footer {
  position: relative;
  z-index: 1;
  max-width: 1180px;
  margin: 36px auto 24px;
  padding: 16px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--md-text-muted);
  font-size: 13px;
  flex-wrap: wrap;
  gap: 12px;
}

footer a {
  color: var(--md-text-muted);
  text-decoration: none;
}

footer a:hover {
  color: var(--md-text);
}

.hidden {
  display: none !important;
}

.loading {
  opacity: 0.6;
  pointer-events: none;
}

.ssr {
  display: none;
}

main {
  display: block;
}

@media (max-width: 768px) {
  .mobile-sky {
    display: block;
  }

  header {
    background-color: transparent;
    backdrop-filter: none;
  }

  .loc-badge {
    display: none;
  }

  .hero-card {
    background: transparent;
    padding: 8px 4px 16px;
  }

  .hero-card .card-header {
    display: none;
  }

  .hero-primary {
    min-height: 46vh;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 10px;
  }

  .mobile-loc-title {
    display: block;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .temp-display {
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }

  .big-icon {
    font-size: 64px;
  }

  .temp-value {
    font-size: 88px;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .condition-meta {
    text-align: center;
    align-items: center;
  }

  .metric-item,
  .card:not(.hero-card) {
    background-color: color-mix(in srgb, var(--md-surface) 88%, transparent);
    backdrop-filter: blur(16px);
  }
}
</style>

<noscript>
  <style>
    .ssr { display: block !important; }
    main { display: none !important; }
  </style>
</noscript>
</head>
<body class="<%= ssr && ssr.forceNoJS ? 'no-js' : '' %>">

  <div id="mobileSky" class="mobile-sky" data-sky="clear-day" aria-hidden="true">
    <div class="sky-stars"></div>
    <div class="sky-celestial"></div>
    <div class="sky-clouds"></div>
    <div class="sky-precip"></div>
  </div>

  <header>
    <div class="header-inner">
      <div class="brand-area">
        <a href="/weather" class="brand">PokeWeather</a>
        <div class="loc-badge" id="locChip"><%= (ssr && ssr.name) || 'Select Location' %></div>
      </div>

      <div class="search-wrap">
        <form class="search-form" role="search" aria-label="Search location" action="/weather" method="GET" id="searchForm">
          <input id="q" name="q" type="search" placeholder="Search city, place, or coordinates..." autocomplete="off" />
          <input type="hidden" name="units" id="unitsHidden" value="<%= (ssr && ssr.units) || 'metric' %>"/>
          <button id="btnGeo" class="pill-btn" type="button" title="Use current location">Locate</button>
          <button id="btnSearch" class="pill-btn" type="submit" title="Search">Search</button>
        </form>
        <div id="suggest" class="suggest" role="listbox" aria-label="Suggestions"></div>
      </div>

      <div class="controls">
        <button id="btnUnits" class="btn" title="Toggle °C/°F">°C</button>
        <button id="btnTheme" class="btn" title="Toggle theme">Theme</button>
        <button id="btnInstall" class="btn hidden" title="Install App">Install</button>
        <a class="btn" href="#" id="btnShare" title="Share Forecast">Share</a>
      </div>
    </div>
  </header>

  <section class="ssr container">
    <div class="dashboard">
      <div class="col-main">
        <article class="card hero-card" aria-live="polite">
          <div class="card-header">Current Weather — <%= (ssr && ssr.name) || 'Unknown' %></div>
          <% if (ssr && ssr.current) { %>
            <div class="hero-primary">
              <div class="temp-display">
                <div class="big-icon"><%= ssr.icon %></div>
                <div class="temp-value"><%= Math.round(ssr.current.temperature_2m) %>°</div>
              </div>
              <div class="condition-meta">
                <div class="condition-desc"><%= ssr.desc %></div>
                <div class="condition-sub">Feels like <%= Math.round(ssr.current.apparent_temperature) %>°</div>
              </div>
            </div>
            <div class="metrics-grid">
              <div class="metric-item"><div class="metric-label">Wind</div><div class="metric-val"><%= Math.round(ssr.current.wind_speed_10m) %> <%= ssr.windUnit %></div></div>
              <div class="metric-item"><div class="metric-label">Humidity</div><div class="metric-val"><%= Math.round(ssr.current.relative_humidity_2m) %>%</div></div>
              <div class="metric-item"><div class="metric-label">Pressure</div><div class="metric-val"><%= Math.round(ssr.current.pressure_msl) %> hPa</div></div>
              <div class="metric-item"><div class="metric-label">Precip Prob</div><div class="metric-val"><%= ssr.popNext ?? '—' %>%</div></div>
              <div class="metric-item"><div class="metric-label">Sunrise</div><div class="metric-val"><%= ssr.sunriseLocal %></div></div>
              <div class="metric-item"><div class="metric-label">Sunset</div><div class="metric-val"><%= ssr.sunsetLocal %></div></div>
              <div class="metric-item"><div class="metric-label">UV Index</div><div class="metric-val"><%= ssr.daily.uv_index_max?.[0] ?? '—' %></div></div>
              <div class="metric-item"><div class="metric-label">Feels Like</div><div class="metric-val"><%= Math.round(ssr.current.apparent_temperature) %>°</div></div>
            </div>
          <% } else { %>
            <p style="color:var(--md-text-muted);margin:0;">No weather data available.</p>
          <% } %>
        </article>
      </div>

      <div class="col-side">
        <article class="card">
          <h3 class="card-header">7-Day Forecast</h3>
          <% if (ssr && ssr.daily) { %>
            <div class="daily-list">
              <% for (let i=0; i<ssr.daily.time.length; i++) { %>
                <div class="day-row">
                  <div class="day-name"><%= ssr.dailyLabels[i] %></div>
                  <div class="day-icon"><%= ssr.dailyIcons[i] %></div>
                  <div class="day-cond"><%= ssr.dailyTexts[i] %></div>
                  <div class="day-temps">
                    <span class="day-hi"><%= Math.round(ssr.daily.temperature_2m_max[i]) %>°</span>
                    <span class="day-lo"><%= Math.round(ssr.daily.temperature_2m_min[i]) %>°</span>
                  </div>
                </div>
              <% } %>
            </div>
          <% } %>
        </article>
      </div>
    </div>
  </section>

  <main class="container">
    <div class="dashboard">
      <div class="col-main">
        <article id="now" class="card hero-card current" aria-live="polite">
          <div class="card-header">
            <span>Current Conditions</span>
            <span id="currFeelHeader"></span>
          </div>
          <div class="hero-primary">
            <div class="mobile-loc-title" id="mobileLocTitle">Select Location</div>
            <div class="temp-display">
              <div class="big-icon" id="currIcon">—</div>
              <div class="temp-value" id="currTemp">—</div>
            </div>
            <div class="condition-meta">
              <div class="condition-desc" id="currDesc">—</div>
              <div class="condition-sub">Feels like <span id="currFeels">—</span></div>
            </div>
          </div>
          <div class="metrics-grid">
            <div class="metric-item"><div class="metric-label">Wind</div><div class="metric-val" id="currWind">—</div></div>
            <div class="metric-item"><div class="metric-label">Humidity</div><div class="metric-val" id="currHum">—</div></div>
            <div class="metric-item"><div class="metric-label">Pressure</div><div class="metric-val" id="currPress">—</div></div>
            <div class="metric-item"><div class="metric-label">Precip (1h)</div><div class="metric-val" id="pop">—</div></div>
            <div class="metric-item"><div class="metric-label">Sunrise</div><div class="metric-val" id="sunrise">—</div></div>
            <div class="metric-item"><div class="metric-label">Sunset</div><div class="metric-val" id="sunset">—</div></div>
            <div class="metric-item"><div class="metric-label">Max UV</div><div class="metric-val" id="uv">—</div></div>
            <div class="metric-item"><div class="metric-label">Cycle</div><div class="metric-val" id="dayMode">—</div></div>
          </div>
        </article>

        <section id="hourly" class="card">
          <h3 class="card-header">24-Hour Outlook</h3>
          <div id="hours" class="hourly-scroll" aria-label="Hourly forecast"></div>
          <div class="chart-wrap">
            <canvas id="chart" aria-label="Temperature trend chart" role="img"></canvas>
          </div>
        </section>
      </div>

      <div class="col-side">
        <section id="daily" class="card">
          <h3 class="card-header">7-Day Forecast</h3>
          <div id="days" class="daily-list"></div>
        </section>
      </div>
    </div>
  </main>

  <footer>
    <div>PokeWeather</div>
    <div style="display:flex;gap:16px;">
      <a href="/privacy">Privacy Policy</a>
      <a href="https://open-meteo.com/" target="_blank" rel="noopener">Data: Open-Meteo</a>
    </div>
  </footer>
    
