<%
  const ssrSafe = (typeof ssr !== 'undefined' && ssr) ? ssr : {};
  const ssrCurrent = ssrSafe.current || null;
  const ssrDaily = ssrSafe.daily || null;
  const ssrHourly = ssrSafe.hourly || null;
  const ssrAq = ssrSafe.airQuality || null;
  const ssrUnits = ssrSafe.units === 'imperial' ? 'imperial' : 'metric';
  const ssrTempSymbol = ssrUnits === 'imperial' ? '°F' : '°C';
  const ssrWindSymbol = ssrSafe.windUnit || (ssrUnits === 'imperial' ? 'mph' : 'km/h');
  const ssrAnon = Boolean(ssrSafe.anon);
  const ssrTimeFormat = ssrSafe.tf === '12h' ? '12h' : '24h';
  const ssrRawName = ssrSafe.name || 'Choose a location';
  const ssrDisplayName = ssrAnon ? 'My Location' : ssrRawName;

  const ssrWeatherMap = {
    0: 'Clear sky',
    1: 'Mostly clear',
    2: 'Partly cloudy',
    3: 'Overcast',
    45: 'Fog',
    48: 'Rime fog',
    51: 'Light drizzle',
    53: 'Drizzle',
    55: 'Dense drizzle',
    56: 'Freezing drizzle',
    57: 'Heavy freezing drizzle',
    61: 'Slight rain',
    63: 'Rain',
    65: 'Heavy rain',
    66: 'Freezing rain',
    67: 'Heavy freezing rain',
    71: 'Slight snow',
    73: 'Snow',
    75: 'Heavy snow',
    77: 'Snow grains',
    80: 'Rain showers',
    81: 'Moderate showers',
    82: 'Heavy showers',
    85: 'Snow showers',
    86: 'Heavy snow showers',
    95: 'Thunderstorm',
    96: 'Storm with hail',
    99: 'Severe hailstorm'
  };

  function getSsrDesc(code) {
    return ssrWeatherMap[code] || '-';
  }

  function getSsrIcon(code, isDay) {
    if (code === 0) return isDay ? '☀️' : '🌙';
    if (code === 1 || code === 2) return isDay ? '🌤️' : '☁️';
    if (code === 3) return '☁️';
    if (code === 45 || code === 48) return '🌫️';
    if ([51, 53, 55, 80, 81, 82].includes(code)) return '🌦️';
    if ([61, 63, 65].includes(code)) return '🌧️';
    if ([66, 67].includes(code)) return '🌧️❄️';
    if ([71, 73, 75, 77, 85, 86].includes(code)) return '❄️';
    if ([95, 96, 99].includes(code)) return '⛈️';
    return '☁️';
  }

  function getSsrSky(code, isDay) {
    const suffix = isDay ? 'day' : 'night';
    if (code === 0 || code === 1) return 'clear-' + suffix;
    if ([2, 3, 45, 48].includes(code)) return 'cloudy-' + suffix;
    if ([51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(code)) return 'rain-' + suffix;
    if ([71, 73, 75, 77, 85, 86].includes(code)) return 'snow-' + suffix;
    if ([95, 96, 99].includes(code)) return 'storm-' + suffix;
    return 'clear-' + suffix;
  }

  function isSsrPrecip(code) {
    return [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 71, 73, 75, 77, 80, 81, 82, 85, 86, 95, 96, 99].includes(code);
  }

  function formatSsrClock(isoStr) {
    if (!isoStr) return '-';
    const d = new Date(isoStr);
    if (Number.isNaN(d.getTime())) return String(isoStr);
    const use12 = ssrTimeFormat === '12h';
    return d.toLocaleTimeString([], {
      hour: '2-digit',
      minute: '2-digit',
      hour12: use12,
      hourCycle: use12 ? 'h12' : 'h23'
    });
  }

  function getSsrAqiShort(aqi) {
    if (aqi === null || aqi === undefined) return 'low';
    if (aqi <= 50) return 'low';
    if (aqi <= 100) return 'moderate';
    if (aqi <= 150) return 'sensitive';
    if (aqi <= 200) return 'high';
    if (aqi <= 300) return 'very high';
    return 'hazardous';
  }

  function getSsrAqiColor(aqi) {
    if (aqi === null || aqi === undefined) return '#4ade80';
    if (aqi <= 50) return '#4ade80';
    if (aqi <= 100) return '#facc15';
    if (aqi <= 150) return '#fb923c';
    if (aqi <= 200) return '#f87171';
    if (aqi <= 300) return '#c084fc';
    return '#e11d48';
  }

  function getSsrPollenStage(val) {
    if (val === null || val === undefined || Number.isNaN(Number(val)) || Number(val) <= 0) return 'NONE';
    const v = Number(val);
    if (v <= 10) return 'LOW';
    if (v <= 50) return 'MOD';
    if (v <= 200) return 'HIGH';
    return 'V.HIGH';
  }

  const ssrAqiVal = ssrAq && ssrAq.usAqi != null ? Math.round(ssrAq.usAqi) : null;
  const ssrAqiShort = getSsrAqiShort(ssrAqiVal);
  const ssrAqiColor = getSsrAqiColor(ssrAqiVal);
  const ssrAqiFillWidth = ssrAqiVal !== null ? Math.max(6, Math.min(100, Math.round((ssrAqiVal / 200) * 100))) : 0;

  const ssrPb = (ssrAq && ssrAq.pollenBreakdown) ? ssrAq.pollenBreakdown : {};
  const ssrTreeVal = Math.max(Number(ssrPb.birch ?? 0), Number(ssrPb.alder ?? 0), Number(ssrPb.olive ?? 0));
  const ssrGrassVal = Number(ssrPb.grass ?? 0);
  const ssrWeedVal = Math.max(Number(ssrPb.ragweed ?? 0), Number(ssrPb.mugwort ?? 0));

  const ssrTopPollens = [
    { key: 'tree', name: 'Tree', val: ssrTreeVal, stage: getSsrPollenStage(ssrTreeVal), active: ssrTreeVal > 0 },
    { key: 'grass', name: 'Grass', val: ssrGrassVal, stage: getSsrPollenStage(ssrGrassVal), active: ssrGrassVal > 0 },
    { key: 'weed', name: 'Weed', val: ssrWeedVal, stage: getSsrPollenStage(ssrWeedVal), active: ssrWeedVal > 0 }
  ];

  const ssrIsDay = ssrCurrent ? Boolean(ssrCurrent.is_day ?? 1) : true;
  const ssrSkyVariant = ssrCurrent ? getSsrSky(ssrCurrent.weather_code, ssrIsDay) : 'clear-day';
  const ssrHeroIcon = ssrSafe.icon || (ssrCurrent ? getSsrIcon(ssrCurrent.weather_code, ssrIsDay) : '-');
  const ssrHeroDesc = ssrSafe.desc || (ssrCurrent ? getSsrDesc(ssrCurrent.weather_code) : '-');

  let ssrSliceStart = 0;
  if (ssrHourly && Array.isArray(ssrHourly.time)) {
    const foundIdx = ssrHourly.time.findIndex((t) => Date.parse(t) > Date.now());
    ssrSliceStart = foundIdx > 0 ? foundIdx - 1 : 0;
  }
  const ssrSliceEnd = (ssrHourly && Array.isArray(ssrHourly.time)) ? Math.min(ssrSliceStart + 24, ssrHourly.time.length) : 0;

  let ssrOutlookSummary = '-';
  if (ssrCurrent && ssrDaily) {
    const currentCode = ssrCurrent.weather_code;
    const currentDesc = getSsrDesc(currentCode);
    const next12Codes = (ssrHourly && Array.isArray(ssrHourly.weather_code))
      ? ssrHourly.weather_code.slice(ssrSliceStart, ssrSliceStart + 12)
      : [currentCode];
    const next12Pops = (ssrHourly && Array.isArray(ssrHourly.precipitation_probability))
      ? ssrHourly.precipitation_probability.slice(ssrSliceStart, ssrSliceStart + 12)
      : [];

    let narrative = '';
    if (isSsrPrecip(currentCode)) {
      const dryOffset = next12Codes.findIndex((c, idx) => idx > 0 && !isSsrPrecip(c));
      if (dryOffset !== -1 && dryOffset <= 6 && ssrHourly && ssrHourly.time) {
        narrative = currentDesc + ' right now, tapering off around ' + formatSsrClock(ssrHourly.time[ssrSliceStart + dryOffset]);
      } else {
        narrative = currentDesc + ' continuing for the next several hours';
      }
    } else {
      const precipOffset = next12Codes.findIndex((c, idx) => idx > 0 && (isSsrPrecip(c) || (next12Pops[idx] ?? 0) >= 60));
      if (precipOffset !== -1 && precipOffset <= 8 && ssrHourly && ssrHourly.time) {
        const incCode = next12Codes[precipOffset];
        const incName = isSsrPrecip(incCode) ? getSsrDesc(incCode).toLowerCase() : 'scattered showers';
        narrative = currentDesc + ' now, with ' + incName + ' expected around ' + formatSsrClock(ssrHourly.time[ssrSliceStart + precipOffset]);
      } else {
        const clearCount = next12Codes.filter((c) => c === 0 || c === 1).length;
        const overcastCount = next12Codes.filter((c) => c === 3).length;
        const partlyCount = next12Codes.filter((c) => c === 2).length;
        if (currentCode === 0 && clearCount >= 9) {
          narrative = 'Generally clear skies ahead';
        } else if ((currentCode === 0 || currentCode === 1) && (partlyCount + overcastCount) >= 5) {
          narrative = currentDesc + ' now, becoming cloudier later';
        } else if ((currentCode === 2 || currentCode === 3) && clearCount >= 6) {
          narrative = currentDesc + ' now, clearing up later';
        } else if (overcastCount >= 8) {
          narrative = 'Overcast skies continuing';
        } else if (partlyCount >= 5) {
          narrative = 'Partly cloudy throughout the outlook';
        } else {
          narrative = currentDesc + ' conditions continuing';
        }
      }
    }

    const tMax = Math.round(ssrDaily.temperature_2m_max?.[0] ?? ssrCurrent.temperature_2m);
    const tMin = Math.round(ssrDaily.temperature_2m_min?.[0] ?? ssrCurrent.temperature_2m);
    const tmwMin = Math.round(ssrDaily.temperature_2m_min?.[1] ?? tMin);
    const currHr = new Date().getHours();

    let tempPart = '';
    if (currHr >= 5 && currHr < 12) {
      tempPart = 'Highs ' + (tMax - 1) + ' to ' + (tMax + 1) + ssrTempSymbol + ' and lows ' + (tMin - 1) + ' to ' + (tMin + 1) + ssrTempSymbol + '.';
    } else if (currHr >= 12 && currHr < 18) {
      tempPart = 'High ' + tMax + ssrTempSymbol + ', low ' + tmwMin + ssrTempSymbol + ' tonight.';
    } else {
      tempPart = 'Low ' + tmwMin + ssrTempSymbol + '.';
    }
    ssrOutlookSummary = narrative + '. ' + tempPart;
  }

  const ssrInsights = [];
  if (ssrCurrent && ssrDaily) {
    const todayMax = Math.round(ssrDaily.temperature_2m_max?.[0] ?? ssrCurrent.temperature_2m);
    const tmwMax = Math.round(ssrDaily.temperature_2m_max?.[1] ?? todayMax);
    const delta = tmwMax - todayMax;
    const absDelta = Math.abs(delta);
    const isImp = ssrUnits === 'imperial';
    const bigShift = isImp ? 9 : 5;
    const modShift = isImp ? 4 : 2;

    let cmpText = 'Temperatures tomorrow will feel nearly identical to today.';
    let arrow = 'none';
    if (delta >= bigShift) {
      cmpText = 'Temperatures are much higher than today.';
      arrow = 'up';
    } else if (delta >= modShift) {
      cmpText = 'Temperatures are a little higher than today.';
      arrow = 'up';
    } else if (delta <= -bigShift) {
      cmpText = 'Temperatures are much lower than today.';
      arrow = 'down';
    } else if (delta <= -modShift) {
      cmpText = 'Temperatures are a little lower than today.';
      arrow = 'down';
    }
    ssrInsights.push({ title: "Tomorrow's temperature", sub: cmpText, rightVal: absDelta + '°', arrow });

    if (ssrAqiVal !== null && ssrAqiVal > 50) {
      ssrInsights.push({
        title: 'Air quality alert',
        sub: 'AQI is ' + ssrAqiVal + ' (' + (ssrAq.aqiLabel || ssrAqiShort) + '). Sensitive groups should limit prolonged exertion.',
        rightVal: 'AQI ' + ssrAqiVal,
        arrow: 'none'
      });
    }

    const activePollensList = ssrTopPollens.filter(p => p.active);
    if (activePollensList.length > 0) {
      const names = activePollensList.map(p => p.name + ' (' + p.stage.toLowerCase() + ')').join(', ');
      ssrInsights.push({
        title: 'Pollen alert',
        sub: 'Active pollen in the air right now: ' + names + '.',
        rightVal: '🌿',
        arrow: 'none'
      });
    } else if (ssrAq && ssrAq.pollenBreakdown) {
      ssrInsights.push({
        title: 'Pollen outlook',
        sub: 'Pollen counts are minimal across your tracked allergens right now.',
        rightVal: '🌿',
        arrow: 'none'
      });
    }

    const runMin = isImp ? 50 : 10;
    const runMax = isImp ? 75 : 24;
    const runWindMax = isImp ? 15 : 24;
    const runGoodAir = !ssrAq || (ssrAq.usAqi ?? 0) <= 75;
    if (!isSsrPrecip(ssrCurrent.weather_code) && ssrCurrent.temperature_2m >= runMin && ssrCurrent.temperature_2m <= runMax && (ssrCurrent.wind_speed_10m ?? 0) <= runWindMax && runGoodAir) {
      ssrInsights.push({
        title: 'Today is a good day for running',
        sub: 'Mild temperatures, light winds, and clean air make conditions ideal for a run.',
        rightVal: '🏃',
        arrow: 'none'
      });
    }

    if (isSsrPrecip(ssrCurrent.weather_code)) {
      ssrInsights.push({
        title: 'Grab an umbrella!',
        sub: getSsrDesc(ssrCurrent.weather_code) + ' is active and likely to continue nearby.',
        rightVal: '☂️',
        arrow: 'none'
      });
    } else if ((ssrSafe.popNext ?? 0) >= 50) {
      ssrInsights.push({
        title: 'Grab an umbrella!',
        sub: 'Rain is likely in the coming hours (' + ssrSafe.popNext + '% peak chance).',
        rightVal: ssrSafe.popNext + '%',
        arrow: 'none'
      });
    }

    const uvMax = ssrDaily.uv_index_max?.[0] ?? 0;
    if (ssrIsDay && uvMax >= 6) {
      ssrInsights.push({
        title: 'High UV alert',
        sub: 'UV index reaches ' + Math.round(uvMax) + ' today. Sun protection is recommended.',
        rightVal: 'UV ' + Math.round(uvMax),
        arrow: 'none'
      });
    }

    const goodStargazingAir = !ssrAq || ((ssrAq.usAqi ?? 0) <= 60 && (ssrAq.pm25 ?? 0) <= 20);
    if (!ssrIsDay && [0, 1].includes(ssrCurrent.weather_code) && (ssrCurrent.relative_humidity_2m ?? 50) < 80 && goodStargazingAir) {
      ssrInsights.push({
        title: 'Great for stargazing',
        sub: 'Clear night skies and clean air quality offer crisp visibility of the stars.',
        rightVal: '🌌',
        arrow: 'none'
      });
    }

    if (ssrSafe.sunriseLocal) {
      ssrInsights.push({
        title: "Don't miss tomorrow's sunrise",
        sub: 'Sunrise is at ' + ssrSafe.sunriseLocal + ' with clear viewing conditions.',
        rightVal: '🌅',
        arrow: 'none'
      });
    }
  }
%>
<!DOCTYPE html>
<html lang="en" data-theme="<%= ssrSafe.theme === 'light' ? 'light' : 'dark' %>" data-device="desktop">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>PokeWeather</title>
<meta name="theme-color" content="#111318" />
<meta name="color-scheme" content="dark light" />
<meta content="PokeWeather" property="og:title">
<meta content="View Weather info :3c" property="twitter:description">
<meta content="/static/poke-weather.png" property="og:image" />
<meta content="summary_large_image" name="twitter:card">
<style>
:root {
  --md-bg: #111318;
  --md-surface: #1d2026;
  --md-surface-high: #282a31;
  --md-surface-highest: #33353c;
  --md-primary: #a8c7fa;
  --md-on-primary: #062e6f;
  --md-primary-container: #284777;
  --md-on-primary-container: #d6e3ff;
  --md-text: #e2e2e9;
  --md-text-muted: #c4c6d0;
  --md-outline: #44474e;
  --md-danger: #ffb4ab;
  --radius-xl: 28px;
  --radius-lg: 20px;
  --radius-pill: 999px;
  --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --sky-opacity: 1;
  --mobile-sky-height: 760px;
  --sun-x: 50%;
  --sun-y: 86px;
}

[data-theme="light"] {
  --md-bg: #f8f9ff;
  --md-surface: #ecedf4;
  --md-surface-high: #e1e2e9;
  --md-surface-highest: #d5d7de;
  --md-primary: #2b5bb5;
  --md-on-primary: #ffffff;
  --md-primary-container: #d6e3ff;
  --md-on-primary-container: #001b3e;
  --md-text: #191c20;
  --md-text-muted: #44474e;
  --md-outline: #c4c6d0;
  --md-danger: #ba1a1a;
}

* {
  box-sizing: border-box;
}

html, body {
  min-height: 100%;
  margin: 0;
  background-color: var(--md-bg);
  color: var(--md-text);
  font-family: var(--font-sans);
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

.sky-layer {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  transition: background 0.6s ease, opacity 0.25s ease;
  overflow: hidden;
}

.mobile-sky {
  display: none;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--mobile-sky-height);
  opacity: var(--sky-opacity);
  mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
  -webkit-mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
}

.hero-sky {
  border-radius: inherit;
}

.sky-layer[data-sky="clear-day"] {
  background: linear-gradient(165deg, #0d47a1 0%, #2563eb 52%, #60a5fa 100%);
}

.sky-layer[data-sky="clear-night"] {
  background: linear-gradient(165deg, #050814 0%, #101b33 60%, #1e293b 100%);
}

.sky-layer[data-sky="cloudy-day"] {
  background: linear-gradient(165deg, #364961 0%, #566d87 55%, #2b394a 100%);
}

.sky-layer[data-sky="cloudy-night"] {
  background: linear-gradient(165deg, #111722 0%, #232e3f 60%, #161e2b 100%);
}

.sky-layer[data-sky="rain-day"],
.sky-layer[data-sky="rain-night"] {
  background: linear-gradient(165deg, #162030 0%, #27364b 55%, #151d2a 100%);
}

.sky-layer[data-sky="snow-day"],
.sky-layer[data-sky="snow-night"] {
  background: linear-gradient(165deg, #384961 0%, #61748f 55%, #2f3e52 100%);
}

.sky-layer[data-sky="storm-day"],
.sky-layer[data-sky="storm-night"] {
  background: linear-gradient(165deg, #11101d 0%, #29233a 60%, #151321 100%);
}

.sky-celestial {
  position: absolute;
  top: 40px;
  right: 12%;
  width: 96px;
  height: 96px;
  border-radius: 50%;
  transition: left 0.8s cubic-bezier(0.22, 1, 0.36, 1), top 0.8s cubic-bezier(0.22, 1, 0.36, 1), background 0.6s ease, box-shadow 0.6s ease;
}

.mobile-sky .sky-celestial {
  top: var(--sun-y);
  left: var(--sun-x);
  right: auto;
  transform: translate(-50%, -50%);
  width: 92px;
  height: 92px;
}

.sky-layer[data-sky="clear-day"] .sky-celestial {
  background: radial-gradient(circle, #ffffff 0%, #fef08a 38%, #f59e0b 68%, rgba(245, 158, 11, 0) 76%);
  box-shadow:
    0 0 36px 12px rgba(254, 240, 138, 0.65),
    0 0 90px 38px rgba(251, 191, 36, 0.38),
    0 0 160px 70px rgba(245, 158, 11, 0.22);
  animation: solarPulse 5s ease-in-out infinite alternate;
}

.sky-layer[data-sky="clear-night"] .sky-celestial {
  width: 72px;
  height: 72px;
  background: radial-gradient(circle at 35% 35%, #ffffff 0%, #e2e8f0 55%, #94a3b8 85%, rgba(148, 163, 184, 0) 90%);
  box-shadow:
    0 0 40px 10px rgba(226, 232, 240, 0.3),
    0 0 90px 28px rgba(148, 163, 184, 0.16);
}

.sky-layer[data-sky="cloudy-day"] .sky-celestial {
  background: radial-gradient(circle, #fef9c3 0%, rgba(253, 224, 71, 0.45) 55%, rgba(226, 232, 240, 0) 74%);
  box-shadow: 0 0 70px 24px rgba(254, 240, 138, 0.25);
  filter: blur(4px);
}

.sky-layer[data-sky^="rain"] .sky-celestial,
.sky-layer[data-sky^="storm"] .sky-celestial,
.sky-layer[data-sky^="snow"] .sky-celestial {
  opacity: 0.18;
  filter: blur(12px);
}

@keyframes solarPulse {
  from { transform: translate(-50%, -50%) scale(0.97); }
  to { transform: translate(-50%, -50%) scale(1.04); }
}

.hero-sky .sky-celestial {
  animation: none;
}

.sky-stars {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.6s ease;
  background-image:
    radial-gradient(1.5px 1.5px at 18% 14%, #ffffff 100%, transparent),
    radial-gradient(1px 1px at 76% 22%, #ffffff 100%, transparent),
    radial-gradient(2px 2px at 38% 8%, #ffffff 100%, transparent),
    radial-gradient(1.5px 1.5px at 84% 11%, #ffffff 100%, transparent),
    radial-gradient(1px 1px at 12% 32%, #ffffff 100%, transparent),
    radial-gradient(1.5px 1.5px at 62% 28%, #ffffff 100%, transparent);
}

.sky-layer[data-sky="clear-night"] .sky-stars,
.sky-layer[data-sky="cloudy-night"] .sky-stars {
  opacity: 0.75;
}

.sky-clouds {
  position: absolute;
  top: 30px;
  left: -10%;
  right: -10%;
  height: 180px;
  opacity: 0;
  transition: opacity 0.6s ease;
  background:
    radial-gradient(ellipse 160px 55px at 30% 60%, rgba(255, 255, 255, 0.22), transparent 70%),
    radial-gradient(ellipse 200px 65px at 70% 45%, rgba(255, 255, 255, 0.18), transparent 70%);
}

.sky-layer[data-sky^="cloudy"] .sky-clouds,
.sky-layer[data-sky^="rain"] .sky-clouds,
.sky-layer[data-sky^="storm"] .sky-clouds {
  opacity: 1;
}

.sky-precip {
  position: absolute;
  inset: -120px -20% 0 -20%;
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.sky-precip::before,
.sky-precip::after {
  content: "";
  position: absolute;
  inset: 0;
}

.sky-layer[data-sky^="rain"] .sky-precip,
.sky-layer[data-sky^="storm"] .sky-precip {
  opacity: 0.75;
  transform: rotate(13deg);
}

.sky-layer[data-sky^="rain"] .sky-precip::before,
.sky-layer[data-sky^="storm"] .sky-precip::before {
  background-image:
    radial-gradient(1.5px 24px at 18px 34px, rgba(186, 230, 253, 0.65), transparent),
    radial-gradient(1.5px 30px at 62px 105px, rgba(186, 230, 253, 0.55), transparent),
    radial-gradient(1px 22px at 108px 52px, rgba(186, 230, 253, 0.6), transparent),
    radial-gradient(1.5px 28px at 154px 145px, rgba(186, 230, 253, 0.5), transparent),
    radial-gradient(1px 26px at 192px 88px, rgba(186, 230, 253, 0.62), transparent);
  background-size: 210px 210px;
  animation: smoothRainA 0.52s linear infinite;
  will-change: background-position;
}

.sky-layer[data-sky^="rain"] .sky-precip::after,
.sky-layer[data-sky^="storm"] .sky-precip::after {
  background-image:
    radial-gradient(1px 18px at 36px 70px, rgba(186, 230, 253, 0.42), transparent),
    radial-gradient(1px 20px at 94px 18px, rgba(186, 230, 253, 0.36), transparent),
    radial-gradient(1px 16px at 142px 112px, rgba(186, 230, 253, 0.4), transparent);
  background-size: 160px 160px;
  animation: smoothRainB 0.74s linear infinite;
  will-change: background-position;
}

.sky-layer[data-sky^="snow"] .sky-precip {
  opacity: 0.7;
}

.sky-layer[data-sky^="snow"] .sky-precip::before {
  background-image:
    radial-gradient(3px 3px at 24px 36px, #ffffff 90%, transparent),
    radial-gradient(4px 4px at 105px 18px, #ffffff 90%, transparent),
    radial-gradient(2.5px 2.5px at 64px 115px, #ffffff 90%, transparent),
    radial-gradient(3.5px 3.5px at 136px 85px, #ffffff 90%, transparent);
  background-size: 160px 160px;
  animation: snowfall 3.2s linear infinite;
  will-change: background-position;
}

@keyframes smoothRainA {
  from { background-position: 0 0; }
  to { background-position: 0 210px; }
}

@keyframes smoothRainB {
  from { background-position: 0 0; }
  to { background-position: 0 160px; }
}

@keyframes snowfall {
  from { background-position: 0 0; }
  to { background-position: 24px 160px; }
}

