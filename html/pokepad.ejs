  <div id="snackbar" role="status" aria-live="polite"></div>

  <script>
    let notes = [];
    let currentTabId = null;
    let tabCounter = 0;
    let dragSrcId = null;
    let savedSelectionRange = null;

    let currentModalAction = null;
    let pendingUploadData = null;
    let pendingUploadFileName = '';
    let snackbarTimeout = null;

    const STORAGE_KEY = 'pokepadEncrypted';
    const PLAIN_KEY = 'pokepadPlain';

    const tabBar = document.getElementById('tabBar');
    const addTabBtn = document.getElementById('addTabBtn');
    const editor = document.getElementById('editor');
    const saveBtn = document.getElementById('saveBtn');
    const loadBtn = document.getElementById('loadBtn');
    const uploadBtn = document.getElementById('uploadBtn');
    const fileInput = document.getElementById('fileInput');
    const snackbar = document.getElementById('snackbar');
    const toolbarButtons = document.querySelectorAll('#toolbar .tool-btn[data-cmd]');
    const colorPicker = document.getElementById('colorPicker');
    const colorPickerBtn = document.getElementById('colorPickerBtn');
    const colorIndicator = document.getElementById('colorIndicator');

    const lineGutter = document.getElementById('lineGutter');
    const lineNumbersList = document.getElementById('lineNumbersList');
    const closeGutterBtn = document.getElementById('closeGutterBtn');
    const toggleGutterStatusBtn = document.getElementById('toggleGutterStatusBtn');
    const lineCountDisplay = document.getElementById('lineCountDisplay');
    const wordCountDisplay = document.getElementById('wordCountDisplay');
    const charCountDisplay = document.getElementById('charCountDisplay');

    const e2eeLabel = document.getElementById('e2eeLabel');
    const e2eeModalScrim = document.getElementById('e2eeModalScrim');
    const e2eeCloseBtn = document.getElementById('e2eeCloseBtn');

    const passwordModalScrim = document.getElementById('passwordModalScrim');
    const passwordModalTitle = document.getElementById('passwordModalTitle');
    const passwordModalSubtitle = document.getElementById('passwordModalSubtitle');
    const passwordFieldBox = document.getElementById('passwordFieldBox');
    const modalPasswordInput = document.getElementById('modalPasswordInput');
    const togglePasswordVisBtn = document.getElementById('togglePasswordVisBtn');
    const togglePasswordVisIcon = document.getElementById('togglePasswordVisIcon');
    const copyPasswordBtn = document.getElementById('copyPasswordBtn');
    const suggestKeyRow = document.getElementById('suggestKeyRow');
    const suggestKeyBtn = document.getElementById('suggestKeyBtn');
    const passwordModalError = document.getElementById('passwordModalError');
    const passwordModalCancelBtn = document.getElementById('passwordModalCancelBtn');
    const passwordModalConfirmBtn = document.getElementById('passwordModalConfirmBtn');

    const insertLinkBtn = document.getElementById('insertLinkBtn');
    const linkModalScrim = document.getElementById('linkModalScrim');
    const modalLinkInput = document.getElementById('modalLinkInput');
    const linkModalCancelBtn = document.getElementById('linkModalCancelBtn');
    const linkModalConfirmBtn = document.getElementById('linkModalConfirmBtn');

    const EYE_OPEN_PATH = 'M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z';
    const EYE_OFF_PATH = 'M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z';

    window.addEventListener('DOMContentLoaded', () => {
      const storedPlain = localStorage.getItem(PLAIN_KEY);
      if (storedPlain) {
        try {
          const parsedPlain = JSON.parse(storedPlain);
          if (parsedPlain.notes && Array.isArray(parsedPlain.notes) && parsedPlain.notes.length > 0) {
            notes = parsedPlain.notes;
            tabCounter = Math.max(...notes.map(n => n.id)) + 1;
            currentTabId = parsedPlain.currentTabId != null
              ? parsedPlain.currentTabId
              : notes[0]?.id;
            renderTabs();
            if (currentTabId != null) {
              const curr = notes.find(n => n.id === currentTabId);
              editor.innerHTML = curr ? curr.content : '';
            }
            updateMetricsAndLines();
            setInterval(savePlain, 10000);
            return;
          }
        } catch {}
      }
      createNewTab();
      updateMetricsAndLines();
      setInterval(savePlain, 10000);
    });

    function updateMetricsAndLines() {
      const rawText = (editor.innerText || '').replace(/\r\n/g, '\n');
      const normalized = rawText.replace(/\n$/, '');

      const trimmed = normalized.trim();
      const words = trimmed ? trimmed.split(/\s+/).length : 0;
      const chars = normalized.replace(/\n/g, '').length;

      let totalLines = 1;
      const hasBlockChildren = editor.querySelector('div, p, li, br, h1, h2, h3, h4, h5, h6, blockquote, pre') !== null;

      if (normalized.length === 0 && !hasBlockChildren) {
        totalLines = 1;
      } else if (normalized.length > 0) {
        totalLines = Math.max(1, normalized.split('\n').length);
      } else {
        const brCount = editor.querySelectorAll('br').length;
        const blockCount = editor.querySelectorAll('div, p, li').length;
        totalLines = Math.max(1, blockCount || brCount);
      }

      wordCountDisplay.textContent = `${words} ${words === 1 ? 'word' : 'words'}`;
      charCountDisplay.textContent = `${chars} ${chars === 1 ? 'character' : 'characters'}`;
      lineCountDisplay.textContent = `${totalLines} ${totalLines === 1 ? 'line' : 'lines'}`;

      let gutterHtml = '';
      for (let i = 1; i <= totalLines; i++) {
        gutterHtml += `<span class="line-num">${i}</span>`;
      }
      lineNumbersList.innerHTML = gutterHtml;
      lineNumbersList.scrollTop = editor.scrollTop;
    }

    editor.addEventListener('scroll', () => {
      lineNumbersList.scrollTop = editor.scrollTop;
    });

    window.addEventListener('resize', updateMetricsAndLines);

    closeGutterBtn.addEventListener('click', () => {
      lineGutter.classList.add('closed');
      toggleGutterStatusBtn.classList.remove('active');
      toggleGutterStatusBtn.setAttribute('aria-pressed', 'false');
    });

    toggleGutterStatusBtn.addEventListener('click', () => {
      const isClosed = lineGutter.classList.toggle('closed');
      toggleGutterStatusBtn.classList.toggle('active', !isClosed);
      toggleGutterStatusBtn.setAttribute('aria-pressed', (!isClosed).toString());
      if (!isClosed) {
        updateMetricsAndLines();
      }
    });

    function createNewTab(name = null, content = '') {
      const id = tabCounter++;
      const defaultName = name || `Note ${id + 1}`;
      notes.push({ id, name: defaultName, content });
      switchToTab(id);
      renderTabs();
      savePlain();
    }

    addTabBtn.addEventListener('click', () => createNewTab());

    function renderTabs() {
      tabBar.innerHTML = '';
      notes.forEach((note) => {
        const tabEl = document.createElement('div');
        tabEl.className = 'tab' + (note.id === currentTabId ? ' active' : '');
        tabEl.setAttribute('role', 'tab');
        tabEl.setAttribute('aria-selected', note.id === currentTabId ? 'true' : 'false');
        tabEl.setAttribute('draggable', 'true');
        tabEl.dataset.id = note.id;

        const titleSpan = document.createElement('span');
        titleSpan.className = 'title-text';
        titleSpan.textContent = note.name;
        titleSpan.addEventListener('dblclick', (e) => {
          e.stopPropagation();
          promptRename(note.id, titleSpan);
        });
        tabEl.appendChild(titleSpan);

        const actionsWrap = document.createElement('div');
        actionsWrap.className = 'tab-actions';

        const renameBtn = document.createElement('button');
        renameBtn.type = 'button';
        renameBtn.className = 'icon-btn';
        renameBtn.innerHTML = '<svg class="svg-icon" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>';
        renameBtn.title = 'Rename tab';
        renameBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          promptRename(note.id, titleSpan);
        });
        actionsWrap.appendChild(renameBtn);

        const closeBtn = document.createElement('button');
        closeBtn.type = 'button';
        closeBtn.className = 'icon-btn';
        closeBtn.innerHTML = '<svg class="svg-icon" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>';
        closeBtn.title = 'Close tab';
        closeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          closeTab(note.id);
        });
        actionsWrap.appendChild(closeBtn);

        tabEl.appendChild(actionsWrap);

        tabEl.addEventListener('click', () => switchToTab(note.id));
        tabEl.addEventListener('dragstart', tabDragStart);
        tabEl.addEventListener('dragover', tabDragOver);
        tabEl.addEventListener('drop', tabDrop);
        tabEl.addEventListener('dragend', tabDragEnd);

        tabBar.appendChild(tabEl);
      });
    }

    function switchToTab(id) {
      if (currentTabId !== null) {
        const currentNote = notes.find(n => n.id === currentTabId);
        if (currentNote) currentNote.content = editor.innerHTML;
      }
      currentTabId = id;
      const nextNote = notes.find(n => n.id === id);
      editor.innerHTML = nextNote ? nextNote.content : '';
      renderTabs();
      updateMetricsAndLines();
      editor.focus();
      savePlain();
    }

    function promptRename(id, titleSpan) {
      const note = notes.find(n => n.id === id);
      if (!note) return;
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'tab-rename-input';
      input.value = note.name;
      titleSpan.replaceWith(input);
      input.focus();
      input.select();

      const commitRename = () => {
        const newName = input.value.trim();
        if (newName) note.name = newName;
        renderTabs();
        savePlain();
      };

      input.addEventListener('blur', commitRename);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') input.blur();
        if (e.key === 'Escape') {
          input.value = note.name;
          input.blur();
        }
      });
    }

    function closeTab(id) {
      const idx = notes.findIndex(n => n.id === id);
      if (idx === -1) return;
      const wasActive = (id === currentTabId);
      notes.splice(idx, 1);
      if (notes.length === 0) {
        tabCounter = 0;
        notes = [];
        createNewTab();
        return;
      }
      if (wasActive) {
        const newIdx = idx > 0 ? idx - 1 : 0;
        switchToTab(notes[newIdx].id);
      } else {
        renderTabs();
        savePlain();
      }
    }

    function tabDragStart(e) {
      dragSrcId = Number(e.currentTarget.dataset.id);
      e.currentTarget.dataset.dragging = 'true';
    }

    function tabDragOver(e) {
      e.preventDefault();
      const targetId = Number(e.currentTarget.dataset.id);
      if (dragSrcId === targetId) return;
      const srcIndex = notes.findIndex(n => n.id === dragSrcId);
      const tgtIndex = notes.findIndex(n => n.id === targetId);
      if (srcIndex === -1 || tgtIndex === -1) return;
      notes.splice(tgtIndex, 0, notes.splice(srcIndex, 1)[0]);
      renderTabs();
    }

    function tabDrop(e) {
      e.stopPropagation();
      savePlain();
    }

    function tabDragEnd(e) {
      delete e.currentTarget.dataset.dragging;
    }

    editor.addEventListener('input', () => {
      if (currentTabId !== null) {
        const note = notes.find(n => n.id === currentTabId);
        if (note) note.content = editor.innerHTML;
      }
      updateMetricsAndLines();
      savePlain();
    });

    function savePlain() {
      if (currentTabId !== null) {
        const currentNote = notes.find(n => n.id === currentTabId);
        if (currentNote) currentNote.content = editor.innerHTML;
      }
      const payload = { notes, currentTabId };
      localStorage.setItem(PLAIN_KEY, JSON.stringify(payload));
    }

    async function getKeyMaterial(password) {
      const encoder = new TextEncoder();
      return crypto.subtle.importKey(
        'raw',
        encoder.encode(password),
        'PBKDF2',
        false,
        ['deriveKey']
      );
    }

    async function deriveKey(password, salt) {
      const keyMaterial = await getKeyMaterial(password);
      return crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: salt, iterations: 150000, hash: 'SHA-256' },
        keyMaterial,
        { name: 'AES-GCM', length: 256 },
        false,
        ['encrypt', 'decrypt']
      );
    }

    function arrayBufferToBase64(buffer) {
      const bytes = new Uint8Array(buffer);
      let binary = '';
      for (let b of bytes) {
        binary += String.fromCharCode(b);
      }
      return btoa(binary);
    }

    function base64ToArrayBuffer(base64) {
      const binary = atob(base64);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) {
        bytes[i] = binary.charCodeAt(i);
      }
      return bytes.buffer;
    }

    async function encryptData(plainText, password) {
      const encoder = new TextEncoder();
      const salt = crypto.getRandomValues(new Uint8Array(16));
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const key = await deriveKey(password, salt);
      const cipherBuffer = await crypto.subtle.encrypt(
        { name: 'AES-GCM', iv: iv },
        key,
        encoder.encode(plainText)
      );
      return {
        salt: arrayBufferToBase64(salt.buffer),
        iv: arrayBufferToBase64(iv.buffer),
        data: arrayBufferToBase64(cipherBuffer)
      };
    }

    async function decryptData(encryptedObj, password) {
      const salt = base64ToArrayBuffer(encryptedObj.salt);
      const iv = base64ToArrayBuffer(encryptedObj.iv);
      const cipherBuffer = base64ToArrayBuffer(encryptedObj.data);
      const key = await deriveKey(password, salt);
      try {
        const decryptedBuffer = await crypto.subtle.decrypt(
          { name: 'AES-GCM', iv: iv },
          key,
          cipherBuffer
        );
        const decoder = new TextDecoder();
        return decoder.decode(decryptedBuffer);
      } catch {
        throw new Error('Decryption failed. Wrong password or corrupted data.');
      }
    }

    function applyDecryptedNotes(parsed) {
      notes = parsed.notes.map(n => ({ id: n.id, name: n.name, content: n.content }));
      tabCounter = notes.length ? Math.max(...notes.map(n => n.id)) + 1 : 0;
      currentTabId = parsed.currentTabId != null ? parsed.currentTabId : (notes[0]?.id);
      renderTabs();
      if (currentTabId != null) {
        const curr = notes.find(n => n.id === currentTabId);
        editor.innerHTML = curr ? curr.content : '';
      } else if (notes[0]) {
        currentTabId = notes[0].id;
        editor.innerHTML = notes[0].content;
      }
      updateMetricsAndLines();
      savePlain();
    }

    function generateStrongKey() {
      const charset = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*';
      const values = new Uint32Array(24);
      crypto.getRandomValues(values);
      let result = '';
      for (let i = 0; i < 24; i++) {
        if (i > 0 && i % 6 === 0) result += '-';
        result += charset[values[i] % charset.length];
      }
      return result;
    }

    function copyTextToClipboard(text) {
      const tempInput = document.createElement('textarea');
      tempInput.value = text;
      tempInput.style.position = 'fixed';
      tempInput.style.opacity = '0';
      document.body.appendChild(tempInput);
      tempInput.select();
      try {
        document.execCommand('copy');
        showSnackbar('Encryption key copied to clipboard.', 'success');
      } catch {
        showSnackbar('Could not copy automatically.', 'error');
      }
      document.body.removeChild(tempInput);
    }

    function openPasswordModal({ mode, title, subtitle, confirmText }) {
      currentModalAction = mode;
      passwordModalTitle.textContent = title;
      passwordModalSubtitle.textContent = subtitle;
      passwordModalConfirmBtn.textContent = confirmText;

      modalPasswordInput.value = '';
      modalPasswordInput.type = 'password';
      togglePasswordVisIcon.innerHTML = `<path d="${EYE_OPEN_PATH}"/>`;
      copyPasswordBtn.style.display = 'none';
      clearModalError();

      if (mode === 'download') {
        suggestKeyRow.classList.add('visible');
      } else {
        suggestKeyRow.classList.remove('visible');
      }

      passwordModalScrim.classList.add('open');
      setTimeout(() => modalPasswordInput.focus(), 50);
    }

    function closePasswordModal() {
      passwordModalScrim.classList.remove('open');
      currentModalAction = null;
      pendingUploadData = null;
      pendingUploadFileName = '';
      modalPasswordInput.value = '';
      clearModalError();
    }

    function setModalError(msg) {
      passwordFieldBox.classList.add('error');
      passwordModalError.textContent = msg;
    }

    function clearModalError() {
      passwordFieldBox.classList.remove('error');
      passwordModalError.textContent = '';
    }

    modalPasswordInput.addEventListener('input', () => {
      clearModalError();
      copyPasswordBtn.style.display = modalPasswordInput.value ? 'inline-flex' : 'none';
    });

    suggestKeyBtn.addEventListener('click', () => {
      const suggested = generateStrongKey();
      modalPasswordInput.value = suggested;
      modalPasswordInput.type = 'text';
      togglePasswordVisIcon.innerHTML = `<path d="${EYE_OFF_PATH}"/>`;
      copyPasswordBtn.style.display = 'inline-flex';
      clearModalError();
      copyTextToClipboard(suggested);
      modalPasswordInput.focus();
    });

    copyPasswordBtn.addEventListener('click', () => {
      if (modalPasswordInput.value) {
        copyTextToClipboard(modalPasswordInput.value);
      }
    });

    togglePasswordVisBtn.addEventListener('click', () => {
      const isPw = modalPasswordInput.type === 'password';
      modalPasswordInput.type = isPw ? 'text' : 'password';
      togglePasswordVisIcon.innerHTML = `<path d="${isPw ? EYE_OFF_PATH : EYE_OPEN_PATH}"/>`;
      modalPasswordInput.focus();
    });

    passwordModalCancelBtn.addEventListener('click', closePasswordModal);

    passwordModalScrim.addEventListener('click', (e) => {
      if (e.target === passwordModalScrim) closePasswordModal();
    });

    modalPasswordInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        handlePasswordModalSubmit();
      } else if (e.key === 'Escape') {
        closePasswordModal();
      }
    });

    passwordModalConfirmBtn.addEventListener('click', handlePasswordModalSubmit);

    async function handlePasswordModalSubmit() {
      const pw = modalPasswordInput.value;
      if (!pw) {
        setModalError('Please enter a password.');
        modalPasswordInput.focus();
        return;
      }

      if (currentModalAction === 'upload') {
        try {
          const decryptedText = await decryptData(pendingUploadData, pw);
          const parsed = JSON.parse(decryptedText);
          if (!parsed.notes || !Array.isArray(parsed.notes)) {
            setModalError('Decrypted file does not contain valid Notes :c');
            return;
          }
          applyDecryptedNotes(parsed);
          closePasswordModal();
          showSnackbar('Decryption successful! Ur Notes are loaded', 'success');
        } catch {
          setModalError('Incorrect password or corrupted file. Please try again.');
          modalPasswordInput.select();
        }
      } else if (currentModalAction === 'download') {
        if (currentTabId !== null) {
          const currentNote = notes.find(n => n.id === currentTabId);
          if (currentNote) currentNote.content = editor.innerHTML;
        }
        savePlain();
        const payload = { notes, currentTabId };
        const jsonString = JSON.stringify(payload);
        try {
          const encrypted = await encryptData(jsonString, pw);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(encrypted));
          const downloadObj = JSON.stringify(encrypted);
          const blob = new Blob([downloadObj], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          const timestamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
          a.download = `pokepad_${timestamp}.json`;
          a.href = url;
          a.click();
          URL.revokeObjectURL(url);
          closePasswordModal();
          showSnackbar('Encrypted file ready to download!! yippe', 'success');
        } catch {
          setModalError('Error during encryption...... sad');
        }
      } else if (currentModalAction === 'loadLocal') {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (!stored) {
          closePasswordModal();
          showSnackbar('No locally stored data found!', 'error');
          return;
        }
        try {
          const encryptedObj = JSON.parse(stored);
          const decryptedText = await decryptData(encryptedObj, pw);
          const parsed = JSON.parse(decryptedText);
          if (!parsed.notes || !Array.isArray(parsed.notes)) {
            setModalError('Invalid local data format.');
            return;
          }
          applyDecryptedNotes(parsed);
          closePasswordModal();
          showSnackbar('Decryption successful!!!!!!!!! Notes loaded from localStorage.', 'success');
        } catch {
          setModalError('Decryption failed or data corrupted :c');
          modalPasswordInput.select();
        }
      }
    }

    uploadBtn.addEventListener('click', () => {
      fileInput.click();
    });

    fileInput.addEventListener('change', () => {
      const file = fileInput.files[0];
      if (!file) return;
      const fileName = file.name;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const encryptedObj = JSON.parse(e.target.result);
          if (!encryptedObj.salt || !encryptedObj.iv || !encryptedObj.data) {
            showSnackbar('Invalid file format.', 'error');
            return;
          }
          pendingUploadData = encryptedObj;
          pendingUploadFileName = fileName;
          openPasswordModal({
            mode: 'upload',
            title: 'Decrypt Uploaded File',
            subtitle: `Enter ur password to decrypt "${fileName}".`,
            confirmText: 'Decrypt'
          });
        } catch {
          showSnackbar('Failed to parse file! :c', 'error');
        }
      };
      reader.readAsText(file);
      fileInput.value = '';
    });

    saveBtn.addEventListener('click', () => {
      openPasswordModal({
        mode: 'download',
        title: 'Download Encrypted',
        subtitle: 'Enter a password or suggest a key to encrypt your notes! Make sure to pick a good one :>',
        confirmText: 'Encrypt & Download'
      });
    });

    loadBtn.addEventListener('click', () => {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (!stored) {
        showSnackbar('No locally stored data found.', 'error');
        return;
      }
      openPasswordModal({
        mode: 'loadLocal',
        title: 'Decrypt & Load',
        subtitle: 'Enter password to decrypt stored data!',
        confirmText: 'Decrypt'
      });
    });

    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
        e.preventDefault();
        savePlain();
        showSnackbar('PokePad autosaves :3 ', 'success');
      }
    });

    toolbarButtons.forEach(btn => {
      const cmd = btn.getAttribute('data-cmd');
      btn.addEventListener('click', () => {
        document.execCommand(cmd, false, null);
        editor.focus();
      });
    });

    colorPickerBtn.addEventListener('click', () => {
      colorPicker.click();
    });

    colorPicker.addEventListener('input', () => {
      colorIndicator.style.backgroundColor = colorPicker.value;
      document.execCommand('foreColor', false, colorPicker.value);
      editor.focus();
    });

    insertLinkBtn.addEventListener('click', () => {
      const sel = window.getSelection();
      if (sel && sel.rangeCount > 0) {
        savedSelectionRange = sel.getRangeAt(0).cloneRange();
      }
      modalLinkInput.value = 'https://';
      linkModalScrim.classList.add('open');
      setTimeout(() => {
        modalLinkInput.focus();
        modalLinkInput.select();
      }, 50);
    });

    function closeLinkModal() {
      linkModalScrim.classList.remove('open');
      savedSelectionRange = null;
    }

    function confirmInsertLink() {
      const url = modalLinkInput.value.trim();
      linkModalScrim.classList.remove('open');
      editor.focus();
      if (savedSelectionRange) {
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(savedSelectionRange);
      }
      if (url && url !== 'https://') {
        document.execCommand('createLink', false, url);
      }
      savedSelectionRange = null;
    }

    linkModalCancelBtn.addEventListener('click', closeLinkModal);
    linkModalConfirmBtn.addEventListener('click', confirmInsertLink);
    linkModalScrim.addEventListener('click', (e) => {
      if (e.target === linkModalScrim) closeLinkModal();
    });
    modalLinkInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        confirmInsertLink();
      } else if (e.key === 'Escape') {
        closeLinkModal();
      }
    });

    e2eeLabel.addEventListener('click', () => {
      e2eeModalScrim.classList.add('open');
    });

    e2eeCloseBtn.addEventListener('click', () => {
      e2eeModalScrim.classList.remove('open');
    });

    e2eeModalScrim.addEventListener('click', (e) => {
      if (e.target === e2eeModalScrim) e2eeModalScrim.classList.remove('open');
    });

    function showSnackbar(text, type = 'info') {
      if (snackbarTimeout) clearTimeout(snackbarTimeout);
      snackbar.textContent = text;
      snackbar.className = 'show' + (type === 'error' ? ' error' : '');
      snackbarTimeout = setTimeout(() => {
        snackbar.className = '';
      }, 4000);
    }
  </script>

</body></html>