<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Player Configure</title>
  <style>
    @font-face {
      font-family: "PokeTube Flex";
      src: url("/static/robotoflex.ttf?v=29");
      font-style: normal;
      font-stretch: 1% 800%;
      font-display: swap;
    }

    body {
      background-color: #222222;
      color: #e0e0e0;
      font-family: system-ui, -apple-system, sans-serif;
      display: flex;
      justify-content: flex-start;
      align-items: flex-start;
      margin: 0;
      padding: 24px;
      box-sizing: border-box;
      zoom: 200%;
      overflow: auto;
    }

    .container {
      width: 340px;
    }

    h1 {
      font-family: "PokeTube Flex", sans-serif;
      font-stretch: ultra-expanded;
      margin: 0 0 16px 0;
      font-size: 24px;
      color: #fff;
      font-weight: 1000;
    }

    .loader-wrapper {
      width: 100%;
      height: 4px;
      background-color: #333;
      border-radius: 4px;
      overflow: hidden;
      margin: 24px 0;
    }

    .loader-bar {
      height: 100%;
      width: 0%;
      background-color: #3b82f6;
      animation: loadProgress 0.4s ease-out forwards;
    }

    @keyframes loadProgress {
      0% { width: 0%; }
      100% { width: 100%; }
    }

    .setting-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      /* border-bottom: 1px solid #3d3d3d; */
    }

    .setting-row:last-child {
      border-bottom: none;
    }

    .label-group {
      display: flex;
      flex-direction: column;
    }

    .setting-title {
      font-size: 14px;
      font-weight: 500;
    }

    .switch {
      position: relative;
      display: inline-block;
      width: 46px;
      height: 24px;
      flex-shrink: 0;
    }

    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #444;
      transition: 0.2s;
      border-radius: 24px;
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: #fff;
      transition: 0.2s;
      border-radius: 50%;
    }

    input:checked + .slider {
      background-color: #3b82f6;
    }

    input:checked + .slider:before {
      transform: translateX(22px);
    }
  </style>
  <noscript>
  <style>
  .container {
    display:none;
  }
  </style>
  </noscript>
</head>
<body>
<noscript>
settings require javascript to work :p
</noscript>

  <div class="container">
    <img src="/css/logo-poke.svg?v=5" style="width: 9em;margin-bottom: 10px;">
    <h1>player settings</h1>
    <div id="loader" class="loader-wrapper">
      <div class="loader-bar"></div>
    </div>
    <div id="settings-list"></div>
  </div>

  <script>
   // @license magnet:?xt=urn:btih:1f739d935676111cfff4b4693e3816e664797050&dn=gpl-3.0.txt GPL-3.0-or-later
    const settings = [
      {
        key: 'DontUseAlabasterStyleDescriptionOpeningFS',
        toggleId: 'toggle-alabaster',
        title: 'Use Description Button instead of title to open Description'
      },
      {
        key: 'CloseFullScreenDiscover',
        toggleId: 'toggle-discover',
        title: 'Remove Discover in fullscreen'
      },
      {
        key: 'ShowDislikesOnFullScreenDesc',
        toggleId: 'toggle-fullscreen-dislikes',
        title: 'Show the dislike count instead of upload date on the fullscreen Description'
      },
      {
        key: 'DontShowVerifiedBadgeOnPopUpDescription',
        toggleId: 'toggle-fullscreen-verified-badge',
        title: 'Dont Show Channel verification badge if verified on the fullscreen description-pop up'
      }
    ];

    const loader = document.getElementById('loader');
    const settingsList = document.getElementById('settings-list');

    function syncSettings() {
      settings.forEach(({ key, toggleId }) => {
        const toggle = document.getElementById(toggleId);
        if (toggle) {
          const isChecked = localStorage.getItem(key) === 'true';
          if (toggle.checked !== isChecked) {
            toggle.checked = isChecked;
          }
        }
      });
    }

    setTimeout(() => {
      loader.style.display = 'none';

      settings.forEach(({ key, toggleId, title }) => {
        const row = document.createElement('div');
        row.className = 'setting-row';

        const labelGroup = document.createElement('div');
        labelGroup.className = 'label-group';

        const titleSpan = document.createElement('span');
        titleSpan.className = 'setting-title';
        titleSpan.textContent = title;

        labelGroup.appendChild(titleSpan);

        const switchLabel = document.createElement('label');
        switchLabel.className = 'switch';

        const toggle = document.createElement('input');
        toggle.type = 'checkbox';
        toggle.id = toggleId;

        const slider = document.createElement('span');
        slider.className = 'slider';

        switchLabel.appendChild(toggle);
        switchLabel.appendChild(slider);

        row.appendChild(labelGroup);
        row.appendChild(switchLabel);
        settingsList.appendChild(row);

        if (localStorage.getItem(key) === null) {
          localStorage.setItem(key, 'false');
        }

        toggle.checked = localStorage.getItem(key) === 'true';

        toggle.addEventListener('change', () => {
          localStorage.setItem(key, String(toggle.checked));
        });
      });

      window.addEventListener('storage', syncSettings);
      window.addEventListener('focus', syncSettings);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) syncSettings();
      });
      setInterval(syncSettings, 2000);
    }, 400);
    // @license-end
  </script>

</body>
</html>