<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>wrong turn? - poke</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/css/yt-ukraine.svg?v=3" />
    <style>
         @font-face {
            font-family: "PokeTube Flex";
            src: url("/static/robotoflex.ttf");
            font-style: normal;
            font-stretch: 1% 800%;
            font-display: swap;
        }

        :root {
            --bg-color: #0f0f0f;
            --text-primary: #f1f1f1;
            --text-secondary: #aaaaaa;
            --border-color: #303030;
            --search-bg: #121212;
            --search-btn-bg: #222222;
            --search-btn-hover: #303030;
            --accent-color: #ffabcc;
            --font-family: "PokeTube Flex", "Roboto", Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-primary);
            font-family: var(--font-family);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px; 
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: var(--accent-color);
        }

        a:hover {
            text-decoration: underline;
        }

        .error-container {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            max-width: 900px;
            width: 100%;
            gap: 60px;
        }

        .error-content {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            flex: 1;
        }

        .brand-logo {
            height: 48px;
            margin-bottom: 24px;
            cursor: pointer;
            user-select: none;
            -webkit-user-drag: none;
            transition: transform 0.1s;
        }
        
        .brand-logo:active {
            transform: scale(0.95);
        }

        .error-title {
            font-size: 56px;
            font-weight: 800;
            line-height: 1.05;
            margin-bottom: 16px;
            color: var(--text-primary);
            font-stretch: 150%; 
            font-variation-settings: "wdth" 150; 
        }

        .error-message {
            font-size: 16px;
            color: var(--text-secondary);
            margin-bottom: 32px;
            line-height: 1.5;
        }

        /* YouTube-style Search Bar */
        .search-bar {
            display: flex;
            align-items: center;
            width: 100%;
            max-width: 450px;
            margin-bottom: 24px;
        }

        .search-input-container {
            flex: 1;
            display: flex;
            align-items: center;
            background-color: var(--search-bg);
            border: 1px solid var(--border-color);
            border-right: none;
            border-radius: 40px 0 0 40px;
            padding: 0 16px;
            height: 40px;
            transition: border-color 0.2s;
        }

        .search-input-container:focus-within {
            border: 1px solid var(--accent-color);
            border-right: none;
        }

        .search-input {
            background: transparent;
            border: none;
            color: var(--text-primary);
            font-size: 16px;
            width: 100%;
            outline: none;
            font-family: inherit;
        }

        .search-input::placeholder {
            color: var(--text-secondary);
        }

        .search-btn {
            height: 40px;
            width: 64px;
            background-color: var(--search-btn-bg);
            border: 1px solid var(--border-color);
            border-radius: 0 40px 40px 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.2s;
        }

        .search-btn:hover {
            background-color: var(--search-btn-hover);
        }

        .search-icon {
            width: 20px;
            height: 20px;
            fill: var(--accent-color); 
        }

        .back-links {
            display: flex;
            gap: 16px;
            font-size: 14px;
            font-weight: 500;
        }

        .error-mascot {
            flex: 1;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }

        .error-mascot img {
            width: 100%;
            max-width: 320px;
            height: auto;
            object-fit: contain;
            user-select: none;
            -webkit-user-drag: none; 
        }

        #arcade-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 15, 15, 0.95);
            backdrop-filter: blur(5px);
            z-index: 1000;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.4s;
        }

        #arcade-overlay.active {
            opacity: 1;
        }

        .arcade-cabinet {
            position: relative;
            width: 90%;
            max-width: 800px;
            height: 70vh;
            background: #000;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
        }

        .arcade-screen {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }

        .close-fab {
            margin-top: 24px;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background-color: var(--search-btn-bg);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            transition: all 0.2s;
        }

        .close-fab:hover {
            background-color: var(--search-btn-hover);
            color: var(--accent-color);
            border-color: var(--accent-color);
            transform: scale(1.05);
        }

        @media (max-width: 768px) {
            .error-container {
                flex-direction: column-reverse;
                text-align: center;
                gap: 40px;
            }

            .error-content {
                align-items: center;
            }

            .error-mascot {
                justify-content: center;
            }

            .error-mascot img {
                max-width: 240px;
            }

            .search-bar {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="error-container">
        
        <div class="error-content">
            <img src="/css/poke-logo-pride.svg?v=5" alt="poke logo" class="brand-logo" id="secret-trigger" title="poke">
            
            <h1 class="error-title">wrong<br>turn?</h1>
            
            <p class="error-message">
                Welp, this is awkward... Looks like this page doesnt exist at all...!<br>
                Try searching for something else to get back on track!
            </p>

             <form action="/search" method="GET" class="search-bar">
                <div class="search-input-container">
                    <input 
                        type="text" 
                        name="q" 
                        class="search-input" 
                        placeholder="search poke for something else..."
                        autocomplete="off"
                    >
                </div>
                <button type="submit" class="search-btn" aria-label="Search">
                    <svg class="search-icon" viewBox="0 0 24 24">
                        <path d="M20.87,20.17l-5.59-5.59C16.35,13.35,17,11.75,17,10c0-3.87-3.13-7-7-7s-7,3.13-7,7s3.13,7,7,7c1.75,0,3.35-0.65,4.58-1.71 l5.59,5.59L20.87,20.17z M10,16c-3.31,0-6-2.69-6-6s2.69-6,6-6s6,2.69,6,6S13.31,16,10,16z"></path>
                    </svg>
                </button>
            </form>

            <div class="back-links">
                <a href="/">Go to Homepage</a>
            </div>
        </div>

         <div class="error-mascot">
            <img src="/static/poke-mascot-new.webp?v=2" alt="Poke Mascot">
        </div>

    </div>

    <div id="arcade-overlay">
        <div class="arcade-cabinet">
            <iframe id="game-frame" class="arcade-screen" src="" frameborder="0"></iframe>
        </div>
        <button id="close-game-btn" class="close-fab" title="Close Game">✕</button>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const trigger = document.getElementById('secret-trigger');
            const overlay = document.getElementById('arcade-overlay');
            const closeBtn = document.getElementById('close-game-btn');
            const gameFrame = document.getElementById('game-frame');
            
            const gameUrl = "/game-hub?game=snake";
            let clickCount = 0;
            let clickTimer = null;

             trigger.addEventListener('click', function(e) {
                e.preventDefault(); 
                clickCount++;

                if (clickCount === 1) {
                    clickTimer = setTimeout(() => {
                        clickCount = 0; 
                    }, 10000); 
                }

                if (clickCount >= 10) {
                    clearTimeout(clickTimer);
                    clickCount = 0;
                    launchGame();
                }
            });

            function launchGame() {
                gameFrame.src = gameUrl;
                overlay.style.display = 'flex';
                setTimeout(() => {
                    overlay.classList.add('active');
                }, 10);
            }

            closeBtn.addEventListener('click', function() {
                overlay.classList.remove('active');
                setTimeout(() => {
                    overlay.style.display = 'none';
                    gameFrame.src = "";  
                }, 400); 
            });
        });
    </script>
</body>
</html>