<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Unavailable <%= (locals.v) ? '- ' + v : '' %></title>
    <style>
        @import url('https://p.poketube.fun/https://fonts.bunny.net/css?family=roboto:400,500,700&display=swap');

        body {
            margin: 0;
            padding: 32px 0;
            font-family: 'Roboto', Arial, sans-serif;
            background-color: #000000;
            color: #f1f1f1;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            box-sizing: border-box;
        }

        #error-container {
            max-width: 500px;
            width: 90%;
            text-align: center;
        }

        .error-icon {
            width: 64px;
            height: 64px;
            fill: #ffffff;
            margin-bottom: 24px;
        }

        h1 {
            font-size: 24px;
            font-weight: 400;
            margin: 0 0 12px 0;
            color: #ffffff;
        }

        .subtitle {
            font-size: 15px;
            color: #aaaaaa;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .might-be {
            font-size: 15px;
            color: #f1f1f1;
            margin-bottom: 16px;
        }

        .reasons-list {
            text-align: left;
            display: inline-block;
            padding: 0;
            margin: 0 auto 28px auto;
            font-size: 14px;
            color: #aaaaaa;
            line-height: 1.6;
            list-style-type: none;
        }

        .reasons-list li {
            margin-bottom: 10px;
            position: relative;
            padding-left: 18px;
        }

        .reasons-list li.active-reason {
            color: #ff4e4e;
            font-weight: 500;
        }

        .reasons-list li::before {
            content: "•";
            position: absolute;
            left: 0;
            color: #717171;
        }

        .metadata-wrapper {
            margin: 0 auto 28px auto;
            text-align: center;
        }

        .metadata-heading {
            font-size: 13px;
            font-weight: 500;
            color: #aaaaaa;
            margin: 0 0 12px 0;
            letter-spacing: 0.2px;
        }

        .yt-metadata-card {
            background-color: #161616;
            border: 1px solid #272727;
            border-radius: 16px;
            padding: 14px;
            text-align: center;
            transition: border-color 0.2s ease, background-color 0.2s ease;
        }

        .yt-metadata-card:hover {
            background-color: #1c1c1c;
            border-color: #383838;
        }

        .yt-thumb-wrap {
            display: block;
            width: 100%;
            aspect-ratio: 16 / 9;
            border-radius: 12px;
            overflow: hidden;
            background-color: #272727;
            margin-bottom: 14px;
        }

        .yt-thumb {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            border-radius: 12px;
        }

        .yt-meta-title {
            font-size: 16px;
            font-weight: 500;
            color: #f1f1f1;
            margin: 0 0 6px 0;
            line-height: 1.4;
            word-break: break-word;
            text-align: center;
        }

        .yt-meta-author {
            font-size: 14px;
            color: #aaaaaa;
            margin: 0;
            text-align: center;
        }

        .yt-meta-author a {
            color: #aaaaaa;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .yt-meta-author a:hover {
            color: #f1f1f1;
            text-decoration: underline;
        }

        .actions {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }

        .btn-home,
        .btn-youtube {
            border: none;
            min-height: 36px;
            padding: 0 16px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 18px;
            cursor: pointer;
            transition: background-color 0.2s, opacity 0.2s;
            font-family: 'Roboto', Arial, sans-serif;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            white-space: nowrap;
        }

        .btn-home {
            background-color: #f1f1f1;
            color: #0f0f0f;
        }

        .btn-home:hover {
            background-color: #d9d9d9;
        }

        .btn-youtube {
            background-color: #272727;
            color: #f1f1f1;
        }

        .btn-youtube:hover {
            background-color: #3f3f3f;
        }

        .report-issue {
            font-size: 13px;
            color: #717171;
            line-height: 1.6;
        }

        .report-issue a {
            font-weight: 500;
            color: #aaaaaa;
            text-decoration: none;
        }

        .report-issue a:hover {
            color: #f1f1f1;
            text-decoration: underline;
        }

        .debug-info {
            margin-top: 15px;
            font-family: monospace;
            font-size: 11px;
            opacity: 0.4;
            border-top: 1px solid #333;
            padding-top: 10px;
        }
    </style>
</head>
<body>

    <%
        const getSafeErrorMessage = value => {
            const message = String(value || "").trim();

            if (!message) {
                return "No error message provided";
            }

            if (/fetch failed for\s+.+/i.test(message)) {
                return "fetch timeouted";
            }

            return message;
        };

        const issueNow = new Date();
        const issueMonths = [
            "january",
            "february",
            "march",
            "april",
            "may",
            "june",
            "july",
            "august",
            "september",
            "october",
            "november",
            "december"
        ];

        const padIssueNumber = value => String(value).padStart(2, "0");

        const issueDateFormatted = `${issueNow.getUTCDate()} ${issueMonths[issueNow.getUTCMonth()]} ${issueNow.getUTCFullYear()}, ${padIssueNumber(issueNow.getUTCHours())}:${padIssueNumber(issueNow.getUTCMinutes())} UTC`;
        const issueVideoId = locals.v || "Unknown";
        const issueErrorMessage = getSafeErrorMessage(locals.error_message);
        const issueReason = getSafeErrorMessage(locals.err_reason || "Unknown");
        const issuePageUrl = locals.url || locals.page_url || "Please paste the Poke page URL here";
        const issueLabel = "bug";

        const isAgeRestricted =
            locals.err_reason === "AGE_RESTRICTED" ||
            /sign in to confirm your age|this video is age-restricted/i.test(issueErrorMessage);

        const metaTitle = (locals.oembed && locals.oembed.title) || locals.title || "";
        const metaAuthor = (locals.oembed && locals.oembed.author_name) || locals.author || "";
        const metaAuthorUrl = (locals.oembed && locals.oembed.author_url) || locals.authorUrl || "";
        const rawThumbUrl =
            (locals.oembed && locals.oembed.thumbnail_url) ||
            locals.thumbnailUrl ||
            (locals.v ? `https://i.ytimg.com/vi/${encodeURIComponent(locals.v)}/hqdefault.jpg` : "");

        const mediaProxyBase = String(locals.mediaproxy || "").replace(/\/+$/, "");
        const proxiedThumbUrl = rawThumbUrl
            ? `${mediaProxyBase}/proxy?url=${encodeURIComponent(rawThumbUrl)}`
            : "";

        const hasMetadata = Boolean(metaTitle || metaAuthor);

        const issueTitle = `[Video Error] ${issueVideoId} | ${issueErrorMessage}`;

        const issueBody = [
            "Haiiii, lovely Poke user!",
            "",
            "First of all: you did not do anything wrong. Poke just had a little video-loading moment and faceplanted like a cat sliding off a table.",
            "",
            "We are genuinely sorry this happened. This report already has the important techy details filled in, so you can just add anything you noticed. Even a tiny note helps the Poke contributors understand what went wrong.",
            "",
            "How to fill this out:",
            "- Keep the auto-filled details below if you can.",
            "- Answer only the questions you know.",
            "- It is totally okay to leave blanks.",
            "- Screenshots, browser names, and little clues are very helpful.",
            "- If you pressed Try on YouTube, please say whether it worked there.",
            "",
            "Auto-filled bug details:",
            `Video ID: ${issueVideoId}`,
            `Error message: ${issueErrorMessage}`,
            `Error reason: ${issueReason}`,
            `Reported at: ${issueDateFormatted}`,
            `Page URL: ${issuePageUrl}`,
            "",
            "What happened?",
            "- The video opened the unavailable page instead of playing.",
            "",
            "What were you trying to do?",
            "- I was trying to watch this video on Poke.",
            "",
            "What did you expect to happen?",
            "- The video should have loaded normally, or Poke should have explained the problem more clearly.",
            "",
            "Tiny helpful questions:",
            "- Does the video work when you press Try on YouTube?",
            "- Did the page break right away, or did it load for a bit first?",
            "- Did refreshing the page help?",
            "- Does this happen every time you open this same video?",
            "- Are other videos working fine on Poke?",
            "- What browser are you using?",
            "- What device or operating system are you using?",
            "",
            "Extra notes:",
            "- You can write anything else here, even if it feels small.",
            "- Weird behavior, copied console messages, screenshots, or steps to reproduce are all welcome.",
            "- Thank you for helping Poke get better. Very cute and very appreciated."
        ].join("\n");

        const issueUrl = `https://codeberg.org/ashleyirispuppy/poke/issues/new?title=${encodeURIComponent(issueTitle)}&body=${encodeURIComponent(issueBody)}&labels=${encodeURIComponent(issueLabel)}`;
    %>

    <div id="error-container">

        <svg class="error-icon" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
        </svg>

        <h1>Video unavailable</h1>

        <p class="subtitle">
            <% if (isAgeRestricted) { %>
                this video is age-restricted. please try to watch this on youtube
            <% } else if (locals.error_message) { %>
                <% if (error_message === "Video unavailable.") { %>
                    Video unavailable - This Backend is blocked (╥﹏╥)
                <% } else { %>
                    <%= issueErrorMessage %>
                <% } %>
            <% } else { %>
                This video isn't available right now. (╥﹏╥)
            <% } %>
        </p>

        <% if (
            isAgeRestricted ||
            (locals.knownErrors && locals.err_reason && knownErrors[err_reason]) ||
            locals.err_reason === "LIVE_EVENT_UPCOMING" ||
            /this live event will begin in/i.test(issueErrorMessage)
        ) { %>
        <% } else { %>
            <div class="might-be">This usually happens because...</div>
            <ul class="reasons-list">
                <li>The video was removed by the uploader.</li>
                <li>The uploader closed their account.</li>
                <li>The video was taken down for Terms of Service violations.</li>
                <li>The video ID provided is invalid.</li>
            </ul>
        <% } %>

        <% if (hasMetadata) { %>
            <div class="metadata-wrapper">
                <p class="metadata-heading">You can still view the metadata</p>
                <div class="yt-metadata-card">
                    <% if (proxiedThumbUrl) { %>
                        <div class="yt-thumb-wrap">
                            <img class="yt-thumb" src="<%= proxiedThumbUrl %>" alt="<%= metaTitle || 'Video thumbnail' %>" loading="lazy" />
                        </div>
                    <% } %>

                    <% if (metaTitle) { %>
                        <h2 class="yt-meta-title"><%= metaTitle %></h2>
                    <% } %>

                    <% if (metaAuthor) { %>
                        <p class="yt-meta-author">
                                <%= metaAuthor %>
                        </p>
                    <% } %>
                </div>
            </div>
        <% } %>

        <div class="actions">
            <a class="btn-home" href="/home">Go Home</a>

            <% if (locals.v) { %>
                <a class="btn-youtube" href="https://www.youtube.com/watch?v=<%= encodeURIComponent(v) %>" target="_blank" rel="noopener noreferrer">Try on YouTube</a>
            <% } else { %>
                <a class="btn-youtube" href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer">Try on YouTube</a>
            <% } %>
        </div>

        <% if (!isAgeRestricted) { %>
            <div class="report-issue">
                Think this is a Poke mistake?<br>
                <a href="<%= issueUrl %>" target="_blank" rel="noopener noreferrer">Report an issue here</a>.
            </div>
        <% } %>

    </div>

</body>
</html>