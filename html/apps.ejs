<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>About Poke!</title>
  <meta name="description" content="Poke is privacy-first suite with a player, gif picker, maps, notes, calendar, weather, and more!!" />
  <meta name="theme-color" content="#151112" />
  
  <link href="https://p.poketube.fun/https://site-assets.fontawesome.com/releases/v6.1.1/css/all.css" rel="stylesheet" />
  
  <style>
    @font-face {
      font-family: "PokeTube Flex";
      src: url("/static/robotoflex.ttf");
      font-style: normal;
      font-stretch: 1% 800%;
      font-display: swap;
    }

    :root {
      --md-sys-color-primary: #ffabbc;
      --md-sys-color-on-primary: #3b0917;
      --md-sys-color-primary-container: #561d2b;
      --md-sys-color-on-primary-container: #ffd9df;
      
      --md-sys-color-surface: #151112;
      --md-sys-color-surface-dim: #100c0d;
      --md-sys-color-surface-container-low: #1e191a;
      --md-sys-color-surface-container: #241d1f;
      --md-sys-color-surface-container-high: #2f2628;
      --md-sys-color-surface-container-highest: #3b3033;
      
      --md-sys-color-on-surface: #f2dfe1;
      --md-sys-color-on-surface-variant: #c4afb2;
      --md-sys-color-outline: #544346;
      --md-sys-color-outline-variant: #382c2e;

      --spring-fast: 0.35s cubic-bezier(0.22, 1.35, 0.36, 1);
      --spring-spatial: 0.55s cubic-bezier(0.18, 1.15, 0.3, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      background-color: var(--md-sys-color-surface);
      color: var(--md-sys-color-on-surface);
      font-family: "PokeTube Flex", system-ui, -apple-system, sans-serif;
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
    }

    body {
      min-height: 100dvh;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
    }

    ::selection {
      background: var(--md-sys-color-primary);
      color: var(--md-sys-color-on-primary);
    }

    .hero-centered {
      position: relative;
      padding: clamp(56px, 9vw, 112px) 24px clamp(40px, 6vw, 72px);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid var(--md-sys-color-outline-variant);
      background: var(--md-sys-color-surface);
      overflow: hidden;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .hero-mascot {
      position: absolute;
      right: clamp(-40px, 2vw, 40px);
      top: 50%;
      transform: translateY(-50%);
      width: clamp(200px, 35vw, 450px);
      height: auto;
      z-index: 1;
      opacity: 0.25;
      pointer-events: none;
      filter: drop-shadow(0 12px 24px rgba(255, 171, 188, 0.1));
    }
    
    .hero-logo {
      width: clamp(100px, 15vw, 140px);
      height: auto;
      margin-bottom: 32px;
      filter: drop-shadow(0 4px 24px rgba(255, 171, 188, 0.15));
      transition: transform var(--spring-spatial), filter var(--spring-spatial);
      will-change: transform;
    }

    .hero-logo:hover {
      transform: scale(1.08) rotate(-4deg);
      filter: drop-shadow(0 8px 32px rgba(255, 171, 188, 0.25));
    }

    .hero-title {
      font-size: clamp(3rem, 8.5vw, 8.2rem);
      line-height: 0.95;
      text-transform: uppercase;
      letter-spacing: -0.03em;
      margin-bottom: 32px;
      user-select: none;
      cursor: default;
      position: relative;
    }

    .hero-title .line-main {
      display: block;
      font-variation-settings: "wdth" 145, "wght" 950, "slnt" 0;
      color: var(--md-sys-color-on-surface);
      position: relative;
      z-index: 2;
    }

    .hero-title .line-privately {
      display: inline-block;
      font-variation-settings: "wdth" 150, "wght" 950, "slnt" 0;
      background: var(--md-sys-color-primary);
      color: var(--md-sys-color-on-primary);
      text-transform: none;
      letter-spacing: 0.01em;
      margin-top: 14px;
      padding: 6px 28px;
      border-radius: 50px;
      transform: rotate(-2deg);
      position: relative;
      z-index: 2;
    }

    .hero-sub {
      font-size: clamp(1.1rem, 2vw, 1.5rem);
      color: var(--md-sys-color-on-surface-variant);
      font-variation-settings: "wdth" 115, "wght" 650;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* Editorial Split Grid for About & History */
    .story-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      width: 100%;
      background: var(--md-sys-color-surface);
    }

    .story-card {
      padding: clamp(40px, 6vw, 80px) clamp(24px, 5vw, 72px);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      position: relative;
    }

    .story-card:first-child {
      border-right: 1px solid var(--md-sys-color-outline-variant);
    }

    .story-header {
      display: flex;
      align-items: center;
      margin-bottom: 28px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--md-sys-color-outline-variant);
    }

    .story-card h2 {
      font-size: clamp(2rem, 3.8vw, 2.85rem);
      color: var(--md-sys-color-primary);
      text-transform: uppercase;
      font-variation-settings: "wdth" 135, "wght" 900;
      letter-spacing: -0.02em;
      line-height: 1;
    }

    .story-body {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .story-body p {
      font-size: 1.1rem;
      line-height: 1.75;
      color: var(--md-sys-color-on-surface-variant);
      font-variation-settings: "wdth" 100, "wght" 450;
    }

    .story-body p:first-child {
      color: var(--md-sys-color-on-surface);
      font-size: 1.2rem;
      font-variation-settings: "wdth" 102, "wght" 550;
    }

    .section-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px clamp(24px, 5vw, 72px);
      background: var(--md-sys-color-surface-dim);
      border-top: 1px solid var(--md-sys-color-outline-variant);
      border-bottom: 1px solid var(--md-sys-color-outline-variant);
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--md-sys-color-on-surface-variant);
      font-variation-settings: "wdth" 125, "wght" 700;
    }

    .apps-directory {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .app-row {
      display: grid;
      grid-template-columns: 90px 88px minmax(240px, 1.2fr) 1.5fr 96px;
      align-items: center;
      text-decoration: none;
      color: var(--md-sys-color-on-surface);
      background: var(--md-sys-color-surface);
      border-bottom: 1px solid var(--md-sys-color-outline-variant);
      min-height: 116px;
      padding: 16px clamp(16px, 4vw, 56px);
      position: relative;
      transition: background-color 0.2s ease, padding var(--spring-fast);
    }

    .app-row::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 0;
      background: var(--md-sys-color-primary);
      transition: width var(--spring-fast);
    }

    .app-row:hover,
    .app-row:focus-visible {
      background: var(--md-sys-color-surface-container);
      outline: none;
    }

    .app-row:hover::before,
    .app-row:focus-visible::before {
      width: 10px;
    }

    .app-index {
      font-size: 1.05rem;
      color: var(--md-sys-color-on-surface-variant);
      font-variation-settings: "wdth" 60, "wght" 600;
      transition: font-variation-settings var(--spring-fast), color 0.2s;
    }

    .app-row:hover .app-index,
    .app-row:focus-visible .app-index {
      color: var(--md-sys-color-primary);
      font-variation-settings: "wdth" 140, "wght" 900;
    }

    .app-shape {
      width: 60px;
      height: 60px;
      background: var(--md-sys-color-surface-container-high);
      color: var(--md-sys-color-primary);
      display: grid;
      place-items: center;
      font-size: 1.4rem;
      border-radius: 14px;
      transition: border-radius var(--spring-fast), background-color 0.2s, color 0.2s, transform var(--spring-fast);
    }

    .app-row:hover .app-shape,
    .app-row:focus-visible .app-shape {
      background: var(--md-sys-color-primary);
      color: var(--md-sys-color-on-primary);
      border-radius: 50%;
      transform: scale(1.08) rotate(-6deg);
    }

    .app-name {
      font-size: clamp(2rem, 3.6vw, 3.35rem);
      text-transform: uppercase;
      line-height: 0.95;
      letter-spacing: -0.02em;
      font-variation-settings: "wdth" 90, "wght" 780;
      transition: font-variation-settings var(--spring-spatial), color 0.2s, transform var(--spring-fast);
      padding-right: 24px;
    }

    .app-row:hover .app-name,
    .app-row:focus-visible .app-name {
      font-variation-settings: "wdth" 148, "wght" 950;
      color: var(--md-sys-color-primary);
    }

    .app-desc {
      font-size: 1.05rem;
      color: var(--md-sys-color-on-surface-variant);
      font-variation-settings: "wdth" 98, "wght" 450;
      display: flex;
      align-items: center;
      gap: 14px;
      padding-right: 16px;
    }

    .app-tag {
      display: inline-block;
      font-size: 0.75rem;
      text-transform: uppercase;
      padding: 4px 8px;
      background: var(--md-sys-color-primary-container);
      color: var(--md-sys-color-on-primary-container);
      border-radius: 4px;
      font-variation-settings: "wdth" 130, "wght" 800;
      letter-spacing: 0.05em;
      flex-shrink: 0;
    }

    .app-go {
      justify-self: end;
      width: 52px;
      height: 52px;
      display: grid;
      place-items: center;
      border: 1px solid var(--md-sys-color-outline);
      border-radius: 10px;
      color: var(--md-sys-color-on-surface-variant);
      font-size: 1.1rem;
      transition: all var(--spring-fast);
    }

    .app-row:hover .app-go,
    .app-row:focus-visible .app-go {
      background: var(--md-sys-color-on-surface);
      color: var(--md-sys-color-surface);
      border-color: var(--md-sys-color-on-surface);
      transform: translateX(6px);
    }
    
    .site-footer {
      margin-top: auto;
      padding: 64px 24px;
      text-align: center;
      background: var(--md-sys-color-surface-dim);
      border-top: 1px solid var(--md-sys-color-outline-variant);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .site-footer p {
      color: var(--md-sys-color-on-surface-variant);
      font-size: 0.95rem;
      line-height: 1.5;
      max-width: 600px;
    }

    .site-footer a {
      color: var(--md-sys-color-primary);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s, text-decoration 0.2s;
    }

    .site-footer a:hover {
      color: var(--md-sys-color-on-surface);
      text-decoration: underline;
    }

    .footer-msg {
      font-size: 1.15rem !important;
      color: var(--md-sys-color-on-surface) !important;
      font-variation-settings: "wdth" 105, "wght" 550;
      margin-bottom: 12px;
    }

    .footer-anti-ai {
      margin-top: 16px;
      font-variation-settings: "wdth" 110, "wght" 700;
      color: var(--md-sys-color-primary) !important;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.85rem !important;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::after, ::before {
        transition: none !important;
      }
    }

    @media (max-width: 1080px) {
      .app-row {
        grid-template-columns: 52px 72px 1fr 56px;
        row-gap: 8px;
        padding: 22px 24px;
      }
      .app-desc {
        grid-column: 3 / 5;
        padding-top: 4px;
      }
      .app-go {
        grid-column: 4;
        grid-row: 1;
      }
    }

    @media (max-width: 900px) {
      .story-grid {
        grid-template-columns: 1fr;
      }
      .story-card:first-child {
        border-right: none;
        border-bottom: 1px solid var(--md-sys-color-outline-variant);
      }
    }

    @media (max-width: 640px) {
      .app-row {
        grid-template-columns: 64px 1fr 48px;
      }
      .app-index {
        display: none;
      }
      .app-desc {
        grid-column: 2 / 4;
      }
      .app-go {
        grid-column: 3;
        grid-row: 1;
      }
    }
  </style>
</head>
<body>

  <header class="hero-centered">
    <img src="/static/poke-mascot-new.webp?v=2" alt="Poke Mascot" class="hero-mascot" />
    <div class="hero-content">
