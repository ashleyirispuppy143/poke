    <p>You can see our source code here: <br/><a href="https://codeberg.org/ashleyirispuppy/poke/" target="_blank" rel="noopener">https://codeberg.org/ashleyirispuppy/poke/</a></p>
    <p class="footer-anti-ai">Poke is proudly <strong>not</strong> AI slop</p>
  </footer>

  <script>
    (function(){
      const rows = Array.from(document.querySelectorAll('.app-row'));
      rows.forEach((row, idx) => {
        row.tabIndex = 0;
        row.addEventListener('keydown', e => {
          let targetIdx = null;
          if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
            targetIdx = (idx + 1) % rows.length;
          } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
            targetIdx = (idx - 1 + rows.length) % rows.length;
          } else if (e.key === 'Home') {
            targetIdx = 0;
          } else if (e.key === 'End') {
            targetIdx = rows.length - 1;
          } else if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            row.click();
            return;
          }

          if (targetIdx !== null) {
            e.preventDefault();
            rows[targetIdx].focus();
          }
        });
      });
    })();
  </script>
</body>
</html>