<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Poke! Games Hub</title>
  <style>
    @font-face {
      font-family: "PokeTube Flex";
      src: url("/static/robotoflex.ttf?v=29");
      font-style: normal;
      font-stretch: 1% 800%;
      font-display: swap;
    }
    :root {
      --bg: #160e11;
      --surface-1: #22161b;
      --surface-2: #2e1e24;
      --surface-3: #3c272f;
      --primary: #ffb0cd;
      --on-primary: #541d34;
      --primary-container: #70334b;
      --on-primary-container: #ffd8e4;
      --text: #f3dfe4;
      --muted: #cfb8be;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100%; }
    body {
      background: var(--bg);
      font-family: "PokeTube Flex", system-ui, -apple-system, sans-serif;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      display: flex;
      flex-direction: column;
    }
    .app-shell {
      display: grid;
      grid-template-columns: 260px 1fr;
      min-height: 100vh;
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      gap: 24px;
      padding: 24px;
    }
    .nav-drawer {
      background: var(--surface-1);
      border-radius: 32px;
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: calc(100vh - 48px);
      position: sticky;
      top: 24px;
    }
    .brand-box {
      padding: 8px 16px 24px;
    }
    .brand-box h1 {
      font-size: 1.65rem;
      font-weight: 800;
      color: var(--primary);
      letter-spacing: -0.5px;
      line-height: 1.15;
    }
    .nav-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      border-radius: 20px;
      background: transparent;
      border: none;
      color: var(--muted);
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      text-align: left;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .nav-item:hover {
      background: var(--surface-2);
      color: var(--text);
    }
    .nav-item.active {
      background: var(--primary);
      color: var(--on-primary);
    }
    .drawer-footer {
      padding: 16px;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--muted);
      line-height: 1.4;
      background: var(--surface-2);
      border-radius: 20px;
    }
    .main-view {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      background: var(--surface-1);
      padding: 16px 24px;
      border-radius: 28px;
    }
    .search-box {
      flex: 1;
      max-width: 420px;
      position: relative;
    }
    .search-box input {
      width: 100%;
      background: var(--surface-2);
      border: none;
      border-radius: 20px;
      padding: 14px 20px;
      color: var(--text);
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 600;
      outline: none;
    }
    .search-box input::placeholder { color: var(--muted); opacity: 0.7; }
    .search-box input:focus { background: var(--surface-3); }

    .overview-slider {
      position: relative;
      background: var(--surface-1);
      border-radius: 36px;
      overflow: hidden;
      min-height: 270px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 34px 38px;
    }
    .slides-track {
      position: relative;
      flex: 1;
      display: flex;
      align-items: center;
    }
    .overview-slide {
      display: none;
      width: 100%;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      flex-wrap: wrap;
      animation: slideFade 0.35s cubic-bezier(0.2, 0, 0, 1);
    }
    .overview-slide.active {
      display: flex;
    }
    @keyframes slideFade {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .slide-left {
      display: flex;
      align-items: center;
      gap: 26px;
      max-width: 680px;
    }
     .slide-emblem {
      width: 100px;
      height: 100px;
      border-radius: 30px;
      display: grid;
      place-items: center;
      font-size: 3.4rem;
      flex-shrink: 0;
     }
    .slide-meta {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .slide-pill-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .slide-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--primary-container);
      color: var(--on-primary-container);
      font-size: 0.74rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 6px 12px;
      border-radius: 99px;
    }
    .slide-pill.secondary {
      background: var(--surface-3);
      color: var(--muted);
    }
    .spotlight-title {
      font-size: 2.35rem;
      font-weight: 800;
      color: var(--primary);
      letter-spacing: -0.6px;
      line-height: 1.08;
    }
    .spotlight-sub {
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.55;
    }
    .spotlight-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .play-now-btn {
      background: var(--primary);
      color: var(--on-primary);
      text-decoration: none;
      padding: 16px 28px;
      border-radius: 24px;
      font-weight: 800;
      font-size: 1rem;
      transition: transform 0.15s ease, background 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      white-space: nowrap;
    }
    .play-now-btn:hover { transform: scale(1.03); background: #ffc4da; }
    .slider-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 22px;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    .slider-dots {
      display: flex;
      gap: 8px;
    }
    .slider-dot {
      width: 10px;
      height: 10px;
      border-radius: 99px;
      border: none;
      background: var(--surface-3);
      cursor: pointer;
      transition: width 0.25s ease, background 0.2s ease;
    }
    .slider-dot.active {
      width: 30px;
      background: var(--primary);
    }
    .slider-arrows {
      display: flex;
      gap: 8px;
    }
    .slider-arrow {
      width: 38px;
      height: 38px;
      border-radius: 14px;
      border: none;
      background: var(--surface-2);
      color: var(--text);
      font-family: inherit;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      display: grid;
      place-items: center;
      transition: background 0.15s ease, transform 0.12s ease;
    }
    .slider-arrow:hover {
      background: var(--primary-container);
      color: var(--on-primary-container);
      transform: scale(1.05);
    }

    .game-container {
      display: grid;
      gap: 18px;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
    .game {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
      background: var(--surface-1);
      border-radius: 32px;
      padding: 24px;
      text-decoration: none;
      color: var(--text);
      min-height: 210px;
      transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), background 0.2s ease;
      outline: none;
      overflow: hidden;
    }
    .game:hover { transform: translateY(-4px); background: var(--surface-2); }
    .game:active { transform: scale(0.98); }
    .game:focus-visible { outline: 3px solid var(--primary); outline-offset: 2px; }
    .row-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .icon {
      font-size: 2.2rem;
      line-height: 1;
      background: var(--surface-2);
      width: 64px;
      height: 64px;
      border-radius: 22px;
      display: grid;
      place-items: center;
      transition: background 0.2s ease;
    }
    .game:hover .icon { background: var(--surface-3); }
    .info-btn {
      height: 44px;
      width: 44px;
      display: inline-grid;
      place-items: center;
      background: var(--surface-2);
      border: none;
      border-radius: 18px;
      color: var(--primary);
      cursor: pointer;
      font-size: 1.1rem;
      transition: background 0.15s ease, transform 0.1s ease;
    }
    .info-btn:hover { background: var(--primary-container); color: var(--on-primary-container); }
    .card-body { display: flex; flex-direction: column; gap: 6px; }
    .title { font-size: 1.35rem; font-weight: 800; color: var(--text); }
    .subtitle { color: var(--muted); font-size: 0.92rem; line-height: 1.45; }

    .info-modal {
      position: absolute;
      inset: 0;
      background: rgba(22, 14, 17, 0.96);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      backdrop-filter: blur(8px);
      z-index: 10;
    }
    .hidden { display: none !important; }
    .info-content {
      background: var(--surface-2);
      border-radius: 24px;
      padding: 20px;
      width: 100%;
      font-size: 0.92rem;
      line-height: 1.5;
      color: var(--text);
    }
    .close-row { display: flex; justify-content: flex-end; margin-top: 14px; }
    .close-info {
      border: none;
      background: var(--primary);
      color: var(--on-primary);
      padding: 10px 18px;
      font-family: inherit;
      font-weight: 700;
      font-size: 0.85rem;
      border-radius: 16px;
      cursor: pointer;
    }

    @media (max-width: 900px) {
      .app-shell { grid-template-columns: 1fr; padding: 16px; }
      .nav-drawer { height: auto; position: static; flex-direction: column; gap: 16px; }
      .nav-list { flex-direction: row; flex-wrap: wrap; }
      .nav-item { flex: 1 1 auto; justify-content: center; }
      .slide-left { flex-direction: column; align-items: flex-start; gap: 16px; }
    }
  </style>
</head>
<body>
  <div class="app-shell" role="region" aria-label="Poke Games Hub">
