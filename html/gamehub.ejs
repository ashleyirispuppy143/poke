<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>POKE SNAKE v2.1.1</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=no">
  <link href="https://fonts.bunny.net/css2?family=Roboto+Flex:opsz,wght@8..144,400..800&family=Roboto+Mono:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #160e11;
      --surface-1: #24171c;
      --surface-2: #312026;
      --surface-3: #3f2931;
      --primary: #ffb0cd;
      --on-primary: #541d34;
      --primary-container: #70334b;
      --on-primary-container: #ffd8e4;
      --text: #f0dee3;
      --muted: #d6c2c7;
      --danger: #ffb4ab;
      --on-danger: #690005;
    }

    html, body {
      margin: 0; padding: 0; background: var(--bg-color);
      font-family: 'Roboto Flex', system-ui, -apple-system, sans-serif; color: var(--text);
      overflow: hidden; user-select: none; touch-action: none;
    }

    #game-container { position: relative; width: 100vw; height: 100vh; display: flex; align-items: center; justify-content: center; }

    #snakeCanvas {
      background: var(--bg-color); display: block;
    }

    .screen {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(22, 14, 17, 0.88);
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; z-index: 100; text-align: center;
      backdrop-filter: blur(16px);
    }

    .hidden { display: none !important; }

    .logo-container { position: relative; margin-bottom: 36px; }
    .logo-text {
      font-size: 68px; font-weight: 800; line-height: 1.05; letter-spacing: -1.5px; margin: 0;
      color: var(--primary);
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    .splash-text {
      position: absolute;
      bottom: -10px;
      right: -55px;
      color: #ffdf9e;
      background: transparent;
      font-size: 15px;
      font-weight: 800;
      text-shadow: 0 2px 8px rgba(0,0,0,0.85);
      transform: rotate(-14deg);
      animation: splashBounce 0.6s alternate infinite ease-in-out;
      white-space: nowrap;
      pointer-events: none;
      z-index: 10;
    }

    @keyframes splashBounce {
      from { transform: scale(1) rotate(-14deg); }
      to { transform: scale(1.08) rotate(-14deg); }
    }

    .version-tag {
      font-size: 14px; font-weight: 600; color: var(--muted);
      margin-top: 12px; opacity: 0.8;
    }

    .title-menu { display: flex; flex-direction: column; gap: 12px; width: 280px; }

    #titlePrompt {
      font-size: 16px; font-weight: 600; color: var(--primary);
      animation: blink 1.5s ease-in-out infinite; margin-top: 20px;
    }

    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

    #startPrompt {
      position: absolute; top: 65%; left: 50%; transform: translate(-50%, -50%);
      font-size: 15px; font-weight: 700; color: var(--on-primary-container);
      animation: blink 1.5s ease-in-out infinite; pointer-events: none; z-index: 60;
      background: var(--primary-container); padding: 14px 24px; border-radius: 24px;
    }

    button {
      background: var(--surface-2); color: var(--text);
      border: none; padding: 16px 24px; cursor: pointer;
      font-family: inherit; font-size: 15px; font-weight: 700;
      border-radius: 24px;
      transition: transform 0.15s cubic-bezier(0.2, 0, 0, 1), background 0.15s ease;
    }

    button:hover {
      background: var(--primary); color: var(--on-primary);
      transform: scale(1.02);
    }

    button:active { transform: scale(0.97); }

    #btnPlayTitle, #saveSettings {
      background: var(--primary); color: var(--on-primary);
    }
    #btnPlayTitle:hover, #saveSettings:hover {
      background: #ffc2d9;
    }

    #scoreboard {
      position: absolute; top: 20px; left: 20px; z-index: 50;
      white-space: nowrap; color: var(--text);
      background: var(--surface-2); padding: 14px 22px;
      border-radius: 24px; font-size: 15px; font-weight: 700;
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    }

    #topRightControls {
      position: absolute; top: 20px; right: 20px; z-index: 50;
      display: flex; align-items: center; gap: 10px;
    }

    .icon-btn {
      font-size: 18px; font-weight: 700; cursor: pointer;
      background: var(--surface-2); width: 48px; height: 48px;
      border-radius: 20px;
      transition: all 0.2s ease; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    }

    .icon-btn:hover {
      background: var(--primary-container);
      transform: scale(1.05);
    }

    .modal {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      background: var(--surface-1);
      padding: 32px; display: none; z-index: 200; width: min(640px, 92vw); max-height: 90vh; overflow-y: auto;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5); border-radius: 36px;
    }

    .modal h2 {
      margin: 0 0 24px 0; text-align: center; font-size: 24px; font-weight: 800;
      color: var(--primary);
    }

    #levelGrid {
      display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin: 20px 0 28px 0;
    }

    .lvl-btn {
      margin: 0; padding: 0; height: 56px; font-size: 16px; font-weight: 700;
      background: var(--surface-2); color: #6e5a60;
      display: flex; align-items: center; justify-content: center;
      cursor: not-allowed; border-radius: 20px;
    }

    .lvl-btn.unlocked { color: var(--text); cursor: pointer; background: var(--surface-3); }

    .lvl-btn.unlocked:hover {
      background: var(--primary-container); color: var(--on-primary-container);
      transform: scale(1.04);
    }

    .lvl-btn.selected {
      background: var(--primary); color: var(--on-primary);
      transform: scale(1.05);
    }

    .settings-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;
    }

    .settings-card {
      background: var(--surface-2);
      padding: 20px; border-radius: 28px; text-align: left;
    }

    .settings-card h3 {
      margin: 0 0 16px 0; font-size: 13px; font-weight: 800; color: var(--primary);
      letter-spacing: 0.8px;
    }

    .setting-row {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 14px; font-weight: 600; margin-bottom: 14px; gap: 16px;
    }

    .setting-row:last-child { margin-bottom: 0; }

    .setting-info { display: flex; flex-direction: column; gap: 4px; }
    .setting-desc { font-size: 11px; font-weight: 400; color: var(--muted); max-width: 150px; line-height: 1.3; }

    select, input[type="number"], input[type="color"] {
      background: var(--surface-3); color: var(--text); border: none;
      font-family: inherit; font-size: 13px; font-weight: 600; padding: 10px 14px; outline: none; width: 125px;
      border-radius: 16px; cursor: pointer;
    }

    input[type="color"] { padding: 4px; height: 38px; }

    input[type="range"] { accent-color: var(--primary); width: 130px; cursor: pointer; }

    .modal-footer { display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; }
    .modal-footer button { flex: 1; margin: 0; padding: 16px; }

    .btn-cancel { background: var(--surface-2); color: var(--muted); }
    .btn-cancel:hover { background: var(--danger); color: var(--on-danger); }

    #gameOverText { font-size: 56px; font-weight: 800; color: var(--danger); margin-bottom: 12px; }

    #debugMenu {
      position: absolute; top: 82px; left: 20px;
      color: var(--text); background: rgba(36, 23, 28, 0.92);
      padding: 16px; border-radius: 24px;
      font-family: 'Roboto Mono', monospace; font-size: 11px; line-height: 1.5;
      white-space: pre; z-index: 300; display: none;
      pointer-events: none; backdrop-filter: blur(8px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.4);
    }
  </style>
</head>
<body>
  <div id="game-container">
    <div id="titleScreen" class="screen">
      <div class="logo-container">
        <h1 class="logo-text">POKE<br>SNAKE</h1>
        <div id="splashText" class="splash-text"></div>
        <div class="version-tag">v2.1.1</div>
      </div>

      <div class="title-menu" id="titleMenu">
        <button id="btnPlayTitle">Play Game</button>
        <button id="btnLevelTitle">Sandbox Levels</button>
        <button id="btnSettingsTitle">Settings</button>
      </div>

      <p id="titlePrompt" class="hidden">Press Any Key to Start</p>
    </div>

    <div id="scoreboard">Score: 0  High: 0  Level: 1</div>

    <div id="topRightControls" class="hidden">
      <div id="debugBtn" class="icon-btn" title="Toggle Debug Info (D or F3)">🐛</div>
      <div id="openLevelBtn" class="icon-btn" title="Select Level">🎚️</div>
      <div id="settingsBtn" class="icon-btn" title="Settings">⚙️</div>
    </div>

    <canvas id="snakeCanvas"></canvas>

    <div id="startPrompt" class="hidden">PRESS ARROW KEY TO START</div>

    <div id="gameOverScreen" class="screen hidden">
      <h1 id="gameOverText">GAME OVER!</h1>
      <p style="margin-bottom: 25px; font-size: 16px; font-weight: 600; color: var(--muted);">Press [R] to Retry</p>
      <button id="backToTitle">Main Menu</button>
    </div>

    <div id="levelModal" class="modal">
      <h2 id="levelModalTitle">Select Level</h2>
      <div id="levelGrid"></div>
      <div class="modal-footer">
        <button id="closeLevelModal" class="btn-cancel">Close</button>
      </div>
    </div>

    <div id="settingsModal" class="modal">
      <h2>System Config</h2>

      <div class="settings-grid">
        <div class="settings-card">
          <h3>GAMEPLAY</h3>

          <div class="setting-row">
            <div class="setting-info">
              <span>Speed</span>
            </div>
            <select id="paramSpeed">
              <option value="150">Slow</option>
              <option value="100" selected>Normal</option>
              <option value="50">Fast</option>
              <option value="30">Extra Hard</option>
            </select>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span>Assist Mode</span>
              <span class="setting-desc">Auto-dodges to prevent death.</span>
            </div>
            <select id="paramAssist">
              <option value="off" selected>Off</option>
              <option value="on">On</option>
            </select>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span>Wall Mode</span>
            </div>
            <select id="paramWallMode">
              <option value="kill" selected>Die on Hit</option>
              <option value="wrap">Wrap Around</option>
            </select>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span>Start Length</span>
            </div>
            <input type="number" id="paramStartLength" min="1" max="20" value="3">
          </div>
        </div>

        <div class="settings-card">
          <h3>SYSTEM & UI</h3>

          <div class="setting-row">
            <div class="setting-info"><span>Auto-Start</span></div>
            <select id="paramAutoStart">
              <option value="off" selected>Off</option>
              <option value="on">On</option>
            </select>
          </div>

          <div class="setting-row">
            <div class="setting-info"><span>Start Prompt</span></div>
            <select id="paramShowPrompt">
              <option value="on" selected>On</option>
              <option value="off">Off</option>
            </select>
          </div>

          <div class="setting-row">
            <div class="setting-info"><span>Head Color</span></div>
            <input type="color" id="paramHeadColor" value="#ffb0cd">
          </div>

          <div class="setting-row">
            <div class="setting-info"><span>Body Color</span></div>
            <input type="color" id="paramBodyColor" value="#d97a9e">
          </div>
        </div>

        <div class="settings-card" style="grid-column: 1 / -1;">
          <h3>AUDIO</h3>
          <div class="setting-row" style="justify-content: flex-start; gap: 40px; flex-wrap: wrap;">
            <div class="setting-info" style="flex-direction: row; align-items: center; gap: 15px;">
              <span>Sound FX</span>
              <select id="paramSfx" style="width: 90px;">
                <option value="on" selected>On</option>
                <option value="off">Off</option>
              </select>
            </div>
            <div class="setting-info" style="flex-direction: row; align-items: center; gap: 15px;">
              <span>Volume</span>
              <input type="range" id="paramSfxVolume" min="0" max="1" step="0.1" value="1" style="width: 150px;">
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button id="saveSettings">Apply Changes</button>
        <button id="closeSettings" class="btn-cancel">Discard</button>
      </div>
    </div>

    <div id="debugMenu"></div>
  </div>

  <script>
    const canvas           = document.getElementById('snakeCanvas'),
          ctx              = canvas.getContext('2d'),
          titleScreen      = document.getElementById('titleScreen'),
          titleMenu        = document.getElementById('titleMenu'),
          titlePrompt      = document.getElementById('titlePrompt'),
          startPrompt      = document.getElementById('startPrompt'),
          splashText       = document.getElementById('splashText'),
          topRightControls = document.getElementById('topRightControls'),
          gameOverScreen   = document.getElementById('gameOverScreen'),
          gameOverText     = document.getElementById('gameOverText'),
          scoreboard       = document.getElementById('scoreboard'),
          debugBtn         = document.getElementById('debugBtn'),
          settingsBtn      = document.getElementById('settingsBtn'),
          btnSettingsTitle = document.getElementById('btnSettingsTitle'),
          openLevelBtn     = document.getElementById('openLevelBtn'),
          btnLevelTitle    = document.getElementById('btnLevelTitle'),
          btnPlayTitle     = document.getElementById('btnPlayTitle'),
          levelModal       = document.getElementById('levelModal'),
          levelModalTitle  = document.getElementById('levelModalTitle'),
          closeLevelBtn    = document.getElementById('closeLevelModal'),
          settingsModal    = document.getElementById('settingsModal'),
          saveBtn          = document.getElementById('saveSettings'),
          closeBtn         = document.getElementById('closeSettings'),
          backToTitle      = document.getElementById('backToTitle'),
          debugMenu        = document.getElementById('debugMenu');

    const splashes = [
      "100% bug free!",
      "Sss-ss-sss!",
      "Don't bite your tail!",
      "Pixel perfect!",
      "Try Extra Hard!",
    ];
    splashText.textContent = splashes[Math.floor(Math.random() * splashes.length)];

    let params = {
      speed: 100, sfx: true, startLength: 3,
      wallMode: 'kill', assistMode: false,
      sfxVolume: 1, showPrompt: true, autoStart: false,
      headColor: '#ffb0cd', bodyColor: '#d97a9e'
    };

    let snake, dir, food, score, highScore = parseInt(localStorage.getItem('pokeSnakeHigh')) || 0, level;
    let state = 'start', startTime = 0;
    const endMessages = ["SKILL ISSUE!","SNAKE BIT YA!","SSSORRY, TRY AGAIN!","FATAL COLLISION!"];
    let fps = 0, frameCount = 0, lastFpsTime = Date.now();
    let movesCount = 0, framesSinceFood = 0;

    let hasPlayedOnce = false;
    let hasStartedMoving = false;
    let maxUnlockedLevel = parseInt(localStorage.getItem('pokeSnakeMaxLevel')) || 1;
    let selectedStartingLevel = 1;

    let reqAnimFrameId;
    let lastTime = 0;
    let accumulator = 0;
    let currentTickRate = params.speed;
    let inputQueue = [];
    let lastProcessedDir = {x: 0, y: -1};
    let sharedAudioCtx = null;

    function toggleDebug() {
      debugMenu.style.display = debugMenu.style.display === 'block' ? 'none' : 'block';
      if (state === 'playing') updateDebugMenu();
    }

    debugBtn.addEventListener('click', toggleDebug);

    function buildLevelGrid(isSandboxContext) {
      const grid = document.getElementById('levelGrid');
      grid.innerHTML = '';
      const totalDisplayLevels = 20;

      levelModalTitle.textContent = isSandboxContext ? "Sandbox (All Unlocked)" : "Select Level";

      for (let i = 1; i <= totalDisplayLevels; i++) {
        const btn = document.createElement('button');
        btn.className = 'lvl-btn';
        btn.textContent = i;

        if (isSandboxContext || i <= maxUnlockedLevel) {
          btn.classList.add('unlocked');
          if (i === selectedStartingLevel) btn.classList.add('selected');

          btn.addEventListener('click', () => {
            selectedStartingLevel = i;
            document.querySelectorAll('.lvl-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');

            levelModal.style.display = 'none';

            if(state === 'start') {
              startGame();
            } else if (state === 'playing') {
              initGame();
            }
          });
        } else {
          btn.title = "Locked - Reach higher scores to unlock!";
        }
        grid.appendChild(btn);
      }
    }

    function resizeCanvas() {
      canvas.width = Math.floor(window.innerWidth / 24) * 24;
      canvas.height = Math.floor(window.innerHeight / 24) * 24;
      if (food) {
        const cols = canvas.width / 24, rows = canvas.height / 24;
        if (food.x >= cols || food.y >= rows) pickFood();
      }
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function pickFood() {
      const cols = Math.floor(canvas.width / 24);
      const rows = Math.floor(canvas.height / 24);
      let validFood = false;
      let padding = (params.speed <= 30) ? 0 : 2;

      if (cols <= padding * 2 || rows <= padding * 2) {
        padding = 0;
      }

      while (!validFood) {
        let fx = padding + Math.floor(Math.random() * (cols - 2 * padding));
        let fy = padding + Math.floor(Math.random() * (rows - 2 * padding));
        food = { x: fx, y: fy };
        validFood = !snake.some(seg => seg.x === food.x && seg.y === food.y);
      }
      framesSinceFood = 0;
    }

    function showMainMenu() {
      gameOverScreen.classList.add('hidden');
      titleScreen.classList.remove('hidden');
      topRightControls.classList.add('hidden');
      startPrompt.classList.add('hidden');
      state = 'start';

      if (hasPlayedOnce) {
        titleMenu.classList.add('hidden');
        titlePrompt.classList.remove('hidden');
        splashText.style.display = 'none';
      } else {
        titleMenu.classList.remove('hidden');
        titlePrompt.classList.add('hidden');
      }
    }

    function startGame() {
      hasPlayedOnce = true;
      titleScreen.classList.add('hidden');
      topRightControls.classList.remove('hidden');
      state = 'playing';
      initGame();
    }

    function initGame() {
      const cols = canvas.width / 24;
      const rows = canvas.height / 24;
      const startX = Math.floor(cols / 2);
      const startY = Math.floor(rows / 2);

      snake = [];
      for(let i = 0; i < params.startLength; i++){
        snake.push({x: startX, y: startY + i});
      }

      dir = {x: 0, y: -1};
      lastProcessedDir = {x: 0, y: -1};
      inputQueue = [];
      pickFood();
      score = 0;
      level = selectedStartingLevel;
      movesCount = 0;
      framesSinceFood = 0;
      frameCount = 0;
      fps = 0;
      lastFpsTime = Date.now();

      if (params.autoStart) {
        hasStartedMoving = true;
        startPrompt.classList.add('hidden');
        startTime = Date.now();
      } else {
        hasStartedMoving = false;
        if(params.showPrompt) {
          startPrompt.classList.remove('hidden');
        } else {
          startPrompt.classList.add('hidden');
        }
      }

      currentTickRate = params.speed * Math.pow(0.98, (level - 1) * 5);
      updateScoreboard();

      if (reqAnimFrameId) cancelAnimationFrame(reqAnimFrameId);
      lastTime = performance.now();
      accumulator = 0;
      reqAnimFrameId = requestAnimationFrame(gameLoop);
    }

    function drawRoundedCell(x, y, size, radius, color) {
      ctx.fillStyle = color;
      ctx.beginPath();
      if (ctx.roundRect) {
        ctx.roundRect(x, y, size, size, radius);
      } else {
        ctx.rect(x, y, size, size);
      }
      ctx.fill();
    }

    function draw(){
      ctx.fillStyle = '#160e11';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      const pulse = 1 + Math.sin(Date.now() / 160) * 0.12;
      ctx.save();
      ctx.translate(food.x * 24 + 12, food.y * 24 + 12);
      ctx.scale(pulse, pulse);
      ctx.fillStyle = '#ff5470';
      ctx.beginPath();
      ctx.arc(0, 0, 9, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      snake.forEach((seg, i) => {
        const isHead = i === 0;
        drawRoundedCell(
          seg.x * 24 + 2,
          seg.y * 24 + 2,
          20,
          isHead ? 8 : 6,
          isHead ? params.headColor : params.bodyColor
        );
      });
    }

    function processInput() {
      if (inputQueue.length > 0) {
        dir = inputQueue.shift();
        lastProcessedDir = dir;
      }
    }

    function update(){
      if(!hasStartedMoving) return;

      processInput();

      const cols = canvas.width / 24, rows = canvas.height / 24;

      if (params.assistMode) {
        let danger = false;
        let testNextX = snake[0].x + dir.x;
        let testNextY = snake[0].y + dir.y;

        if (params.wallMode === 'kill') {
          if (testNextX < 0 || testNextX >= cols || testNextY < 0 || testNextY >= rows) danger = true;
        } else {
          testNextX = (testNextX + cols) % cols;
          testNextY = (testNextY + rows) % rows;
        }

        if (snake.some((s,i) => i > 0 && s.x === testNextX && s.y === testNextY)) danger = true;

        if (danger) {
          const alternativeTurns = dir.x === 0 ? [{x:-1, y:0}, {x:1, y:0}] : [{x:0, y:-1}, {x:0, y:1}];
          for (let t of alternativeTurns) {
            let altX = snake[0].x + t.x;
            let altY = snake[0].y + t.y;
            let safe = true;

            if (params.wallMode === 'kill') {
              if (altX < 0 || altX >= cols || altY < 0 || altY >= rows) safe = false;
            } else {
              altX = (altX + cols) % cols;
              altY = (altY + rows) % rows;
            }

            if (snake.some((s,i) => i > 0 && s.x === altX && s.y === altY)) safe = false;

            if (safe) {
              dir = t;
              lastProcessedDir = dir;
              break;
            }
          }
        }
      }

      const head = {x: snake[0].x + dir.x, y: snake[0].y + dir.y};

      if(params.wallMode === 'wrap'){
        head.x = (head.x + cols) % cols;
        head.y = (head.y + rows) % rows;
      } else if(head.x < 0 || head.x >= cols || head.y < 0 || head.y >= rows){
        return endGame();
      }

      if(snake.some((s,i) => i > 0 && s.x === head.x && s.y === head.y)){
        return endGame();
      }

      snake.unshift(head);
      movesCount++;

      if(head.x === food.x && head.y === food.y){
        score++;
        if(score > 0 && score % 5 === 0) {
          level++;
          if (level > maxUnlockedLevel) {
            maxUnlockedLevel = level;
            localStorage.setItem('pokeSnakeMaxLevel', maxUnlockedLevel);
          }
          currentTickRate = Math.max(30, currentTickRate * 0.98);
        }
        updateScoreboard();
        pickFood();
        if(params.sfx) playBeep(520, 0.08);
      } else {
        snake.pop();
      }
    }

    function recordFrame(){
      const now = Date.now();
      frameCount++;
      if(hasStartedMoving) framesSinceFood++;
      if(now - lastFpsTime >= 1000){
        fps = frameCount; frameCount = 0; lastFpsTime = now;
      }
    }

    function updateDebugMenu(){
      if(debugMenu.style.display !== 'block') return;
      const head = snake[0], tail = snake[snake.length-1],
            cols = canvas.width / 24, rows = canvas.height / 24,
            cells = cols * rows,
            elapsedMs = hasStartedMoving ? (Date.now() - startTime) : 0,
            elapsedS = Math.floor(elapsedMs / 1000),
            avgRate = elapsedS > 0 ? (score / elapsedS).toFixed(2) : 'N/A',
            frameTime = fps > 0 ? (1000 / fps).toFixed(1) : 'N/A',
            cores = navigator.hardwareConcurrency || 'N/A',
            ua = navigator.userAgent,
            vis = document.visibilityState,
            focus = document.hasFocus(),
            heap = performance.memory
              ? (performance.memory.usedJSHeapSize/1024/1024).toFixed(2)+'/'+
                (performance.memory.jsHeapSizeLimit/1024/1024).toFixed(2)+'MB'
              : 'N/A',
            diff = params.speed>=150?'Easy':params.speed>=100?'Normal':params.speed<=30?'Extra Hard':'Hard';

      let fpsColor = fps >= 50 ? '#ffb0cd' : fps >= 30 ? '#ffdf9e' : '#ffb4ab';

      debugMenu.innerHTML =
        `Poke Snake v2.1.1 on ${diff} \n\n` +
        `<span style="color:${fpsColor}">FPS: ${fps}</span>\n` +
        `FrameTime: ${frameTime}ms\n` +
        `Head: ${head.x},${head.y}\n` +
        `Tail: ${tail.x},${tail.y}\n` +
        `Dir: ${dir.x},${dir.y}\n` +
        `DistToFood: ${Math.abs(head.x-food.x)+Math.abs(head.y-food.y)}\n` +
        `FramesSinceFood: ${framesSinceFood}\n` +
        `Moves: ${movesCount}\n` +
        `Moves/s: ${elapsedS>0?(movesCount/elapsedS).toFixed(2):'N/A'}\n` +
        `SnakeLen: ${snake.length}\n` +
        `Occupancy: ${(snake.length/cells*100).toFixed(1)}%\n` +
        `Cells: ${cells}\n` +
        `Canvas: ${cols}×${rows}\n` +
        `Time: ${elapsedS}s\n` +
        `AvgRate: ${avgRate} pts/s\n` +
        `Score: ${score}\n` +
        `Level: ${level} (Max: ${maxUnlockedLevel})\n` +
        `HighScore: ${highScore}\n` +
        `TickRate(ms): ${Math.round(currentTickRate)}\n` +
        `StartLen: ${params.startLength}\n` +
        `Wall: ${params.wallMode}\n` +
        `Assist: ${params.assistMode}\n` +
        `SFXVol: ${params.sfxVolume}\n` +
        `Heap: ${heap}\n` +
        `Cores: ${cores}\n` +
        `VisState: ${vis}\n` +
        `HasFocus: ${focus}\n` +
        `Resolution: ${window.innerWidth}×${window.innerHeight}\n` +
        `UA: ${ua}`;
    }

    function gameLoop(time){
      if (!lastTime) lastTime = time;
      const deltaTime = time - lastTime;
      lastTime = time;

      if (state === 'playing') {
        accumulator += deltaTime;
        while (accumulator >= currentTickRate) {
          if(hasStartedMoving) update();
          accumulator -= currentTickRate;
        }
        draw();
        recordFrame();
        updateDebugMenu();
        reqAnimFrameId = requestAnimationFrame(gameLoop);
      }
    }

    function endGame(){
      cancelAnimationFrame(reqAnimFrameId);
      state = 'gameover';
      if(params.sfx) playBeep(180, 0.25);
      gameOverText.textContent = endMessages[Math.floor(Math.random() * endMessages.length)];
      gameOverScreen.classList.remove('hidden');
      topRightControls.classList.add('hidden');
      startPrompt.classList.add('hidden');
    }

    function updateScoreboard(){
      if (score > highScore) {
        highScore = score;
        localStorage.setItem('pokeSnakeHigh', highScore);
      }
      scoreboard.textContent = `Score: ${score}  High: ${highScore}  Level: ${level}`;
    }

    function playBeep(freq, dur){
      try {
        if (!sharedAudioCtx) sharedAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (sharedAudioCtx.state === 'suspended') sharedAudioCtx.resume();
        const gain = sharedAudioCtx.createGain(), osc = sharedAudioCtx.createOscillator();
        osc.type = 'sine';
        gain.gain.setValueAtTime(params.sfxVolume * 0.2, sharedAudioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, sharedAudioCtx.currentTime + dur);
        osc.frequency.setValueAtTime(freq, sharedAudioCtx.currentTime);
        osc.connect(gain).connect(sharedAudioCtx.destination);
        osc.start();
        osc.stop(sharedAudioCtx.currentTime + dur);
      } catch (e) {}
    }

    btnPlayTitle.addEventListener('click', startGame);

    btnLevelTitle.addEventListener('click', () => {
      buildLevelGrid(true);
      levelModal.style.display = 'block';
    });

    btnSettingsTitle.addEventListener('click', openSettings);

    openLevelBtn.addEventListener('click', () => {
      if(state === 'playing') cancelAnimationFrame(reqAnimFrameId);
      buildLevelGrid(false);
      levelModal.style.display = 'block';
    });

    settingsBtn.addEventListener('click', () => {
      if(state === 'playing') cancelAnimationFrame(reqAnimFrameId);
      openSettings();
    });

    function openSettings() {
      document.getElementById('paramSpeed').value       = params.speed;
      document.getElementById('paramSfx').value         = params.sfx ? 'on' : 'off';
      document.getElementById('paramAssist').value      = params.assistMode ? 'on' : 'off';
      document.getElementById('paramWallMode').value    = params.wallMode;
      document.getElementById('paramStartLength').value = params.startLength;
      document.getElementById('paramSfxVolume').value   = params.sfxVolume;
      document.getElementById('paramHeadColor').value   = params.headColor;
      document.getElementById('paramBodyColor').value   = params.bodyColor;
      document.getElementById('paramShowPrompt').value  = params.showPrompt ? 'on' : 'off';
      document.getElementById('paramAutoStart').value   = params.autoStart ? 'on' : 'off';
      settingsModal.style.display = 'block';
    }

    closeLevelBtn.addEventListener('click', () => {
      levelModal.style.display = 'none';
      resumeGameIfPlaying();
    });

    closeBtn.addEventListener('click', () => {
      settingsModal.style.display = 'none';
      resumeGameIfPlaying();
    });

    function resumeGameIfPlaying() {
      if(state === 'playing') {
        lastTime = performance.now();
        reqAnimFrameId = requestAnimationFrame(gameLoop);
      }
    }

    saveBtn.addEventListener('click', () => {
      params.speed       = parseInt(document.getElementById('paramSpeed').value, 10);
      params.sfx         = document.getElementById('paramSfx').value === 'on';
      params.assistMode  = document.getElementById('paramAssist').value === 'on';
      params.wallMode    = document.getElementById('paramWallMode').value;
      params.startLength = parseInt(document.getElementById('paramStartLength').value, 10);
      params.sfxVolume   = parseFloat(document.getElementById('paramSfxVolume').value);
      params.headColor   = document.getElementById('paramHeadColor').value;
      params.bodyColor   = document.getElementById('paramBodyColor').value;
      params.showPrompt  = document.getElementById('paramShowPrompt').value === 'on';
      params.autoStart   = document.getElementById('paramAutoStart').value === 'on';
      settingsModal.style.display = 'none';

      if(state === 'playing') initGame();
    });

    backToTitle.addEventListener('click', showMainMenu);

    function queueDirection(newDir) {
      if(!hasStartedMoving) {
        if(params.startLength > 1 && newDir.x === 0 && newDir.y === 1) return;
        hasStartedMoving = true;
        startPrompt.classList.add('hidden');
        dir = newDir;
        lastProcessedDir = dir;
        startTime = Date.now();
        return;
      }

      const lastQueuedDir = inputQueue.length > 0 ? inputQueue[inputQueue.length - 1] : lastProcessedDir;
      if ((newDir.x !== -lastQueuedDir.x || newDir.y !== -lastQueuedDir.y) &&
          (newDir.x !== lastQueuedDir.x || newDir.y !== lastQueuedDir.y)) {
        if (inputQueue.length < 3) {
          inputQueue.push(newDir);
        } else {
          inputQueue[inputQueue.length - 1] = newDir;
        }
      }
    }

    document.addEventListener('keydown', e => {
      if(e.key === 'F3' || e.key.toLowerCase() === 'd'){
        toggleDebug();
        return;
      }

      if(settingsModal.style.display === 'block' || levelModal.style.display === 'block') return;

      if(state === 'start') {
        if(hasPlayedOnce) startGame();
      }
      else if (state === 'playing') {
        const M = {
          ArrowUp:[0,-1], ArrowDown:[0,1], ArrowLeft:[-1,0], ArrowRight:[1,0],
          w:[0,-1], s:[0,1], a:[-1,0], d:[1,0],
          W:[0,-1], S:[0,1], A:[-1,0], D:[1,0]
        };

        if (M[e.key]) {
          e.preventDefault();
          queueDirection({x: M[e.key][0], y: M[e.key][1]});
        }
      }
      else if (state === 'gameover' && e.key.toLowerCase() === 'r') {
        gameOverScreen.classList.add('hidden');
        startGame();
      }
    });

    let touchStartX = 0, touchStartY = 0;
    canvas.addEventListener('touchstart', e => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, {passive: true});

    canvas.addEventListener('touchend', e => {
      if (state !== 'playing') return;
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) < 15 && Math.abs(dy) < 15) return;
      if (Math.abs(dx) > Math.abs(dy)) {
        queueDirection({x: dx > 0 ? 1 : -1, y: 0});
      } else {
        queueDirection({x: 0, y: dy > 0 ? 1 : -1});
      }
    }, {passive: true});

    showMainMenu();
  </script>
</body>
</html>
<% } %>


