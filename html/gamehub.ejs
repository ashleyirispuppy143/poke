<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Poke! Games</title>
  <link href="https://fonts.bunny.net/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #0b0c0e;
      --surface: #131519;
      --surface-hover: #1a1d23;
      --border: #232730;
      --border-hover: #383e4c;
      --text: #f1f3f5;
      --muted: #8b92a5;
      --accent: #3b82f6;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      background-color: var(--bg);
      background-image: radial-gradient(#1e222a 1px, transparent 1px);
      background-size: 24px 24px;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      display: flex;
      flex-direction: column;
    }
    .container {
      max-width: 1040px;
      width: 100%;
      margin: 0 auto;
      padding: 3.5rem 1.5rem;
      flex: 1;
    }
    header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2.5rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .brand-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #10b981;
    }
    h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: -0.03em;
    }
    .subtitle {
      color: var(--muted);
      font-size: 0.9rem;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.15rem;
    }
    .card {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.4rem;
      text-decoration: none;
      color: var(--text);
      transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
      min-height: 190px;
    }
    .card:hover {
      background: var(--surface-hover);
      border-color: var(--border-hover);
      transform: translateY(-2px);
    }
    .card:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .card-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 1.1rem;
    }
    .icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      display: grid;
      place-items: center;
      color: var(--card-accent, var(--text));
    }
    .icon-wrap svg {
      width: 22px;
      height: 22px;
    }
    .tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      color: var(--muted);
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      padding: 0.25rem 0.55rem;
      border-radius: 6px;
    }
    .card-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 0.35rem;
    }
    .card-desc {
      color: var(--muted);
      font-size: 0.85rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }
    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 0.85rem;
      border-top: 1px solid var(--border);
      font-size: 0.75rem;
      color: var(--muted);
    }
    .stat-val {
      font-family: 'JetBrains Mono', monospace;
      color: var(--text);
    }
    .play-label {
      font-weight: 600;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }
    .card:hover .play-label {
      color: var(--card-accent, var(--accent));
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="brand">
        <span class="brand-dot"></span>
        <h1>Poke! Games</h1>
      </div>
      <p class="subtitle">Lightweight browser arcade &mdash; no tracking, local high scores</p>
    </header>

    <div class="grid">
      <a class="card" href="?game=snake" style="--card-accent: #10b981;">
        <div>
          <div class="card-top">
            <div class="icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12h6a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h6"/>
                <circle cx="19" cy="6" r="2"/>
              </svg>
            </div>
            <span class="tag">ARCADE</span>
          </div>
          <div class="card-title">Snake</div>
          <div class="card-desc">Navigate the grid, collect apples and bonus fruit, and avoid colliding with your tail.</div>
        </div>
        <div class="card-footer">
          <span>Best: <strong class="stat-val" data-stat="snake">--</strong></span>
          <span class="play-label">Play &rarr;</span>
        </div>
      </a>

      <a class="card" href="?game=tic-tac-toe" style="--card-accent: #f43f5e;">
        <div>
          <div class="card-top">
            <div class="icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M5 5l6 6m0-6l-6 6"/>
                <circle cx="16.5" cy="16.5" r="3.5"/>
                <path d="M12 3v18M3 12h18" stroke-opacity="0.35"/>
              </svg>
            </div>
            <span class="tag">BOARD</span>
          </div>
          <div class="card-title">Tic-Tac-Toe</div>
          <div class="card-desc">Play against a tunable minimax AI or challenge a friend in local two-player mode.</div>
        </div>
        <div class="card-footer">
          <span>Wins: <strong class="stat-val" data-stat="ttt">--</strong></span>
          <span class="play-label">Play &rarr;</span>
        </div>
      </a>

      <a class="card" href="?game=sudoku" style="--card-accent: #8b5cf6;">
        <div>
          <div class="card-top">
            <div class="icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M9 3v18M15 3v18M3 9h18M3 15h18"/>
              </svg>
            </div>
            <span class="tag">PUZZLE</span>
          </div>
          <div class="card-title">Sudoku</div>
          <div class="card-desc">Generated 9&times;9 logic puzzles with candidate notes, smart conflict checks, and undo history.</div>
        </div>
        <div class="card-footer">
          <span>Solved: <strong class="stat-val" data-stat="sudoku">--</strong></span>
          <span class="play-label">Play &rarr;</span>
        </div>
      </a>

      <a class="card" href="?game=pong" style="--card-accent: #06b6d4;">
        <div>
          <div class="card-top">
            <div class="icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M4 7v10M20 7v10"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
            </div>
            <span class="tag">SPORTS</span>
          </div>
          <div class="card-title">Ping-Pong</div>
          <div class="card-desc">Fast-paced table tennis with spin physics, smash shots, and single or two-player modes.</div>
        </div>
        <div class="card-footer">
          <span>1P / 2P Local</span>
          <span class="play-label">Play &rarr;</span>
        </div>
      </a>

      <a class="card" href="?game=minesweeper" style="--card-accent: #f59e0b;">
        <div>
          <div class="card-top">
            <div class="icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="5"/>
                <path d="M12 3v3m0 12v3M3 12h3m12 0h3m-2.6-6.4l-2.1 2.1M7.7 16.3l-2.1 2.1m0-12.8l2.1 2.1m8.6 8.6l2.1 2.1"/>
              </svg>
            </div>
            <span class="tag">LOGIC</span>
          </div>
          <div class="card-title">Minesweeper</div>
          <div class="card-desc">Deduce hidden mines with safe first-click openings, chording support, and three board sizes.</div>
        </div>
        <div class="card-footer">
          <span>Best: <strong class="stat-val" data-stat="mines">--</strong></span>
          <span class="play-label">Play &rarr;</span>
        </div>
      </a>

      <a class="card" href="?game=breakout" style="--card-accent: #ec4899;">
        <div>
          <div class="card-top">
            <div class="icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <rect x="3" y="4" width="5" height="3" rx="0.5"/>
                <rect x="9.5" y="4" width="5" height="3" rx="0.5"/>
                <rect x="16" y="4" width="5" height="3" rx="0.5"/>
                <rect x="6" y="9" width="12" height="3" rx="0.5"/>
                <circle cx="12" cy="15" r="1.5"/>
                <path d="M7 20h10"/>
              </svg>
            </div>
            <span class="tag">ARCADE</span>
          </div>
          <div class="card-title">Breakout</div>
          <div class="card-desc">Clear multi-hit brick formations, chain combo multipliers, and catch falling power-ups.</div>
        </div>
        <div class="card-footer">
          <span>Best: <strong class="stat-val" data-stat="breakout">--</strong></span>
          <span class="play-label">Play &rarr;</span>
        </div>
      </a>
    </div>
  </div>

  <script>
    (function loadStats() {
      try {
        const snakeHi = localStorage.getItem('poke_snake_high');
        if (snakeHi) document.querySelector('[data-stat="snake"]').textContent = snakeHi;

        const tttRaw = localStorage.getItem('poke_ttt_scores');
        if (tttRaw) {
          const s = JSON.parse(tttRaw);
          document.querySelector('[data-stat="ttt"]').textContent = (s.X || 0) + 'W / ' + (s.T || 0) + 'T';
        }

        const sudokuWins = localStorage.getItem('poke_sudoku_wins');
        if (sudokuWins) document.querySelector('[data-stat="sudoku"]').textContent = sudokuWins;

        const minesRaw = localStorage.getItem('poke_mines_best');
        if (minesRaw) {
          const b = JSON.parse(minesRaw);
          const best = b.medium || b.easy || b.hard;
          if (best) document.querySelector('[data-stat="mines"]').textContent = best + 's';
        }

        const brkHi = localStorage.getItem('poke_breakout_high');
        if (brkHi) document.querySelector('[data-stat="breakout"]').textContent = brkHi;
      } catch (e) {}
    })();
  </script>
</body>
</html>
<% } %>


<% if (game === "snake") { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Snake &mdash; Poke! Games</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
  <link href="https://fonts.bunny.net/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0b0c0e;
      --surface: #131519;
      --surface-2: #1b1e24;
      --border: #252932;
      --text: #f1f3f5;
      --muted: #8b92a5;
      --accent: #10b981;
      --danger: #f43f5e;
      --gold: #f59e0b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-tap-highlight-color: transparent; }
    body {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      overflow-x: hidden;
    }
    .topbar {
      width: 100%;
      max-width: 680px;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    .back-link {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.65rem;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--surface);
      transition: color 0.15s, border-color 0.15s;
    }
    .back-link:hover { color: var(--text); border-color: #3b4252; }
    .game-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
    }
    .top-actions { display: flex; gap: 0.5rem; }
    .btn {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 0.45rem 0.8rem;
      border-radius: 6px;
      font-family: inherit;
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }
    .btn:hover { background: var(--surface-2); border-color: #3b4252; }
    .btn-primary {
      background: var(--accent);
      color: #042f2e;
      border-color: var(--accent);
      font-weight: 600;
    }
    .btn-primary:hover { background: #34d399; border-color: #34d399; }

    .hud {
      width: 100%;
      max-width: 680px;
      padding: 0.85rem 1.25rem;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
    }
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.6rem 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .stat-label { font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .stat-value { font-family: 'JetBrains Mono', monospace; font-size: 1.1rem; font-weight: 700; }

    .board-wrap {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px;
      box-shadow: 0 12px 32px rgba(0,0,0,0.35);
    }
    canvas {
      display: block;
      border-radius: 6px;
      background: #0e1014;
      width: min(88vw, 520px);
      height: min(88vw, 520px);
    }
    .overlay {
      position: absolute;
      inset: 10px;
      background: rgba(11, 12, 14, 0.86);
      backdrop-filter: blur(4px);
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      padding: 1.5rem;
      text-align: center;
    }
    .hidden { display: none !important; }
    .overlay h2 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.75rem;
    }
    .overlay p { color: var(--muted); font-size: 0.88rem; max-width: 300px; line-height: 1.5; }
    .overlay-actions { display: flex; gap: 0.6rem; margin-top: 0.25rem; }

    .dpad {
      display: none;
      margin-top: 1rem;
      grid-template-columns: repeat(3, 56px);
      grid-template-rows: repeat(2, 52px);
      gap: 0.4rem;
    }
    .dpad button {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 8px;
      font-size: 1.1rem;
      cursor: pointer;
    }
    .dpad button:active { background: var(--surface-2); }
    @media (max-width: 640px), (pointer: coarse) {
      .dpad { display: grid; }
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 50;
      padding: 1rem;
    }
    .modal {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      width: 100%;
      max-width: 380px;
    }
    .modal h3 { font-family: 'Space Grotesk', sans-serif; margin-bottom: 1rem; font-size: 1.15rem; }
    .field {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.85rem;
    }
    .field select {
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 0.35rem 0.6rem;
      border-radius: 6px;
      font-family: inherit;
    }
    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 0.5rem;
      margin-top: 1.25rem;
    }
    .hint-bar {
      margin-top: 0.85rem;
      color: var(--muted);
      font-size: 0.78rem;
    }
  </style>
</head>
<body>
  <div class="topbar">
    <a class="back-link" href="?">&larr; Hub</a>
    <div class="game-title">Snake</div>
    <div class="top-actions">
      <button class="btn" id="btnPause">Pause</button>
      <button class="btn" id="btnSettings">Settings</button>
    </div>
  </div>

  <div class="hud">
    <div class="stat-card">
      <span class="stat-label">Score</span>
      <span class="stat-value" id="valScore">0</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Best</span>
      <span class="stat-value" id="valHigh">0</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Level</span>
      <span class="stat-value" id="valLevel">1</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Walls</span>
      <span class="stat-value" id="valWalls">Solid</span>
    </div>
  </div>

  <div class="board-wrap">
    <canvas id="canvas" width="520" height="520"></canvas>

    <div class="overlay" id="overlayStart">
      <h2>Snake</h2>
      <p>Use arrow keys or WASD to steer. Golden apples grant bonus points before they vanish.</p>
      <div class="overlay-actions">
        <button class="btn btn-primary" id="btnStart">Start Game</button>
      </div>
    </div>

    <div class="overlay hidden" id="overlayPause">
      <h2>Paused</h2>
      <p>Press Space or Resume to continue.</p>
      <div class="overlay-actions">
        <button class="btn btn-primary" id="btnResume">Resume</button>
        <button class="btn" id="btnRestartPause">Restart</button>
      </div>
    </div>

    <div class="overlay hidden" id="overlayOver">
      <h2 id="overTitle">Game Over</h2>
      <p id="overStats">Final Score: 0</p>
      <div class="overlay-actions">
        <button class="btn btn-primary" id="btnRetry">Play Again</button>
      </div>
    </div>
  </div>

  <div class="dpad">
    <div></div>
    <button type="button" data-dir="0,-1">&uarr;</button>
    <div></div>
    <button type="button" data-dir="-1,0">&larr;</button>
    <button type="button" data-dir="0,1">&darr;</button>
    <button type="button" data-dir="1,0">&rarr;</button>
  </div>

  <div class="hint-bar">WASD / Arrows to move &bull; Space to pause &bull; R to quick restart</div>

  <div class="modal-backdrop hidden" id="modalSettings">
    <div class="modal">
      <h3>Settings</h3>
      <div class="field">
        <label for="optSpeed">Base Speed</label>
        <select id="optSpeed">
          <option value="135">Relaxed</option>
          <option value="105" selected>Standard</option>
          <option value="75">Fast</option>
          <option value="55">Blitz</option>
        </select>
      </div>
      <div class="field">
        <label for="optWalls">Boundary Mode</label>
        <select id="optWalls">
          <option value="solid" selected>Solid Walls</option>
          <option value="wrap">Wrap Around</option>
        </select>
      </div>
      <div class="field">
        <label for="optGrid">Grid Size</label>
        <select id="optGrid">
          <option value="20" selected>20 &times; 20</option>
          <option value="26">26 &times; 26</option>
        </select>
      </div>
      <div class="field">
        <label for="optSfx">Sound Effects</label>
        <select id="optSfx">
          <option value="on" selected>Enabled</option>
          <option value="off">Muted</option>
        </select>
      </div>
      <div class="modal-footer">
        <button class="btn" id="btnCloseSettings">Cancel</button>
        <button class="btn btn-primary" id="btnSaveSettings">Apply</button>
      </div>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');

    const config = {
      baseSpeed: 105,
      walls: 'solid',
      grid: 20,
      sfx: true
    };

    let highScore = parseInt(localStorage.getItem('poke_snake_high') || '0', 10);
    document.getElementById('valHigh').textContent = highScore;

    let snake = [];
    let dir = { x: 0, y: -1 };
    let lastDir = { x: 0, y: -1 };
    let queue = [];
    let apple = { x: 5, y: 5 };
    let bonus = null;
    let score = 0;
    let level = 1;
    let applesEaten = 0;
    let state = 'idle'; // idle, playing, paused, over
    let tickRate = config.baseSpeed;
    let lastFrame = 0;
    let accum = 0;
    let audioCtx = null;

    function tone(freq, dur, type = 'sine') {
      if (!config.sfx) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.06, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
        osc.connect(gain).connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + dur);
      } catch (e) {}
    }

    function spawnApple() {
      const g = config.grid;
      const occupied = new Set(snake.map(s => `${s.x},${s.y}`));
      if (bonus) occupied.add(`${bonus.x},${bonus.y}`);
      const free = [];
      for (let x = 0; x < g; x++) {
        for (let y = 0; y < g; y++) {
          if (!occupied.has(`${x},${y}`)) free.push({ x, y });
        }
      }
      if (free.length === 0) return;
      apple = free[Math.floor(Math.random() * free.length)];
    }

    function maybeSpawnBonus() {
      if (bonus || applesEaten % 5 !== 0) return;
      const g = config.grid;
      const occupied = new Set(snake.map(s => `${s.x},${s.y}`));
      occupied.add(`${apple.x},${apple.y}`);
      const free = [];
      for (let x = 0; x < g; x++) {
        for (let y = 0; y < g; y++) {
          if (!occupied.has(`${x},${y}`)) free.push({ x, y });
        }
      }
      if (free.length > 0) {
        const pick = free[Math.floor(Math.random() * free.length)];
        bonus = { x: pick.x, y: pick.y, ticks: 38 };
      }
    }

    function startNewGame() {
      const mid = Math.floor(config.grid / 2);
      snake = [
        { x: mid, y: mid },
        { x: mid, y: mid + 1 },
        { x: mid, y: mid + 2 }
      ];
      dir = { x: 0, y: -1 };
      lastDir = { x: 0, y: -1 };
      queue = [];
      score = 0;
      level = 1;
      applesEaten = 0;
      bonus = null;
      tickRate = config.baseSpeed;
      spawnApple();
      updateHUD();

      document.getElementById('overlayStart').classList.add('hidden');
      document.getElementById('overlayPause').classList.add('hidden');
      document.getElementById('overlayOver').classList.add('hidden');
      state = 'playing';
      lastFrame = performance.now();
      accum = 0;
      requestAnimationFrame(loop);
    }

    function updateHUD() {
      if (score > highScore) {
        highScore = score;
        localStorage.setItem('poke_snake_high', String(highScore));
      }
      document.getElementById('valScore').textContent = score;
      document.getElementById('valHigh').textContent = highScore;
      document.getElementById('valLevel').textContent = level;
      document.getElementById('valWalls').textContent = config.walls === 'wrap' ? 'Wrap' : 'Solid';
    }

    function enqueueDir(nx, ny) {
      const ref = queue.length > 0 ? queue[queue.length - 1] : lastDir;
      if ((nx !== -ref.x || ny !== -ref.y) && (nx !== ref.x || ny !== ref.y)) {
        if (queue.length < 2) queue.push({ x: nx, y: ny });
      }
    }

    function step() {
      if (queue.length > 0) {
        dir = queue.shift();
        lastDir = dir;
      }

      const g = config.grid;
      let hx = snake[0].x + dir.x;
      let hy = snake[0].y + dir.y;

      if (config.walls === 'wrap') {
        hx = (hx + g) % g;
        hy = (hy + g) % g;
      } else if (hx < 0 || hx >= g || hy < 0 || hy >= g) {
        return triggerGameOver();
      }

      // Check tail collision (excluding very last segment unless eating)
      const eating = (hx === apple.x && hy === apple.y) || (bonus && hx === bonus.x && hy === bonus.y);
      const bodyToCheck = eating ? snake : snake.slice(0, -1);
      if (bodyToCheck.some(seg => seg.x === hx && seg.y === hy)) {
        return triggerGameOver();
      }

      snake.unshift({ x: hx, y: hy });

      if (hx === apple.x && hy === apple.y) {
        score += 10;
        applesEaten++;
        tone(560, 0.08, 'triangle');
        if (applesEaten % 5 === 0) {
          level++;
          tickRate = Math.max(42, tickRate * 0.94);
        }
        spawnApple();
        maybeSpawnBonus();
        updateHUD();
      } else if (bonus && hx === bonus.x && hy === bonus.y) {
        score += 35;
        bonus = null;
        tone(780, 0.14, 'sine');
        updateHUD();
      } else {
        snake.pop();
      }

      if (bonus) {
        bonus.ticks--;
        if (bonus.ticks <= 0) bonus = null;
      }
    }

    function triggerGameOver() {
      state = 'over';
      tone(160, 0.25, 'sawtooth');
      document.getElementById('overStats').textContent = `Final Score: ${score}  •  Level ${level}`;
      document.getElementById('overlayOver').classList.remove('hidden');
    }

    function draw() {
      const g = config.grid;
      const cell = canvas.width / g;

      ctx.fillStyle = '#0e1014';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Subtle checkerboard
      ctx.fillStyle = '#12151b';
      for (let x = 0; x < g; x++) {
        for (let y = 0; y < g; y++) {
          if ((x + y) % 2 === 1) {
            ctx.fillRect(x * cell, y * cell, cell, cell);
          }
        }
      }

      // Apple
      const ax = (apple.x + 0.5) * cell;
      const ay = (apple.y + 0.5) * cell;
      ctx.fillStyle = '#f43f5e';
      ctx.beginPath();
      ctx.arc(ax, ay, cell * 0.38, 0, Math.PI * 2);
      ctx.fill();

      // Bonus apple
      if (bonus) {
        const bx = (bonus.x + 0.5) * cell;
        const by = (bonus.y + 0.5) * cell;
        ctx.fillStyle = '#f59e0b';
        ctx.beginPath();
        ctx.arc(bx, by, cell * 0.42, 0, Math.PI * 2);
        ctx.fill();
      }

      // Snake segments
      snake.forEach((seg, idx) => {
        const pad = idx === 0 ? 1.5 : 2.5;
        ctx.fillStyle = idx === 0 ? '#34d399' : '#10b981';
        ctx.beginPath();
        ctx.roundRect(seg.x * cell + pad, seg.y * cell + pad, cell - pad * 2, cell - pad * 2, 5);
        ctx.fill();

        if (idx === 0) {
          ctx.fillStyle = '#06281e';
          const cx = (seg.x + 0.5) * cell;
          const cy = (seg.y + 0.5) * cell;
          const off = cell * 0.18;
          const ex1 = cx + dir.x * off - dir.y * off;
          const ey1 = cy + dir.y * off + dir.x * off;
          const ex2 = cx + dir.x * off + dir.y * off;
          const ey2 = cy + dir.y * off - dir.x * off;
          ctx.beginPath();
          ctx.arc(ex1, ey1, 2.2, 0, Math.PI * 2);
          ctx.arc(ex2, ey2, 2.2, 0, Math.PI * 2);
          ctx.fill();
        }
      });
    }

    function loop(now) {
      if (state !== 'playing') return;
      const dt = now - lastFrame;
      lastFrame = now;
      accum += dt;
      while (accum >= tickRate && state === 'playing') {
        step();
        accum -= tickRate;
      }
      draw();
      if (state === 'playing') requestAnimationFrame(loop);
    }

    function togglePause() {
      if (state === 'playing') {
        state = 'paused';
        document.getElementById('overlayPause').classList.remove('hidden');
      } else if (state === 'paused') {
        state = 'playing';
        document.getElementById('overlayPause').classList.add('hidden');
        lastFrame = performance.now();
        requestAnimationFrame(loop);
      }
    }

    document.getElementById('btnStart').onclick = startNewGame;
    document.getElementById('btnRetry').onclick = startNewGame;
    document.getElementById('btnPause').onclick = togglePause;
    document.getElementById('btnResume').onclick = togglePause;
    document.getElementById('btnRestartPause').onclick = startNewGame;

    document.getElementById('btnSettings').onclick = () => {
      if (state === 'playing') togglePause();
      document.getElementById('modalSettings').classList.remove('hidden');
    };
    document.getElementById('btnCloseSettings').onclick = () => {
      document.getElementById('modalSettings').classList.add('hidden');
    };
    document.getElementById('btnSaveSettings').onclick = () => {
      config.baseSpeed = parseInt(document.getElementById('optSpeed').value, 10);
      config.walls = document.getElementById('optWalls').value;
      config.grid = parseInt(document.getElementById('optGrid').value, 10);
      config.sfx = document.getElementById('optSfx').value === 'on';
      document.getElementById('modalSettings').classList.add('hidden');
      startNewGame();
    };

    document.querySelectorAll('.dpad button').forEach(btn => {
      btn.addEventListener('click', () => {
        const [dx, dy] = btn.dataset.dir.split(',').map(Number);
        if (state === 'playing') enqueueDir(dx, dy);
      });
    });

    window.addEventListener('keydown', e => {
      const map = {
        ArrowUp: [0, -1], w: [0, -1], W: [0, -1],
        ArrowDown: [0, 1], s: [0, 1], S: [0, 1],
        ArrowLeft: [-1, 0], a: [-1, 0], A: [-1, 0],
        ArrowRight: [1, 0], d: [1, 0], D: [1, 0]
      };
      if (map[e.key]) {
        e.preventDefault();
        if (state === 'playing') enqueueDir(map[e.key][0], map[e.key][1]);
      } else if (e.code === 'Space' || e.key === 'p' || e.key === 'P') {
        if (state === 'playing' || state === 'paused') {
          e.preventDefault();
          togglePause();
        }
      } else if (e.key === 'r' || e.key === 'R') {
        if (state === 'over' || state === 'playing') startNewGame();
      }
    });

    draw();
  </script>
</body>
</html>
<% } %>


<% if (game === "tic-tac-toe") { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Tic-Tac-Toe &mdash; Poke! Games</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
  <link href="https://fonts.bunny.net/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0b0c0e;
      --surface: #131519;
      --surface-2: #1c1f26;
      --border: #252932;
      --text: #f1f3f5;
      --muted: #8b92a5;
      --x-color: #f43f5e;
      --o-color: #38bdf8;
      --accent: #3b82f6;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-tap-highlight-color: transparent; }
    body {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .topbar {
      width: 100%;
      max-width: 520px;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    .back-link {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      padding: 0.4rem 0.65rem;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--surface);
    }
    .back-link:hover { color: var(--text); border-color: #3b4252; }
    .game-title { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.1rem; }

    .toolbar {
      width: 100%;
      max-width: 420px;
      margin-top: 1.25rem;
      padding: 0 1rem;
      display: flex;
      gap: 0.5rem;
      justify-content: space-between;
    }
    .select-pill {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 0.45rem 0.7rem;
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.8rem;
      flex: 1;
    }

    .scoreboard {
      width: 100%;
      max-width: 420px;
      padding: 1rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.65rem;
    }
    .score-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.7rem;
      text-align: center;
      transition: border-color 0.15s;
    }
    .score-card.active-x { border-color: var(--x-color); }
    .score-card.active-o { border-color: var(--o-color); }
    .score-label { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .score-num { font-family: 'JetBrains Mono', monospace; font-size: 1.35rem; font-weight: 700; margin-top: 0.2rem; }

    .status-banner {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      margin-bottom: 0.85rem;
      color: var(--text);
      height: 1.5rem;
    }

    .board {
      width: min(88vw, 370px);
      height: min(88vw, 370px);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(3, 1fr);
      gap: 10px;
      box-shadow: 0 12px 32px rgba(0,0,0,0.35);
    }
    .cell {
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, transform 0.1s;
    }
    .cell:hover:not(.taken) { background: #232731; border-color: #363c4a; }
    .cell:active:not(.taken) { transform: scale(0.97); }
    .cell.taken { cursor: default; }
    .cell.win-cell {
      background: rgba(59, 130, 246, 0.14);
      border-color: var(--accent);
    }
    .cell svg { width: 54%; height: 54%; }

    .actions {
      margin-top: 1.25rem;
      display: flex;
      gap: 0.65rem;
    }
    .btn {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 0.6rem 1.1rem;
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }
    .btn:hover { background: var(--surface-2); border-color: #3b4252; }
    .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
    .btn-primary:hover { background: #2563eb; }
  </style>
</head>
<body>
  <div class="topbar">
    <a class="back-link" href="?">&larr; Hub</a>
    <div class="game-title">Tic-Tac-Toe</div>
    <button class="btn" id="btnResetScores" style="padding:0.35rem 0.65rem;font-size:0.75rem;">Reset Stats</button>
  </div>

  <div class="toolbar">
    <select class="select-pill" id="selMode">
      <option value="pvc">Player vs AI</option>
      <option value="pvp">2 Players</option>
    </select>
    <select class="select-pill" id="selDiff">
      <option value="easy">AI: Casual</option>
      <option value="medium">AI: Balanced</option>
      <option value="hard" selected>AI: Unbeatable</option>
    </select>
    <select class="select-pill" id="selStarter">
      <option value="X">Play as X</option>
      <option value="O">Play as O</option>
    </select>
  </div>

  <div class="scoreboard">
    <div class="score-card" id="cardX">
      <div class="score-label" style="color:var(--x-color)">Player X</div>
      <div class="score-num" id="scoreX">0</div>
    </div>
    <div class="score-card">
      <div class="score-label">Ties</div>
      <div class="score-num" id="scoreT">0</div>
    </div>
    <div class="score-card" id="cardO">
      <div class="score-label" style="color:var(--o-color)">Player O</div>
      <div class="score-num" id="scoreO">0</div>
    </div>
  </div>

  <div class="status-banner" id="statusText">X's Turn</div>

  <div class="board" id="board"></div>

  <div class="actions">
    <button class="btn" id="btnUndo">Undo Move</button>
    <button class="btn btn-primary" id="btnNew">New Round</button>
  </div>

  <script>
    const WIN_LINES = [
      [0,1,2],[3,4,5],[6,7,8],
      [0,3,6],[1,4,7],[2,5,8],
      [0,4,8],[2,4,6]
    ];

    const SVG_X = `<svg viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2.75" stroke-linecap="round"><path d="M5 5L19 19M19 5L5 19"/></svg>`;
    const SVG_O = `<svg viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.75"><circle cx="12" cy="12" r="7.5"/></svg>`;

    let board = Array(9).fill('');
    let history = [];
    let turn = 'X';
    let active = true;
    let aiBusy = false;
    let scores = { X: 0, T: 0, O: 0 };

    try {
      const saved = JSON.parse(localStorage.getItem('poke_ttt_scores'));
      if (saved) scores = { X: saved.X || 0, T: saved.T || 0, O: saved.O || 0 };
    } catch (e) {}

    const boardEl = document.getElementById('board');
    const statusEl = document.getElementById('statusText');

    function saveScores() {
      localStorage.setItem('poke_ttt_scores', JSON.stringify(scores));
      document.getElementById('scoreX').textContent = scores.X;
      document.getElementById('scoreT').textContent = scores.T;
      document.getElementById('scoreO').textContent = scores.O;
    }

    function getWinner(b) {
      for (const line of WIN_LINES) {
        const [a, c, d] = line;
        if (b[a] && b[a] === b[c] && b[a] === b[d]) {
          return { player: b[a], line };
        }
      }
      return null;
    }

    function minimax(b, depth, isMax, aiP, huP, alpha, beta) {
      const w = getWinner(b);
      if (w) return w.player === aiP ? 10 - depth : depth - 10;
      if (!b.includes('')) return 0;

      if (isMax) {
        let best = -Infinity;
        for (let i = 0; i < 9; i++) {
          if (b[i]) continue;
          b[i] = aiP;
          best = Math.max(best, minimax(b, depth + 1, false, aiP, huP, alpha, beta));
          b[i] = '';
          alpha = Math.max(alpha, best);
          if (beta <= alpha) break;
        }
        return best;
      } else {
        let best = Infinity;
        for (let i = 0; i < 9; i++) {
          if (b[i]) continue;
          b[i] = huP;
          best = Math.min(best, minimax(b, depth + 1, true, aiP, huP, alpha, beta));
          b[i] = '';
          beta = Math.min(beta, best);
          if (beta <= alpha) break;
        }
        return best;
      }
    }

    function pickAiMove(b, diff, aiP, huP) {
      const legal = [];
      for (let i = 0; i < 9; i++) {
        if (!b[i]) {
          b[i] = aiP;
          const score = minimax(b, 0, false, aiP, huP, -Infinity, Infinity);
          b[i] = '';
          legal.push({ i, score });
        }
      }
      if (!legal.length) return -1;
      legal.sort((a, c) => c.score - a.score);
      const topScore = legal[0].score;
      const tops = legal.filter(m => m.score === topScore);

      if (diff === 'hard') return tops[Math.floor(Math.random() * tops.length)].i;
      if (diff === 'medium' && Math.random() < 0.75) return tops[Math.floor(Math.random() * tops.length)].i;
      if (diff === 'easy' && Math.random() < 0.35) return tops[Math.floor(Math.random() * tops.length)].i;
      return legal[Math.floor(Math.random() * legal.length)].i;
    }

    function updateTurnHighlight() {
      document.getElementById('cardX').classList.toggle('active-x', active && turn === 'X');
      document.getElementById('cardO').classList.toggle('active-o', active && turn === 'O');
    }

    function render(winLine = []) {
      boardEl.innerHTML = '';
      for (let i = 0; i < 9; i++) {
        const cell = document.createElement('div');
        cell.className = 'cell' + (board[i] ? ' taken' : '') + (winLine.includes(i) ? ' win-cell' : '');
        if (board[i] === 'X') cell.innerHTML = SVG_X;
        else if (board[i] === 'O') cell.innerHTML = SVG_O;
        cell.onclick = () => onCellClick(i);
        boardEl.appendChild(cell);
      }
      updateTurnHighlight();
    }

    function makeMove(idx, player) {
      history.push({ board: [...board], turn });
      board[idx] = player;

      const win = getWinner(board);
      if (win) {
        active = false;
        scores[win.player]++;
        saveScores();
        statusEl.textContent = `Player ${win.player} Wins!`;
        render(win.line);
        return;
      }
      if (!board.includes('')) {
        active = false;
        scores.T++;
        saveScores();
        statusEl.textContent = 'Draw Game';
        render();
        return;
      }

      turn = player === 'X' ? 'O' : 'X';
      statusEl.textContent = `Player ${turn}'s Turn`;
      render();
    }

    function onCellClick(idx) {
      if (!active || aiBusy || board[idx]) return;
      const mode = document.getElementById('selMode').value;
      const human = document.getElementById('selStarter').value;
      if (mode === 'pvc' && turn !== human) return;

      makeMove(idx, turn);

      if (active && mode === 'pvc') {
        triggerAi();
      }
    }

    function triggerAi() {
      aiBusy = true;
      const human = document.getElementById('selStarter').value;
      const ai = human === 'X' ? 'O' : 'X';
      const diff = document.getElementById('selDiff').value;
      statusEl.textContent = 'AI is thinking...';
      setTimeout(() => {
        if (!active) { aiBusy = false; return; }
        const move = pickAiMove([...board], diff, ai, human);
        aiBusy = false;
        if (move !== -1) makeMove(move, ai);
      }, 260);
    }

    function startRound() {
      board = Array(9).fill('');
      history = [];
      turn = 'X';
      active = true;
      aiBusy = false;
      statusEl.textContent = "Player X's Turn";
      render();

      const mode = document.getElementById('selMode').value;
      const human = document.getElementById('selStarter').value;
      if (mode === 'pvc' && human === 'O') {
        triggerAi();
      }
    }

    document.getElementById('btnNew').onclick = startRound;
    document.getElementById('selMode').onchange = startRound;
    document.getElementById('selDiff').onchange = startRound;
    document.getElementById('selStarter').onchange = startRound;

    document.getElementById('btnUndo').onclick = () => {
      if (!active || aiBusy || history.length === 0) return;
      const mode = document.getElementById('selMode').value;
      const steps = mode === 'pvc' && history.length >= 2 ? 2 : 1;
      const target = history[history.length - steps];
      history = history.slice(0, history.length - steps);
      board = [...target.board];
      turn = target.turn;
      statusEl.textContent = `Player ${turn}'s Turn`;
      render();
    };

    document.getElementById('btnResetScores').onclick = () => {
      scores = { X: 0, T: 0, O: 0 };
      saveScores();
    };

    saveScores();
    startRound();
  </script>
</body>
</html>
<% } %>


