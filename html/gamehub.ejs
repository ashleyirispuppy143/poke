    .go-t { font-size: 1.35rem; font-weight: 800; margin-bottom: 6px; }
    .go-s { font-size: 0.88rem; color: var(--md-text-muted); margin-bottom: 18px; }
    .go-b {
      padding: 12px 26px;
      border-radius: var(--radius-pill);
      background: var(--md-primary);
      color: var(--md-on-primary);
      border: none;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
    }
  </style>
</head>
<body>
<div class="window">
  <div class="top-bar">
    <div class="brand">
      <a href="?" class="pill-btn">Hub</a>
      <strong style="font-size:1.15rem;">Minesweeper</strong>
    </div>
    <div class="seg-group">
      <button class="seg-btn dif" data-d="easy" type="button">9x9</button>
      <button class="seg-btn dif active" data-d="medium" type="button">16x16</button>
      <button class="seg-btn dif" data-d="hard" type="button">30x16</button>
    </div>
  </div>

  <div class="hud">
    <div class="stat">💣 <span id="l-mines">040</span></div>
    <button class="face" id="face" type="button">Reset</button>
    <div class="stat" style="text-align:right;">⏱️ <span id="l-timer">000</span></div>
  </div>

  <div class="bwrap" id="bwrap">
    <div id="grid"></div>
    <div class="gov" id="gov">
      <div class="goc">
        <div class="go-t" id="gt">Game Over</div>
        <div class="go-s" id="gs">You hit a mine</div>
        <button class="go-b" id="gb" type="button">Play Again</button>
      </div>
    </div>
  </div>

  <div class="bottom-controls">
    <div class="seg-group">
      <button class="seg-btn active" id="m-dig" type="button">Dig Mode</button>
      <button class="seg-btn" id="m-flag" type="button">Flag Mode</button>
    </div>
    <button class="pill-btn" id="strict-toggle" type="button">Strict Flags: Off</button>
  </div>
</div>

<script>
const AC = new (window.AudioContext || window.webkitAudioContext)();
function sfx(t) {
  try {
    if (AC.state === 'suspended') AC.resume();
    const o = AC.createOscillator(), g = AC.createGain();
    o.connect(g); g.connect(AC.destination);
    const n = AC.currentTime;
    if (t === 'dig') {
      o.type = 'sine'; o.frequency.setValueAtTime(520, n);
      g.gain.setValueAtTime(0.05, n); g.gain.exponentialRampToValueAtTime(0.001, n + 0.05);
      o.start(n); o.stop(n + 0.05);
    } else if (t === 'flag') {
      o.type = 'triangle'; o.frequency.setValueAtTime(660, n);
      g.gain.setValueAtTime(0.05, n); g.gain.exponentialRampToValueAtTime(0.001, n + 0.06);
      o.start(n); o.stop(n + 0.06);
    } else if (t === 'lose') {
      o.type = 'sawtooth'; o.frequency.setValueAtTime(160, n);
      o.frequency.linearRampToValueAtTime(50, n + 0.35);
      g.gain.setValueAtTime(0.08, n); g.gain.linearRampToValueAtTime(0, n + 0.35);
      o.start(n); o.stop(n + 0.35);
    }
  } catch (e) {}
}

class MS {
  constructor() {
    this.G = document.getElementById('grid');
    this.LM = document.getElementById('l-mines');
    this.LT = document.getElementById('l-timer');
    this.F = document.getElementById('face');
    this.GOV = document.getElementById('gov');
    this.fm = false;
    this.strict = false;
    this.diff = 'medium';
    this.revealTimeouts = [];
    this.bind();
    this.init('medium');
  }

  bind() {
    this.F.onclick = () => this.init();
    document.getElementById('gb').onclick = () => { this.GOV.classList.remove('show'); this.init(); };

    const db = document.getElementById('m-dig'), fb = document.getElementById('m-flag');
    db.onclick = () => { this.fm = false; db.classList.add('active'); fb.classList.remove('active'); };
    fb.onclick = () => { this.fm = true; fb.classList.add('active'); db.classList.remove('active'); };

    document.querySelectorAll('.dif').forEach(b => {
      b.onclick = () => {
        document.querySelectorAll('.dif').forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        this.init(b.dataset.d);
      };
    });

    const st = document.getElementById('strict-toggle');
    st.onclick = () => {
      this.strict = !this.strict;
      st.textContent = `Strict Flags: ${this.strict ? 'On' : 'Off'}`;
    };
  }

  init(d) {
    this.revealTimeouts.forEach(clearTimeout);
    this.revealTimeouts = [];
    if (d) this.diff = d;
    const D = { easy: [9, 9, 10], medium: [16, 16, 40], hard: [16, 30, 99] };
    [this.rows, this.cols, this.mines] = D[this.diff];

    const mW = window.innerWidth - 64, mH = window.innerHeight - 250;
    const sz = Math.max(24, Math.min(36, Math.floor(mW / this.cols) - 4, Math.floor(mH / this.rows) - 4));
    document.documentElement.style.setProperty('--cell', sz + 'px');

    this.cells = [];
    this.dead = false;
    this.won = false;
    this.first = true;
    this.ml = this.mines;
    this.fc = 0;
    this.sec = 0;
    clearInterval(this.iv);
    this.LT.textContent = '000';
    this.updLED();
    this.F.textContent = 'Reset';
    this.GOV.classList.remove('show');

    this.G.style.gridTemplateColumns = `repeat(${this.cols}, var(--cell))`;
    this.G.innerHTML = '';

    for (let i = 0; i < this.rows * this.cols; i++) {
      this.cells.push({ m: false, o: false, f: false, n: 0 });
      const el = document.createElement('div');
      el.className = 'c';
      el.addEventListener('click', () => this.clk(i));
      el.addEventListener('contextmenu', e => { e.preventDefault(); this.flg(i); });
      this.G.appendChild(el);
    }
  }

  place(safe) {
    const ex = new Set([safe, ...this.nb(safe)]);
    let n = 0;
    while (n < this.mines) {
      const i = Math.floor(Math.random() * this.cells.length);
      if (ex.has(i) || this.cells[i].m) continue;
      this.cells[i].m = true;
      n++;
    }
    for (let i = 0; i < this.cells.length; i++) {
      if (!this.cells[i].m) this.cells[i].n = this.nb(i).filter(j => this.cells[j].m).length;
    }
  }

  clk(i) {
    if (this.dead || this.won) return;
    const c = this.cells[i];
    if (this.fm && !c.o) { this.flg(i); return; }
    if (c.f) return;
    if (c.o) { this.chord(i); return; }
    this.rev(i);
  }

  flg(i) {
    if (this.dead || this.won) return;
    const c = this.cells[i];
    if (c.o) return;
    const el = this.G.children[i];
    if (c.f) {
      c.f = false; this.fc--; this.ml++;
      el.textContent = ''; sfx('flag'); this.updLED(); return;
    }
    if (this.strict && this.fc >= this.mines) return;
    c.f = true; this.fc++; this.ml--;
    el.textContent = '🚩'; sfx('flag'); this.updLED();
    if (this.strict && !c.m) setTimeout(() => this.end(false, i, true), 150);
  }

  rev(i) {
    if (this.first) {
      this.first = false;
      this.place(i);
      this.iv = setInterval(() => {
        this.sec++;
        this.LT.textContent = String(Math.min(999, this.sec)).padStart(3, '0');
      }, 1000);
    }
    const c = this.cells[i];
    if (c.o || c.f) return;
    c.o = true;
    const el = this.G.children[i];
    el.classList.add('o');
    if (c.m) { this.end(false, i); return; }
    sfx('dig');
    if (c.n > 0) {
      el.textContent = c.n;
      el.classList.add('n' + c.n);
    } else {
      this.nb(i).forEach(j => { if (!this.cells[j].o) this.rev(j); });
    }
    if (this.cells.filter(x => x.o).length === this.cells.length - this.mines) this.end(true);
  }

  chord(i) {
    const c = this.cells[i];
    if (!c.o || c.n === 0) return;
    const ns = this.nb(i);
    if (ns.filter(j => this.cells[j].f).length !== c.n) return;
    ns.forEach(j => { if (!this.cells[j].o && !this.cells[j].f) this.rev(j); });
  }

  nb(i) {
    const o = [], x = i % this.cols, y = Math.floor(i / this.cols);
    for (let dx = -1; dx <= 1; dx++)
      for (let dy = -1; dy <= 1; dy++) {
        if (!dx && !dy) continue;
        const nx = x + dx, ny = y + dy;
        if (nx >= 0 && nx < this.cols && ny >= 0 && ny < this.rows) o.push(ny * this.cols + nx);
      }
    return o;
  }

  updLED() {
    const v = Math.max(-99, this.ml);
    this.LM.textContent = v < 0 ? '-' + String(Math.abs(v)).padStart(2, '0') : String(v).padStart(3, '0');
  }

  end(won, hit, wf = false) {
    this.dead = !won;
    this.won = won;
    clearInterval(this.iv);

    if (won) {
      document.getElementById('gt').textContent = 'Board Cleared!';
      document.getElementById('gs').textContent = `Completed in ${this.sec} seconds`;
    } else {
      sfx('lose');
      this.cells.forEach((c, idx) => {
        if (c.m) {
          const el = this.G.children[idx];
          if (idx === hit) el.classList.add('mine-hit');
          el.classList.add('o');
          if (!c.f) el.textContent = '💣';
        } else if (c.f) {
          const el = this.G.children[idx];
          el.classList.add('wrong-flag', 'o');
          el.textContent = '✕';
        }
      });
      document.getElementById('gt').textContent = wf ? 'Incorrect Flag' : 'Mine Detonated';
      document.getElementById('gs').textContent = wf ? 'Strict mode ended the round' : 'Better luck next board';
    }
    setTimeout(() => this.GOV.classList.add('show'), 450);
  }
}

new MS();
</script>
</body>
</html>
<% } %>

<% if (game === "breakout") { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Poke Breakout</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <link href="https://fonts.bunny.net/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
  <style>
    :root {
      --md-bg: #111318;
      --md-surface: #1d2026;
      --md-surface-high: #282a31;
      --md-primary: #a8c7fa;
      --md-on-primary: #062e6f;
      --md-text: #e2e2e9;
      --md-text-muted: #9da1ad;
      --radius-xl: 32px;
      --radius-pill: 9999px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-tap-highlight-color: transparent; }
    body {
      overflow: hidden;
      background: var(--md-bg);
      color: var(--md-text);
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      padding: 16px;
    }

    #arcade-cabinet {
      position: relative;
      width: 100%;
      height: 100%;
      max-width: 960px;
      max-height: 720px;
      background: var(--md-surface);
      border-radius: var(--radius-xl);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
      overflow: hidden;
    }

    canvas { display: block; width: 100%; height: 100%; }

    .ui-layer {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 20;
      background: rgba(17, 19, 24, 0.85);
      backdrop-filter: blur(12px);
      padding: 24px;
    }

    .hidden { display: none !important; }

    .menu-card {
      background: var(--md-surface-high);
      padding: 36px 32px;
      border-radius: var(--radius-xl);
      width: min(380px, 90vw);
      text-align: center;
    }

    h1 {
      font-size: 2.2rem;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .sub {
      color: var(--md-text-muted);
      font-size: 0.9rem;
      margin-bottom: 24px;
      line-height: 1.5;
    }

    button.btn {
      width: 100%;
      background: var(--md-primary);
      border: none;
      color: var(--md-on-primary);
      font-family: inherit;
      padding: 14px 20px;
      cursor: pointer;
      font-size: 0.95rem;
      font-weight: 700;
      border-radius: var(--radius-pill);
      margin-top: 10px;
      transition: transform 0.12s;
    }

    button.btn.tonal {
      background: #353842;
      color: var(--md-text);
    }

    button.btn:active { transform: scale(0.97); }

    #hud {
      position: absolute;
      top: 18px;
      left: 20px;
      right: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      z-index: 5;
    }

    .hud-group {
      display: flex;
      gap: 10px;
      background: rgba(40, 42, 49, 0.85);
      backdrop-filter: blur(8px);
      padding: 8px 16px;
      border-radius: var(--radius-pill);
      font-size: 0.85rem;
      font-weight: 700;
    }

    .hud-group span {
      color: var(--md-primary);
      font-family: 'JetBrains Mono', monospace;
    }

    #settings-btn {
      pointer-events: auto;
      background: rgba(40, 42, 49, 0.85);
      color: var(--md-text);
      border: none;
      padding: 8px 18px;
      border-radius: var(--radius-pill);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
    }

    #msg-display {
      position: absolute;
      top: 45%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: var(--md-surface-high);
      color: var(--md-primary);
      padding: 12px 28px;
      border-radius: var(--radius-pill);
      font-size: 1.25rem;
      font-weight: 800;
      pointer-events: none;
      z-index: 5;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .setting-row {
      display: flex;
      justify-content: space-between;
      margin: 14px 0;
      color: var(--md-text);
      font-size: 0.9rem;
      font-weight: 600;
      align-items: center;
    }
  </style>
</head>
<body>

<div id="arcade-cabinet">
  <div id="hud">
    <div class="hud-group">
      <div>Score <span id="score-el">0</span></div>
      <div>•</div>
      <div>Lives <span id="lives-el">3</span></div>
      <div>•</div>
      <div>Lvl <span id="level-el">1</span></div>
    </div>
    <button id="settings-btn" type="button" onclick="Game.pause()">Pause</button>
  </div>

  <div id="msg-display">Level 1</div>

  <div id="menu-start" class="ui-layer">
    <div class="menu-card">
      <h1>Breakout</h1>
      <p class="sub">Use Mouse, Touch, or Left/Right Arrow keys to steer the paddle and catch power-ups.</p>
      <button class="btn" type="button" onclick="Game.start()">Start Game</button>
      <a href="?" style="text-decoration:none;"><button class="btn tonal" type="button">Back to Hub</button></a>
    </div>
  </div>

  <div id="menu-settings" class="ui-layer hidden">
    <div class="menu-card">
      <h1 style="font-size:1.6rem;margin-bottom:16px;">Paused</h1>
      <div class="setting-row"><label>Ball Speed</label><input type="range" id="set-speed" min="4" max="9" value="6" style="accent-color:var(--md-primary);"></div>
      <div class="setting-row"><label>Sound Effects</label><input type="checkbox" id="set-sfx" checked style="width:20px;height:20px;accent-color:var(--md-primary);"></div>
      <button class="btn" type="button" onclick="Game.resume()">Resume</button>
      <button class="btn tonal" type="button" onclick="Game.reset()">Main Menu</button>
    </div>
  </div>

  <canvas id="gameCanvas" width="800" height="600"></canvas>
</div>

<script>
const AudioEngine = {
  ctx: new (window.AudioContext || window.webkitAudioContext)(),
  enabled: true,
  play(type) {
    if (!this.enabled) return;
    try {
      if (this.ctx.state === 'suspended') this.ctx.resume();
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      const now = this.ctx.currentTime;

      if (type === 'hit') {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(480, now);
        osc.frequency.exponentialRampToValueAtTime(240, now + 0.08);
        gain.gain.setValueAtTime(0.06, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
        osc.start(now); osc.stop(now + 0.08);
      } else if (type === 'brick') {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(420, now);
        osc.frequency.linearRampToValueAtTime(680, now + 0.06);
        gain.gain.setValueAtTime(0.06, now);
        gain.gain.linearRampToValueAtTime(0, now + 0.09);
        osc.start(now); osc.stop(now + 0.09);
      } else if (type === 'powerup') {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(520, now);
        osc.frequency.linearRampToValueAtTime(880, now + 0.22);
        gain.gain.setValueAtTime(0.06, now);
        gain.gain.linearRampToValueAtTime(0, now + 0.22);
        osc.start(now); osc.stop(now + 0.22);
      } else if (type === 'lose') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(180, now);
        osc.frequency.linearRampToValueAtTime(60, now + 0.4);
        gain.gain.setValueAtTime(0.08, now);
        gain.gain.linearRampToValueAtTime(0, now + 0.4);
        osc.start(now); osc.stop(now + 0.4);
      }
    } catch (e) {}
  }
};

const Game = {
  canvas: document.getElementById('gameCanvas'),
  ctx: document.getElementById('gameCanvas').getContext('2d'),
  width: 800, height: 600,
  state: 'menu', loopId: null,
  level: 1, score: 0, lives: 3, combo: 0,
  baseSpeed: 6,
  keys: {},
  paddle: { x: 340, y: 555, w: 120, h: 16, targetX: 400, laserTimer: 0 },
  balls: [], bricks: [], particles: [], powerups: [], lasers: [],

  init() {
    const updatePaddle = clientX => {
      const rect = this.canvas.getBoundingClientRect();
      const scaleX = this.canvas.width / rect.width;
      const x = (clientX - rect.left) * scaleX;
      this.paddle.targetX = Math.max(this.paddle.w / 2, Math.min(this.width - this.paddle.w / 2, x));
    };

    window.addEventListener('mousemove', e => updatePaddle(e.clientX));
    this.canvas.addEventListener('touchmove', e => { e.preventDefault(); updatePaddle(e.touches[0].clientX); }, {passive: false});
    window.addEventListener('keydown', e => {
      this.keys[e.key] = true;
      if (e.key === 'Escape' && this.state === 'playing') this.pause();
    });
    window.addEventListener('keyup', e => this.keys[e.key] = false);

    document.getElementById('set-speed').addEventListener('input', e => this.baseSpeed = parseInt(e.target.value, 10));
    document.getElementById('set-sfx').addEventListener('change', e => AudioEngine.enabled = e.target.checked);
  },

  start() {
    this.score = 0;
    this.lives = 3;
    this.level = 1;
    this.resetLevel();
    this.state = 'playing';
    document.getElementById('menu-start').classList.add('hidden');
    document.getElementById('menu-settings').classList.add('hidden');
    this.updateHUD();
    this.loop();
  },

  pause() {
    if (this.state === 'playing') {
      this.state = 'paused';
      document.getElementById('menu-settings').classList.remove('hidden');
      cancelAnimationFrame(this.loopId);
    }
  },

  resume() {
    if (this.state === 'paused') {
      this.state = 'playing';
      document.getElementById('menu-settings').classList.add('hidden');
      this.loop();
    }
  },

  reset() {
    this.state = 'menu';
    document.getElementById('menu-start').classList.remove('hidden');
    document.getElementById('menu-settings').classList.add('hidden');
    cancelAnimationFrame(this.loopId);
  },

  resetLevel() {
    this.bricks = [];
    const rows = 4 + Math.min(5, this.level);
    const cols = 9;
    const pad = 10;
    const brickW = (this.width - pad * (cols + 1)) / cols;
    const brickH = 24;
    const palette = ['#f28b82', '#fdd663', '#81c995', '#78d9ec', '#8ab4f8', '#c58af9'];

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        this.bricks.push({
          x: pad + c * (brickW + pad),
          y: 68 + r * (brickH + pad),
          w: brickW, h: brickH,
          color: palette[r % palette.length],
          active: true,
          value: (rows - r) * 15
        });
      }
    }

    this.resetBall();
    this.paddle.w = 120;
    this.paddle.laserTimer = 0;
    this.powerups = [];
    this.lasers = [];
    this.updateHUD();
    this.flashMsg(`Level ${this.level}`);
  },

  resetBall() {
    this.balls = [{
      x: this.width / 2, y: this.height - 90,
      vx: (Math.random() > 0.5 ? 1 : -1) * (this.baseSpeed * 0.75),
      vy: -this.baseSpeed,
      r: 8, active: true
    }];
  },

  spawnPowerup(x, y) {
    const types = [
      { id: 'multi', label: '+Ball', color: '#78d9ec' },
      { id: 'wide', label: 'Wide', color: '#81c995' },
      { id: 'laser', label: 'Laser', color: '#f28b82' }
    ];
    const t = types[Math.floor(Math.random() * types.length)];
    this.powerups.push({ x, y, ...t, vy: 2.8, w: 54, h: 24 });
  },

  update() {
    if (this.keys['ArrowLeft'] || this.keys['a'] || this.keys['A']) {
      this.paddle.targetX = Math.max(this.paddle.w / 2, this.paddle.targetX - 10);
    }
    if (this.keys['ArrowRight'] || this.keys['d'] || this.keys['D']) {
      this.paddle.targetX = Math.min(this.width - this.paddle.w / 2, this.paddle.targetX + 10);
    }

    this.paddle.x += (this.paddle.targetX - this.paddle.w / 2 - this.paddle.x) * 0.28;

    if (this.paddle.laserTimer > 0) {
      this.paddle.laserTimer--;
      if (this.paddle.laserTimer % 18 === 0) {
        this.lasers.push({ x: this.paddle.x + 12, y: this.paddle.y, vy: -11 });
        this.lasers.push({ x: this.paddle.x + this.paddle.w - 12, y: this.paddle.y, vy: -11 });
      }
    }

    for (let i = this.lasers.length - 1; i >= 0; i--) {
      const l = this.lasers[i];
      l.y += l.vy;
      let hit = false;
      for (const b of this.bricks) {
        if (b.active && l.x > b.x && l.x < b.x + b.w && l.y > b.y && l.y < b.y + b.h) {
          this.destroyBrick(b);
          hit = true;
          break;
        }
      }
      if (l.y < 0 || hit) this.lasers.splice(i, 1);
    }

    let activeBalls = 0;
    this.balls.forEach(b => {
      if (!b.active) return;
      activeBalls++;
      b.x += b.vx;
      b.y += b.vy;

      if (b.x < b.r) { b.x = b.r; b.vx *= -1; AudioEngine.play('hit'); }
      if (b.x > this.width - b.r) { b.x = this.width - b.r; b.vx *= -1; AudioEngine.play('hit'); }
      if (b.y < b.r) { b.y = b.r; b.vy *= -1; AudioEngine.play('hit'); }

      if (b.vy > 0 && b.y + b.r >= this.paddle.y && b.y - b.r <= this.paddle.y + this.paddle.h &&
          b.x >= this.paddle.x && b.x <= this.paddle.x + this.paddle.w) {
        const hitPoint = (b.x - (this.paddle.x + this.paddle.w / 2)) / (this.paddle.w / 2);
        const angle = hitPoint * (Math.PI / 3);
        const speed = Math.hypot(b.vx, b.vy);
        b.vx = speed * Math.sin(angle);
        b.vy = -Math.abs(speed * Math.cos(angle));
        b.y = this.paddle.y - b.r;
        AudioEngine.play('hit');
        this.combo = 0;
      }

      for (const brick of this.bricks) {
        if (brick.active && b.x + b.r > brick.x && b.x - b.r < brick.x + brick.w &&
            b.y + b.r > brick.y && b.y - b.r < brick.y + brick.h) {
          const overlapX = Math.min(b.x + b.r - brick.x, brick.x + brick.w - (b.x - b.r));
          const overlapY = Math.min(b.y + b.r - brick.y, brick.y + brick.h - (b.y - b.r));
          if (overlapX < overlapY) b.vx *= -1;
          else b.vy *= -1;
          this.destroyBrick(brick);
          break;
        }
      }

      if (b.y > this.height + 20) b.active = false;
    });

    if (activeBalls === 0 && this.state === 'playing') {
      this.lives--;
      AudioEngine.play('lose');
      this.updateHUD();
      if (this.lives <= 0) {
        this.flashMsg("Game Over");
        this.state = 'gameover';
        setTimeout(() => this.reset(), 2000);
      } else {
        this.resetBall();
      }
    }

    for (let i = this.powerups.length - 1; i >= 0; i--) {
      const p = this.powerups[i];
      p.y += p.vy;
      if (p.y + p.h / 2 >= this.paddle.y && p.y - p.h / 2 <= this.paddle.y + this.paddle.h &&
          p.x >= this.paddle.x && p.x <= this.paddle.x + this.paddle.w) {
        this.activatePowerup(p.id);
        this.powerups.splice(i, 1);
        AudioEngine.play('powerup');
      } else if (p.y > this.height + 30) {
        this.powerups.splice(i, 1);
      }
    }

    if (!this.bricks.some(b => b.active)) {
      this.level++;
      this.score += 500;
      AudioEngine.play('powerup');
      this.resetLevel();
    }
  },

  destroyBrick(brick) {
    brick.active = false;
    this.score += brick.value + (this.combo * 5);
    this.combo++;
    this.createParticles(brick.x + brick.w / 2, brick.y + brick.h / 2, 8, brick.color);
    AudioEngine.play('brick');
    this.updateHUD();
    if (Math.random() < 0.16) this.spawnPowerup(brick.x + brick.w / 2, brick.y + brick.h / 2);
  },

  activatePowerup(id) {
    if (id === 'multi') {
      const base = this.balls.find(b => b.active) || this.balls[0];
      if (base) {
        this.balls.push({ ...base, vx: -base.vx, active: true });
        this.balls.push({ ...base, vx: base.vx * 0.6, vy: -Math.abs(base.vy), active: true });
      }
    } else if (id === 'wide') {
      this.paddle.w = Math.min(200, this.paddle.w + 45);
    } else if (id === 'laser') {
      this.paddle.laserTimer = 320;
    }
  },

  createParticles(x, y, count, color) {
    for (let i = 0; i < count; i++) {
      this.particles.push({
        x, y,
        vx: (Math.random() - 0.5) * 6,
        vy: (Math.random() - 0.5) * 6,
        life: 1.0,
        color,
        size: Math.random() * 4 + 3
      });
    }
  },

  draw() {
    const ctx = this.ctx;
    ctx.fillStyle = '#1d2026';
    ctx.fillRect(0, 0, this.width, this.height);

    this.bricks.forEach(b => {
      if (!b.active) return;
      ctx.fillStyle = b.color;
      ctx.beginPath();
      ctx.roundRect(b.x, b.y, b.w, b.h, 8);
      ctx.fill();
    });

    ctx.fillStyle = '#a8c7fa';
    ctx.beginPath();
    ctx.roundRect(this.paddle.x, this.paddle.y, this.paddle.w, this.paddle.h, 8);
    ctx.fill();

    if (this.paddle.laserTimer > 0) {
      ctx.fillStyle = '#f28b82';
      ctx.beginPath();
      ctx.arc(this.paddle.x + 12, this.paddle.y, 4, 0, Math.PI * 2);
      ctx.arc(this.paddle.x + this.paddle.w - 12, this.paddle.y, 4, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.fillStyle = '#ffffff';
    this.balls.forEach(b => {
      if (!b.active) return;
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
      ctx.fill();
    });

    ctx.fillStyle = '#f28b82';
    this.lasers.forEach(l => {
      ctx.beginPath();
      ctx.roundRect(l.x - 2, l.y, 4, 12, 2);
      ctx.fill();
    });

    this.powerups.forEach(p => {
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.roundRect(p.x - p.w / 2, p.y - p.h / 2, p.w, p.h, 12);
      ctx.fill();
      ctx.fillStyle = '#111318';
      ctx.font = '700 11px "Plus Jakarta Sans", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(p.label, p.x, p.y + 4);
    });

    for (let i = this.particles.length - 1; i >= 0; i--) {
      const p = this.particles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.life -= 0.04;
      if (p.life <= 0) {
        this.particles.splice(i, 1);
      } else {
        ctx.fillStyle = p.color;
        ctx.globalAlpha = p.life;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
    }
  },

  loop() {
    if (this.state !== 'playing') return;
    this.update();
    this.draw();
    this.loopId = requestAnimationFrame(() => this.loop());
  },

  updateHUD() {
    document.getElementById('score-el').innerText = this.score;
    document.getElementById('lives-el').innerText = this.lives;
    document.getElementById('level-el').innerText = this.level;
  },

  flashMsg(text) {
    const el = document.getElementById('msg-display');
    el.innerText = text;
    el.style.opacity = 1;
    setTimeout(() => el.style.opacity = 0, 1400);
  }
};

Game.init();
</script>
</body>
</html>
<% } %>