<script>
const AC = new (window.AudioContext || window.webkitAudioContext)();
function playTone(freq, dur = 0.09, type = 'sine') {
  try {
    if (AC.state === 'suspended') AC.resume();
    const o = AC.createOscillator(), g = AC.createGain();
    o.type = type;
    o.frequency.setValueAtTime(freq, AC.currentTime);
    g.gain.setValueAtTime(0.08, AC.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, AC.currentTime + dur);
    o.connect(g).connect(AC.destination);
    o.start();
    o.stop(AC.currentTime + dur);
  } catch (e) {}
}

const GEMS_ALL = ['🍓', '🍋', '🍇', '🫐', '🍏', '🍑', '💎'];

class Match3Game {
  constructor() {
    this.size = 8;
    this.mode = 'forever'; // 'forever' | 'adventure'
    this.level = 1;
    this.maxUnlocked = parseInt(localStorage.getItem('pokeMatch3Unlocked')) || 1;
    this.bestForever = parseInt(localStorage.getItem('pokeMatch3Best')) || 0;

    this.board = [];
    this.selected = null;
    this.busy = false;
    this.score = 0;
    this.targetScore = 1000;
    this.movesLeft = 20;

    this.gridEl = document.getElementById('gem-grid');
    this.overlay = document.getElementById('end-overlay');

    this.bindUI();
    this.buildPath();
    this.startForever();
  }

  bindUI() {
    const tabForever = document.getElementById('tab-forever');
    const tabAdv = document.getElementById('tab-adventure');
    const pathPanel = document.getElementById('path-panel');
    const layout = document.getElementById('main-layout');

    tabForever.onclick = () => {
      tabForever.classList.add('active');
      tabAdv.classList.remove('active');
      pathPanel.classList.add('hidden');
      layout.classList.add('single');
      this.startForever();
    };

    tabAdv.onclick = () => {
      tabAdv.classList.add('active');
      tabForever.classList.remove('active');
      pathPanel.classList.remove('hidden');
      layout.classList.remove('single');
      this.startLevel(this.maxUnlocked);
    };

    document.getElementById('ov-btn').onclick = () => {
      this.overlay.classList.add('hidden');
      if (this.mode === 'forever') {
        this.startForever();
      } else {
        if (this.wonLast) {
          this.startLevel(Math.min(50, this.level + 1));
        } else {
          this.startLevel(this.level);
        }
      }
    };
  }

  buildPath() {
    const container = document.getElementById('path-scroll');
    container.innerHTML = '';
    document.getElementById('unlocked-label').textContent = `${this.maxUnlocked} / 50`;

    for (let i = 1; i <= 50; i++) {
      const row = document.createElement('div');
      row.className = 'stage-row';

      const btn = document.createElement('button');
      const isHard = i % 10 === 0;
      btn.className = 'stage-node' + (isHard ? ' hard' : '');
      if (i <= this.maxUnlocked) btn.classList.add('unlocked');
      if (i === this.level && this.mode === 'adventure') btn.classList.add('current');

      btn.innerHTML = `<span>${i}</span>${isHard ? '<span class="hard-tag">HARD</span>' : ''}`;
      if (i <= this.maxUnlocked) {
        btn.onclick = () => this.startLevel(i);
      }
      row.appendChild(btn);
      container.appendChild(row);
    }
  }

  getGemPool() {
    if (this.mode === 'forever') return GEMS_ALL.slice(0, 6);
    const isHard = this.level % 10 === 0;
    return GEMS_ALL.slice(0, isHard ? 7 : 6);
  }

  startForever() {
    this.mode = 'forever';
    this.score = 0;
    this.selected = null;
    this.busy = false;
    this.overlay.classList.add('hidden');
    this.generateInitialBoard();
    this.render();
    this.updateHUD();
  }

  startLevel(lvl) {
    this.mode = 'adventure';
    this.level = lvl;
    this.score = 0;
    this.selected = null;
    this.busy = false;
    this.wonLast = false;
    this.overlay.classList.add('hidden');

    const isHard = lvl % 10 === 0;
    this.movesLeft = isHard ? 16 : Math.max(18, 25 - Math.floor(lvl / 12));
    this.targetScore = isHard ? (1400 + lvl * 180) : (700 + lvl * 110);

    this.buildPath();
    this.generateInitialBoard();
    this.render();
    this.updateHUD();
  }

  generateInitialBoard() {
    const pool = this.getGemPool();
    do {
      this.board = Array.from({ length: this.size }, () => Array(this.size).fill(''));
      for (let r = 0; r < this.size; r++) {
        for (let c = 0; c < this.size; c++) {
          let g;
          do {
            g = pool[Math.floor(Math.random() * pool.length)];
          } while (
            (c >= 2 && this.board[r][c - 1] === g && this.board[r][c - 2] === g) ||
            (r >= 2 && this.board[r - 1][c] === g && this.board[r - 2][c] === g)
          );
          this.board[r][c] = g;
        }
      }
    } while (this.countValidMoves() === 0);
  }

  findMatches(b = this.board) {
    const matched = new Set();
    for (let r = 0; r < this.size; r++) {
      let run = 1;
      for (let c = 1; c <= this.size; c++) {
        if (c < this.size && b[r][c] && b[r][c] === b[r][c - 1]) {
          run++;
        } else {
          if (run >= 3) {
            for (let k = c - run; k < c; k++) matched.add(`${r},${k}`);
          }
          run = 1;
        }
      }
    }
    for (let c = 0; c < this.size; c++) {
      let run = 1;
      for (let r = 1; r <= this.size; r++) {
        if (r < this.size && b[r][c] && b[r][c] === b[r - 1][c]) {
          run++;
        } else {
          if (run >= 3) {
            for (let k = r - run; k < r; k++) matched.add(`${k},${c}`);
          }
          run = 1;
        }
      }
    }
    return matched;
  }

  countValidMoves() {
    let moves = 0;
    const copy = this.board.map(row => [...row]);
    const swap = (r1, c1, r2, c2) => {
      const tmp = copy[r1][c1];
      copy[r1][c1] = copy[r2][c2];
      copy[r2][c2] = tmp;
    };

    for (let r = 0; r < this.size; r++) {
      for (let c = 0; c < this.size; c++) {
        if (c + 1 < this.size) {
          swap(r, c, r, c + 1);
          if (this.findMatches(copy).size > 0) moves++;
          swap(r, c, r, c + 1);
        }
        if (r + 1 < this.size) {
          swap(r, c, r + 1, c);
          if (this.findMatches(copy).size > 0) moves++;
          swap(r, c, r + 1, c);
        }
      }
    }
    return moves;
  }

  render() {
    this.gridEl.innerHTML = '';
    for (let r = 0; r < this.size; r++) {
      for (let c = 0; c < this.size; c++) {
        const cell = document.createElement('div');
        cell.className = 'gem-cell';
        if (this.selected && this.selected.r === r && this.selected.c === c) {
          cell.classList.add('selected');
        }
        cell.textContent = this.board[r][c];
        cell.onclick = () => this.onCellClick(r, c);
        this.gridEl.appendChild(cell);
      }
    }
  }

  onCellClick(r, c) {
    if (this.busy) return;
    if (!this.selected) {
      this.selected = { r, c };
      playTone(360, 0.05);
      this.render();
      return;
    }

    const dr = Math.abs(this.selected.r - r);
    const dc = Math.abs(this.selected.c - c);

    if (dr + dc === 1) {
      this.attemptSwap(this.selected.r, this.selected.c, r, c);
      this.selected = null;
    } else {
      this.selected = { r, c };
      playTone(360, 0.05);
      this.render();
    }
  }

  async attemptSwap(r1, c1, r2, c2) {
    this.busy = true;
    this.swapCells(r1, c1, r2, c2);
    this.render();

    const matches = this.findMatches();
    if (matches.size === 0) {
      await new Promise(res => setTimeout(res, 180));
      this.swapCells(r1, c1, r2, c2);
      playTone(180, 0.12, 'sawtooth');
      this.render();
      this.busy = false;
      return;
    }

    if (this.mode === 'adventure') {
      this.movesLeft--;
    }

    let combo = 1;
    while (true) {
      const currentMatches = this.findMatches();
      if (currentMatches.size === 0) break;

      this.score += currentMatches.size * 30 * combo;
      playTone(400 + combo * 90, 0.1, 'triangle');
      combo++;

      currentMatches.forEach(key => {
        const [mr, mc] = key.split(',').map(Number);
        const idx = mr * this.size + mc;
        this.gridEl.children[idx]?.classList.add('clearing');
      });

      this.updateHUD();
      await new Promise(res => setTimeout(res, 200));

      currentMatches.forEach(key => {
        const [mr, mc] = key.split(',').map(Number);
        this.board[mr][mc] = null;
      });

      const pool = this.getGemPool();
      for (let c = 0; c < this.size; c++) {
        let writeRow = this.size - 1;
        for (let r = this.size - 1; r >= 0; r--) {
          if (this.board[r][c] !== null) {
            this.board[writeRow][c] = this.board[r][c];
            if (writeRow !== r) this.board[r][c] = null;
            writeRow--;
          }
        }
        for (let r = writeRow; r >= 0; r--) {
          this.board[r][c] = pool[Math.floor(Math.random() * pool.length)];
        }
      }

      this.render();
      await new Promise(res => setTimeout(res, 160));
    }

    this.updateHUD();
    this.checkEndState();
    this.busy = false;
  }

  swapCells(r1, c1, r2, c2) {
    const tmp = this.board[r1][c1];
    this.board[r1][c1] = this.board[r2][c2];
    this.board[r2][c2] = tmp;
  }

  updateHUD() {
    const validMoves = this.countValidMoves();
    document.getElementById('val-score').textContent = this.score;

    if (this.mode === 'forever') {
      if (this.score > this.bestForever) {
        this.bestForever = this.score;
        localStorage.setItem('pokeMatch3Best', this.bestForever);
      }
      document.getElementById('lbl-left').textContent = 'Best';
      document.getElementById('val-left').textContent = this.bestForever;
      document.getElementById('lbl-right').textContent = 'Possible Moves';
      document.getElementById('val-right').textContent = validMoves;
      document.getElementById('progress-fill').style.width = '100%';
    } else {
      const isHard = this.level % 10 === 0;
      document.getElementById('lbl-left').textContent = isHard ? `Level ${this.level} (HARD)` : `Level ${this.level}`;
      document.getElementById('val-left').textContent = `Goal: ${this.targetScore}`;
      document.getElementById('lbl-right').textContent = 'Moves Left';
      document.getElementById('val-right').textContent = this.movesLeft;
      const pct = Math.min(100, Math.floor((this.score / this.targetScore) * 100));
      document.getElementById('progress-fill').style.width = pct + '%';
    }
  }

  checkEndState() {
    const validMoves = this.countValidMoves();

    if (this.mode === 'forever') {
      if (validMoves === 0) {
        document.getElementById('ov-title').textContent = 'No More Moves!';
        document.getElementById('ov-desc').textContent = `Final Score: ${this.score}`;
        document.getElementById('ov-btn').textContent = 'Play Again';
        this.overlay.classList.remove('hidden');
      }
    } else {
      if (this.score >= this.targetScore) {
        this.wonLast = true;
        if (this.level >= this.maxUnlocked && this.level < 50) {
          this.maxUnlocked = this.level + 1;
          localStorage.setItem('pokeMatch3Unlocked', this.maxUnlocked);
          this.buildPath();
        }
        document.getElementById('ov-title').textContent = `Level ${this.level} Cleared!`;
        document.getElementById('ov-desc').textContent = `Score: ${this.score}`;
        document.getElementById('ov-btn').textContent = this.level < 50 ? 'Next Level' : 'Replay Level 50';
        this.overlay.classList.remove('hidden');
      } else if (this.movesLeft <= 0 || validMoves === 0) {
        this.wonLast = false;
        document.getElementById('ov-title').textContent = validMoves === 0 ? 'No More Moves!' : 'Out of Moves!';
        document.getElementById('ov-desc').textContent = `Score: ${this.score} / ${this.targetScore}`;
        document.getElementById('ov-btn').textContent = 'Try Again';
        this.overlay.classList.remove('hidden');
      }
    }
  }
}

new Match3Game();
</script>
</body>
</html>
