<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link href="https://fonts.bunny.net/css2?family=Roboto+Flex:opsz,wght@8..144,400..800&display=swap" rel="stylesheet" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Poke! Games Hub</title>
  <style>
    :root {
      --bg: #160e11;
      --surface-1: #22161b;
      --surface-2: #2e1e24;
      --surface-3: #3c272f;
      --primary: #ffb0cd;
      --on-primary: #541d34;
      --primary-container: #70334b;
      --on-primary-container: #ffd8e4;
      --text: #f3dfe4;
      --muted: #cfb8be;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100%; }
    body {
      background: var(--bg);
      font-family: 'Roboto Flex', system-ui, -apple-system, sans-serif;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      display: flex;
      flex-direction: column;
    }
    .app-shell {
      display: grid;
      grid-template-columns: 260px 1fr;
      min-height: 100vh;
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      gap: 24px;
      padding: 24px;
    }
    .nav-drawer {
      background: var(--surface-1);
      border-radius: 32px;
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: calc(100vh - 48px);
      position: sticky;
      top: 24px;
    }
    .brand-box {
      padding: 8px 16px 24px;
    }
    .brand-box h1 {
      font-size: 1.65rem;
      font-weight: 800;
      color: var(--primary);
      letter-spacing: -0.5px;
      line-height: 1.15;
    }
    .nav-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      border-radius: 20px;
      background: transparent;
      border: none;
      color: var(--muted);
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      text-align: left;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .nav-item:hover {
      background: var(--surface-2);
      color: var(--text);
    }
    .nav-item.active {
      background: var(--primary);
      color: var(--on-primary);
    }
    .drawer-footer {
      padding: 16px;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--muted);
      line-height: 1.4;
      background: var(--surface-2);
      border-radius: 20px;
    }
    .main-view {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      background: var(--surface-1);
      padding: 16px 24px;
      border-radius: 28px;
    }
    .search-box {
      flex: 1;
      max-width: 420px;
      position: relative;
    }
    .search-box input {
      width: 100%;
      background: var(--surface-2);
      border: none;
      border-radius: 20px;
      padding: 14px 20px;
      color: var(--text);
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 600;
      outline: none;
    }
    .search-box input::placeholder { color: var(--muted); opacity: 0.7; }
    .search-box input:focus { background: var(--surface-3); }

    .spotlight-banner {
      background: var(--surface-1);
      border-radius: 36px;
      padding: 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .spotlight-info {
      max-width: 540px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .spotlight-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--primary);
      letter-spacing: -0.5px;
    }
    .spotlight-sub {
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.5;
    }
    .spotlight-actions {
      display: flex;
      gap: 12px;
    }
    .play-now-btn {
      background: var(--primary);
      color: var(--on-primary);
      text-decoration: none;
      padding: 16px 28px;
      border-radius: 24px;
      font-weight: 800;
      font-size: 1rem;
      transition: transform 0.15s ease, background 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .play-now-btn:hover { transform: scale(1.03); background: #ffc4da; }

    .game-container {
      display: grid;
      gap: 18px;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
    .game {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
      background: var(--surface-1);
      border-radius: 32px;
      padding: 24px;
      text-decoration: none;
      color: var(--text);
      min-height: 210px;
      transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), background 0.2s ease;
      outline: none;
      overflow: hidden;
    }
    .game:hover { transform: translateY(-4px); background: var(--surface-2); }
    .game:active { transform: scale(0.98); }
    .game:focus-visible { outline: 3px solid var(--primary); outline-offset: 2px; }
    .row-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .icon {
      font-size: 2.2rem;
      line-height: 1;
      background: var(--surface-2);
      width: 64px;
      height: 64px;
      border-radius: 22px;
      display: grid;
      place-items: center;
      transition: background 0.2s ease;
    }
    .game:hover .icon { background: var(--surface-3); }
    .info-btn {
      height: 44px;
      width: 44px;
      display: inline-grid;
      place-items: center;
      background: var(--surface-2);
      border: none;
      border-radius: 18px;
      color: var(--primary);
      cursor: pointer;
      font-size: 1.1rem;
      transition: background 0.15s ease, transform 0.1s ease;
    }
    .info-btn:hover { background: var(--primary-container); color: var(--on-primary-container); }
    .card-body { display: flex; flex-direction: column; gap: 6px; }
    .title { font-size: 1.35rem; font-weight: 800; color: var(--text); }
    .subtitle { color: var(--muted); font-size: 0.92rem; line-height: 1.45; }

    .info-modal {
      position: absolute;
      inset: 0;
      background: rgba(22, 14, 17, 0.96);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      backdrop-filter: blur(8px);
      z-index: 10;
    }
    .hidden { display: none !important; }
    .info-content {
      background: var(--surface-2);
      border-radius: 24px;
      padding: 20px;
      width: 100%;
      font-size: 0.92rem;
      line-height: 1.5;
      color: var(--text);
    }
    .close-row { display: flex; justify-content: flex-end; margin-top: 14px; }
    .close-info {
      border: none;
      background: var(--primary);
      color: var(--on-primary);
      padding: 10px 18px;
      font-family: inherit;
      font-weight: 700;
      font-size: 0.85rem;
      border-radius: 16px;
      cursor: pointer;
    }

    @media (max-width: 900px) {
      .app-shell { grid-template-columns: 1fr; padding: 16px; }
      .nav-drawer { height: auto; position: static; flex-direction: column; gap: 16px; }
      .nav-list { flex-direction: row; flex-wrap: wrap; }
      .nav-item { flex: 1 1 auto; justify-content: center; }
    }
  </style>
</head>
<body>
  <div class="app-shell" role="region" aria-label="Poke Games Hub">
    <aside class="nav-drawer">
      <div>
        <div class="brand-box">
          <h1>Poke! Games Hub</h1>
        </div>
        <nav class="nav-list">
          <button class="nav-item active" data-filter="all">All Games</button>
          <button class="nav-item" data-filter="arcade">Arcade</button>
          <button class="nav-item" data-filter="puzzle">Puzzle & Logic</button>
        </nav>
      </div>
      <div class="drawer-footer">
        copyleft 2026 poke project, not vibecoded
      </div>
    </aside>

    <main class="main-view">
      <header class="top-bar">
        <div class="search-box">
          <input type="text" id="gameSearch" placeholder="Search library..." aria-label="Search games" />
        </div>
      </header>

      <section class="spotlight-banner">
        <div class="spotlight-info">
          <div class="spotlight-title">Forever Match 3</div>
          <div class="spotlight-sub">Swap gems in endless mode until no moves remain, or play through the 50-stage adventure map with hard boss boards every 10 levels.</div>
        </div>
        <div class="spotlight-actions">
          <a href="?game=match3" class="play-now-btn">💎 Play Match 3</a>
        </div>
      </section>

      <div class="game-container" id="gameGrid">
        <!-- Snake -->
        <a class="game" data-game="snake" data-cat="arcade" href="?game=snake" role="button" aria-label="Open Snake">
          <div class="row-top">
            <div class="icon" aria-hidden="true">🐍</div>
            <button class="info-btn" type="button" aria-haspopup="dialog" aria-label="About Snake">ℹ️</button>
          </div>
          <div class="card-body">
            <div class="title">Snake</div>
            <div class="subtitle">Guide the snake, eat apples, don’t hit walls or yourself.</div>
          </div>
          <div class="info-modal hidden" role="dialog" aria-modal="true" aria-label="Snake info">
            <div class="info-content">
              <p><strong>Snake</strong> is a retro arcade classic. Eat food to grow; collisions end your run.</p>
              <div class="close-row"><button class="close-info" type="button">Close</button></div>
            </div>
          </div>
        </a>

        <!-- Tic-Tac-Toe -->
        <a class="game" data-game="tic-tac-toe" data-cat="puzzle" href="?game=tic-tac-toe" role="button" aria-label="Open Tic-Tac-Toe">
          <div class="row-top">
            <div class="icon" aria-hidden="true">❌⭕</div>
            <button class="info-btn" type="button" aria-haspopup="dialog" aria-label="About Tic-Tac-Toe">ℹ️</button>
          </div>
          <div class="card-body">
            <div class="title">Tic-Tac-Toe</div>
            <div class="subtitle">Classic 3×3. Get three in a row before your opponent.</div>
          </div>
          <div class="info-modal hidden" role="dialog" aria-modal="true" aria-label="Tic-Tac-Toe info">
            <div class="info-content">
              <p><strong>Tic-Tac-Toe</strong> lets you play X vs O on a 3×3 grid. Play vs AI or a friend.</p>
              <div class="close-row"><button class="close-info" type="button">Close</button></div>
            </div>
          </div>
        </a>

        <!-- Sudoku -->
        <a class="game" data-game="sudoku" data-cat="puzzle" href="?game=sudoku" role="button" aria-label="Open Sudoku">
          <div class="row-top">
            <div class="icon" aria-hidden="true">🧩</div>
            <button class="info-btn" type="button" aria-haspopup="dialog" aria-label="About Sudoku">ℹ️</button>
          </div>
          <div class="card-body">
            <div class="title">Sudoku</div>
            <div class="subtitle">Fill each row, column, and 3×3 box with digits 1–9.</div>
          </div>
          <div class="info-modal hidden" role="dialog" aria-modal="true" aria-label="Sudoku info">
            <div class="info-content">
              <p><strong>Sudoku</strong> is a logic puzzle: each row/column/box must contain 1–9 exactly once.</p>
              <div class="close-row"><button class="close-info" type="button">Close</button></div>
            </div>
          </div>
        </a>

        <!-- Pong -->
        <a class="game" data-game="pong" data-cat="arcade" href="?game=pong" role="button" aria-label="Open Ping-Pong">
          <div class="row-top">
            <div class="icon" aria-hidden="true">🏓</div>
            <button class="info-btn" type="button" aria-haspopup="dialog" aria-label="About Pong">ℹ️</button>
          </div>
          <div class="card-body">
            <div class="title">Ping-Pong</div>
            <div class="subtitle">Retro table tennis. Bounce the ball past the paddle.</div>
          </div>
          <div class="info-modal hidden" role="dialog" aria-modal="true" aria-label="Pong info">
            <div class="info-content">
              <p><strong>Pong</strong> is the original table-tennis arcade game. Move, deflect, score.</p>
              <div class="close-row"><button class="close-info" type="button">Close</button></div>
            </div>
          </div>
        </a>

        <!-- Minesweeper -->
        <a class="game" data-game="minesweeper" data-cat="puzzle" href="?game=minesweeper" role="button" aria-label="Open Minesweeper">
          <div class="row-top">
            <div class="icon" aria-hidden="true">💣</div>
            <button class="info-btn" type="button" aria-haspopup="dialog" aria-label="About Minesweeper">ℹ️</button>
          </div>
          <div class="card-body">
            <div class="title">Minesweeper</div>
            <div class="subtitle">Use numbers to flag mines and clear the board.</div>
          </div>
          <div class="info-modal hidden" role="dialog" aria-modal="true" aria-label="Minesweeper info">
            <div class="info-content">
              <p><strong>Minesweeper</strong> is deduction: numbers tell how many adjacent mines to avoid.</p>
              <div class="close-row"><button class="close-info" type="button">Close</button></div>
            </div>
          </div>
        </a>

        <!-- Breakout -->
        <a class="game" data-game="breakout" data-cat="arcade" href="?game=breakout" role="button" aria-label="Open Breakout">
          <div class="row-top">
            <div class="icon" aria-hidden="true">🧱</div>
            <button class="info-btn" type="button" aria-haspopup="dialog" aria-label="About Breakout">ℹ️</button>
          </div>
          <div class="card-body">
            <div class="title">Breakout</div>
            <div class="subtitle">Bust the bricks. Catch power-ups. Don’t drop the ball.</div>
          </div>
          <div class="info-modal hidden" role="dialog" aria-modal="true" aria-label="Breakout info">
            <div class="info-content">
              <p><strong>Breakout</strong> challenges you to clear bricks with a bouncing ball and paddle.</p>
              <div class="close-row"><button class="close-info" type="button">Close</button></div>
            </div>
          </div>
        </a>

        <!-- Forever Match 3 -->
        <a class="game" data-game="match3" data-cat="puzzle" href="?game=match3" role="button" aria-label="Open Forever Match 3">
          <div class="row-top">
            <div class="icon" aria-hidden="true">💎</div>
            <button class="info-btn" type="button" aria-haspopup="dialog" aria-label="About Forever Match 3">ℹ️</button>
          </div>
          <div class="card-body">
            <div class="title">Forever Match 3</div>
            <div class="subtitle">Swap gems in endless mode or clear the 50-stage adventure path.</div>
          </div>
          <div class="info-modal hidden" role="dialog" aria-modal="true" aria-label="Forever Match 3 info">
            <div class="info-content">
              <p><strong>Forever Match 3</strong> includes an endless mode that runs until no moves remain, plus a 50-level map with hard stages every 10 levels.</p>
              <div class="close-row"><button class="close-info" type="button">Close</button></div>
            </div>
          </div>
        </a>
      </div>
    </main>
  </div>

  <script>
    (function initLibrary(){
      const cards = document.querySelectorAll('.game');
      const navBtns = document.querySelectorAll('.nav-item');
      const searchInput = document.getElementById('gameSearch');
      let currentCat = 'all';

      function filterGames() {
        const q = searchInput.value.toLowerCase().trim();
        cards.forEach(card => {
          const cat = card.dataset.cat;
          const title = card.querySelector('.title').textContent.toLowerCase();
          const sub = card.querySelector('.subtitle').textContent.toLowerCase();
          const matchCat = currentCat === 'all' || cat === currentCat;
          const matchQ = !q || title.includes(q) || sub.includes(q);
          card.style.display = (matchCat && matchQ) ? 'flex' : 'none';
        });
      }

      navBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          navBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentCat = btn.dataset.filter;
          filterGames();
        });
      });

      searchInput.addEventListener('input', filterGames);

      function openModal(modal){
        modal.classList.remove('hidden');
        modal.querySelector('.close-info')?.focus();
      }
      function closeModal(modal){
        modal.classList.add('hidden');
      }

      cards.forEach(card => {
        const infoBtn = card.querySelector('.info-btn');
        const modal  = card.querySelector('.info-modal');
        const closeBtn = card.querySelector('.close-info');

        infoBtn.addEventListener('click', (e)=>{
          e.preventDefault();
          e.stopPropagation();
          openModal(modal);
        }, { passive:false });

        closeBtn.addEventListener('click', (e)=>{
          e.preventDefault();
          e.stopPropagation();
          closeModal(modal);
          infoBtn.focus();
        });

        modal.addEventListener('click', (e)=>{
          if(e.target === modal){
            e.preventDefault();
            e.stopPropagation();
            closeModal(modal);
            infoBtn.focus();
          }
        });

        document.addEventListener('keydown', (e)=>{
          if(e.key === 'Escape' && !modal.classList.contains('hidden')){
            closeModal(modal);
            infoBtn.focus();
          }
        });

        card.addEventListener('keydown', (e)=>{
          if(!modal.classList.contains('hidden')) return;
          if(e.code === 'Enter' || e.code === 'Space'){
            e.preventDefault();
            const href = card.getAttribute('href');
            if(href) window.location.assign(href);
          }
        });
      });
    })();
  </script>
</body>
</html>
<% } %>


