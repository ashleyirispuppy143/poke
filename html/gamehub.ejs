    }

    .cell {
      background: var(--md-surface-high);
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3.2rem;
      font-weight: 800;
      cursor: pointer;
      transition: background 0.15s, transform 0.12s;
    }

    .cell:hover:not(.taken) {
