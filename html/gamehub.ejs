<script>
class SudokuToolbox {
  static isValid(board, row, col, num) {
    for (let x = 0; x < 9; x++) {
      if (board[row][x] === num || board[x][col] === num) return false;
      const boxRow = 3 * Math.floor(row / 3) + Math.floor(x / 3);
      const boxCol = 3 * Math.floor(col / 3) + x % 3;
      if (board[boxRow][boxCol] === num) return false;
    }
    return true;
  }

  static solve(board) {
    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        if (board[r][c] === 0) {
          for (let n = 1; n <= 9; n++) {
            if (this.isValid(board, r, c, n)) {
              board[r][c] = n;
              if (this.solve(board)) return true;
              board[r][c] = 0;
            }
          }
          return false;
        }
      }
    }
    return true;
  }

  static generate(difficulty) {
    let board = Array.from({ length: 9 }, () => Array(9).fill(0));
    for (let i = 0; i < 9; i += 3) this.fillBox(board, i, i);
    this.solve(board);
    const solution = board.map(row => [...row]);

    let attempts = difficulty === 'easy' ? 32 : difficulty === 'medium' ? 44 : 54;
    while (attempts > 0) {
      let r = Math.floor(Math.random() * 9);
      let c = Math.floor(Math.random() * 9);
      if (board[r][c] !== 0) {
        board[r][c] = 0;
        attempts--;
      }
    }
    return { initial: board, solution: solution };
  }

  static fillBox(board, row, col) {
    let num;
    for (let i = 0; i < 3; i++) {
      for (let j = 0; j < 3; j++) {
        do {
          num = Math.floor(Math.random() * 9) + 1;
        } while (!this.isSafeInBox(board, row, col, num));
        board[row + i][col + j] = num;
      }
    }
  }

  static isSafeInBox(board, row, col, num) {
    for (let i = 0; i < 3; i++)
      for (let j = 0; j < 3; j++)
        if (board[row + i][col + j] === num) return false;
    return true;
  }
}

class Game {
  constructor() {
    this.boardState = [];
    this.solution = [];
    this.initialState = [];
    this.notes = [];
    this.history = [];

    this.selected = { r: -1, c: -1 };
    this.isNoteMode = false;
    this.hintsRemaining = 3;
    this.timer = 0;
    this.timerInterval = null;
    this.difficulty = 'medium';
    this.settings = { showTimer: true, color: '#ffb0cd' };

    this.gridEl = document.getElementById('sudoku-grid');
    this.timerEl = document.getElementById('timer');
    this.noteBtn = document.getElementById('btn-note');
    this.hintBtn = document.getElementById('btn-hint');
    this.numpadEl = document.getElementById('numpad');

    this.initNumpad();
    this.setupEventListeners();
  }

  initNumpad() {
    this.numpadEl.innerHTML = '';
    for (let n = 1; n <= 9; n++) {
      const btn = document.createElement('button');
      btn.className = 'num-btn';
      btn.innerHTML = `<span>${n}</span><span class="num-rem" id="rem-${n}">9</span>`;
      btn.onclick = () => this.handleInput(n);
      this.numpadEl.appendChild(btn);
    }
  }

  startNewGame(difficulty = this.difficulty) {
    this.difficulty = difficulty;
    document.getElementById('difficulty-display').innerText = difficulty === 'medium' ? 'Normal' : difficulty;

    const data = SudokuToolbox.generate(difficulty);
    this.initialState = data.initial.map(row => [...row]);
    this.boardState = data.initial.map(row => [...row]);
    this.solution = data.solution;

    this.notes = Array.from({length: 9}, () => Array.from({length: 9}, () => new Set()));
    this.history = [];
    this.hintsRemaining = 3;
    this.updateHintButton();

    this.selected = { r: 0, c: 0 };
    this.resetTimer();
    this.renderBoard();
    this.selectCell(0, 0);
  }

  updateHintButton() {
    this.hintBtn.textContent = `💡 Hint (${this.hintsRemaining})`;
    this.hintBtn.disabled = this.hintsRemaining <= 0;
  }

  useHint() {
    if (this.hintsRemaining <= 0) return;

    let targetR = this.selected.r;
    let targetC = this.selected.c;

    if (targetR === -1 || this.boardState[targetR][targetC] === this.solution[targetR][targetC]) {
      const unfilled = [];
      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (this.boardState[r][c] !== this.solution[r][c]) unfilled.push({ r, c });
        }
      }
      if (unfilled.length === 0) return;
      const pick = unfilled[Math.floor(Math.random() * unfilled.length)];
      targetR = pick.r;
      targetC = pick.c;
    }

    this.saveToHistory();
    const correctNum = this.solution[targetR][targetC];
    this.boardState[targetR][targetC] = correctNum;
    this.notes[targetR][targetC].clear();
    this.prunePeerNotes(targetR, targetC, correctNum);

    this.hintsRemaining--;
    this.updateHintButton();
    this.renderBoard();
    this.selectCell(targetR, targetC);
    this.checkWin();
  }

  renderBoard() {
    this.gridEl.innerHTML = '';
    const counts = Array(10).fill(0);

    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        const cell = document.createElement('div');
        const val = this.boardState[r][c];
        const isGiven = this.initialState[r][c] !== 0;

        cell.className = 'cell';
        if (isGiven) cell.classList.add('given');
        else if (val !== 0) cell.classList.add('user-val');

        if (val !== 0) {
          cell.textContent = val;
          if (val === this.solution[r][c]) counts[val]++;
          else cell.classList.add('error');
        } else {
          const noteContainer = document.createElement('div');
          noteContainer.className = 'notes-grid';
          const cellNotes = this.notes[r][c];
          if(cellNotes.size > 0) {
            for(let n = 1; n <= 9; n++) {
              const span = document.createElement('span');
              span.className = 'note-num';
              span.textContent = cellNotes.has(n) ? n : '';
              noteContainer.appendChild(span);
            }
          }
          cell.appendChild(noteContainer);
        }

        cell.onclick = () => this.selectCell(r, c);
        this.gridEl.appendChild(cell);
      }
    }

    for (let n = 1; n <= 9; n++) {
      const rem = Math.max(0, 9 - counts[n]);
      const remEl = document.getElementById(`rem-${n}`);
      if (remEl) {
        remEl.textContent = rem;
        remEl.parentElement.classList.toggle('completed', rem === 0);
      }
    }
  }

  selectCell(r, c) {
    this.selected = { r, c };
    this.highlightBoard();
  }

  highlightBoard() {
    const cells = Array.from(this.gridEl.children);
    const { r, c } = this.selected;
    const selectedVal = (r !== -1 && this.boardState[r][c]) ? this.boardState[r][c] : null;

    cells.forEach((cell, idx) => {
      const cr = Math.floor(idx / 9);
      const cc = idx % 9;

      cell.classList.remove('selected', 'highlighted', 'same-number');

      if (cr === r && cc === c) {
        cell.classList.add('selected');
      } else if (r !== -1 && (cr === r || cc === c ||
               (Math.floor(cr/3) === Math.floor(r/3) && Math.floor(cc/3) === Math.floor(c/3)))) {
        cell.classList.add('highlighted');
      }

      if (selectedVal && this.boardState[cr][cc] === selectedVal && !(cr === r && cc === c)) {
        cell.classList.add('same-number');
      }
    });
  }

  prunePeerNotes(r, c, num) {
    for (let i = 0; i < 9; i++) {
      this.notes[r][i].delete(num);
      this.notes[i][c].delete(num);
      const br = 3 * Math.floor(r / 3) + Math.floor(i / 3);
      const bc = 3 * Math.floor(c / 3) + (i % 3);
      this.notes[br][bc].delete(num);
    }
  }

  handleInput(num) {
    if (this.selected.r === -1) return;
    const { r, c } = this.selected;

    if (this.initialState[r][c] !== 0) return;

    this.saveToHistory();

    if (this.isNoteMode) {
      const cellNotes = this.notes[r][c];
      if (cellNotes.has(num)) cellNotes.delete(num);
      else cellNotes.add(num);
      this.renderBoard();
      this.selectCell(r, c);
    } else {
      if (this.boardState[r][c] === num) return;

      this.boardState[r][c] = num;
      if (num === this.solution[r][c]) {
        this.notes[r][c].clear();
        this.prunePeerNotes(r, c, num);
      }

      this.renderBoard();
      this.selectCell(r, c);
      this.checkWin();
    }
  }

  clearCell() {
    if (this.selected.r === -1) return;
    const { r, c } = this.selected;
    if (this.initialState[r][c] !== 0) return;

    this.saveToHistory();
    this.boardState[r][c] = 0;
    this.notes[r][c].clear();
    this.renderBoard();
    this.selectCell(r, c);
  }

  moveSelection(dr, dc) {
    let { r, c } = this.selected;
    if (r === -1) { r = 0; c = 0; }
    else {
      r = Math.max(0, Math.min(8, r + dr));
      c = Math.max(0, Math.min(8, c + dc));
    }
    this.selectCell(r, c);
  }

  toggleNoteMode() {
    this.isNoteMode = !this.isNoteMode;
    this.noteBtn.textContent = this.isNoteMode ? "✎ Note: ON" : "✎ Note: OFF";
    this.noteBtn.classList.toggle('active', this.isNoteMode);
  }

  saveToHistory() {
    const state = {
      board: this.boardState.map(row => [...row]),
      notes: this.notes.map(row => row.map(set => new Set(set)))
    };
    this.history.push(state);
    if(this.history.length > 30) this.history.shift();
  }

  undo() {
    if (this.history.length === 0) return;
    const prev = this.history.pop();
    this.boardState = prev.board;
    this.notes = prev.notes;
    this.renderBoard();
    if (this.selected.r !== -1) this.selectCell(this.selected.r, this.selected.c);
  }

  checkWin() {
    for(let r = 0; r < 9; r++)
      for(let c = 0; c < 9; c++)
        if(this.boardState[r][c] !== this.solution[r][c]) return;

    clearInterval(this.timerInterval);
    document.getElementById('win-time').textContent = `Time: ${this.timerEl.textContent}`;
    document.getElementById('modal-win').style.display = 'flex';
    confettiExplosion();
  }

  resetTimer() {
    clearInterval(this.timerInterval);
    this.timer = 0;
    this.timerEl.textContent = "00:00";
    if (this.settings.showTimer) {
      this.timerInterval = setInterval(() => {
        this.timer++;
        const m = String(Math.floor(this.timer / 60)).padStart(2, '0');
        const s = String(this.timer % 60).padStart(2, '0');
        this.timerEl.textContent = `${m}:${s}`;
      }, 1000);
    }
  }

  updateSettings() {
    const color = document.getElementById('set-color').value;
    const showTimer = document.getElementById('set-timer').checked;
    const diff = document.getElementById('set-difficulty').value;

    document.documentElement.style.setProperty('--primary', color);
    document.documentElement.style.setProperty('--selected', color);

    this.settings.showTimer = showTimer;
    if (!showTimer) {
      clearInterval(this.timerInterval);
      this.timerInterval = null;
      this.timerEl.textContent = "--:--";
    } else if (!this.timerInterval) {
      this.resetTimer();
    }

    if(diff !== this.difficulty) {
      this.startNewGame(diff);
    }
  }

  setupEventListeners() {
    document.addEventListener('keydown', (e) => {
      if (['ArrowUp', 'w'].includes(e.key)) { e.preventDefault(); this.moveSelection(-1, 0); }
      else if (['ArrowDown', 's'].includes(e.key)) { e.preventDefault(); this.moveSelection(1, 0); }
      else if (['ArrowLeft', 'a'].includes(e.key)) { e.preventDefault(); this.moveSelection(0, -1); }
      else if (['ArrowRight', 'd'].includes(e.key)) { e.preventDefault(); this.moveSelection(0, 1); }
      else if (['Backspace', 'Delete'].includes(e.key)) this.clearCell();
      else if (['n', 'N'].includes(e.key)) this.toggleNoteMode();
      else if (['h', 'H'].includes(e.key)) this.useHint();
      else if (['u', 'U'].includes(e.key)) this.undo();
      else if (!isNaN(parseInt(e.key)) && e.key !== '0') this.handleInput(parseInt(e.key));
    });

    document.getElementById('btn-note').onclick = () => this.toggleNoteMode();
    document.getElementById('btn-hint').onclick = () => this.useHint();
    document.getElementById('btn-undo').onclick = () => this.undo();
    document.getElementById('btn-erase').onclick = () => this.clearCell();
    document.getElementById('btn-new').onclick = () => this.startNewGame();

    document.getElementById('btn-settings').onclick = () => document.getElementById('modal-settings').style.display = 'flex';
    document.getElementById('btn-save-settings').onclick = () => {
      this.updateSettings();
      document.getElementById('modal-settings').style.display = 'none';
    };

    document.getElementById('btn-help').onclick = () => document.getElementById('modal-help').style.display = 'flex';

    document.getElementById('btn-play-again').onclick = () => {
      document.getElementById('modal-win').style.display = 'none';
      this.startNewGame();
    };

    window.onclick = (e) => {
      if (e.target.classList.contains('modal')) e.target.style.display = 'none';
    };
  }
}

function confettiExplosion() {
  const canvas = document.getElementById('confetti');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  const particles = [];
  const colors = ['#ffb0cd', '#ffdf9e', '#fff', '#ff80ab'];

  for(let i = 0; i < 120; i++) {
    particles.push({
      x: canvas.width / 2,
      y: canvas.height / 2,
      r: Math.random() * 5 + 2,
      dx: Math.random() * 10 - 5,
      dy: Math.random() * 10 - 5,
      color: colors[Math.floor(Math.random() * colors.length)],
      life: 100
    });
  }

  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach((p, index) => {
      p.x += p.dx;
      p.y += p.dy;
      p.life--;
      p.dy += 0.12;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
      if(p.life <= 0) particles.splice(index, 1);
    });
    if(particles.length > 0) requestAnimationFrame(animate);
  }
  animate();
}

const game = new Game();
game.startNewGame();
</script>
</body>
</html>
<% } %>


<% if (game === "pong") { %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>POKE PONG</title>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
<link href="https://fonts.bunny.net/css2?family=Roboto+Flex:opsz,wght@8..144,400..800&display=swap" rel="stylesheet">
<style>
  :root {
    --primary: #ffb0cd;
    --on-primary: #541d34;
    --bg: #1a1114;
    --surface: #271a1f;
    --surface-2: #352329;
    --text: #f0dee3;
    --muted: #d6c2c7;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; overflow: hidden; touch-action: none; }
  body {
    background: #120b0d; color: var(--primary);
    font-family: 'Roboto Flex', system-ui, -apple-system, sans-serif;
    display: flex; justify-content: center; align-items: center;
    height: 100vh;
  }

  #cab {
    position: relative; width: 100%; height: 100%;
    max-width: 1000px; max-height: 700px;
    background: var(--bg); border-radius: 36px; overflow: hidden;
    box-shadow: 0 24px 64px rgba(0,0,0,0.5);
  }

  canvas { display: block; width: 100%; height: 100%; }

  #hud {
    position: absolute; top: 24px; width: 100%;
    display: flex; justify-content: center; gap: 120px;
    font-size: 3.5rem; font-weight: 800; pointer-events: none; opacity: 0.35; z-index: 5;
    color: var(--primary);
  }
  #msg {
    position: absolute; top: 38%; width: 100%;
    text-align: center; font-size: 2.2rem; font-weight: 800; color: var(--text);
    pointer-events: none; z-index: 5; opacity: 0;
    transition: opacity 0.2s;
  }
  #msg.show { opacity: 1; }
  #submsg {
    position: absolute; top: 48%; width: 100%;
    text-align: center; font-size: 1rem; font-weight: 600; color: var(--muted);
    pointer-events: none; z-index: 5; opacity: 0;
    transition: opacity 0.2s;
  }
  #submsg.show { opacity: 1; }

  .ov {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    z-index: 20; background: rgba(26, 17, 20, 0.9);
    backdrop-filter: blur(14px);
    transition: opacity 0.25s;
  }
  .ov.hidden { opacity: 0; pointer-events: none; }

  h1 {
    font-size: clamp(2.4rem, 6vw, 3.8rem); font-weight: 800; color: var(--primary);
    margin-bottom: 1.5rem; letter-spacing: -1px;
    text-align: center; line-height: 1.1;
  }

  .mg {
    display: flex; flex-direction: column; gap: 12px; width: min(320px, 84vw);
    background: var(--surface); padding: 24px; border-radius: 32px;
  }

  button {
    background: var(--surface-2); border: none;
    color: var(--text); font-family: inherit;
    padding: 16px; cursor: pointer;
    font-size: 1rem; font-weight: 700; border-radius: 22px;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  button:hover { background: var(--primary); color: var(--on-primary); transform: scale(1.02); }

  .sr {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 0.9rem; font-weight: 600; color: var(--text); padding: 6px 0;
  }
  select {
    background: var(--surface-2); color: var(--text);
    border: none; padding: 8px 12px; border-radius: 14px;
    font-family: inherit; font-size: 0.85rem; font-weight: 600;
  }
  input[type="range"] { accent-color: var(--primary); cursor: pointer; width: 110px; }
  input[type="color"] { cursor: pointer; background: var(--surface-2); border: none; border-radius: 12px; height: 34px; width: 60px; padding: 3px; }

  #gear {
    position: absolute; bottom: 20px; right: 20px; z-index: 30;
    width: 48px; height: 48px; border-radius: 20px; font-size: 1.2rem; padding: 0;
    display: grid; place-items: center;
  }

  .controls-hint {
    font-size: 0.85rem; font-weight: 600; color: var(--muted); text-align: center;
    margin-top: 16px; line-height: 1.6;
  }

  .touch-zone {
    position: absolute; top: 0; height: 100%; width: 50%;
    z-index: 4;
  }
  .touch-zone.left { left: 0; }
  .touch-zone.right { right: 0; }
</style>
</head>
<body>
<div id="cab">
  <div id="hud"><span id="sl">0</span><span id="sr">0</span></div>
  <div id="msg"></div>
  <div id="submsg"></div>

  <div class="touch-zone left" id="tz-left"></div>
  <div class="touch-zone right" id="tz-right"></div>

  <div id="ov-menu" class="ov">
    <h1>POKE<br>PONG</h1>
    <div class="mg">
      <button id="btn-1p" style="background:var(--primary); color:var(--on-primary);">1 Player</button>
      <button id="btn-2p">2 Players</button>
    </div>
    <div class="controls-hint">
      W/S or touch left side — Player 1<br>
      ↑/↓ or touch right side — Player 2
    </div>
  </div>

  <div id="ov-pause" class="ov hidden">
    <h1 style="font-size:2rem; margin-bottom:1rem;">PAUSED</h1>
    <div class="mg">
      <div class="sr"><label>Difficulty</label>
        <select id="s-diff">
          <option value="easy">Easy</option>
          <option value="medium" selected>Medium</option>
          <option value="hard">Impossible</option>
        </select>
      </div>
      <div class="sr"><label>Ball Speed</label><input type="range" id="s-speed" min="4" max="12" value="6"></div>
      <div class="sr"><label>Win Score</label>
        <select id="s-score">
          <option value="5">5</option>
          <option value="10" selected>10</option>
          <option value="21">21</option>
        </select>
      </div>
      <div class="sr"><label>Theme</label><input type="color" id="s-color" value="#ffb0cd"></div>
      <button id="btn-resume" style="background:var(--primary); color:var(--on-primary); margin-top:8px;">Resume</button>
      <button id="btn-quit">Quit to Menu</button>
    </div>
  </div>

  <button id="gear">⚙️</button>
  <canvas id="cv" width="800" height="600"></canvas>
</div>

<script>
const SFX = {
  ctx: new (window.AudioContext || window.webkitAudioContext)(),
  play(t) {
    if (this.ctx.state === 'suspended') this.ctx.resume();
    const o = this.ctx.createOscillator(), g = this.ctx.createGain();
    o.connect(g); g.connect(this.ctx.destination);
    const n = this.ctx.currentTime;
    ({
      hit() {
        o.type = 'sine';
        o.frequency.setValueAtTime(440, n);
        o.frequency.exponentialRampToValueAtTime(160, n + 0.08);
        g.gain.setValueAtTime(0.1, n);
        g.gain.exponentialRampToValueAtTime(0.001, n + 0.08);
        o.start(n); o.stop(n + 0.08);
      },
      smash() {
        o.type = 'triangle';
        o.frequency.setValueAtTime(620, n);
        o.frequency.exponentialRampToValueAtTime(100, n + 0.14);
        g.gain.setValueAtTime(0.15, n);
        g.gain.exponentialRampToValueAtTime(0.001, n + 0.14);
        o.start(n); o.stop(n + 0.14);
      },
      wall() {
        o.type = 'sine';
        o.frequency.setValueAtTime(240, n);
        g.gain.setValueAtTime(0.06, n);
        g.gain.linearRampToValueAtTime(0, n + 0.04);
        o.start(n); o.stop(n + 0.04);
      },
      score() {
        o.type = 'sine';
        o.frequency.setValueAtTime(400, n);
        o.frequency.linearRampToValueAtTime(840, n + 0.15);
        g.gain.setValueAtTime(0.1, n);
        g.gain.linearRampToValueAtTime(0, n + 0.28);
        o.start(n); o.stop(n + 0.28);
      },
      win() {
        o.type = 'sine';
        o.frequency.setValueAtTime(523, n);
        o.frequency.setValueAtTime(659, n + 0.12);
        o.frequency.setValueAtTime(784, n + 0.24);
        o.frequency.setValueAtTime(1047, n + 0.36);
        g.gain.setValueAtTime(0.1, n);
        g.gain.linearRampToValueAtTime(0, n + 0.6);
        o.start(n); o.stop(n + 0.6);
      }
    })[t]?.();
  }
};

const G = {
  cv: document.getElementById('cv'),
  W: 800, H: 600,
  state: 'menu', mode: 'pvc', loopId: null,

  winScore: 10, diff: 'medium', baseSpeed: 6, accent: '#ffb0cd',

  ball: {}, p1: {}, p2: {},
  keys: {},
  touchY: { left: null, right: null },
  particles: [], trails: [], shake: 0, freeze: 0, rally: 0,

  init() {
    this.cx = this.cv.getContext('2d');

    window.addEventListener('keydown', e => {
      this.keys[e.key] = true;
      if (['ArrowUp','ArrowDown','w','s'].includes(e.key)) e.preventDefault();
      if (e.key === 'Escape') {
        if (this.state === 'playing') this.pause();
        else if (this.state === 'paused') this.resume();
      }
    });
    window.addEventListener('keyup', e => this.keys[e.key] = false);

    const tzL = document.getElementById('tz-left');
    const tzR = document.getElementById('tz-right');

    const touchHandler = (zone, side) => {
      zone.addEventListener('touchstart', e => { e.preventDefault(); this.updateTouch(e, side); }, { passive: false });
      zone.addEventListener('touchmove', e => { e.preventDefault(); this.updateTouch(e, side); }, { passive: false });
      zone.addEventListener('touchend', () => { this.touchY[side] = null; });
      zone.addEventListener('touchcancel', () => { this.touchY[side] = null; });
    };
    touchHandler(tzL, 'left');
    touchHandler(tzR, 'right');

    document.getElementById('cab').addEventListener('mousemove', e => {
      if (this.mode === 'pvc') {
        const rect = this.cv.getBoundingClientRect();
        this.touchY.left = (e.clientY - rect.top) / rect.height * this.H;
      }
    });

    document.getElementById('btn-1p').onclick = () => this.start('pvc');
    document.getElementById('btn-2p').onclick = () => this.start('pvp');
    document.getElementById('btn-resume').onclick = () => this.resume();
    document.getElementById('btn-quit').onclick = () => this.toMenu();
    document.getElementById('gear').onclick = () => this.pause();

    document.getElementById('s-color').addEventListener('input', e => {
      this.accent = e.target.value;
      document.documentElement.style.setProperty('--primary', this.accent);
    });
    document.getElementById('s-diff').addEventListener('change', e => this.diff = e.target.value);
    document.getElementById('s-speed').addEventListener('input', e => this.baseSpeed = +e.target.value);
    document.getElementById('s-score').addEventListener('change', e => this.winScore = +e.target.value);
  },

  updateTouch(e, side) {
    const rect = document.getElementById('cab').getBoundingClientRect();
    const touch = e.touches[e.touches.length - 1];
    this.touchY[side] = (touch.clientY - rect.top) / rect.height * this.H;
  },

  start(mode) {
    this.mode = mode;
    this.resetMatch();
    this.state = 'playing';
    this.show('ov-menu', false);
    this.show('ov-pause', false);
    document.getElementById('gear').style.display = 'grid';
    this.lastTime = performance.now();
    this.loop();
  },

  pause() {
    if (this.state !== 'playing') return;
    this.state = 'paused';
    this.show('ov-pause', true);
    cancelAnimationFrame(this.loopId);
  },

  resume() {
    if (this.state !== 'paused') return;
    this.state = 'playing';
    this.show('ov-pause', false);
    this.lastTime = performance.now();
    this.loop();
  },

  toMenu() {
    this.state = 'menu';
    this.show('ov-menu', true);
    this.show('ov-pause', false);
    document.getElementById('gear').style.display = 'none';
    cancelAnimationFrame(this.loopId);
  },

  show(id, visible) {
    document.getElementById(id).classList.toggle('hidden', !visible);
  },

  resetMatch() {
    this.p1 = { x: 24, y: 250, w: 16, h: 96, score: 0, vy: 0, prevY: 250 };
    this.p2 = { x: 760, y: 250, w: 16, h: 96, score: 0, vy: 0, prevY: 250 };
    this.particles = [];
    this.trails = [];
    this.updateHUD();
    this.serveBall(1);
  },

  serveBall(dir) {
    const b = this.ball;
    b.x = this.W / 2;
    b.y = this.H / 2;
    b.size = 8;
    b.speed = this.baseSpeed;
    this.rally = 0;

    const angle = (Math.random() * 0.6 - 0.3);
    b.vx = dir * b.speed * Math.cos(angle);
    b.vy = b.speed * Math.sin(angle);
    if (Math.abs(b.vy) < 1.5) b.vy = (Math.random() > 0.5 ? 1 : -1) * 1.5;

    this.freeze = 35;
    this.flashMsg('READY', '');
  },

  flashMsg(text, sub) {
    const el = document.getElementById('msg');
    const sel = document.getElementById('submsg');
    el.textContent = text; el.classList.add('show');
    sel.textContent = sub || ''; if (sub) sel.classList.add('show');
    setTimeout(() => { el.classList.remove('show'); sel.classList.remove('show'); }, 1100);
  },

  update() {
    if (this.state !== 'playing') return;
    if (this.freeze > 0) { this.freeze--; return; }

    const pSpeed = 8.5;

    if (this.keys['w'] || this.keys['W']) { this.p1.y -= pSpeed; this.touchY.left = null; }
    else if (this.keys['s'] || this.keys['S']) { this.p1.y += pSpeed; this.touchY.left = null; }
    else if (this.touchY.left !== null) {
      const center = this.p1.y + this.p1.h / 2;
      const diff = this.touchY.left - center;
      this.p1.y += diff * 0.28;
    }

    if (this.mode === 'pvp') {
      if (this.keys['ArrowUp']) { this.p2.y -= pSpeed; this.touchY.right = null; }
      else if (this.keys['ArrowDown']) { this.p2.y += pSpeed; this.touchY.right = null; }
      else if (this.touchY.right !== null) {
        const center = this.p2.y + this.p2.h / 2;
        const diff = this.touchY.right - center;
        this.p2.y += diff * 0.28;
      }
    } else {
      this.aiUpdate();
    }

    this.p1.vy = this.p1.y - this.p1.prevY;
    this.p2.vy = this.p2.y - this.p2.prevY;
    this.p1.prevY = this.p1.y;
    this.p2.prevY = this.p2.y;

    this.p1.y = Math.max(0, Math.min(this.H - this.p1.h, this.p1.y));
    this.p2.y = Math.max(0, Math.min(this.H - this.p2.h, this.p2.y));

    const b = this.ball;
    const steps = 2;
    for (let s = 0; s < steps; s++) {
      b.x += b.vx / steps;
      b.y += b.vy / steps;

      if (b.y - b.size <= 0) {
        b.y = b.size;
        b.vy = Math.abs(b.vy);
        this.spawnParticles(b.x, b.y, 5, this.accent);
        SFX.play('wall');
      } else if (b.y + b.size >= this.H) {
        b.y = this.H - b.size;
        b.vy = -Math.abs(b.vy);
        this.spawnParticles(b.x, b.y, 5, this.accent);
        SFX.play('wall');
      }

      this.checkPaddleHit(this.p1, 1);
      this.checkPaddleHit(this.p2, -1);
    }

    if (b.x < -30) { this.p2.score++; this.onScore(-1); }
    else if (b.x > this.W + 30) { this.p1.score++; this.onScore(1); }

    this.trails.push({ x: b.x, y: b.y });
    if (this.trails.length > 16) this.trails.shift();

    if (this.shake > 0) { this.shake *= 0.85; if (this.shake < 0.3) this.shake = 0; }

    for (let i = this.particles.length - 1; i >= 0; i--) {
      const p = this.particles[i];
      p.x += p.vx; p.y += p.vy; p.life -= 0.05;
      if (p.life <= 0) this.particles.splice(i, 1);
    }
  },

  checkPaddleHit(pad, dir) {
    const b = this.ball;
    if (dir === 1 && b.vx > 0) return;
    if (dir === -1 && b.vx < 0) return;

    if (b.x - b.size < pad.x + pad.w &&
        b.x + b.size > pad.x &&
        b.y + b.size > pad.y &&
        b.y - b.size < pad.y + pad.h) {

      const hitPos = ((b.y - (pad.y + pad.h / 2)) / (pad.h / 2));
      const clampedHit = Math.max(-1, Math.min(1, hitPos));

      const maxAngle = Math.PI / 3;
      let angle = clampedHit * maxAngle + (pad.vy * 0.03);
      angle = Math.max(-maxAngle, Math.min(maxAngle, angle));

      b.speed = Math.min(b.speed + 0.4, this.baseSpeed + 8);
      this.rally++;

      const isSmash = Math.abs(pad.vy) > 5 && Math.abs(clampedHit) > 0.3;
      if (isSmash) {
        b.speed = Math.min(b.speed + 1.2, this.baseSpeed + 10);
        this.shake = 8;
        this.spawnParticles(b.x, b.y, 18, this.accent);
        SFX.play('smash');
      } else {
        this.shake = 3;
        this.spawnParticles(b.x, b.y, 10, '#ffffff');
        SFX.play('hit');
      }

      b.vx = dir * b.speed * Math.cos(angle);
      b.vy = b.speed * Math.sin(angle);
      if (Math.abs(b.vy) < 1) b.vy = (b.vy >= 0 ? 1 : -1) * 1;
      b.x = dir === 1 ? pad.x + pad.w + b.size : pad.x - b.size;
    }
  },

  aiUpdate() {
    const b = this.ball;
    const pad = this.p2;
    const center = pad.y + pad.h / 2;

    let speed, errorAmp, anticipation;
    if (this.diff === 'easy') { speed = 4.2; errorAmp = 45; anticipation = 0; }
    else if (this.diff === 'medium') { speed = 6.0; errorAmp = 18; anticipation = 0.5; }
    else { speed = 8.2; errorAmp = 2; anticipation = 1; }

    let targetY = this.H / 2;
    if (b.vx > 0) {
      targetY = this.predictBallY(anticipation);
      if (!this._aiError || Math.random() < 0.03) {
        this._aiError = (Math.random() - 0.5) * errorAmp;
      }
      targetY += this._aiError;
    }

    const diff = targetY - center;
    if (Math.abs(diff) > 4) {
      pad.y += Math.sign(diff) * Math.min(Math.abs(diff), speed);
    }
  },

  predictBallY(quality) {
    const b = this.ball;
    if (b.vx <= 0 || quality < 0.3) return b.y;
    let simX = b.x, simY = b.y, simVx = b.vx, simVy = b.vy;
    let steps = 0;
    while (simX < this.p2.x && steps < 200) {
      simX += simVx;
      simY += simVy;
      if (simY <= 0 || simY >= this.H) simVy *= -1;
      steps++;
    }
    return simY;
  },

  onScore(serveDir) {
    SFX.play('score');
    this.updateHUD();

    if (this.p1.score >= this.winScore || this.p2.score >= this.winScore) {
      const w = this.p1.score >= this.winScore ? 'PLAYER 1' : (this.mode === 'pvc' ? 'CPU' : 'PLAYER 2');
      this.flashMsg(w + ' WINS!', 'First to ' + this.winScore);
      SFX.play('win');
      this.state = 'gameover';
      setTimeout(() => this.toMenu(), 3000);
    } else {
      this.serveBall(serveDir);
    }
  },

  updateHUD() {
    document.getElementById('sl').textContent = this.p1.score;
    document.getElementById('sr').textContent = this.p2.score;
  },

  draw() {
    const cx = this.cx;
    cx.fillStyle = '#1a1114';
    cx.fillRect(0, 0, this.W, this.H);

    cx.save();
    if (this.shake > 0) {
      cx.translate((Math.random() - 0.5) * this.shake, (Math.random() - 0.5) * this.shake);
    }

    cx.strokeStyle = '#312026';
    cx.lineWidth = 4;
    cx.setLineDash([12, 16]);
    cx.beginPath(); cx.moveTo(this.W / 2, 0); cx.lineTo(this.W / 2, this.H); cx.stroke();
    cx.setLineDash([]);

    for (let i = 0; i < this.trails.length; i++) {
      const t = this.trails[i];
      const alpha = (i / this.trails.length) * 0.25;
      const sz = this.ball.size * (i / this.trails.length);
      cx.fillStyle = `rgba(255, 176, 205, ${alpha})`;
      cx.beginPath(); cx.arc(t.x, t.y, sz, 0, Math.PI * 2); cx.fill();
    }

    cx.fillStyle = this.accent;
    this.drawPaddle(cx, this.p1);
    this.drawPaddle(cx, this.p2);

    const b = this.ball;
    cx.fillStyle = '#ffffff';
    cx.beginPath(); cx.arc(b.x, b.y, b.size, 0, Math.PI * 2); cx.fill();

    for (const p of this.particles) {
      cx.fillStyle = p.color;
      cx.globalAlpha = Math.max(0, p.life);
      cx.beginPath(); cx.arc(p.x, p.y, p.size, 0, Math.PI * 2); cx.fill();
    }
    cx.globalAlpha = 1;
    cx.restore();
  },

  drawPaddle(cx, pad) {
    cx.beginPath();
    if (cx.roundRect) cx.roundRect(pad.x, pad.y, pad.w, pad.h, 8);
    else cx.rect(pad.x, pad.y, pad.w, pad.h);
    cx.fill();
  },

  spawnParticles(x, y, n, color) {
    for (let i = 0; i < n; i++) {
      this.particles.push({
        x, y,
        vx: (Math.random() - 0.5) * 7,
        vy: (Math.random() - 0.5) * 7,
        life: 0.8 + Math.random() * 0.2,
        size: 2 + Math.random() * 3,
        color
      });
    }
  },

  loop() {
    if (this.state !== 'playing') return;
    this.update();
    this.draw();
    this.loopId = requestAnimationFrame(() => this.loop());
  }
};

G.init();
</script>
</body>
</html>
<% } %>


