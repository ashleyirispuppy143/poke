    #confetti { position: fixed; inset: 0; pointer-events: none; z-index: 300; }
    .shake { animation: shake 0.3s ease-out; }
    @keyframes shake { 0%,100%{transform:translate(0)} 25%{transform:translate(-4px,2px)} 75%{transform:translate(4px,-2px)} }

    @media(max-width:600px) {
      :root{--cell:28px}
      .app-card{border-radius:0;max-width:100vw;max-height:100vh;width:100vw;height:100vh;padding:14px;}
    }
  </style>
</head>
<body>
<canvas id="confetti"></canvas>
<div class="app-card">

  <div class="top-row">
    <div class="app-title">Minesweeper</div>
    <div class="preset-bar">
      <button class="preset-btn" data-d="easy">9×9</button>
      <button class="preset-btn active" data-d="medium">16×16</button>
      <button class="preset-btn" data-d="hard">30×16</button>
      <button class="preset-btn" data-d="custom">Custom</button>
    </div>
    <div class="icon-actions">
      <button class="tb" id="b-help" title="Rules">?</button>
      <button class="tb" id="b-set" title="Options">⚙️</button>
    </div>
  </div>

  <div class="stats-bar">
    <div class="stat-block">
      <span class="stat-label">Mines Left</span>
      <div class="led" id="l-mines">040</div>
    </div>
    <button class="face" id="face" title="Restart">🙂</button>
    <div class="stat-block right">
      <span class="stat-label">Time</span>
      <div class="led" id="l-timer">000</div>
    </div>
  </div>

  <div class="bwrap" id="bwrap">
    <div id="grid"></div>
    <div class="gov" id="gov">
      <div class="goc">
        <div class="go-e" id="ge">💥</div>
        <div class="go-t" id="gt">Game Over</div>
        <div class="go-s" id="gs">Stepped on a mine</div>
        <button class="go-b" id="gb">Play Again</button>
      </div>
    </div>
  </div>

  <div class="bottom-bar">
    <div class="mode-switch">
      <button class="mb active" id="m-dig">⛏️ Dig</button>
      <button class="mb" id="m-flag">🚩 Flag</button>
      <button class="mb" id="m-new">🔄 Reset</button>
    </div>
  </div>
</div>

<div class="mbg" id="mod-set">
  <div class="mbox">
    <h3>Options</h3>
    <div class="mr">
      <label>Board Size</label>
      <select id="o-diff">
        <option value="easy">9×9 (10 mines)</option>
        <option value="medium" selected>16×16 (40 mines)</option>
        <option value="hard">30×16 (99 mines)</option>
        <option value="custom">Custom</option>
      </select>
      <div class="custom-grid" id="custom-inputs" style="display:none;">
        <div><label>Width</label><input type="number" id="c-cols" min="6" max="40" value="12"></div>
        <div><label>Height</label><input type="number" id="c-rows" min="6" max="30" value="12"></div>
        <div><label>Mines</label><input type="number" id="c-mines" min="1" max="300" value="24"></div>
      </div>
    </div>
    <div class="mr">
      <label>Tile Size</label>
      <select id="o-scale">
        <option value="auto" selected>Auto Fit</option>
        <option value="26">Small</option>
        <option value="32">Medium</option>
        <option value="38">Large</option>
      </select>
    </div>
    <div class="mr">
      <div class="trow">
        <div><span>Question Marks</span><div class="tdesc">Right-click cycles through Flag, ?, and blank.</div></div>
        <button class="tsw" id="o-qmark"></button>
      </div>
      <div class="trow">
        <div><span>Strict Flags</span><div class="tdesc">Flagging a safe tile ends the game right away.</div></div>
        <button class="tsw" id="o-strict"></button>
      </div>
    </div>
    <div class="macts">
      <button class="mbt mbt-g" id="set-cancel">Cancel</button>
      <button class="mbt mbt-p" id="set-save">Apply</button>
    </div>
  </div>
</div>

<div class="mbg" id="mod-help">
  <div class="mbox">
    <h3>Controls & Rules</h3>
    <div style="font-size:0.92rem;line-height:1.65;color:var(--text-dim);display:flex;flex-direction:column;gap:8px;">
      <p>Left-click a tile to uncover it. The number shows how many mines touch that tile.</p>
      <p>Right-click (or hold on touchscreens) to place a flag on a suspected mine.</p>
      <p>Click an uncovered number once you've flagged all its mines to open the rest of its neighbors at once.</p>
      <p>Your first click is always safe.</p>
    </div>
    <div class="macts"><button class="mbt mbt-p" id="help-close" style="flex:1">Close</button></div>
  </div>
</div>

<script>
const AC=new(window.AudioContext||window.webkitAudioContext)();
function sfx(t){if(AC.state==='suspended')AC.resume();const o=AC.createOscillator(),g=AC.createGain();o.connect(g);g.connect(AC.destination);const n=AC.currentTime;({dig(){o.type='sine';o.frequency.setValueAtTime(520,n);o.frequency.exponentialRampToValueAtTime(220,n+.06);g.gain.setValueAtTime(.05,n);g.gain.exponentialRampToValueAtTime(.001,n+.06);o.start(n);o.stop(n+.06)},flag(){o.type='triangle';o.frequency.setValueAtTime(480,n);o.frequency.exponentialRampToValueAtTime(820,n+.05);g.gain.setValueAtTime(.04,n);g.gain.exponentialRampToValueAtTime(.001,n+.05);o.start(n);o.stop(n+.05)},win(){o.type='sine';o.frequency.setValueAtTime(523,n);o.frequency.setValueAtTime(659,n+.1);o.frequency.setValueAtTime(784,n+.2);o.frequency.setValueAtTime(1047,n+.3);g.gain.setValueAtTime(.08,n);g.gain.linearRampToValueAtTime(0,n+.5);o.start(n);o.stop(n+.5)},lose(){o.type='sawtooth';o.frequency.setValueAtTime(160,n);o.frequency.linearRampToValueAtTime(45,n+.45);g.gain.setValueAtTime(.09,n);g.gain.linearRampToValueAtTime(0,n+.45);o.start(n);o.stop(n+.45)},bad(){o.type='sine';o.frequency.setValueAtTime(150,n);o.frequency.setValueAtTime(110,n+.1);g.gain.setValueAtTime(.08,n);g.gain.linearRampToValueAtTime(0,n+.2);o.start(n);o.stop(n+.2)},chord(){o.type='sine';o.frequency.setValueAtTime(420,n);o.frequency.exponentialRampToValueAtTime(760,n+.05);g.gain.setValueAtTime(.04,n);g.gain.exponentialRampToValueAtTime(.001,n+.05);o.start(n);o.stop(n+.05)}})[t]?.()}

class MS{
  constructor(){
    this.G=document.getElementById('grid');
    this.LM=document.getElementById('l-mines');
    this.LT=document.getElementById('l-timer');
    this.F=document.getElementById('face');
    this.BW=document.getElementById('bwrap');
    this.GOV=document.getElementById('gov');
    this.fm=false;this.strict=false;this.qmarks=false;this.scale='auto';this.diff='medium';
    this.custom={rows:12,cols:12,mines:24};
    this.lt=null;this.lf=false;this.best={easy:null,medium:null,hard:null,custom:null};
    this.revealTimeouts = [];
    this.goTimeout = null;
    this.bind();this.init('medium');
  }

  bind(){
    this.F.onclick=()=>this.init();
    document.getElementById('gb').onclick=()=>{this.GOV.classList.remove('show');this.init()};

    const db=document.getElementById('m-dig'),fb=document.getElementById('m-flag');
    db.onclick=()=>{this.fm=false;db.classList.add('active');fb.classList.remove('active')};
    fb.onclick=()=>{this.fm=true;fb.classList.add('active');db.classList.remove('active')};
    document.getElementById('m-new').onclick=()=>this.init();

    document.querySelectorAll('.preset-btn').forEach(b=>{
      b.onclick=()=>{
        const d=b.dataset.d;
        if(d==='custom'){
          document.getElementById('o-diff').value='custom';
          document.getElementById('custom-inputs').style.display='grid';
          this.om('mod-set');
          return;
        }
        this.diff=d;
        document.getElementById('o-diff').value=d;
        this.init(d);
      };
    });

    document.getElementById('o-diff').onchange=e=>{
      document.getElementById('custom-inputs').style.display=e.target.value==='custom'?'grid':'none';
    };

    document.getElementById('b-set').onclick=()=>this.om('mod-set');
    document.getElementById('set-cancel').onclick=()=>this.cm('mod-set');
    document.getElementById('set-save').onclick=()=>{
      this.diff=document.getElementById('o-diff').value;
      this.scale=document.getElementById('o-scale').value;
      if(this.diff==='custom'){
        const c=Math.max(6,Math.min(40,parseInt(document.getElementById('c-cols').value)||12));
        const r=Math.max(6,Math.min(30,parseInt(document.getElementById('c-rows').value)||12));
        const m=Math.max(1,Math.min(r*c-9,parseInt(document.getElementById('c-mines').value)||20));
        this.custom={rows:r,cols:c,mines:m};
      }
      this.init(this.diff);this.cm('mod-set');
    };
    document.getElementById('o-strict').onclick=e=>{e.currentTarget.classList.toggle('on');this.strict=e.currentTarget.classList.contains('on')};
    document.getElementById('o-qmark').onclick=e=>{e.currentTarget.classList.toggle('on');this.qmarks=e.currentTarget.classList.contains('on')};

    document.getElementById('b-help').onclick=()=>this.om('mod-help');
    document.getElementById('help-close').onclick=()=>this.cm('mod-help');

    document.querySelectorAll('.mbg').forEach(m=>{m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open')})});
  }

  om(id){document.getElementById(id).classList.add('open')}
  cm(id){document.getElementById(id).classList.remove('open')}

  init(d){
    if(this.revealTimeouts) this.revealTimeouts.forEach(clearTimeout);
    this.revealTimeouts = [];
    if(this.goTimeout) clearTimeout(this.goTimeout);

    if(d)this.diff=d;
    const D={easy:[9,9,10],medium:[16,16,40],hard:[16,30,99],custom:[this.custom.rows,this.custom.cols,this.custom.mines]};
    [this.rows,this.cols,this.mines]=D[this.diff];

    document.querySelectorAll('.preset-btn').forEach(b=>{
      b.classList.toggle('active', b.dataset.d === this.diff);
    });

    let sz = 34;
    if (this.scale === 'auto') {
      const mW=window.innerWidth-70,mH=window.innerHeight-260;
      sz=Math.max(24,Math.min(38,Math.floor(mW/this.cols),Math.floor(mH/this.rows)));
    } else {
      sz = parseInt(this.scale, 10);
    }
    document.documentElement.style.setProperty('--cell',sz+'px');

    this.cells=[];this.dead=false;this.won=false;this.first=true;
    this.ml=this.mines;this.fc=0;this.sec=0;
    this.stopT();this.LT.textContent='000';this.updLED();
    this.F.textContent='🙂';this.GOV.classList.remove('show');

    this.G.style.gridTemplateColumns=`repeat(${this.cols},var(--cell))`;
    this.G.innerHTML='';

    for(let i=0;i<this.rows*this.cols;i++){
      this.cells.push({m:false,o:false,f:false,q:false,n:0});
      const el=document.createElement('div');el.className='c';
      el.addEventListener('mousedown',e=>{if(e.button===0)this.clk(i);else if(e.button===2){e.preventDefault();this.flg(i)}});
      el.addEventListener('contextmenu',e=>e.preventDefault());
      el.addEventListener('touchstart',()=>{this.lf=false;this.lt=setTimeout(()=>{this.lf=true;this.flg(i)},380)},{passive:true});
      el.addEventListener('touchend',()=>{clearTimeout(this.lt);if(!this.lf)this.clk(i)});
      el.addEventListener('touchmove',()=>clearTimeout(this.lt),{passive:true});
      this.G.appendChild(el);
    }
  }

  place(safe){
    const ex=new Set([safe,...this.nb(safe)]);let n=0;
    while(n<this.mines){const i=Math.floor(Math.random()*this.cells.length);if(ex.has(i)||this.cells[i].m)continue;this.cells[i].m=true;n++}
    for(let i=0;i<this.cells.length;i++)if(!this.cells[i].m)this.cells[i].n=this.nb(i).filter(j=>this.cells[j].m).length;
  }

  clk(i){
    if(this.dead||this.won)return;
    const c=this.cells[i];
    if(this.fm&&!c.o){this.flg(i);return}
    if(c.f||c.q)return;
    if(c.o){this.chord(i);return}
    this.rev(i);
  }

  flg(i){
    if(this.dead||this.won)return;
    const c=this.cells[i];if(c.o)return;
    const el=this.G.children[i];
    if(c.f){
      c.f=false;this.fc--;this.ml++;el.classList.remove('flagged');
      if(this.qmarks){c.q=true;el.textContent='❓';}else{el.textContent='';}
      sfx('flag');this.updLED();return;
    }
    if(c.q){
      c.q=false;el.textContent='';sfx('flag');return;
    }
    if(this.strict&&this.fc>=this.mines){sfx('bad');return}
    c.f=true;this.fc++;this.ml--;
    el.classList.add('flagged');el.textContent='🚩';sfx('flag');this.updLED();
    if(this.strict&&!c.m){setTimeout(()=>this.end(false,i,true),200)}
  }

  rev(i){
    if(this.first){this.first=false;this.place(i);this.startT()}
    const c=this.cells[i];if(c.o||c.f)return;c.o=true;
    const el=this.G.children[i];el.classList.add('o');
    if(c.m){this.end(false,i);return}
    sfx('dig');
    if(c.n>0){el.textContent=c.n;el.classList.add('n'+c.n)}
    else{this.nb(i).forEach(j=>{if(!this.cells[j].o)this.rev(j)})}
    this.chkWin();
  }

  chord(i){
    const c=this.cells[i];if(!c.o||c.n===0)return;
    const ns=this.nb(i);if(ns.filter(j=>this.cells[j].f).length!==c.n)return;
    let any=false;
    ns.forEach(j=>{if(!this.cells[j].o&&!this.cells[j].f){this.rev(j);any=true}});
    if(any)sfx('chord');
  }

  nb(i){
    const o=[],x=i%this.cols,y=Math.floor(i/this.cols);
    for(let dx=-1;dx<=1;dx++)for(let dy=-1;dy<=1;dy++){if(!dx&&!dy)continue;const nx=x+dx,ny=y+dy;if(nx>=0&&nx<this.cols&&ny>=0&&ny<this.rows)o.push(ny*this.cols+nx)}
    return o;
  }

  updLED(){const v=Math.max(-99,this.ml);this.LM.textContent=v<0?'-'+String(Math.abs(v)).padStart(2,'0'):String(v).padStart(3,'0')}
  startT(){this.iv=setInterval(()=>{this.sec++;this.LT.textContent=String(Math.min(999,this.sec)).padStart(3,'0')},1000)}
  stopT(){clearInterval(this.iv)}

  chkWin(){if(this.cells.filter(c=>c.o).length===this.cells.length-this.mines)this.end(true)}

  end(won,hit,wf=false){
    this.dead=!won;this.won=won;this.stopT();
    Array.from(this.G.children).forEach(el=>el.classList.add('go'));

    if(won){
      this.F.textContent='😎';sfx('win');doConfetti();
      this.cells.forEach((c,i)=>{if(c.m&&!c.f){this.G.children[i].textContent='🚩';this.G.children[i].classList.add('flagged')}});
      const b=this.best[this.diff],ib=b===null||this.sec<b;if(ib)this.best[this.diff]=this.sec;
      document.getElementById('ge').textContent='🏆';
      document.getElementById('gt').textContent='Cleared!';
      document.getElementById('gt').style.color='var(--win)';
      document.getElementById('gs').textContent=this.sec+'s'+(ib?' (New record)':b?' (Best: '+b+'s)':'');
    } else {
      this.F.textContent='😵';sfx('lose');
      this.BW.classList.add('shake');setTimeout(()=>this.BW.classList.remove('shake'),400);
      const mi=this.cells.map((c,i)=>c.m?i:-1).filter(x=>x>=0);

      mi.forEach((m,k)=>{
        this.revealTimeouts.push(
          setTimeout(()=>{
            const el=this.G.children[m];
            if(!el) return;
            if(m===hit) el.classList.add('mine-hit');
            else el.classList.add('mine-show');
            el.classList.add('o');
            if(!this.cells[m].f) el.textContent='💣';
          }, k*15)
        );
      });

      this.cells.forEach((c,i)=>{if(!c.m&&c.f){const el=this.G.children[i];el.classList.add('wrong-flag','o');el.textContent='✕';el.style.color='var(--danger)';el.style.fontWeight='900'}});
      if(wf){document.getElementById('ge').textContent='🚩';document.getElementById('gt').textContent='Misflagged';document.getElementById('gs').textContent="That tile was safe"}
      else{document.getElementById('ge').textContent='💥';document.getElementById('gt').textContent='Game Over';document.getElementById('gs').textContent='Stepped on a mine'}
      document.getElementById('gt').style.color='var(--danger)';
    }

    this.goTimeout = setTimeout(()=>this.GOV.classList.add('show'),won?400:600);
  }
}

function doConfetti(){const cv=document.getElementById('confetti'),cx=cv.getContext('2d');cv.width=innerWidth;cv.height=innerHeight;const P=[],cl=['#ffb0cd','#ffdf9e','#a6f2d1','#d0bcff','#ffffff'];for(let i=0;i<140;i++){const a=Math.random()*Math.PI*2,v=5+Math.random()*9;P.push({x:cv.width/2,y:cv.height/2,vx:Math.cos(a)*v,vy:Math.sin(a)*v-5,life:70+Math.random()*50,c:cl[Math.floor(Math.random()*cl.length)],w:4+Math.random()*5,h:3+Math.random()*3,r:Math.random()*360,rv:(Math.random()-.5)*14})}(function f(){cx.clearRect(0,0,cv.width,cv.height);let a=false;P.forEach(p=>{if(p.life<=0)return;a=true;p.x+=p.vx;p.y+=p.vy;p.vy+=.14;p.life--;p.r+=p.rv;cx.save();cx.translate(p.x,p.y);cx.rotate(p.r*Math.PI/180);cx.fillStyle=p.c;cx.globalAlpha=Math.min(1,p.life/15);cx.fillRect(-p.w/2,-p.h/2,p.w,p.h);cx.restore()});if(a)requestAnimationFrame(f)})()}

new MS();
</script>
</body>
</html>
<% } %>


<% if (game === "breakout") { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>BREAKOUT</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
  <style>
    @font-face {
      font-family: "PokeTube Flex";
      src: url("/static/robotoflex.ttf?v=29");
      font-style: normal;
      font-stretch: 1% 800%;
      font-display: swap;
    }
    :root {
      --primary: #ffb0cd;
      --on-primary: #541d34;
      --bg-dark: #1a1114;
      --surface: #271a1f;
      --surface-2: #352329;
      --text: #f0dee3;
      --muted: #d6c2c7;
    }

    body {
      margin: 0; overflow: hidden;
      background: #120b0d; color: var(--primary);
      font-family: "PokeTube Flex", system-ui, -apple-system, sans-serif;
      display: flex; justify-content: center; align-items: center;
      height: 100vh;
    }

    #arcade-cabinet {
      position: relative;
      width: 100%; height: 100%;
      max-width: 1000px; max-height: 800px;
      background: var(--bg-dark);
      border-radius: 36px;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
      overflow: hidden;
    }

    canvas { display: block; width: 100%; height: 100%; }

    .ui-layer {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      z-index: 20; background: rgba(26, 17, 20, 0.88);
      backdrop-filter: blur(14px); transition: opacity 0.25s;
    }

    .hidden { opacity: 0; pointer-events: none; }

    h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 800; color: var(--primary); margin-bottom: 2rem; letter-spacing: -1px; text-align: center; line-height: 1.15; }

    button {
      background: var(--primary); border: none;
      color: var(--on-primary); font-family: inherit;
      padding: 16px 32px; cursor: pointer;
      font-size: 1rem; font-weight: 700; margin: 8px; border-radius: 24px;
      transition: transform 0.15s ease, background 0.15s ease;
    }
    button:hover { transform: scale(1.03); background: #ffc2d9; }

    #hud {
      position: absolute; top: 18px; left: 0; width: 100%;
      display: flex; justify-content: space-between; padding: 0 28px;
      font-size: 1.05rem; font-weight: 800; pointer-events: none; z-index: 5;
      box-sizing: border-box; color: var(--text);
    }

    #msg-display {
      position: absolute; top: 42%; width: 100%; text-align: center;
      font-size: 2.2rem; font-weight: 800; color: var(--primary);
      pointer-events: none; z-index: 5; opacity: 0; transition: opacity 0.2s;
    }

    #settings-btn {
      position: absolute; bottom: 20px; right: 20px; z-index: 30;
      width: 48px; height: 48px; font-size: 1.2rem; padding: 0;
      background: var(--surface-2); color: var(--text); border-radius: 20px;
      display: grid; place-items: center;
    }

    .settings-box {
      background: var(--surface); padding: 28px; border-radius: 32px;
      display: flex; flex-direction: column; align-items: center; width: min(340px, 88vw);
    }

    .setting-row { display: flex; justify-content: space-between; width: 100%; margin: 10px 0; color: var(--text); font-size: 0.95rem; font-weight: 600; align-items: center; }
    input[type=range] { width: 120px; accent-color: var(--primary); }
    input[type=color] { background: var(--surface-2); border: none; border-radius: 12px; width: 60px; height: 36px; padding: 3px; cursor: pointer; }
  </style>
</head>
<body>

<div id="arcade-cabinet">
  <div id="hud">
    <span>SCORE: <span id="score-el">0</span></span>
    <span>LIVES: <span id="lives-el">3</span></span>
  </div>
  <div id="msg-display">LEVEL 1</div>

  <div id="menu-start" class="ui-layer">
    <h1>BREAKOUT</h1>
    <button onclick="Game.start()">START GAME</button>
  </div>

  <div id="menu-settings" class="ui-layer hidden">
    <div class="settings-box">
      <h2 style="color:var(--primary); margin:0 0 16px 0; font-size:1.6rem; font-weight:800;">PAUSED</h2>
      <div class="setting-row"><label>Theme</label><input type="color" id="set-color" value="#ffb0cd"></div>
      <div class="setting-row"><label>Speed</label><input type="range" id="set-speed" min="3" max="10" value="5"></div>
      <div class="setting-row"><label>Sound</label><input type="checkbox" id="set-sfx" checked style="width:20px; height:20px; accent-color:var(--primary);"></div>
      <div style="display:flex; width:100%; gap:10px; margin-top:16px;">
        <button onclick="Game.resume()" style="flex:1; margin:0;">RESUME</button>
        <button onclick="Game.reset()" style="flex:1; margin:0; background:var(--surface-2); color:var(--text);">QUIT</button>
      </div>
    </div>
  </div>

  <button id="settings-btn" onclick="Game.pause()">⚙️</button>
  <canvas id="gameCanvas" width="800" height="600"></canvas>
</div>

<script>
const AudioEngine = {
  ctx: new (window.AudioContext || window.webkitAudioContext)(),
  enabled: true,

  play(type, combo = 0) {
    if (!this.enabled) return;
    if (this.ctx.state === 'suspended') this.ctx.resume();
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.connect(gain);
    gain.connect(this.ctx.destination);
    const now = this.ctx.currentTime;
    const pitchMod = Math.min(2.2, 1 + combo * 0.07);

    if (type === 'hit') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(520, now);
      osc.frequency.exponentialRampToValueAtTime(180, now + 0.08);
      gain.gain.setValueAtTime(0.07, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
      osc.start(now); osc.stop(now + 0.08);
    } else if (type === 'brick') {
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(380 * pitchMod, now);
      osc.frequency.linearRampToValueAtTime(680 * pitchMod, now + 0.07);
      gain.gain.setValueAtTime(0.07, now);
      gain.gain.linearRampToValueAtTime(0, now + 0.1);
      osc.start(now); osc.stop(now + 0.1);
    } else if (type === 'armor') {
      osc.type = 'square';
      osc.frequency.setValueAtTime(210, now);
      osc.frequency.exponentialRampToValueAtTime(120, now + 0.06);
      gain.gain.setValueAtTime(0.05, now);
      gain.gain.exponentialRampToValueAtTime(0.005, now + 0.06);
      osc.start(now); osc.stop(now + 0.06);
    } else if (type === 'explode') {
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(160, now);
      osc.frequency.exponentialRampToValueAtTime(38, now + 0.28);
      gain.gain.setValueAtTime(0.11, now);
      gain.gain.linearRampToValueAtTime(0, now + 0.28);
      osc.start(now); osc.stop(now + 0.28);
    } else if (type === 'laser') {
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(880, now);
      osc.frequency.exponentialRampToValueAtTime(240, now + 0.05);
      gain.gain.setValueAtTime(0.03, now);
      gain.gain.linearRampToValueAtTime(0, now + 0.05);
      osc.start(now); osc.stop(now + 0.05);
    } else if (type === 'powerup') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(580, now);
      osc.frequency.linearRampToValueAtTime(1160, now + 0.25);
      gain.gain.setValueAtTime(0.07, now);
      gain.gain.linearRampToValueAtTime(0, now + 0.25);
      osc.start(now); osc.stop(now + 0.25);
    } else if (type === 'lose') {
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(180, now);
      osc.frequency.linearRampToValueAtTime(55, now + 0.4);
      gain.gain.setValueAtTime(0.08, now);
      gain.gain.linearRampToValueAtTime(0, now + 0.4);
      osc.start(now); osc.stop(now + 0.4);
    }
  }
};

const Game = {
  canvas: document.getElementById('gameCanvas'),
  ctx: document.getElementById('gameCanvas').getContext('2d'),
  width: 800, height: 600,

  state: 'menu',
  loopId: null,

  level: 1,
  score: 0,
  lives: 3,
  combo: 0,
  shake: 0,

  baseSpeed: 6,
  accent: '#ffb0cd',
  keys: {},

  paddle: {
    x: 348, y: 550, w: 104, h: 16,
    targetX: 400, vx: 0, prevX: 348,
    laserTimer: 0, wideTimer: 0, magnetTimer: 0, shieldTimer: 0
  },
  fireballTimer: 0,
  slowTimer: 0,

  balls: [],
  bricks: [],
  particles: [],
  shockwaves: [],
  floatingTexts: [],
  powerups: [],
  lasers: [],

  init() {
    const updatePaddle = (clientX) => {
      const rect = this.canvas.getBoundingClientRect();
      const scaleX = this.canvas.width / rect.width;
      let x = (clientX - rect.left) * scaleX;
      this.paddle.targetX = Math.max(this.paddle.w / 2, Math.min(this.width - this.paddle.w / 2, x));
    };

    window.addEventListener('mousemove', e => updatePaddle(e.clientX));
    this.canvas.addEventListener('touchmove', e => { e.preventDefault(); updatePaddle(e.touches[0].clientX); }, {passive: false});
    this.canvas.addEventListener('mousedown', () => this.launchWaitingBalls());
    this.canvas.addEventListener('touchstart', () => this.launchWaitingBalls(), {passive: true});

    window.addEventListener('keydown', e => {
      this.keys[e.key] = true;
      if (e.code === 'Space') this.launchWaitingBalls();
      if (e.key === 'Escape') {
        if (this.state === 'playing') this.pause();
        else if (this.state === 'paused') this.resume();
      }
    });
    window.addEventListener('keyup', e => this.keys[e.key] = false);

    document.getElementById('set-color').addEventListener('input', e => {
      this.accent = e.target.value;
      document.documentElement.style.setProperty('--primary', this.accent);
    });
    document.getElementById('set-speed').addEventListener('input', e => {
      this.baseSpeed = parseInt(e.target.value) + 1;
      this.balls.forEach(b => { if (!b.held) this.normalizeBallVelocity(b); });
    });
    document.getElementById('set-sfx').addEventListener('change', e => AudioEngine.enabled = e.target.checked);
  },

  getTargetBallSpeed() {
    const levelBoost = Math.min(2.8, (this.level - 1) * 0.35);
    const mult = this.slowTimer > 0 ? 0.68 : 1;
    return (this.baseSpeed + levelBoost) * mult;
  },

  normalizeBallVelocity(b) {
    const target = this.getTargetBallSpeed();
    let angle = Math.atan2(b.vy, b.vx);
    const minVert = 0.26;
    if (Math.abs(Math.sin(angle)) < minVert) {
      const signY = b.vy >= 0 ? 1 : -1;
      const signX = b.vx >= 0 ? 1 : -1;
      angle = signX > 0 ? (signY * minVert) : (Math.PI - signY * minVert);
    }
    b.vx = Math.cos(angle) * target;
    b.vy = Math.sin(angle) * target;
  },

  launchWaitingBalls() {
    if (this.state !== 'playing') return;
    const spd = this.getTargetBallSpeed();
    this.balls.forEach(b => {
      if (b.held) {
        b.held = false;
        const offset = (b.holdOffset || 0) / (this.paddle.w / 2);
        const angle = -Math.PI / 2 + offset * 0.55 + (Math.random() - 0.5) * 0.15;
        b.vx = Math.cos(angle) * spd;
        b.vy = Math.sin(angle) * spd;
        this.normalizeBallVelocity(b);
      }
    });
  },

  start() {
    this.score = 0;
    this.lives = 3;
    this.level = 1;
    this.resetLevel();
    this.state = 'playing';

    document.getElementById('menu-start').classList.add('hidden');
    document.getElementById('menu-settings').classList.add('hidden');
    document.getElementById('settings-btn').style.display = 'grid';
    this.updateHUD();
    if (this.loopId) cancelAnimationFrame(this.loopId);
    this.loop();
  },

  pause() {
    if (this.state === 'playing') {
      this.state = 'paused';
      document.getElementById('menu-settings').classList.remove('hidden');
      cancelAnimationFrame(this.loopId);
    }
  },

  resume() {
    if (this.state === 'paused') {
      this.state = 'playing';
      document.getElementById('menu-settings').classList.add('hidden');
      this.loop();
    }
  },

  reset() {
    this.state = 'menu';
    document.getElementById('menu-start').classList.remove('hidden');
    document.getElementById('menu-settings').classList.add('hidden');
    document.getElementById('settings-btn').style.display = 'none';
    cancelAnimationFrame(this.loopId);
  },

  resetLevel() {
    this.bricks = [];
    const rows = Math.min(9, 5 + Math.floor(this.level / 2));
    const cols = 10;
    const padding = 8;
    const brickW = (this.width - padding * (cols + 1)) / cols;
    const brickH = 24;
    const colors = ['#ff80ab', '#ffb0cd', '#ffdf9e', '#a6f2d1', '#a8c7fa', '#d0bcff'];
    const pattern = (this.level - 1) % 5;

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        let place = true;
        if (pattern === 1 && (r + c) % 2 === 1 && r % 2 === 1) place = false;
        else if (pattern === 2 && (c < Math.floor(r / 2) || c >= cols - Math.floor(r / 2))) place = false;
        else if (pattern === 3 && (c === 4 || c === 5) && r > 0 && r < rows - 1) place = false;
        else if (pattern === 4 && Math.abs(c - 4.5) + Math.abs(r - (rows - 1) / 2) > 5.5) place = false;
        if (!place) continue;

        let type = 'normal';
        let hp = 1;
        const roll = Math.random();

        if (this.level >= 3 && r === rows - 1 && (c === 2 || c === 7)) {
          type = 'gold';
          hp = 999;
        } else if (roll < 0.08 && r > 0 && r < rows - 1) {
          type = 'explosive';
          hp = 1;
        } else if (r === 0 && this.level >= 2) {
          type = 'armor';
          hp = Math.min(3, 2 + Math.floor(this.level / 4));
        } else if (r === 1 && roll < 0.35 && this.level >= 2) {
          type = 'armor';
          hp = 2;
        }

        const baseX = padding + c * (brickW + padding);
        this.bricks.push({
          x: baseX,
          baseX,
          y: 58 + r * (brickH + padding),
          w: brickW,
          h: brickH,
          color: type === 'explosive' ? '#ff5470' : type === 'gold' ? '#ffd166' : colors[r % colors.length],
          type,
          hp,
          maxHp: hp,
          breakable: type !== 'gold',
          moving: this.level >= 4 && r === rows - 2 && type !== 'gold',
          movePhase: r + c * 0.5,
          hitFlash: 0,
          active: true,
          value: (rows - r) * 15 * hp
        });
      }
    }

    this.paddle.w = 104;
    this.paddle.laserTimer = 0;
    this.paddle.wideTimer = 0;
    this.paddle.magnetTimer = 0;
    this.paddle.shieldTimer = 0;
    this.fireballTimer = 0;
    this.slowTimer = 0;
    this.powerups = [];
    this.lasers = [];
    this.shockwaves = [];
    this.floatingTexts = [];
    this.resetBall();
    this.flashMsg(`LEVEL ${this.level}`);
  },

  resetBall() {
    this.combo = 0;
    this.balls = [{
      x: this.paddle.x + this.paddle.w / 2,
      y: this.paddle.y - 8,
      vx: 0,
      vy: 0,
      r: 7,
      active: true,
      held: true,
      holdOffset: 0,
      trail: []
    }];
  },

  spawnPowerup(x, y) {
    const types = ['multi', 'wide', 'laser', 'slow', 'fire', 'magnet', 'shield', 'life'];
    const weights = [20, 20, 18, 14, 12, 12, 12, 4];
    const total = weights.reduce((a, b) => a + b, 0);
    let pick = Math.random() * total;
    let type = 'multi';
    for (let i = 0; i < types.length; i++) {
      if (pick < weights[i]) { type = types[i]; break; }
      pick -= weights[i];
    }
    this.powerups.push({ x, y, type, vy: 2.6, w: 24, h: 24, phase: Math.random() * Math.PI * 2 });
  },

  addFloatingText(x, y, text, color = '#ffffff') {
    this.floatingTexts.push({ x, y, text, color, life: 1.0, vy: -1.2 });
  },

  update() {
    if (this.keys['ArrowLeft'] || this.keys['a'] || this.keys['A']) {
      this.paddle.targetX = Math.max(this.paddle.w / 2, this.paddle.targetX - 10);
    }
    if (this.keys['ArrowRight'] || this.keys['d'] || this.keys['D']) {
      this.paddle.targetX = Math.min(this.width - this.paddle.w / 2, this.paddle.targetX + 10);
    }

    this.paddle.prevX = this.paddle.x;
    this.paddle.x += (this.paddle.targetX - this.paddle.w / 2 - this.paddle.x) * 0.32;
    this.paddle.x = Math.max(0, Math.min(this.width - this.paddle.w, this.paddle.x));
    this.paddle.vx = this.paddle.x - this.paddle.prevX;

    if (this.paddle.wideTimer > 0) {
      this.paddle.wideTimer--;
      if (this.paddle.wideTimer === 0) this.paddle.w = 104;
    }
    if (this.paddle.magnetTimer > 0) this.paddle.magnetTimer--;
    if (this.paddle.shieldTimer > 0) this.paddle.shieldTimer--;
    if (this.fireballTimer > 0) this.fireballTimer--;
    if (this.slowTimer > 0) {
      this.slowTimer--;
      if (this.slowTimer === 0) {
        this.balls.forEach(b => { if (!b.held) this.normalizeBallVelocity(b); });
      }
    }

    const time = performance.now() * 0.0025;
    this.bricks.forEach(br => {
      if (!br.active) return;
      if (br.hitFlash > 0) br.hitFlash--;
      if (br.moving) {
        br.x = Math.max(8, Math.min(this.width - br.w - 8, br.baseX + Math.sin(time + br.movePhase) * 26));
      }
    });

    if (this.paddle.laserTimer > 0) {
      this.paddle.laserTimer--;
      if (this.paddle.laserTimer % 16 === 0) {
        this.lasers.push({ x: this.paddle.x + 10, y: this.paddle.y, vy: -12 });
        this.lasers.push({ x: this.paddle.x + this.paddle.w - 14, y: this.paddle.y, vy: -12 });
        AudioEngine.play('laser');
      }
    }

    for (let i = this.lasers.length - 1; i >= 0; i--) {
      let l = this.lasers[i];
      l.y += l.vy;
      let hit = false;
      for (let b of this.bricks) {
        if (b.active && l.x + 4 > b.x && l.x < b.x + b.w && l.y > b.y && l.y < b.y + b.h) {
          this.damageBrick(b, 1);
          hit = true;
          break;
        }
      }
      if (l.y < 0 || hit) this.lasers.splice(i, 1);
    }

    let activeBalls = 0;
    const subSteps = 3;

    this.balls.forEach(b => {
      if (!b.active) return;
      activeBalls++;

      if (b.held) {
        b.x = Math.max(b.r, Math.min(this.width - b.r, this.paddle.x + this.paddle.w / 2 + (b.holdOffset || 0)));
        b.y = this.paddle.y - b.r - 1;
        b.trail = [];
        return;
      }

      b.trail.push({ x: b.x, y: b.y });
      if (b.trail.length > 10) b.trail.shift();

      for (let step = 0; step < subSteps; step++) {
        b.x += b.vx / subSteps;
        b.y += b.vy / subSteps;

        if (b.x < b.r) {
          b.x = b.r;
          b.vx = Math.abs(b.vx);
          this.normalizeBallVelocity(b);
          AudioEngine.play('hit');
        }
        if (b.x > this.width - b.r) {
          b.x = this.width - b.r;
          b.vx = -Math.abs(b.vx);
          this.normalizeBallVelocity(b);
          AudioEngine.play('hit');
        }
        if (b.y < b.r) {
          b.y = b.r;
          b.vy = Math.abs(b.vy);
          this.normalizeBallVelocity(b);
          AudioEngine.play('hit');
        }

        if (this.paddle.shieldTimer > 0 && b.vy > 0 && b.y + b.r >= this.height - 10) {
          b.y = this.height - 10 - b.r;
          b.vy = -Math.abs(b.vy);
          this.paddle.shieldTimer = Math.max(0, this.paddle.shieldTimer - 120);
          this.normalizeBallVelocity(b);
          this.createParticles(b.x, b.y, 12, '#7fd8eb');
          AudioEngine.play('hit');
        }

        if (b.vy > 0 &&
            b.y + b.r >= this.paddle.y &&
            b.y - b.r <= this.paddle.y + this.paddle.h &&
            b.x + b.r >= this.paddle.x &&
            b.x - b.r <= this.paddle.x + this.paddle.w) {

          if (this.paddle.magnetTimer > 0) {
            b.held = true;
            b.holdOffset = Math.max(-this.paddle.w / 2 + b.r, Math.min(this.paddle.w / 2 - b.r, b.x - (this.paddle.x + this.paddle.w / 2)));
            b.vx = 0;
            b.vy = 0;
            this.combo = 0;
            AudioEngine.play('hit');
            break;
          }

          let hitPoint = (b.x - (this.paddle.x + this.paddle.w / 2)) / (this.paddle.w / 2);
          hitPoint = Math.max(-1, Math.min(1, hitPoint));
          const english = Math.max(-0.25, Math.min(0.25, this.paddle.vx * 0.025));
          const maxBounceAngle = Math.PI * 0.36;
          const bounceAngle = -Math.PI / 2 + (hitPoint + english) * maxBounceAngle;
          const spd = this.getTargetBallSpeed();

          b.vx = Math.cos(bounceAngle) * spd;
          b.vy = -Math.abs(Math.sin(bounceAngle) * spd);
          b.y = this.paddle.y - b.r - 0.5;
          this.normalizeBallVelocity(b);

          AudioEngine.play('hit');
          this.createParticles(b.x, b.y, 8, this.accent);
          this.combo = 0;
          break;
        }

        for (let brick of this.bricks) {
          if (!brick.active) continue;
          const closestX = Math.max(brick.x, Math.min(b.x, brick.x + brick.w));
          const closestY = Math.max(brick.y, Math.min(b.y, brick.y + brick.h));
          const dx = b.x - closestX;
          const dy = b.y - closestY;

          if (dx * dx + dy * dy <= b.r * b.r) {
            const isFireball = this.fireballTimer > 0 && brick.breakable;
            if (!isFireball) {
              const overlapLeft = (b.x + b.r) - brick.x;
              const overlapRight = (brick.x + brick.w) - (b.x - b.r);
              const overlapTop = (b.y + b.r) - brick.y;
              const overlapBottom = (brick.y + brick.h) - (b.y - b.r);
              const minOverlapX = Math.min(overlapLeft, overlapRight);
              const minOverlapY = Math.min(overlapTop, overlapBottom);

              if (minOverlapX < minOverlapY) {
                b.vx *= -1;
                b.x += b.vx > 0 ? 1.5 : -1.5;
              } else {
                b.vy *= -1;
                b.y += b.vy > 0 ? 1.5 : -1.5;
              }
              this.normalizeBallVelocity(b);
            }

            this.damageBrick(brick, isFireball ? 99 : 1);
            break;
          }
        }
      }

      if (b.y > this.height + 20) b.active = false;
    });

    if (activeBalls === 0 && this.state === 'playing') {
      this.lives--;
      AudioEngine.play('lose');
      this.shake = 10;
      this.updateHUD();
      if (this.lives <= 0) {
        this.state = 'gameover';
        this.flashMsg("GAME OVER");
        setTimeout(() => this.reset(), 2000);
      } else {
        this.resetBall();
      }
    }

    for (let i = this.powerups.length - 1; i >= 0; i--) {
      let p = this.powerups[i];
      p.y += p.vy;
      p.phase += 0.08;

      if (p.y + 12 >= this.paddle.y &&
          p.y - 12 <= this.paddle.y + this.paddle.h &&
          p.x + 12 >= this.paddle.x &&
          p.x - 12 <= this.paddle.x + this.paddle.w) {
        this.activatePowerup(p.type, p.x, p.y);
        this.powerups.splice(i, 1);
        AudioEngine.play('powerup');
      } else if (p.y > this.height + 20) {
        this.powerups.splice(i, 1);
      }
    }

    if (!this.bricks.some(b => b.active && b.breakable)) {
      this.level++;
      this.score += 1000;
      AudioEngine.play('powerup');
      this.resetLevel();
    }

    for (let i = this.shockwaves.length - 1; i >= 0; i--) {
      const sw = this.shockwaves[i];
      sw.r += (sw.maxR - sw.r) * 0.2;
      sw.alpha -= 0.045;
      if (sw.alpha <= 0) this.shockwaves.splice(i, 1);
    }

    for (let i = this.floatingTexts.length - 1; i >= 0; i--) {
      const ft = this.floatingTexts[i];
      ft.y += ft.vy;
      ft.life -= 0.025;
      if (ft.life <= 0) this.floatingTexts.splice(i, 1);
    }

    if (this.shake > 0) this.shake *= 0.86;
    if (this.shake < 0.4) this.shake = 0;
  },

  damageBrick(brick, dmg = 1) {
    if (!brick.active) return;
    if (!brick.breakable) {
      brick.hitFlash = 6;
      AudioEngine.play('armor');
      this.createParticles(brick.x + brick.w / 2, brick.y + brick.h / 2, 5, '#ffd166');
      return;
    }

    brick.hp -= dmg;
    brick.hitFlash = 6;

    if (brick.hp > 0) {
      this.score += 15;
      AudioEngine.play('armor');
      this.createParticles(brick.x + brick.w / 2, brick.y + brick.h / 2, 6, brick.color);
      this.updateHUD();
    } else {
      this.destroyBrick(brick);
    }
  },

  destroyBrick(brick) {
    if (!brick.active) return;
    brick.active = false;
    this.combo++;
    const gained = brick.value + this.combo * 15;
    this.score += gained;
    this.shake = Math.min(9, 3 + Math.floor(this.combo / 4));

    const cx = brick.x + brick.w / 2;
    const cy = brick.y + brick.h / 2;
    this.createParticles(cx, cy, 12, brick.color);

    if (this.combo >= 3) {
      this.addFloatingText(cx, cy, `${this.combo}× COMBO!`, '#ffdf9e');
    } else {
      this.addFloatingText(cx, cy, `+${gained}`, brick.color);
    }

    if (brick.type === 'explosive') {
      AudioEngine.play('explode');
      this.shake = 12;
      this.shockwaves.push({ x: cx, y: cy, r: 8, maxR: 115, alpha: 0.9, color: '#ff5470' });
      this.bricks.forEach(other => {
        if (!other.active) return;
        const ox = other.x + other.w / 2;
        const oy = other.y + other.h / 2;
        if (Math.hypot(ox - cx, oy - cy) <= 105) {
          this.damageBrick(other, 3);
        }
      });
    } else {
      AudioEngine.play('brick', this.combo);
    }

    this.updateHUD();
    if (Math.random() < 0.20) this.spawnPowerup(cx, cy);
  },

  activatePowerup(type, x, y) {
    const labels = {
      multi: 'MULTIBALL!',
      wide: 'WIDE PADDLE!',
      laser: 'TWIN LASERS!',
      slow: 'SLOW MOTION!',
      fire: 'FIREBALL!',
      magnet: 'MAGNET PADDLE!',
      shield: 'SAFETY SHIELD!',
      life: '+1 EXTRA LIFE!'
    };

    if (type === 'multi') {
      let base = this.balls.find(b => b.active) || this.balls[0];
      if (base.held) this.launchWaitingBalls();
      const spd = this.getTargetBallSpeed();
      [-0.4, 0.4].forEach(offsetAngle => {
        const currentAngle = Math.atan2(base.vy || -spd, base.vx || 2);
        const newAngle = currentAngle + offsetAngle;
        const clone = {
          x: base.x,
          y: base.y,
          vx: Math.cos(newAngle) * spd,
          vy: -Math.abs(Math.sin(newAngle) * spd),
          r: base.r,
          active: true,
          held: false,
          holdOffset: 0,
          trail: []
        };
        this.normalizeBallVelocity(clone);
        this.balls.push(clone);
      });
    } else if (type === 'wide') {
      this.paddle.w = Math.min(200, this.paddle.w + 48);
      this.paddle.wideTimer = 660;
    } else if (type === 'laser') {
      this.paddle.laserTimer = 420;
    } else if (type === 'slow') {
      this.slowTimer = 480;
      this.balls.forEach(b => { if (!b.held) this.normalizeBallVelocity(b); });
    } else if (type === 'fire') {
      this.fireballTimer = 420;
    } else if (type === 'magnet') {
      this.paddle.magnetTimer = 600;
    } else if (type === 'shield') {
      this.paddle.shieldTimer = 900;
    } else if (type === 'life') {
      this.lives++;
      this.updateHUD();
    }

    this.addFloatingText(x || this.paddle.x + this.paddle.w / 2, y || this.paddle.y - 16, labels[type] || type.toUpperCase(), '#ffffff');
    this.flashMsg(labels[type] || type.toUpperCase());
  },

  createParticles(x, y, count, color) {
    for (let i = 0; i < count; i++) {
      const a = Math.random() * Math.PI * 2;
      const v = 1.5 + Math.random() * 5.5;
      this.particles.push({
        x, y,
        vx: Math.cos(a) * v,
        vy: Math.sin(a) * v,
        life: 1.0,
        color,
        size: Math.random() * 4 + 2
      });
    }
  },

  drawRounded(x, y, w, h, r, color) {
    this.ctx.fillStyle = color;
    this.ctx.beginPath();
    if (this.ctx.roundRect) this.ctx.roundRect(x, y, w, h, r);
    else this.ctx.rect(x, y, w, h);
    this.ctx.fill();
  },

  draw() {
    this.ctx.fillStyle = '#1a1114';
    this.ctx.fillRect(0, 0, this.width, this.height);

    this.ctx.save();
    if (this.shake > 0) {
      this.ctx.translate((Math.random() - 0.5) * this.shake, (Math.random() - 0.5) * this.shake);
    }

    if (this.paddle.shieldTimer > 0) {
      const alpha = this.paddle.shieldTimer < 120 ? (0.3 + Math.sin(performance.now() * 0.03) * 0.25) : 0.65;
      this.ctx.strokeStyle = `rgba(127, 216, 235, ${alpha})`;
      this.ctx.lineWidth = 4;
      this.ctx.beginPath();
      this.ctx.moveTo(0, this.height - 8);
      this.ctx.lineTo(this.width, this.height - 8);
      this.ctx.stroke();
    }

    this.bricks.forEach(b => {
      if (!b.active) return;
      const drawColor = b.hitFlash > 0 ? '#ffffff' : b.color;
      this.drawRounded(b.x, b.y, b.w - 2, b.h - 2, 7, drawColor);

      if (b.type === 'armor' && b.hp > 1) {
        this.ctx.strokeStyle = 'rgba(26, 17, 20, 0.55)';
        this.ctx.lineWidth = 2;
        this.ctx.strokeRect(b.x + 4, b.y + 4, b.w - 10, b.h - 10);
      } else if (b.type === 'explosive') {
        this.ctx.fillStyle = '#1a1114';
        this.ctx.font = 'bold 11px sans-serif';
        this.ctx.textAlign = 'center';
        this.ctx.fillText('💥', b.x + (b.w - 2) / 2, b.y + (b.h - 2) / 2 + 4);
      } else if (b.type === 'gold') {
        this.ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
        this.ctx.fillRect(b.x + 5, b.y + 4, b.w - 12, 3);
      }
    });

    this.shockwaves.forEach(sw => {
      this.ctx.strokeStyle = sw.color;
      this.ctx.globalAlpha = Math.max(0, sw.alpha);
      this.ctx.lineWidth = 3;
      this.ctx.beginPath();
      this.ctx.arc(sw.x, sw.y, sw.r, 0, Math.PI * 2);
      this.ctx.stroke();
      this.ctx.globalAlpha = 1;
    });

    const padColor = this.paddle.magnetTimer > 0 ? '#d0bcff' : this.accent;
    this.drawRounded(this.paddle.x, this.paddle.y, this.paddle.w, this.paddle.h, 8, padColor);

    if (this.paddle.laserTimer > 0) {
      this.ctx.fillStyle = '#ffb4ab';
      this.ctx.fillRect(this.paddle.x + 6, this.paddle.y - 5, 6, 5);
      this.ctx.fillRect(this.paddle.x + this.paddle.w - 12, this.paddle.y - 5, 6, 5);
    }

    const isFire = this.fireballTimer > 0;
    this.balls.forEach(b => {
      if (!b.active) return;

      if (b.held) {
        const offset = (b.holdOffset || 0) / (this.paddle.w / 2);
        const angle = -Math.PI / 2 + offset * 0.55;
        this.ctx.strokeStyle = 'rgba(255, 176, 205, 0.45)';
        this.ctx.setLineDash([4, 5]);
        this.ctx.lineWidth = 2;
        this.ctx.beginPath();
        this.ctx.moveTo(b.x, b.y);
        this.ctx.lineTo(b.x + Math.cos(angle) * 48, b.y + Math.sin(angle) * 48);
        this.ctx.stroke();
        this.ctx.setLineDash([]);
      }

      for (let i = 0; i < b.trail.length; i++) {
        const t = b.trail[i];
        const ratio = (i + 1) / b.trail.length;
        this.ctx.fillStyle = isFire ? `rgba(255, 110, 64, ${ratio * 0.45})` : `rgba(255, 176, 205, ${ratio * 0.3})`;
        this.ctx.beginPath();
        this.ctx.arc(t.x, t.y, b.r * ratio * 0.9, 0, Math.PI * 2);
        this.ctx.fill();
      }

      this.ctx.fillStyle = isFire ? '#ff6e40' : '#ffffff';
      this.ctx.beginPath();
      this.ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
      this.ctx.fill();
    });

    this.ctx.fillStyle = '#ffb4ab';
    this.lasers.forEach(l => this.drawRounded(l.x, l.y, 4, 14, 2, '#ffb4ab'));

    const pColors = {
      multi: '#a8c7fa',
      wide: '#a6f2d1',
      laser: '#ffb4ab',
      slow: '#ffdf9e',
      fire: '#ff6e40',
      magnet: '#d0bcff',
      shield: '#7fd8eb',
      life: '#ff80ab'
    };
    const pIcons = {
      multi: 'M',
      wide: 'W',
      laser: 'L',
      slow: 'S',
      fire: 'F',
      magnet: 'U',
      shield: 'B',
      life: '♥'
    };

    this.powerups.forEach(p => {
      const pulse = 1 + Math.sin(p.phase) * 0.08;
      this.ctx.save();
      this.ctx.translate(p.x, p.y);
      this.ctx.scale(pulse, pulse);
      this.ctx.fillStyle = pColors[p.type] || '#ffffff';
      this.ctx.beginPath();
      this.ctx.arc(0, 0, 12, 0, Math.PI * 2);
      this.ctx.fill();
      this.ctx.fillStyle = '#1a1114';
      this.ctx.font = 'bold 11px sans-serif';
      this.ctx.textAlign = 'center';
      this.ctx.fillText(pIcons[p.type] || '?', 0, 4);
      this.ctx.restore();
    });

    for (let i = this.particles.length - 1; i >= 0; i--) {
      const p = this.particles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.08;
      p.life -= 0.04;
      if (p.life <= 0) {
        this.particles.splice(i, 1);
      } else {
        this.ctx.fillStyle = p.color;
        this.ctx.globalAlpha = p.life;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.globalAlpha = 1;
      }
    }

    this.floatingTexts.forEach(ft => {
      this.ctx.globalAlpha = Math.max(0, ft.life);
      this.ctx.fillStyle = ft.color;
      this.ctx.font = '800 13px "PokeTube Flex", sans-serif';
      this.ctx.textAlign = 'center';
      this.ctx.fillText(ft.text, ft.x, ft.y);
      this.ctx.globalAlpha = 1;
    });

    this.ctx.restore();
  },

  loop() {
    if (this.state !== 'playing') return;
    this.update();
    this.draw();
    this.loopId = requestAnimationFrame(() => this.loop());
  },

  updateHUD() {
    document.getElementById('score-el').innerText = this.score;
    document.getElementById('lives-el').innerText = this.lives;
  },

  flashMsg(text) {
    const el = document.getElementById('msg-display');
    el.innerText = text;
    el.style.opacity = 1;
    if (this.msgTimeout) clearTimeout(this.msgTimeout);
    this.msgTimeout = setTimeout(() => el.style.opacity = 0, 1400);
  }
};

Game.init();
</script>
</body>
</html>
<% } %>


