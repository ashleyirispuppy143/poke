class PokeMatchGame {
  constructor() {
    this.size = 8;
    this.maxUnlocked = parseInt(localStorage.getItem('pokeMatch3Unlocked')) || 1;
    this.bestForever = parseInt(localStorage.getItem('pokeMatch3Best')) || 0;
    this.savedMode = localStorage.getItem('pokeMatchMode') || 'forever';
    this.level = parseInt(localStorage.getItem('pokeMatchLastLevel')) || this.maxUnlocked;
    if (this.level > this.maxUnlocked) this.level = this.maxUnlocked;
    this.isTimedSideLevel = localStorage.getItem('pokeMatchLastTimed') === '1';

    this.board = [];
    this.selected = null;
    this.activeBooster = null;
    this.busy = false;
    this.score = 0;
    this.targetScore = 1000;
    this.movesLeft = 20;
    this.timeLeft = 60;
    this.timerInterval = null;
    this.hintTimer = null;
    this.touchStartPos = null;
    this.currentMapScrollRealm = 'ocean';

    this.gridEl = document.getElementById('gem-grid');
    this.overlay = document.getElementById('end-overlay');
    this.pathPanel = document.getElementById('path-panel');
    this.pathScroll = document.getElementById('path-scroll');
    this.drawerBackdrop = document.getElementById('drawer-backdrop');

    this.loadLevelStars();
    this.loadSeenStories();
    this.loadSavedBoosters();
    this.syncMobileState();
    this.bindUI();
    this.buildPath();

    if (this.savedMode === 'adventure') {
      this.switchTabUI('adventure');
      if (this.isTimedSideLevel && this.level % 14 === 0 && this.level <= this.maxUnlocked) {
        this.startTimedLevel(this.level, false);
      } else {
        this.startLevel(this.level, false);
      }
    } else {
      this.switchTabUI('forever');
      this.startForever(false);
    }
  }

  loadLevelStars() {
    const raw = localStorage.getItem('pokeMatchStars');
    if (!raw) {
      this.levelStars = {};
      for (let i = 1; i < this.maxUnlocked; i++) {
        this.levelStars[i] = 3;
      }
      this.saveLevelStars();
    } else {
      try {
        this.levelStars = JSON.parse(raw) || {};
      } catch (e) {
        this.levelStars = {};
      }
    }
  }

  saveLevelStars() {
    localStorage.setItem('pokeMatchStars', JSON.stringify(this.levelStars));
  }

  calculateStars(score, target) {
    if (score >= Math.round(target * 1.75)) return 3;
    if (score >= Math.round(target * 1.35)) return 2;
    if (score >= target) return 1;
    return 0;
  }

  formatStars(count) {
    return '★'.repeat(count) + '☆'.repeat(Math.max(0, 3 - count));
  }

  stopCountdown() {
    if (this.timerInterval) {
      clearInterval(this.timerInterval);
      this.timerInterval = null;
    }
  }

  startCountdown() {
    this.stopCountdown();
    this.timerInterval = setInterval(() => {
      if (this.mode !== 'adventure' || !this.isTimedSideLevel) {
        this.stopCountdown();
        return;
      }
      if (!this.overlay.classList.contains('hidden') || !document.getElementById('story-modal').classList.contains('hidden')) {
        return;
      }
      this.timeLeft = Math.max(0, this.timeLeft - 1);
      this.updateHUD();
      this.saveGameProgress();
      if (this.timeLeft <= 0 && !this.busy) {
        this.stopCountdown();
        this.checkEndState();
      }
    }, 1000);
  }

  isRealmUnlocked(realmKey) {
    const minLvlMap = { ocean: 1, forest: 26, magma: 51, astral: 76, extras: 101 };
    return this.maxUnlocked >= (minLvlMap[realmKey] || 1);
  }

  updateLoreButtonState() {
    const btn = document.getElementById('btn-read-lore');
    if (!btn) return;
    const realmKey = this.currentMapScrollRealm || 'ocean';
    const unlocked = this.isRealmUnlocked(realmKey);
    btn.disabled = !unlocked;
    btn.textContent = unlocked ? '📖 Lore' : '🔒 Lore';
  }

  loadSeenStories() {
    try {
      this.seenStories = JSON.parse(localStorage.getItem('pokeMatchSeenStories') || '{}');
    } catch (e) {
      this.seenStories = {};
    }
  }

  markStorySeen(realmKey) {
    this.seenStories[realmKey] = true;
    localStorage.setItem('pokeMatchSeenStories', JSON.stringify(this.seenStories));
  }

  showStoryModal(realmKey) {
    if (!this.isRealmUnlocked(realmKey)) return;
    const story = REALM_STORIES[realmKey];
    if (!story) return;
    document.getElementById('story-title').textContent = story.title;
    const bodyEl = document.getElementById('story-body');
    bodyEl.innerHTML = story.paragraphs.map(p => `<p>${p}</p>`).join('');
    document.getElementById('story-modal').classList.remove('hidden');
    this.markStorySeen(realmKey);
  }

  maybeTriggerRealmStory(lvl) {
    const realm = this.getRealmInfo(lvl);
    if (this.isRealmUnlocked(realm.key) && !this.seenStories[realm.key]) {
      this.showStoryModal(realm.key);
    }
  }

  saveGameProgress() {
    if (!this.board || this.board.length !== this.size) return;
    if (this.mode === 'forever') {
      if (this.countValidMoves() === 0) {
        localStorage.removeItem('pokeMatchSavedEndless');
        return;
      }
      localStorage.setItem('pokeMatchSavedEndless', JSON.stringify({
        score: this.score,
        board: this.board
      }));
    } else {
      const outOfTurn = this.isTimedSideLevel ? (this.timeLeft <= 0) : (this.movesLeft <= 0);
      if (this.score >= this.targetScore || outOfTurn || this.countValidMoves() === 0) {
        localStorage.removeItem('pokeMatchSavedAdventure');
        return;
      }
      localStorage.setItem('pokeMatchSavedAdventure', JSON.stringify({
        level: this.level,
        isTimed: this.isTimedSideLevel,
        score: this.score,
        movesLeft: this.movesLeft,
        timeLeft: this.timeLeft,
        targetScore: this.targetScore,
        board: this.board
      }));
    }
  }

  clearSavedGameProgress(mode) {
    if (mode === 'forever') {
      localStorage.removeItem('pokeMatchSavedEndless');
    } else {
      localStorage.removeItem('pokeMatchSavedAdventure');
    }
  }

  isValidBoardData(b) {
    const validGems = new Set(this.getRelicPool());
    return Array.isArray(b) &&
      b.length === this.size &&
      b.every(row => Array.isArray(row) && row.length === this.size && row.every(cell => cell && validGems.has(cell.type)));
  }

  getTotalMaxLevels() {
    return 110;
  }

  syncMobileState() {
    this.isMobile = checkIsMobile();
    document.body.classList.toggle('is-mobile', this.isMobile);
    if (!this.isMobile) {
      this.closeMobileDrawer();
    }
  }

  openMobileDrawer() {
    this.pathPanel.classList.add('drawer-open');
    this.drawerBackdrop.classList.add('open');
    setTimeout(() => {
      const curr = this.pathPanel.querySelector('.stage-node.current');
      if (curr) curr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      this.syncMapScrollRealm();
    }, 80);
  }

  closeMobileDrawer() {
    this.pathPanel.classList.remove('drawer-open');
    this.drawerBackdrop.classList.remove('open');
  }

  syncMapScrollRealm() {
    const scrollEl = this.pathScroll;
    if (!scrollEl) return;
    const rect = scrollEl.getBoundingClientRect();
    if (rect.height === 0) return;
    const centerY = rect.top + rect.height * 0.5;

    let closestLvl = this.level || 1;
    let minDist = Infinity;
    const nodes = scrollEl.querySelectorAll('.stage-node:not(.timed-node)');
    nodes.forEach(node => {
      const r = node.getBoundingClientRect();
      const nodeCenter = r.top + r.height * 0.5;
      const d = Math.abs(nodeCenter - centerY);
      if (d < minDist) {
        minDist = d;
        closestLvl = parseInt(node.dataset.lvl, 10) || 1;
      }
    });

    const realm = this.getRealmInfo(closestLvl);
    if (this.pathPanel.getAttribute('data-map-realm') !== realm.key) {
      this.pathPanel.setAttribute('data-map-realm', realm.key);
      document.getElementById('map-header-title').textContent = realm.short;
      this.currentMapScrollRealm = realm.key;
    }
    this.updateLoreButtonState();
  }

  loadSavedBoosters() {
    let saved = {};
    try {
      saved = JSON.parse(localStorage.getItem('pokeMatchBoosterInv') || '{}');
    } catch (e) {
      saved = {};
    }
    this.boosterCharges = {};
    BOOSTER_DEFS.forEach(b => {
      if (this.maxUnlocked >= b.unlockLvl) {
        this.boosterCharges[b.id] = typeof saved[b.id] === 'number' ? saved[b.id] : 1;
      } else {
        this.boosterCharges[b.id] = 0;
      }
    });
    this.saveBoosters();
  }

  saveBoosters() {
    localStorage.setItem('pokeMatchBoosterInv', JSON.stringify(this.boosterCharges));
  }

  rewardUnlockedBoosters(amount = 1) {
    let rewardedAny = false;
    BOOSTER_DEFS.forEach(b => {
      if (this.maxUnlocked >= b.unlockLvl) {
        this.boosterCharges[b.id] = (this.boosterCharges[b.id] || 0) + amount;
        rewardedAny = true;
      }
    });
    this.saveBoosters();
    return rewardedAny;
  }

  switchTabUI(mode) {
    const tabForever = document.getElementById('tab-forever');
    const tabAdv = document.getElementById('tab-adventure');
    const mobForever = document.getElementById('mob-tab-forever');
    const mobAdv = document.getElementById('mob-tab-adventure');
    const layout = document.getElementById('main-layout');
    const boostersWrap = document.getElementById('boosters-wrap');
    const btnOpenMap = document.getElementById('btn-open-map');
    const hazardBanner = document.getElementById('hazard-banner');

    if (mode === 'forever') {
      this.stopCountdown();
      tabForever.classList.add('active');
      tabAdv.classList.remove('active');
      mobForever.classList.add('active');
      mobAdv.classList.remove('active');

      this.pathPanel.classList.add('hidden');
      layout.classList.add('single');
      boostersWrap.classList.add('hidden');
      btnOpenMap.classList.add('hidden');
      hazardBanner.classList.add('hidden');
      this.closeMobileDrawer();
    } else {
      tabAdv.classList.add('active');
      tabForever.classList.remove('active');
      mobAdv.classList.add('active');
      mobForever.classList.remove('active');

      this.pathPanel.classList.remove('hidden');
      layout.classList.remove('single');
      boostersWrap.classList.remove('hidden');
      btnOpenMap.classList.remove('hidden');
      setTimeout(() => {
        const curr = this.pathPanel.querySelector('.stage-node.current');
        if (curr) curr.scrollIntoView({ behavior: 'smooth', block: 'center' });
        this.syncMapScrollRealm();
      }, 60);
    }
  }

  bindUI() {
    window.addEventListener('resize', () => this.syncMobileState());
    window.addEventListener('orientationchange', () => this.syncMobileState());

    this.pathScroll.addEventListener('scroll', () => this.syncMapScrollRealm(), { passive: true });

    const goForever = () => {
      this.switchTabUI('forever');
      this.startForever(false);
    };
    const goAdventure = () => {
      this.switchTabUI('adventure');
      if (this.isTimedSideLevel) {
        this.startTimedLevel(this.level || 14, false);
      } else {
        this.startLevel(this.level || this.maxUnlocked, false);
      }
    };

    document.getElementById('tab-forever').onclick = goForever;
    document.getElementById('mob-tab-forever').onclick = goForever;
    document.getElementById('tab-adventure').onclick = goAdventure;
    document.getElementById('mob-tab-adventure').onclick = goAdventure;

    document.getElementById('btn-open-map').onclick = () => this.openMobileDrawer();
    document.getElementById('btn-close-map').onclick = () => this.closeMobileDrawer();
    this.drawerBackdrop.onclick = () => this.closeMobileDrawer();

    document.getElementById('btn-read-lore').onclick = () => {
      const key = this.currentMapScrollRealm || this.getRealmInfo(this.level).key;
      if (this.isRealmUnlocked(key)) {
        this.showStoryModal(key);
      }
    };

    document.getElementById('story-close-btn').onclick = () => {
      document.getElementById('story-modal').classList.add('hidden');
    };

    document.getElementById('ov-btn').onclick = () => {
      this.overlay.classList.add('hidden');
      if (this.mode === 'forever') {
        this.startForever(true);
      } else if (this.isTimedSideLevel) {
        if (this.wonLast) {
          this.startLevel(Math.min(110, this.level + 1), false);
        } else {
          this.startTimedLevel(this.level, true);
        }
      } else {
        if (this.wonLast) {
          this.startLevel(Math.min(110, this.level + 1), true);
        } else {
          this.startLevel(this.level, true);
        }
      }
    };

    ['pointerdown', 'keydown'].forEach(ev => {
      window.addEventListener(ev, () => {
        if (!this.busy && this.overlay.classList.contains('hidden')) {
          this.resetHintTimer();
        }
      }, { passive: true });
    });
  }

  getRealmInfo(lvl) {
    if (lvl <= 25) return { key: 'ocean',  short: 'Ocean Abyss',  name: 'Ocean Abyss (1-25)' };
    if (lvl <= 50) return { key: 'forest', short: 'Sylvan Wilds', name: 'Sylvan Wilds (26-50)' };
    if (lvl <= 75) return { key: 'magma',  short: 'Magma Core',   name: 'Magma Core (51-75)' };
    if (lvl <= 100) return { key: 'astral', short: 'Astral Void', name: 'Astral Void (76-100)' };
    return { key: 'extras', short: 'Crimson Eclipse', name: 'Crimson Eclipse - Extras (101-110)' };
  }

  applyTheme() {
    if (this.mode === 'forever') {
      document.body.setAttribute('data-theme', 'endless');
      document.getElementById('theme-badge').textContent = 'Endless Mode';
      document.getElementById('hazard-banner').classList.add('hidden');
      return;
    }

    const realm = this.getRealmInfo(this.level);
    document.body.setAttribute('data-theme', realm.key);
    this.pathPanel.setAttribute('data-map-realm', realm.key);
    document.getElementById('map-header-title').textContent = realm.short;
    this.currentMapScrollRealm = realm.key;
    this.updateLoreButtonState();
    document.getElementById('theme-badge').textContent = realm.name;

    const lvlTag = this.isTimedSideLevel
      ? `${this.level}T`
      : (this.level > 100 ? `EX-${this.level - 100}` : `Lv.${this.level}`);
    document.getElementById('mobile-realm-label').textContent = `${realm.short} - ${lvlTag}`;

    const hazardBanner = document.getElementById('hazard-banner');
    if (this.isTimedSideLevel) {
      hazardBanner.textContent = '⏱️ Timed Side-Trial: Beat the target score before the 60s clock runs out!';
      hazardBanner.classList.remove('hidden');
    } else if (this.shouldLevelHaveHazards(this.level)) {
      const hz = HAZARD_INFO[realm.key];
      hazardBanner.textContent = hz.text;
      hazardBanner.classList.remove('hidden');
    } else {
      hazardBanner.classList.add('hidden');
    }
  }

  shouldLevelHaveHazards(lvl) {
    return lvl >= 4;
  }

  buildPath() {
    const container = document.getElementById('path-scroll');
    container.innerHTML = '';
    const totalCap = this.getTotalMaxLevels();
    document.getElementById('unlocked-label').textContent = `${this.maxUnlocked} / ${totalCap} Unlocked`;

    for (let i = 1; i <= totalCap; i++) {
      if (i === 1 || i === 26 || i === 51 || i === 76 || i === 101) {
        const div = document.createElement('div');
        div.className = 'realm-divider' + (i === 101 ? ' extras-div' : '');
        div.textContent = this.getRealmInfo(i).name;
        container.appendChild(div);
      }

      const hasTimedSide = (i % 14 === 0) && (i <= 98);
      const row = document.createElement('div');
      row.className = 'stage-row' + (hasTimedSide ? ' has-side-path' : '');

      const btn = document.createElement('button');
      const isExtra = i > 100;
      const isHard = (i % 10 === 0) || isExtra;
      btn.className = 'stage-node' + (isHard ? ' hard' : '') + (isExtra ? ' extra-stage' : '');
      btn.dataset.lvl = i;
      if (i <= this.maxUnlocked) btn.classList.add('unlocked');
      if (i === this.level && this.mode === 'adventure' && !this.isTimedSideLevel) btn.classList.add('current');

      const starsEarned = this.levelStars[i] || 0;
      const starsHtml = starsEarned > 0 ? `<span class="node-stars">${this.formatStars(starsEarned)}</span>` : '';
      const tagText = isExtra ? 'EXTRA' : 'BOSS';
      btn.innerHTML = `<span>${i}</span>${isHard ? `<span class="hard-tag">${tagText}</span>` : ''}${starsHtml}`;

      if (i <= this.maxUnlocked) {
        btn.onclick = () => {
          this.closeMobileDrawer();
          const forceReset = (i !== this.level || this.isTimedSideLevel);
          this.startLevel(i, forceReset);
        };
      }
      row.appendChild(btn);

      if (hasTimedSide) {
        const sideWrap = document.createElement('div');
        sideWrap.className = 'side-path-wrap';

        const line = document.createElement('div');
        line.className = 'side-branch-line';
        sideWrap.appendChild(line);

        const tBtn = document.createElement('button');
        const tKey = `T${i}`;
        const tStars = this.levelStars[tKey] || 0;
        const tUnlocked = i <= this.maxUnlocked;
        tBtn.className = 'stage-node timed-node' + (tUnlocked ? ' unlocked' : '');
        if (this.mode === 'adventure' && this.isTimedSideLevel && this.level === i) {
          tBtn.classList.add('current');
        }
        tBtn.dataset.lvl = i;
        const tStarsHtml = tStars > 0 ? `<span class="node-stars">${this.formatStars(tStars)}</span>` : '';
        tBtn.innerHTML = `<span>⏱️${i}</span>${tStarsHtml}`;

        if (tUnlocked) {
          tBtn.onclick = () => {
            this.closeMobileDrawer();
            const forceReset = (!this.isTimedSideLevel || i !== this.level);
            this.startTimedLevel(i, forceReset);
          };
        }
        sideWrap.appendChild(tBtn);
        row.appendChild(sideWrap);
      }

      container.appendChild(row);
    }
  }

  initBoosters() {
    this.activeBooster = null;
    BOOSTER_DEFS.forEach(b => {
      if (this.maxUnlocked >= b.unlockLvl && (this.boosterCharges[b.id] === undefined)) {
        this.boosterCharges[b.id] = 1;
      }
    });
    this.saveBoosters();
    this.renderBoosters();
  }

  renderBoosters() {
    const bar = document.getElementById('boosters-bar');
    const status = document.getElementById('booster-status');
    bar.innerHTML = '';

    BOOSTER_DEFS.forEach(b => {
      const unlocked = this.maxUnlocked >= b.unlockLvl;
      const qty = this.boosterCharges[b.id] || 0;
      const btn = document.createElement('button');
      btn.className = 'booster-btn' + (!unlocked ? ' locked' : '') + (this.activeBooster === b.id ? ' active' : '');
      if (unlocked && qty <= 0) btn.disabled = true;

      btn.innerHTML = `
        <span class="b-icon">${unlocked ? b.icon : '🔒'}</span>
        <span class="b-name">${b.name}</span>
        <span class="b-qty">${unlocked ? '×' + qty : 'Lv.' + b.unlockLvl}</span>
      `;

      if (unlocked && qty > 0) {
        btn.onclick = () => this.onBoosterClick(b);
      }
      bar.appendChild(btn);
    });

    if (this.activeBooster) {
      const def = BOOSTER_DEFS.find(x => x.id === this.activeBooster);
      status.textContent = def ? def.desc : '';
    } else {
      status.textContent = 'Select an unlocked booster';
    }
  }

  onBoosterClick(def) {
    if (this.busy || this.mode === 'forever') return;
    if (!def.needsTarget) {
      this.boosterCharges[def.id] = Math.max(0, (this.boosterCharges[def.id] || 0) - 1);
      this.saveBoosters();
      this.activeBooster = null;
      this.shuffleBoard();
      this.renderBoosters();
      return;
    }
    this.activeBooster = this.activeBooster === def.id ? null : def.id;
    this.renderBoosters();
  }

  shuffleBoard() {
    const movable = [];
    for (let r = 0; r < this.size; r++) {
      for (let c = 0; c < this.size; c++) {
        if (!this.isCellRooted(r, c)) {
          movable.push(this.board[r][c]);
        }
      }
    }
    let attempts = 0;
    do {
      for (let i = movable.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [movable[i], movable[j]] = [movable[j], movable[i]];
      }
      let k = 0;
      for (let r = 0; r < this.size; r++) {
        for (let c = 0; c < this.size; c++) {
          if (!this.isCellRooted(r, c)) {
            this.board[r][c] = movable[k++];
          }
        }
      }
      attempts++;
    } while ((this.findMatchGroups().length > 0 || this.countValidMoves() === 0) && attempts < 40);

    playTone(540, 0.14, 'triangle');
    this.render();
    this.updateHUD();
    this.saveGameProgress();
    this.resetHintTimer();
  }

  async executeTargetedBooster(id, r, c) {
    this.busy = true;
    this.clearHint();
    this.boosterCharges[id] = Math.max(0, (this.boosterCharges[id] || 0) - 1);
    this.saveBoosters();
    this.activeBooster = null;
    this.renderBoosters();

    const toClear = new Set();
    if (id === 'hammer') {
      toClear.add(`${r},${c}`);
    } else if (id === 'rowzap') {
      for (let cc = 0; cc < this.size; cc++) toClear.add(`${r},${cc}`);
    } else if (id === 'colzap') {
      for (let rr = 0; rr < this.size; rr++) toClear.add(`${rr},${c}`);
    } else if (id === 'nova') {
      for (let dr = -1; dr <= 1; dr++) {
        for (let dc = -1; dc <= 1; dc++) {
          const nr = r + dr, nc = c + dc;
          if (nr >= 0 && nr < this.size && nc >= 0 && nc < this.size) toClear.add(`${nr},${nc}`);
        }
      }
    } else if (id === 'purge') {
      const targetType = this.board[r][c]?.type;
      for (let rr = 0; rr < this.size; rr++) {
        for (let cc = 0; cc < this.size; cc++) {
          if (this.board[rr][cc]?.type === targetType) toClear.add(`${rr},${cc}`);
        }
      }
    }

    await this.clearAndCascade(toClear, [], 1, true);
    this.updateHUD();
    this.saveGameProgress();
    this.checkEndState();
    this.busy = false;
    this.resetHintTimer();
  }

  getRelicPool() {
    if (this.mode === 'forever') {
      return ENDLESS_GEMS.slice(0, 6);
    }
    const realmKey = this.getRealmInfo(this.level).key;
    const gems = REALM_GEMS[realmKey] || REALM_GEMS.ocean;
    const isHardOrExtra = (this.level % 10 === 0) || (this.level > 100);
    return gems.slice(0, isHardOrExtra ? 7 : 6);
  }

  isCellRooted(r, c, b = this.board) {
    const hz = b[r]?.[c]?.hz;
    return hz === 'vine' || hz === 'eclipse';
  }

  seedInitialHazards() {
    if (this.mode !== 'adventure' || !this.shouldLevelHaveHazards(this.level)) return;
    const realmKey = this.getRealmInfo(this.level).key;
    const hzType = HAZARD_INFO[realmKey].key;
    const isBoss = (this.level % 10 === 0) || (this.level > 100);
    const count = isBoss ? 8 : Math.min(6, 2 + Math.floor((this.level % 25) / 5));

    const coords = [];
    for (let r = 0; r < this.size; r++) {
      for (let c = 0; c < this.size; c++) {
        coords.push([r, c]);
      }
    }
    for (let i = coords.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [coords[i], coords[j]] = [coords[j], coords[i]];
    }

    let placed = 0;
    for (const [r, c] of coords) {
      if (placed >= count) break;
      const prevHz = this.board[r][c].hz;
      this.board[r][c].hz = hzType;
      if (this.countValidMoves() >= 2) {
        placed++;
      } else {
        this.board[r][c].hz = prevHz;
      }
    }
  }

  applyBossTurnMechanic() {
    if (this.mode !== 'adventure') return;
    const isBoss = (this.level % 10 === 0) || (this.level > 100);
    if (!isBoss) return;

    const realmKey = this.getRealmInfo(this.level).key;
    const hzType = HAZARD_INFO[realmKey].key;
    const candidates = [];
    for (let r = 0; r < this.size; r++) {
      for (let c = 0; c < this.size; c++) {
        if (this.board[r][c] && !this.board[r][c].hz && !this.board[r][c].pw) {
          candidates.push([r, c]);
        }
      }
    }
    if (candidates.length === 0) return;
    const [tr, tc] = candidates[Math.floor(Math.random() * candidates.length)];
    this.board[tr][tc].hz = hzType;
    if (this.countValidMoves() === 0) {
      this.board[tr][tc].hz = null;
    }
  }

  startForever(forceNew = false) {
    this.stopCountdown();
    this.mode = 'forever';
    this.isTimedSideLevel = false;
    localStorage.setItem('pokeMatchMode', 'forever');
    this.selected = null;
    this.activeBooster = null;
    this.busy = false;
    this.overlay.classList.add('hidden');
    this.applyTheme();

    if (!forceNew) {
      try {
        const saved = JSON.parse(localStorage.getItem('pokeMatchSavedEndless') || 'null');
        if (saved && this.isValidBoardData(saved.board)) {
          this.board = saved.board;
          this.score = saved.score || 0;
          if (this.countValidMoves() > 0) {
            this.render();
            this.updateHUD();
            this.resetHintTimer();
            return;
          }
        }
      } catch (e) {}
    }

    this.score = 0;
    this.generateInitialBoard();
    this.saveGameProgress();
    this.render();
    this.updateHUD();
    this.resetHintTimer();
  }

  startTimedLevel(baseLvl, forceNew = false) {
    this.stopCountdown();
    this.mode = 'adventure';
    this.level = baseLvl;
    this.isTimedSideLevel = true;
    localStorage.setItem('pokeMatchMode', 'adventure');
    localStorage.setItem('pokeMatchLastLevel', baseLvl);
    localStorage.setItem('pokeMatchLastTimed', '1');
    this.selected = null;
    this.busy = false;
    this.wonLast = false;
    this.overlay.classList.add('hidden');

    this.timeLeft = 60;
    this.movesLeft = 999;
    this.targetScore = 950 + baseLvl * 115;

    this.applyTheme();
    this.initBoosters();
    this.buildPath();

    if (!forceNew) {
      try {
        const saved = JSON.parse(localStorage.getItem('pokeMatchSavedAdventure') || 'null');
        if (
          saved &&
          saved.level === baseLvl &&
          saved.isTimed === true &&
          typeof saved.timeLeft === 'number' &&
          saved.timeLeft > 0 &&
          this.isValidBoardData(saved.board)
        ) {
          this.board = saved.board;
          this.score = saved.score || 0;
          this.timeLeft = saved.timeLeft;
          this.targetScore = saved.targetScore || this.targetScore;
          if (this.score < this.targetScore && this.countValidMoves() > 0) {
            this.render();
            this.updateHUD();
            this.startCountdown();
            this.resetHintTimer();
            return;
          }
        }
      } catch (e) {}
    }

    this.score = 0;
    this.generateInitialBoard();
    this.seedInitialHazards();
    this.saveGameProgress();
    this.render();
    this.updateHUD();
    this.startCountdown();
    this.resetHintTimer();
  }

  startLevel(lvl, forceNew = false) {
    this.stopCountdown();
    this.mode = 'adventure';
    this.level = lvl;
    this.isTimedSideLevel = false;
    localStorage.setItem('pokeMatchMode', 'adventure');
    localStorage.setItem('pokeMatchLastLevel', lvl);
    localStorage.setItem('pokeMatchLastTimed', '0');
    this.selected = null;
    this.busy = false;
    this.wonLast = false;
    this.overlay.classList.add('hidden');

    if (lvl > 100) {
      const exIdx = lvl - 100;
      this.movesLeft = exIdx === 10 ? 13 : 14;
      this.targetScore = 11500 + exIdx * 850;
    } else {
      const isHard = lvl % 10 === 0;
      this.movesLeft = isHard ? 16 : Math.max(16, 26 - Math.floor(lvl / 14));
      this.targetScore = isHard ? (1400 + lvl * 160) : (700 + lvl * 105);
    }

    this.applyTheme();
    this.initBoosters();
    this.buildPath();
    this.maybeTriggerRealmStory(lvl);

    if (!forceNew) {
      try {
        const saved = JSON.parse(localStorage.getItem('pokeMatchSavedAdventure') || 'null');
        if (
          saved &&
          saved.level === lvl &&
          !saved.isTimed &&
          typeof saved.movesLeft === 'number' &&
          saved.movesLeft > 0 &&
          this.isValidBoardData(saved.board)
        ) {
          this.board = saved.board;
          this.score = saved.score || 0;
          this.movesLeft = saved.movesLeft;
          this.targetScore = saved.targetScore || this.targetScore;
          if (this.score < this.targetScore && this.countValidMoves() > 0) {
            this.render();
            this.updateHUD();
            this.resetHintTimer();
            return;
          }
        }
      } catch (e) {}
    }

    this.score = 0;
    this.generateInitialBoard();
    this.seedInitialHazards();
    this.saveGameProgress();
    this.render();
    this.updateHUD();
    this.resetHintTimer();
  }

  generateInitialBoard() {
    const pool = this.getRelicPool();
    do {
      this.board = Array.from({ length: this.size }, () => Array(this.size).fill(null));
      for (let r = 0; r < this.size; r++) {
        for (let c = 0; c < this.size; c++) {
          let g;
          do {
            g = pool[Math.floor(Math.random() * pool.length)];
          } while (
            (c >= 2 && this.board[r][c - 1]?.type === g && this.board[r][c - 2]?.type === g) ||
            (r >= 2 && this.board[r - 1][c]?.type === g && this.board[r - 2][c]?.type === g)
          );
          this.board[r][c] = { type: g, pw: null, hz: null };
        }
      }
    } while (this.countValidMoves() === 0);
  }

  findMatchGroups(b = this.board) {
    const horiz = [];
    const vert = [];

    for (let r = 0; r < this.size; r++) {
      let run = 1;
      for (let c = 1; c <= this.size; c++) {
        if (c < this.size && b[r][c] && b[r][c - 1] && b[r][c].type === b[r][c - 1].type) {
          run++;
        } else {
          if (run >= 3) {
            const cells = [];
            for (let k = c - run; k < c; k++) cells.push({ r, c: k });
            horiz.push({ cells, orient: 'h', type: b[r][c - 1].type });
          }
          run = 1;
        }
      }
    }

    for (let c = 0; c < this.size; c++) {
      let run = 1;
      for (let r = 1; r <= this.size; r++) {
        if (r < this.size && b[r][c] && b[r - 1][c] && b[r][c].type === b[r - 1][c].type) {
          run++;
        } else {
          if (run >= 3) {
            const cells = [];
            for (let k = r - run; k < r; k++) cells.push({ r: k, c });
            vert.push({ cells, orient: 'v', type: b[r - 1][c].type });
          }
          run = 1;
        }
      }
    }

    const allRuns = [...horiz, ...vert];
    const visited = new Array(allRuns.length).fill(false);
    const groups = [];

    for (let i = 0; i < allRuns.length; i++) {
      if (visited[i]) continue;
      visited[i] = true;
      const comp = [allRuns[i]];
      let changed = true;
      while (changed) {
        changed = false;
        for (let j = 0; j < allRuns.length; j++) {
          if (visited[j] || allRuns[j].type !== allRuns[i].type) continue;
          const shares = comp.some(runA =>
            runA.cells.some(ca => allRuns[j].cells.some(cb => ca.r === cb.r && ca.c === cb.c))
          );
          if (shares) {
            visited[j] = true;
            comp.push(allRuns[j]);
            changed = true;
          }
        }
      }

      const cellMap = new Map();
      let hasH = false, hasV = false;
      comp.forEach(run => {
        if (run.orient === 'h') hasH = true;
        if (run.orient === 'v') hasV = true;
        run.cells.forEach(pos => cellMap.set(`${pos.r},${pos.c}`, pos));
      });

      const uniqueCells = Array.from(cellMap.values());
      let spawnPw = null;
      if (uniqueCells.length >= 6) {
        spawnPw = 'storm';
      } else if (uniqueCells.length === 5 && (!hasH || !hasV)) {
        spawnPw = 'prism';
      } else if (hasH && hasV) {
        spawnPw = 'nova';
      } else if (uniqueCells.length === 4) {
        spawnPw = hasH ? 'hbeam' : 'vbeam';
      }

      groups.push({
        cells: uniqueCells,
        type: allRuns[i].type,
        spawnPw
      });
    }

    return groups;
  }

  findHintMove() {
    const copy = this.board.map(row => row.map(cell => (cell ? { ...cell } : null)));
    const swap = (r1, c1, r2, c2) => {
      const tmp = copy[r1][c1];
      copy[r1][c1] = copy[r2][c2];
      copy[r2][c2] = tmp;
    };

    for (let r = 0; r < this.size; r++) {
      for (let c = 0; c < this.size; c++) {
        if (c + 1 < this.size && !this.isCellRooted(r, c, copy) && !this.isCellRooted(r, c + 1, copy)) {
          if (copy[r][c]?.pw && copy[r][c + 1]?.pw) return [{ r, c }, { r, c: c + 1 }];
          swap(r, c, r, c + 1);
          if (this.findMatchGroups(copy).length > 0) return [{ r, c }, { r, c: c + 1 }];
          swap(r, c, r, c + 1);
        }
        if (r + 1 < this.size && !this.isCellRooted(r, c, copy) && !this.isCellRooted(r + 1, c, copy)) {
          if (copy[r][c]?.pw && copy[r + 1][c]?.pw) return [{ r, c }, { r: r + 1, c }];
          swap(r, c, r + 1, c);
          if (this.findMatchGroups(copy).length > 0) return [{ r, c }, { r: r + 1, c }];
          swap(r, c, r + 1, c);
        }
      }
    }
    return null;
  }

  countValidMoves() {
    let moves = 0;
    const copy = this.board.map(row => row.map(cell => (cell ? { ...cell } : null)));
    const swap = (r1, c1, r2, c2) => {
      const tmp = copy[r1][c1];
      copy[r1][c1] = copy[r2][c2];
      copy[r2][c2] = tmp;
    };

    for (let r = 0; r < this.size; r++) {
      for (let c = 0; c < this.size; c++) {
        if (c + 1 < this.size && !this.isCellRooted(r, c, copy) && !this.isCellRooted(r, c + 1, copy)) {
          swap(r, c, r, c + 1);
          if (this.findMatchGroups(copy).length > 0 || (copy[r][c]?.pw && copy[r][c + 1]?.pw)) moves++;
          swap(r, c, r, c + 1);
        }
        if (r + 1 < this.size && !this.isCellRooted(r, c, copy) && !this.isCellRooted(r + 1, c, copy)) {
          swap(r, c, r + 1, c);
          if (this.findMatchGroups(copy).length > 0 || (copy[r][c]?.pw && copy[r + 1][c]?.pw)) moves++;
          swap(r, c, r + 1, c);
        }
      }
    }
    return moves;
  }

  clearHint() {
    clearTimeout(this.hintTimer);
    this.gridEl.querySelectorAll('.hint-glow').forEach(el => el.classList.remove('hint-glow'));
  }

  resetHintTimer() {
    this.clearHint();
    this.hintTimer = setTimeout(() => {
      if (this.busy || !this.overlay.classList.contains('hidden')) return;
      const move = this.findHintMove();
      if (move) {
        move.forEach(pos => {
          const idx = pos.r * this.size + pos.c;
          this.gridEl.children[idx]?.classList.add('hint-glow');
        });
      }
    }, 5000);
  }

  expandPowerups(initialSet) {
    const finalSet = new Set(initialSet);
    const queue = Array.from(initialSet);
    const triggered = new Set();

    while (queue.length > 0) {
      const key = queue.shift();
      const [r, c] = key.split(',').map(Number);
      const cell = this.board[r]?.[c];
      if (!cell || !cell.pw || triggered.has(key)) continue;
      triggered.add(key);

      const addCell = (nr, nc) => {
        if (nr < 0 || nr >= this.size || nc < 0 || nc >= this.size) return;
        const k = `${nr},${nc}`;
        if (!finalSet.has(k)) {
          finalSet.add(k);
          queue.push(k);
        }
      };

      if (cell.pw === 'hbeam') {
        for (let cc = 0; cc < this.size; cc++) addCell(r, cc);
      } else if (cell.pw === 'vbeam') {
        for (let rr = 0; rr < this.size; rr++) addCell(rr, c);
      } else if (cell.pw === 'nova') {
        for (let dr = -1; dr <= 1; dr++) {
          for (let dc = -1; dc <= 1; dc++) addCell(r + dr, c + dc);
        }
      } else if (cell.pw === 'prism') {
        for (let rr = 0; rr < this.size; rr++) {
          for (let cc = 0; cc < this.size; cc++) {
            if (this.board[rr][cc]?.type === cell.type) addCell(rr, cc);
          }
        }
      } else if (cell.pw === 'storm') {
        for (let cc = 0; cc < this.size; cc++) addCell(r, cc);
        for (let rr = 0; rr < this.size; rr++) addCell(rr, c);
        for (let dr = -1; dr <= 1; dr++) {
          for (let dc = -1; dc <= 1; dc++) addCell(r + dr, c + dc);
        }
      }
    }
    return finalSet;
  }

  render() {
    this.gridEl.innerHTML = '';
    const hzBadgeLookup = { ice: '❄️', vine: '🌿', cinder: '🔥', void: '🕳️', eclipse: '🩸' };
    for (let r = 0; r < this.size; r++) {
      for (let c = 0; c < this.size; c++) {
        const cell = document.createElement('div');
        cell.className = 'gem-cell';
        if (this.selected && this.selected.r === r && this.selected.c === c) {
          cell.classList.add('selected');
        }
        const item = this.board[r][c];
        if (item) {
          cell.textContent = item.type;
          if (item.hz) {
            cell.setAttribute('data-hz', item.hz);
            const hzb = document.createElement('span');
            hzb.className = 'hz-badge';
            hzb.textContent = hzBadgeLookup[item.hz] || '⚠️';
            cell.appendChild(hzb);
          }
          if (item.pw) {
            cell.setAttribute('data-pw', item.pw);
            const badge = document.createElement('span');
            badge.className = 'pw-badge';
            badge.textContent = POWERUP_BADGES[item.pw] || '✨';
            cell.appendChild(badge);
          }
        }

        cell.onpointerdown = (e) => {
          this.touchStartPos = { r, c, x: e.clientX, y: e.clientY };
        };
        cell.onpointerup = (e) => {
          if (!this.touchStartPos) return;
          const dx = e.clientX - this.touchStartPos.x;
          const dy = e.clientY - this.touchStartPos.y;
          const dist = Math.hypot(dx, dy);
          const sr = this.touchStartPos.r;
          const sc = this.touchStartPos.c;
          this.touchStartPos = null;

          if (dist > 24 && !this.activeBooster && !this.busy) {
            let tr = sr, tc = sc;
            if (Math.abs(dx) > Math.abs(dy)) {
              tc += dx > 0 ? 1 : -1;
            } else {
              tr += dy > 0 ? 1 : -1;
            }
            if (tr >= 0 && tr < this.size && tc >= 0 && tc < this.size) {
              this.selected = null;
              this.attemptSwap(sr, sc, tr, tc);
              return;
            }
          }
          this.onCellClick(r, c);
        };

        this.gridEl.appendChild(cell);
      }
    }
  }

  onCellClick(r, c) {
    if (this.busy) return;
    this.resetHintTimer();

    if (this.activeBooster) {
      this.executeTargetedBooster(this.activeBooster, r, c);
      return;
    }

    if (this.isCellRooted(r, c)) {
      playTone(150, 0.1, 'sawtooth');
      return;
    }

    if (!this.selected) {
      this.selected = { r, c };
      playTone(360, 0.05);
      this.render();
      return;
    }

    const dr = Math.abs(this.selected.r - r);
    const dc = Math.abs(this.selected.c - c);

    if (dr + dc === 1) {
      this.attemptSwap(this.selected.r, this.selected.c, r, c);
      this.selected = null;
    } else {
      this.selected = { r, c };
      playTone(360, 0.05);
      this.render();
    }
  }

  async clearAndCascade(initialClearSet, spawns = [], comboStart = 1, fromBooster = false) {
    let combo = comboStart;
    let toClear = this.expandPowerups(initialClearSet);

    while (toClear.size > 0) {
      const isEarlyLevel = this.mode === 'adventure' && this.level <= 10 && !this.isTimedSideLevel;
      const basePts = isEarlyLevel ? 24 : 32;
      const comboMult = isEarlyLevel
        ? Math.min(2.0, 1 + (combo - 1) * 0.25)
        : Math.min(3.5, 1 + (combo - 1) * 0.55);

      this.score += Math.round(toClear.size * basePts * comboMult);
      playTone(380 + combo * 85, 0.11, 'triangle');
      combo++;

      const adjacentNeighbors = new Set();
      toClear.forEach(key => {
        const [mr, mc] = key.split(',').map(Number);
        const idx = mr * this.size + mc;
        this.gridEl.children[idx]?.classList.add('match-highlight');
        [[mr - 1, mc], [mr + 1, mc], [mr, mc - 1], [mr, mc + 1]].forEach(([nr, nc]) => {
          if (nr >= 0 && nr < this.size && nc >= 0 && nc < this.size && !toClear.has(`${nr},${nc}`)) {
            adjacentNeighbors.add(`${nr},${nc}`);
          }
        });
      });

      adjacentNeighbors.forEach(nKey => {
        const [nr, nc] = nKey.split(',').map(Number);
        const cell = this.board[nr]?.[nc];
        if (!cell || !cell.hz) return;
        if (cell.hz === 'ice' || cell.hz === 'vine' || cell.hz === 'void') {
          cell.hz = null;
        } else if (cell.hz === 'eclipse') {
          cell.hz = 'ice';
        }
      });

      this.updateHUD();
      await new Promise(res => setTimeout(res, 270));

      const actualDestroy = new Set();
      toClear.forEach(key => {
        const [mr, mc] = key.split(',').map(Number);
        const cell = this.board[mr]?.[mc];
        const idx = mr * this.size + mc;
        const el = this.gridEl.children[idx];
        if (!cell) return;

        if (!fromBooster && (cell.hz === 'ice' || cell.hz === 'eclipse')) {
          cell.hz = cell.hz === 'eclipse' ? 'ice' : null;
          if (el) el.classList.remove('match-highlight');
        } else {
          if (cell.hz === 'cinder') {
            this.score += 120;
          } else if (cell.hz === 'void' && !fromBooster) {
            this.score = Math.max(0, this.score - 90);
          }
          actualDestroy.add(key);
          if (el) {
            el.classList.remove('match-highlight');
            el.classList.add('clearing');
          }
        }
      });

      await new Promise(res => setTimeout(res, 190));

      actualDestroy.forEach(key => {
        const [mr, mc] = key.split(',').map(Number);
        this.board[mr][mc] = null;
      });

      spawns.forEach(sp => {
        this.board[sp.r][sp.c] = { type: sp.type, pw: sp.pw, hz: null };
      });
      spawns = [];

      const pool = this.getRelicPool();
      for (let c = 0; c < this.size; c++) {
        let writeRow = this.size - 1;
        for (let r = this.size - 1; r >= 0; r--) {
          if (this.board[r][c] !== null) {
            this.board[writeRow][c] = this.board[r][c];
            if (writeRow !== r) this.board[r][c] = null;
            writeRow--;
          }
        }
        for (let r = writeRow; r >= 0; r--) {
          this.board[r][c] = {
            type: pool[Math.floor(Math.random() * pool.length)],
            pw: null,
            hz: null
          };
        }
      }

      this.render();
      await new Promise(res => setTimeout(res, 160));

      const nextGroups = this.findMatchGroups();
      toClear = new Set();
      nextGroups.forEach(g => {
        if (g.spawnPw) {
          const anchor = g.cells[0];
          spawns.push({ r: anchor.r, c: anchor.c, type: g.type, pw: g.spawnPw });
        }
        g.cells.forEach(pos => toClear.add(`${pos.r},${pos.c}`));
      });
      toClear = this.expandPowerups(toClear);
      fromBooster = false;
    }
  }

  async attemptSwap(r1, c1, r2, c2) {
    if (this.isCellRooted(r1, c1) || this.isCellRooted(r2, c2)) {
      playTone(150, 0.12, 'sawtooth');
      return;
    }

    this.busy = true;
    this.clearHint();
    this.swapCells(r1, c1, r2, c2);
    this.render();

    const bothPowerups = this.board[r1][c1]?.pw && this.board[r2][c2]?.pw;
    const groups = this.findMatchGroups();

    if (groups.length === 0 && !bothPowerups) {
      await new Promise(res => setTimeout(res, 180));
      this.swapCells(r1, c1, r2, c2);
      playTone(180, 0.12, 'sawtooth');
      this.render();
      this.busy = false;
      this.resetHintTimer();
      return;
    }

    if (this.mode === 'adventure' && !this.isTimedSideLevel) {
      this.movesLeft--;
    }

    const initialClear = new Set();
    const spawns = [];

    if (bothPowerups) {
      initialClear.add(`${r1},${c1}`);
      initialClear.add(`${r2},${c2}`);
    }

    groups.forEach(g => {
      if (g.spawnPw) {
        let anchor = g.cells.find(p => (p.r === r1 && p.c === c1) || (p.r === r2 && p.c === c2)) || g.cells[0];
        spawns.push({ r: anchor.r, c: anchor.c, type: g.type, pw: g.spawnPw });
      }
      g.cells.forEach(pos => initialClear.add(`${pos.r},${pos.c}`));
    });

    await this.clearAndCascade(initialClear, spawns);
    this.applyBossTurnMechanic();
    this.render();
    this.updateHUD();
    this.saveGameProgress();
    this.checkEndState();
    this.busy = false;
    this.resetHintTimer();
  }

  swapCells(r1, c1, r2, c2) {
    const tmp = this.board[r1][c1];
    this.board[r1][c1] = this.board[r2][c2];
    this.board[r2][c2] = tmp;
  }

  updateHUD() {
    const validMoves = this.countValidMoves();
    document.getElementById('val-score').textContent = this.score;

    if (this.mode === 'forever') {
      if (this.score > this.bestForever) {
        this.bestForever = this.score;
        localStorage.setItem('pokeMatch3Best', this.bestForever);
      }
      document.getElementById('lbl-left').textContent = 'Best';
      document.getElementById('val-left').textContent = this.bestForever;
      document.getElementById('lbl-right').textContent = 'Possible Moves';
      document.getElementById('val-right').textContent = validMoves;
      document.getElementById('progress-fill').style.width = '100%';
    } else if (this.isTimedSideLevel) {
      document.getElementById('lbl-left').textContent = `Timed ${this.level}T`;
      document.getElementById('val-left').textContent = `${this.targetScore}`;
      document.getElementById('lbl-right').textContent = 'Time Left';
      document.getElementById('val-right').textContent = `${this.timeLeft}s`;
      const pct = Math.min(100, Math.floor((this.score / this.targetScore) * 100));
      document.getElementById('progress-fill').style.width = pct + '%';
    } else {
      const isExtra = this.level > 100;
      const isHard = this.level % 10 === 0;
      if (isExtra) {
        document.getElementById('lbl-left').textContent = `Extra ${this.level - 100}`;
      } else {
        document.getElementById('lbl-left').textContent = isHard ? `Lv.${this.level} (BOSS)` : `Level ${this.level}`;
      }
      document.getElementById('val-left').textContent = `${this.targetScore}`;
      document.getElementById('lbl-right').textContent = 'Moves Left';
      document.getElementById('val-right').textContent = this.movesLeft;
      const pct = Math.min(100, Math.floor((this.score / this.targetScore) * 100));
      document.getElementById('progress-fill').style.width = pct + '%';
    }
  }

  checkEndState() {
    const validMoves = this.countValidMoves();
    const rewardEl = document.getElementById('ov-reward');
    const starsEl = document.getElementById('ov-stars');
    rewardEl.classList.add('hidden');
    starsEl.classList.add('hidden');

    if (this.mode === 'forever') {
      if (validMoves === 0) {
        this.clearHint();
        this.clearSavedGameProgress('forever');
        document.getElementById('ov-title').textContent = 'No More Moves!';
        document.getElementById('ov-desc').textContent = `Final Score: ${this.score}`;
        document.getElementById('ov-btn').textContent = 'Play Again';
        this.overlay.classList.remove('hidden');
      }
      return;
    }

    if (this.score >= this.targetScore) {
      this.stopCountdown();
      this.clearHint();
      this.wonLast = true;
      this.clearSavedGameProgress('adventure');

      const earnedStars = this.calculateStars(this.score, this.targetScore);
      const starKey = this.isTimedSideLevel ? `T${this.level}` : this.level;
      this.levelStars[starKey] = Math.max(this.levelStars[starKey] || 0, earnedStars);
      this.saveLevelStars();

      starsEl.textContent = this.formatStars(earnedStars);
      starsEl.classList.remove('hidden');

      if (this.isTimedSideLevel) {
        const gotBoosters = this.rewardUnlockedBoosters(2);
        if (gotBoosters) {
          rewardEl.textContent = '⏱️ TIMED TRIAL BONUS: +2 Charges to all unlocked boosters!';
          rewardEl.classList.remove('hidden');
        }
        this.buildPath();
        this.renderBoosters();
        document.getElementById('ov-title').textContent = `Timed Trial ${this.level}T Cleared!`;
        document.getElementById('ov-desc').textContent = `Score: ${this.score}`;
        document.getElementById('ov-btn').textContent = 'Return to Main Path';
        this.overlay.classList.remove('hidden');
        return;
      }

      const prevMax = this.maxUnlocked;
      const justUnlockedExtras = (this.level === 100 && this.maxUnlocked === 100);
      if (this.level >= this.maxUnlocked && this.level < 110) {
        this.maxUnlocked = this.level + 1;
        localStorage.setItem('pokeMatch3Unlocked', this.maxUnlocked);
      }

      const prevRealm = this.getRealmInfo(prevMax).key;
      const nextRealm = this.getRealmInfo(this.maxUnlocked).key;
      if (nextRealm !== prevRealm) {
        this.showStoryModal(nextRealm);
      }

      const gotBoosters = this.rewardUnlockedBoosters(1);
      if (justUnlockedExtras) {
        rewardEl.textContent = 'EXTRAS UNLOCKED (Lv. 101-110) + Booster Charges!';
        rewardEl.classList.remove('hidden');
      } else if (gotBoosters) {
        rewardEl.textContent = '🎁 +1 Charge to all unlocked boosters!';
        rewardEl.classList.remove('hidden');
      }

      this.buildPath();
      this.renderBoosters();
      this.updateLoreButtonState();

      const titleText = this.level > 100 ? `Extra ${this.level - 100} Cleared!` : `Level ${this.level} Cleared!`;
      document.getElementById('ov-title').textContent = titleText;
      document.getElementById('ov-desc').textContent = `Score: ${this.score}`;
      document.getElementById('ov-btn').textContent = this.level < 110 ? (justUnlockedExtras ? 'Enter Extras (101)' : 'Next Level') : 'Replay Extra 10';
      this.overlay.classList.remove('hidden');
    } else if ((this.isTimedSideLevel && this.timeLeft <= 0) || (!this.isTimedSideLevel && this.movesLeft <= 0) || validMoves === 0) {
      this.stopCountdown();
      this.clearHint();
      this.wonLast = false;
      this.clearSavedGameProgress('adventure');
      if (validMoves === 0) {
        document.getElementById('ov-title').textContent = 'No More Moves!';
      } else if (this.isTimedSideLevel) {
        document.getElementById('ov-title').textContent = 'Time Up!';
      } else {
        document.getElementById('ov-title').textContent = 'Out of Moves!';
      }
      document.getElementById('ov-desc').textContent = `Score: ${this.score} / ${this.targetScore}`;
      document.getElementById('ov-btn').textContent = 'Try Again';
      this.overlay.classList.remove('hidden');
    }
  }
}

new PokeMatchGame();
</script>
