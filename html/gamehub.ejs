    }

    #overlay-canvas {
      position: absolute;
      inset: 16px;
      width: calc(100% - 32px);
      height: calc(100% - 32px);
      pointer-events: none;
      z-index: 10;
    }

    .controls {
      display: flex;
      gap: 12px;
      width: 100%;
      max-width: 380px;
    }

    .btn {
      flex: 1;
      font-family: inherit;
