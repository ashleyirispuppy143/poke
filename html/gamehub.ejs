      border: none;
      border-radius: 16px;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 600;
      outline: none;
    }
  </style>
</head>
<body>
  <header>
    <div class="title-group">
      <a href="?" class="back-pill">Hub</a>
      <h1>Tic-Tac-Toe</h1>
    </div>
    <button id="settings-btn" class="icon-btn" type="button">Options</button>
  </header>

  <div class="score-strip">
    <div class="score-card">
      <span>Player X</span>
      <strong id="score-x" style="color:var(--x-color)">0</strong>
    </div>
    <div class="score-card">
      <span>Draws</span>
      <strong id="score-d">0</strong>
    </div>
    <div class="score-card">
      <span>Player O</span>
      <strong id="score-o" style="color:var(--o-color)">0</strong>
    </div>
  </div>

  <div class="turn-banner" id="status-msg">Player X's Turn</div>

  <div id="board-container">
    <canvas id="overlay-canvas"></canvas>
    <div id="game-grid"></div>
  </div>

  <div class="controls">
    <button class="btn btn-tonal" id="btn-undo" type="button">Undo</button>
    <button class="btn btn-primary" id="btn-reset" type="button">New Round</button>
  </div>

  <div id="settings-modal" class="modal">
    <div class="modal-content">
      <h2>Game Options</h2>
      <div class="setting-group">
        <label>Mode</label>
        <select id="set-mode">
          <option value="pvc">Player vs CPU</option>
          <option value="pvp">Pass & Play (2P)</option>
        </select>
      </div>
      <div class="setting-group">
        <label>CPU Difficulty</label>
        <select id="set-difficulty">
          <option value="easy">Casual</option>
          <option value="medium">Balanced</option>
          <option value="hard" selected>Unbeatable</option>
        </select>
      </div>
      <div class="setting-group">
        <label>First Move</label>
        <select id="set-starter">
          <option value="X">Play as X (First)</option>
          <option value="O">Play as O (Second)</option>
        </select>
      </div>
      <div style="display:flex;gap:10px;margin-top:24px;">
        <button class="btn btn-tonal" id="btn-cancel" type="button">Cancel</button>
        <button class="btn btn-primary" id="btn-save" type="button">Apply</button>
      </div>
    </div>
  </div>

<script>
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playSound(type) {
  try {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    const now = audioCtx.currentTime;
    if (type === 'move') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(360, now);
      osc.frequency.exponentialRampToValueAtTime(520, now + 0.08);
      gain.gain.setValueAtTime(0.08, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
      osc.start(now); osc.stop(now + 0.08);
    } else if (type === 'win') {
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(440, now);
      osc.frequency.setValueAtTime(554, now + 0.1);
      osc.frequency.setValueAtTime(659, now + 0.2);
      gain.gain.setValueAtTime(0.1, now);
      gain.gain.linearRampToValueAtTime(0, now + 0.45);
      osc.start(now); osc.stop(now + 0.45);
    }
  } catch (e) {}
}

const AI = {
  minimax(board, depth, isMax, aiP, huP, alpha, beta) {
    const w = AI.checkWin(board);
    if (w === aiP) return 10 - depth;
    if (w === huP) return depth - 10;
    if (!board.includes('')) return 0;

    if (isMax) {
      let best = -Infinity;
      for (let i = 0; i < 9; i++) {
        if (board[i] !== '') continue;
        board[i] = aiP;
        best = Math.max(best, AI.minimax(board, depth + 1, false, aiP, huP, alpha, beta));
        board[i] = '';
        alpha = Math.max(alpha, best);
        if (beta <= alpha) break;
      }
      return best;
    } else {
      let best = Infinity;
      for (let i = 0; i < 9; i++) {
        if (board[i] !== '') continue;
        board[i] = huP;
        best = Math.min(best, AI.minimax(board, depth + 1, true, aiP, huP, alpha, beta));
        board[i] = '';
        beta = Math.min(beta, best);
        if (beta <= alpha) break;
      }
      return best;
    }
  },

  checkWin(board) {
    const W = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
    for (const [a,b,c] of W) {
      if (board[a] && board[a] === board[b] && board[a] === board[c]) return board[a];
    }
    return null;
  },

  getBestMove(board, difficulty, aiP, huP) {
    const moves = [];
    for (let i = 0; i < 9; i++) {
      if (board[i] !== '') continue;
      board[i] = aiP;
      const score = AI.minimax(board, 0, false, aiP, huP, -Infinity, Infinity);
      board[i] = '';
      moves.push({ i, score });
    }
    if (moves.length === 0) return -1;
    moves.sort((a, b) => b.score - a.score);
    const bestScore = moves[0].score;

    if (difficulty === 'hard') {
      const tops = moves.filter(m => m.score === bestScore);
      return tops[Math.floor(Math.random() * tops.length)].i;
    }

    const rate = difficulty === 'medium' ? 0.75 : 0.35;
    if (Math.random() < rate) {
      const tops = moves.filter(m => m.score === bestScore);
      return tops[Math.floor(Math.random() * tops.length)].i;
    }
    return moves[Math.floor(Math.random() * moves.length)].i;
  }
};

class TicTacToe {
  constructor() {
    this.board = Array(9).fill('');
    this.history = [];
    this.currentPlayer = 'X';
    this.gameActive = false;
    this.scores = { X: 0, O: 0, D: 0 };
    this.isAiThinking = false;
    this.aiTimeout = null;
    this.settings = { mode: 'pvc', difficulty: 'hard', playerStart: 'X' };

    this.gridEl = document.getElementById('game-grid');
    this.statusEl = document.getElementById('status-msg');
    this.canvas = document.getElementById('overlay-canvas');
    this.ctx = this.canvas.getContext('2d');

    window.addEventListener('resize', () => this.resizeCanvas());
    this.initBoard();
    this.resizeCanvas();
    this.startNewGame();
  }

  resizeCanvas() {
    const rect = document.getElementById('board-container').getBoundingClientRect();
    this.canvas.width = rect.width - 32;
    this.canvas.height = rect.height - 32;
    if (!this.gameActive && this.lastWinCombo) this.drawWinLine(this.lastWinCombo);
  }

  initBoard() {
    this.gridEl.innerHTML = '';
    for (let i = 0; i < 9; i++) {
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.onclick = () => this.handleCellClick(i);
      this.gridEl.appendChild(cell);
    }
  }

  startNewGame() {
    this.board = Array(9).fill('');
    this.history = [];
    this.gameActive = true;
    this.currentPlayer = 'X';
    this.lastWinCombo = null;
    this.isAiThinking = false;
    if (this.aiTimeout) clearTimeout(this.aiTimeout);

    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    Array.from(this.gridEl.children).forEach(c => {
      c.innerHTML = '';
      c.classList.remove('taken');
    });

    this.statusEl.innerText = `Player ${this.currentPlayer}'s Turn`;

    if (this.settings.mode === 'pvc') {
      this.humanPlayer = this.settings.playerStart;
      this.aiPlayer = this.humanPlayer === 'X' ? 'O' : 'X';
      if (this.currentPlayer === this.aiPlayer) {
        this.isAiThinking = true;
        this.aiTimeout = setTimeout(() => this.makeAiMove(), 380);
      }
    }
  }

  handleCellClick(index) {
    if (!this.gameActive || this.board[index] !== '' || this.isAiThinking) return;
    if (this.settings.mode === 'pvc' && this.currentPlayer !== this.humanPlayer) return;

    this.makeMove(index, this.currentPlayer);

    if (this.gameActive && this.settings.mode === 'pvc') {
      this.isAiThinking = true;
      this.aiTimeout = setTimeout(() => this.makeAiMove(), 380);
    }
  }

  makeMove(index, player) {
    this.history.push({ board: [...this.board], player: this.currentPlayer });
    this.board[index] = player;

    const cell = this.gridEl.children[index];
    cell.classList.add('taken');
    const span = document.createElement('span');
    span.innerText = player;
    span.className = player === 'X' ? 'x-mark' : 'o-mark';
    cell.appendChild(span);

    playSound('move');

    if (this.checkWin()) {
      this.gameActive = false;
      this.scores[player]++;
      this.updateScoreboard();
      this.statusEl.innerText = `Player ${player} Wins!`;
      playSound('win');
      this.isAiThinking = false;
      return;
    }

    if (!this.board.includes('')) {
      this.gameActive = false;
      this.scores.D++;
      this.updateScoreboard();
      this.statusEl.innerText = "Round Drawn";
      this.isAiThinking = false;
      return;
    }

    this.currentPlayer = player === 'X' ? 'O' : 'X';
    this.statusEl.innerText = `Player ${this.currentPlayer}'s Turn`;
  }

  makeAiMove() {
    if (!this.gameActive) return;
    const moveIndex = AI.getBestMove([...this.board], this.settings.difficulty, this.aiPlayer, this.humanPlayer);
    if (moveIndex !== -1) this.makeMove(moveIndex, this.aiPlayer);
    this.isAiThinking = false;
  }

  undo() {
    if (this.history.length === 0 || !this.gameActive) return;
    if (this.aiTimeout) clearTimeout(this.aiTimeout);
    this.isAiThinking = false;

    const steps = (this.settings.mode === 'pvc' && this.currentPlayer === this.humanPlayer && this.history.length >= 2) ? 2 : 1;
    const prevState = this.history[this.history.length - steps];
    this.history = this.history.slice(0, this.history.length - steps);
    this.board = [...prevState.board];
    this.currentPlayer = prevState.player;

    Array.from(this.gridEl.children).forEach((cell, i) => {
      cell.innerHTML = '';
      cell.classList.remove('taken');
      const val = this.board[i];
      if (val) {
        cell.classList.add('taken');
        const span = document.createElement('span');
        span.innerText = val;
        span.className = val === 'X' ? 'x-mark' : 'o-mark';
        cell.appendChild(span);
      }
    });

    this.statusEl.innerText = `Player ${this.currentPlayer}'s Turn`;
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
  }

  checkWin() {
    const winCombos = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
    for (const combo of winCombos) {
      const [a, b, c] = combo;
      if (this.board[a] && this.board[a] === this.board[b] && this.board[a] === this.board[c]) {
        this.drawWinLine(combo);
        return true;
      }
    }
    return false;
  }

  drawWinLine(combo) {
    this.lastWinCombo = combo;
    const [a, , c] = combo;
    const cellW = this.canvas.width / 3;
    const cellH = this.canvas.height / 3;
    const center = idx => ({
      x: (idx % 3) * cellW + cellW / 2,
      y: Math.floor(idx / 3) * cellH + cellH / 2
    });
    const start = center(a);
    const end = center(c);

    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    this.ctx.beginPath();
    this.ctx.strokeStyle = '#a8c7fa';
    this.ctx.lineWidth = 10;
    this.ctx.lineCap = 'round';
    this.ctx.moveTo(start.x, start.y);
    this.ctx.lineTo(end.x, end.y);
    this.ctx.stroke();
  }

  updateScoreboard() {
    document.getElementById('score-x').innerText = this.scores.X;
    document.getElementById('score-o').innerText = this.scores.O;
    document.getElementById('score-d').innerText = this.scores.D;
  }
}

const game = new TicTacToe();
document.getElementById('btn-reset').onclick = () => game.startNewGame();
document.getElementById('btn-undo').onclick = () => game.undo();
document.getElementById('settings-btn').onclick = () => document.getElementById('settings-modal').style.display = 'flex';
document.getElementById('btn-cancel').onclick = () => document.getElementById('settings-modal').style.display = 'none';
document.getElementById('btn-save').onclick = () => {
  game.settings.mode = document.getElementById('set-mode').value;
  game.settings.difficulty = document.getElementById('set-difficulty').value;
  game.settings.playerStart = document.getElementById('set-starter').value;
  game.scores = { X: 0, O: 0, D: 0 };
  game.updateScoreboard();
  game.startNewGame();
  document.getElementById('settings-modal').style.display = 'none';
};
</script>
</body>
</html>
<% } %>

