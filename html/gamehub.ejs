<script>
const SFX = {
  ctx: new (window.AudioContext || window.webkitAudioContext)(),
  play(t) {
    try {
      if (this.ctx.state === 'suspended') this.ctx.resume();
      const o = this.ctx.createOscillator(), g = this.ctx.createGain();
      o.connect(g); g.connect(this.ctx.destination);
      const n = this.ctx.currentTime;
      if (t === 'hit') {
        o.type = 'sine';
        o.frequency.setValueAtTime(420, n);
        o.frequency.exponentialRampToValueAtTime(220, n + 0.07);
        g.gain.setValueAtTime(0.1, n);
        g.gain.exponentialRampToValueAtTime(0.001, n + 0.07);
        o.start(n); o.stop(n + 0.07);
      } else if (t === 'wall') {
        o.type = 'triangle';
        o.frequency.setValueAtTime(260, n);
        g.gain.setValueAtTime(0.05, n);
        g.gain.linearRampToValueAtTime(0, n + 0.04);
        o.start(n); o.stop(n + 0.04);
      } else if (t === 'score') {
        o.type = 'sine';
        o.frequency.setValueAtTime(340, n);
        o.frequency.linearRampToValueAtTime(680, n + 0.16);
        g.gain.setValueAtTime(0.08, n);
        g.gain.linearRampToValueAtTime(0, n + 0.25);
        o.start(n); o.stop(n + 0.25);
      }
    } catch (e) {}
  }
};

const G = {
  cv: document.getElementById('cv'),
  W: 800, H: 600,
  state: 'menu', mode: 'pvc', loopId: null,
  winScore: 10, diff: 'medium', baseSpeed: 7,
  ball: {}, p1: {}, p2: {},
  keys: {},
  touchY: { left: null, right: null },
  trails: [], freeze: 0,

  init() {
    this.cx = this.cv.getContext('2d');
    window.addEventListener('keydown', e => {
      this.keys[e.key] = true;
      if (['ArrowUp','ArrowDown','w','s','Escape'].includes(e.key)) e.preventDefault();
      if (e.key === 'Escape' && this.state === 'playing') this.pause();
    });
    window.addEventListener('keyup', e => this.keys[e.key] = false);

    const bindTouch = (el, side) => {
      el.addEventListener('touchstart', e => { e.preventDefault(); this.updateTouch(e, side); }, { passive: false });
      el.addEventListener('touchmove', e => { e.preventDefault(); this.updateTouch(e, side); }, { passive: false });
      el.addEventListener('touchend', () => { this.touchY[side] = null; });
    };
    bindTouch(document.getElementById('tz-left'), 'left');
    bindTouch(document.getElementById('tz-right'), 'right');

    document.getElementById('cab').addEventListener('mousemove', e => {
      if (this.state !== 'playing') return;
      const rect = this.cv.getBoundingClientRect();
      this.touchY.left = (e.clientY - rect.top) / rect.height * this.H;
    });

    document.getElementById('btn-1p').onclick = () => this.start('pvc');
    document.getElementById('btn-2p').onclick = () => this.start('pvp');
    document.getElementById('btn-resume').onclick = () => this.resume();
    document.getElementById('btn-quit').onclick = () => this.toMenu();
    document.getElementById('gear').onclick = () => this.pause();

    document.getElementById('s-diff').addEventListener('change', e => this.diff = e.target.value);
    document.getElementById('s-speed').addEventListener('input', e => this.baseSpeed = +e.target.value);
    document.getElementById('s-score').addEventListener('change', e => this.winScore = +e.target.value);
  },

  updateTouch(e, side) {
    const rect = this.cv.getBoundingClientRect();
    const touch = e.touches[e.touches.length - 1];
    this.touchY[side] = (touch.clientY - rect.top) / rect.height * this.H;
  },

  start(mode) {
    this.mode = mode;
    this.resetMatch();
    this.state = 'playing';
    document.getElementById('ov-menu').classList.add('hidden');
    document.getElementById('ov-pause').classList.add('hidden');
    this.loop();
  },

  pause() {
    if (this.state !== 'playing') return;
    this.state = 'paused';
    document.getElementById('ov-pause').classList.remove('hidden');
    cancelAnimationFrame(this.loopId);
  },

  resume() {
    if (this.state !== 'paused') return;
    this.state = 'playing';
    document.getElementById('ov-pause').classList.add('hidden');
    this.loop();
  },

  toMenu() {
    this.state = 'menu';
    document.getElementById('ov-menu').classList.remove('hidden');
    document.getElementById('ov-pause').classList.add('hidden');
    cancelAnimationFrame(this.loopId);
  },

  resetMatch() {
    this.p1 = { x: 28, y: 250, w: 14, h: 96, score: 0, vy: 0, prevY: 250 };
    this.p2 = { x: 758, y: 250, w: 14, h: 96, score: 0, vy: 0, prevY: 250 };
    this.trails = [];
    this.updateHUD();
    this.serveBall(1);
  },

  serveBall(dir) {
    const b = this.ball;
    b.x = this.W / 2;
    b.y = this.H / 2;
    b.size = 9;
    b.speed = this.baseSpeed;
    const angle = (Math.random() * 0.5 - 0.25);
    b.vx = dir * b.speed * Math.cos(angle);
    b.vy = b.speed * Math.sin(angle);
    if (Math.abs(b.vy) < 1.5) b.vy = (Math.random() > 0.5 ? 1 : -1) * 1.8;
    this.freeze = 35;
  },

  flashMsg(text) {
    const el = document.getElementById('msg');
    el.textContent = text;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), 1400);
  },

  update() {
    if (this.state !== 'playing') return;
    if (this.freeze > 0) { this.freeze--; return; }

    const pSpeed = 8.5;
    if (this.keys['w'] || this.keys['W']) { this.p1.y -= pSpeed; this.touchY.left = null; }
    else if (this.keys['s'] || this.keys['S']) { this.p1.y += pSpeed; this.touchY.left = null; }
    else if (this.touchY.left !== null) {
      const diff = this.touchY.left - (this.p1.y + this.p1.h / 2);
      this.p1.y += diff * 0.25;
    }

    if (this.mode === 'pvp') {
      if (this.keys['ArrowUp']) { this.p2.y -= pSpeed; this.touchY.right = null; }
      else if (this.keys['ArrowDown']) { this.p2.y += pSpeed; this.touchY.right = null; }
      else if (this.touchY.right !== null) {
        const diff = this.touchY.right - (this.p2.y + this.p2.h / 2);
        this.p2.y += diff * 0.25;
      }
    } else {
      this.aiUpdate();
    }

    this.p1.vy = this.p1.y - this.p1.prevY;
    this.p2.vy = this.p2.y - this.p2.prevY;
    this.p1.prevY = this.p1.y;
    this.p2.prevY = this.p2.y;

    this.p1.y = Math.max(12, Math.min(this.H - this.p1.h - 12, this.p1.y));
    this.p2.y = Math.max(12, Math.min(this.H - this.p2.h - 12, this.p2.y));

    const b = this.ball;
    b.x += b.vx;
    b.y += b.vy;

    if (b.y - b.size <= 0) { b.y = b.size; b.vy = Math.abs(b.vy); SFX.play('wall'); }
    else if (b.y + b.size >= this.H) { b.y = this.H - b.size; b.vy = -Math.abs(b.vy); SFX.play('wall'); }

    this.checkPaddleHit(this.p1, 1);
    this.checkPaddleHit(this.p2, -1);

    if (b.x < -20) { this.p2.score++; this.onScore(-1); }
    else if (b.x > this.W + 20) { this.p1.score++; this.onScore(1); }

    this.trails.push({ x: b.x, y: b.y });
    if (this.trails.length > 12) this.trails.shift();
  },

  checkPaddleHit(pad, dir) {
    const b = this.ball;
    if (dir === 1 && b.vx > 0) return;
    if (dir === -1 && b.vx < 0) return;

    if (b.x - b.size < pad.x + pad.w && b.x + b.size > pad.x &&
        b.y + b.size > pad.y && b.y - b.size < pad.y + pad.h) {
      const hitPos = Math.max(-1, Math.min(1, (b.y - (pad.y + pad.h / 2)) / (pad.h / 2)));
      const maxAngle = Math.PI / 3;
      const angle = Math.max(-maxAngle, Math.min(maxAngle, hitPos * maxAngle + pad.vy * 0.03));

      b.speed = Math.min(b.speed + 0.45, this.baseSpeed + 7);
      b.vx = dir * b.speed * Math.cos(angle);
      b.vy = b.speed * Math.sin(angle);
      b.x = dir === 1 ? pad.x + pad.w + b.size : pad.x - b.size;
      SFX.play('hit');
    }
  },

  aiUpdate() {
    const b = this.ball, pad = this.p2;
    const center = pad.y + pad.h / 2;
    const speed = this.diff === 'easy' ? 4.2 : this.diff === 'medium' ? 6.2 : 8.5;
    const targetY = b.vx > 0 ? b.y : this.H / 2;
    const diff = targetY - center;
    if (Math.abs(diff) > 8) {
      pad.y += Math.sign(diff) * Math.min(Math.abs(diff), speed);
    }
  },

  onScore(serveDir) {
    SFX.play('score');
    this.updateHUD();
    if (this.p1.score >= this.winScore || this.p2.score >= this.winScore) {
      const w = this.p1.score >= this.winScore ? 'Player 1' : (this.mode === 'pvc' ? 'CPU' : 'Player 2');
      this.flashMsg(`${w} Wins!`);
      this.state = 'gameover';
      setTimeout(() => this.toMenu(), 2400);
    } else {
      this.serveBall(serveDir);
    }
  },

  updateHUD() {
    document.getElementById('sl').textContent = this.p1.score;
    document.getElementById('sr').textContent = this.p2.score;
  },

  draw() {
    const cx = this.cx;
    cx.fillStyle = '#1d2026';
    cx.fillRect(0, 0, this.W, this.H);

    cx.strokeStyle = 'rgba(255,255,255,0.08)';
    cx.lineWidth = 4;
    cx.setLineDash([12, 16]);
    cx.beginPath(); cx.moveTo(this.W / 2, 20); cx.lineTo(this.W / 2, this.H - 20); cx.stroke();
    cx.setLineDash([]);

    for (let i = 0; i < this.trails.length; i++) {
      const t = this.trails[i];
      const alpha = (i / this.trails.length) * 0.25;
      cx.fillStyle = `rgba(168, 199, 250, ${alpha})`;
      cx.beginPath();
      cx.arc(t.x, t.y, this.ball.size * (i / this.trails.length), 0, Math.PI * 2);
      cx.fill();
    }

    cx.fillStyle = '#a8c7fa';
    cx.beginPath();
    cx.roundRect(this.p1.x, this.p1.y, this.p1.w, this.p1.h, 7);
    cx.roundRect(this.p2.x, this.p2.y, this.p2.w, this.p2.h, 7);
    cx.fill();

    cx.fillStyle = '#ffffff';
    cx.beginPath();
    cx.arc(this.ball.x, this.ball.y, this.ball.size, 0, Math.PI * 2);
    cx.fill();
  },

  loop() {
    if (this.state !== 'playing') return;
    this.update();
    this.draw();
    this.loopId = requestAnimationFrame(() => this.loop());
  }
};

G.init();
</script>
</body>
</html>
<% } %>

<% if (game === "minesweeper") { %>
<!DOCTYPE html>
<html lang="en">
<head>
