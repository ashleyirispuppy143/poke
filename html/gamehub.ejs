    .mbox { background: var(--surface); border-radius: 36px; padding: 28px; width: 92%; max-width: 400px; box-shadow: 0 24px 64px rgba(0,0,0,0.5); }
    .mbox h3 { font-size: 1.3rem; font-weight: 800; color: var(--primary); margin-bottom: 18px; }
