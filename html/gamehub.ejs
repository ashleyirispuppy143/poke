      font-weight: 600;
    }
  </style>
</head>
<body>
  <header>
    <div class="nav-left">
      <a href="?" class="pill-link">Hub</a>
      <h1>Sudoku</h1>
    </div>
    <button class="pill-link" id="btn-settings" type="button" style="border:none;cursor:pointer;">Difficulty</button>
  </header>

  <div class="status-bar">
    <div class="chip">Mode: <strong id="difficulty-display">Normal</strong></div>
    <div class="chip">Time: <strong id="timer">00:00</strong></div>
  </div>

  <div id="board-container">
    <div id="sudoku-grid"></div>
  </div>

  <div class="controls-area">
    <div class="action-row">
      <button class="btn" id="btn-undo" type="button">Undo</button>
      <button class="btn" id="btn-note" type="button">Notes: Off</button>
      <button class="btn" id="btn-erase" type="button">Erase</button>
      <button class="btn" id="btn-new" type="button">New Board</button>
    </div>

    <div class="numpad">
      <button class="num-btn" type="button" onclick="game.handleInput(1)">1</button>
      <button class="num-btn" type="button" onclick="game.handleInput(2)">2</button>
      <button class="num-btn" type="button" onclick="game.handleInput(3)">3</button>
      <button class="num-btn" type="button" onclick="game.handleInput(4)">4</button>
      <button class="num-btn" type="button" onclick="game.handleInput(5)">5</button>
      <button class="num-btn" type="button" onclick="game.handleInput(6)">6</button>
      <button class="num-btn" type="button" onclick="game.handleInput(7)">7</button>
      <button class="num-btn" type="button" onclick="game.handleInput(8)">8</button>
      <button class="num-btn" type="button" onclick="game.handleInput(9)">9</button>
    </div>
  </div>

  <div id="modal-settings" class="modal">
    <div class="modal-content">
      <h2>Puzzle Settings</h2>
      <div class="setting-row">
        <label>Difficulty</label>
        <select id="set-difficulty">
          <option value="easy">Easy</option>
          <option value="medium" selected>Normal</option>
          <option value="hard">Hard</option>
        </select>
      </div>
      <div style="display:flex;gap:10px;margin-top:24px;">
        <button class="btn" style="flex:1;" type="button" onclick="document.getElementById('modal-settings').style.display='none'">Cancel</button>
        <button class="btn active" style="flex:1;" id="btn-save-settings" type="button">Start Puzzle</button>
      </div>
    </div>
  </div>

  <div id="modal-win" class="modal">
    <div class="modal-content" style="text-align:center;">
      <h2>Puzzle Solved!</h2>
      <p id="win-time" style="color:var(--md-text-muted);margin-bottom:20px;">Time: 00:00</p>
      <button class="btn active" style="width:100%;" id="btn-play-again" type="button">Play Another</button>
    </div>
  </div>

<script>
class SudokuToolbox {
  static isValid(board, row, col, num) {
    for (let x = 0; x < 9; x++) {
      if (board[row][x] === num || board[x][col] === num) return false;
      const boxRow = 3 * Math.floor(row / 3) + Math.floor(x / 3);
      const boxCol = 3 * Math.floor(col / 3) + x % 3;
      if (board[boxRow][boxCol] === num) return false;
    }
    return true;
  }

  static solve(board) {
    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        if (board[r][c] === 0) {
          for (let n = 1; n <= 9; n++) {
            if (this.isValid(board, r, c, n)) {
              board[r][c] = n;
              if (this.solve(board)) return true;
              board[r][c] = 0;
            }
          }
          return false;
        }
      }
    }
    return true;
  }

  static generate(difficulty) {
    const board = Array.from({ length: 9 }, () => Array(9).fill(0));
    for (let i = 0; i < 9; i += 3) this.fillBox(board, i, i);
    this.solve(board);
    const solution = board.map(row => [...row]);

    let attempts = difficulty === 'easy' ? 32 : difficulty === 'medium' ? 44 : 54;
    while (attempts > 0) {
      const r = Math.floor(Math.random() * 9);
      const c = Math.floor(Math.random() * 9);
      if (board[r][c] !== 0) {
        board[r][c] = 0;
        attempts--;
      }
    }
    return { initial: board, solution };
  }

  static fillBox(board, row, col) {
    for (let i = 0; i < 3; i++) {
      for (let j = 0; j < 3; j++) {
        let num;
        do { num = Math.floor(Math.random() * 9) + 1; }
        while (!this.isSafeInBox(board, row, col, num));
        board[row + i][col + j] = num;
      }
    }
  }

  static isSafeInBox(board, row, col, num) {
    for (let i = 0; i < 3; i++)
      for (let j = 0; j < 3; j++)
        if (board[row + i][col + j] === num) return false;
    return true;
  }
}

class Game {
  constructor() {
    this.boardState = [];
    this.solution = [];
    this.initialState = [];
    this.notes = [];
    this.history = [];
    this.selected = { r: -1, c: -1 };
    this.isNoteMode = false;
    this.timer = 0;
    this.timerInterval = null;
    this.difficulty = 'medium';

    this.gridEl = document.getElementById('sudoku-grid');
    this.timerEl = document.getElementById('timer');
    this.noteBtn = document.getElementById('btn-note');
    this.setupEventListeners();
  }

  startNewGame(difficulty = this.difficulty) {
    this.difficulty = difficulty;
    const labels = { easy: 'Easy', medium: 'Normal', hard: 'Hard' };
    document.getElementById('difficulty-display').innerText = labels[difficulty] || difficulty;

    const data = SudokuToolbox.generate(difficulty);
    this.initialState = data.initial.map(row => [...row]);
    this.boardState = data.initial.map(row => [...row]);
    this.solution = data.solution;
    this.notes = Array.from({length: 9}, () => Array.from({length: 9}, () => new Set()));
    this.history = [];
    this.selected = { r: 0, c: 0 };
    this.resetTimer();
    this.renderBoard();
    this.highlightBoard();
  }

  renderBoard() {
    this.gridEl.innerHTML = '';
    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        const cell = document.createElement('div');
        const val = this.boardState[r][c];
        const isGiven = this.initialState[r][c] !== 0;

        cell.className = 'cell';
        if (r === 2 || r === 5) cell.classList.add('row-gap');
        if (isGiven) cell.classList.add('given');

        if (val !== 0) {
          cell.textContent = val;
          if (!isGiven && val !== this.solution[r][c]) cell.classList.add('error');
        } else {
          const noteContainer = document.createElement('div');
          noteContainer.className = 'notes-grid';
          const cellNotes = this.notes[r][c];
          if (cellNotes.size > 0) {
            for (let n = 1; n <= 9; n++) {
              const span = document.createElement('span');
              span.className = 'note-num';
              span.textContent = cellNotes.has(n) ? n : '';
              noteContainer.appendChild(span);
            }
          }
          cell.appendChild(noteContainer);
        }

        cell.onclick = () => this.selectCell(r, c);
        this.gridEl.appendChild(cell);
      }
    }
  }

  selectCell(r, c) {
    this.selected = { r, c };
    this.highlightBoard();
  }

  highlightBoard() {
    const cells = Array.from(this.gridEl.children);
    const { r, c } = this.selected;
    const selectedVal = (r !== -1 && this.boardState[r][c]) ? this.boardState[r][c] : null;

    cells.forEach((cell, idx) => {
      const cr = Math.floor(idx / 9);
      const cc = idx % 9;
      cell.classList.remove('selected', 'highlighted', 'same-number');

      if (cr === r && cc === c) {
        cell.classList.add('selected');
      } else if (r !== -1 && (cr === r || cc === c || (Math.floor(cr / 3) === Math.floor(r / 3) && Math.floor(cc / 3) === Math.floor(c / 3)))) {
        cell.classList.add('highlighted');
      }
      if (selectedVal && this.boardState[cr][cc] === selectedVal && !(cr === r && cc === c)) {
        cell.classList.add('same-number');
      }
    });
  }

  handleInput(num) {
    if (this.selected.r === -1) return;
    const { r, c } = this.selected;
    if (this.initialState[r][c] !== 0) return;

    this.saveToHistory();

    if (this.isNoteMode) {
      const cellNotes = this.notes[r][c];
      if (cellNotes.has(num)) cellNotes.delete(num);
      else cellNotes.add(num);
      this.renderBoard();
      this.selectCell(r, c);
    } else {
      if (this.boardState[r][c] === num) return;
      this.boardState[r][c] = num;
      if (num === this.solution[r][c]) {
        for (let i = 0; i < 9; i++) {
          this.notes[r][i].delete(num);
          this.notes[i][c].delete(num);
        }
      }
      this.renderBoard();
      this.selectCell(r, c);
      this.checkWin();
    }
  }

  clearCell() {
    if (this.selected.r === -1) return;
    const { r, c } = this.selected;
    if (this.initialState[r][c] !== 0) return;
    this.saveToHistory();
    this.boardState[r][c] = 0;
    this.notes[r][c].clear();
    this.renderBoard();
    this.selectCell(r, c);
  }

  moveSelection(dr, dc) {
    let { r, c } = this.selected;
    if (r === -1) { r = 0; c = 0; }
    else {
      r = Math.max(0, Math.min(8, r + dr));
      c = Math.max(0, Math.min(8, c + dc));
    }
    this.selectCell(r, c);
  }

  toggleNoteMode() {
    this.isNoteMode = !this.isNoteMode;
    this.noteBtn.textContent = this.isNoteMode ? "Notes: On" : "Notes: Off";
    this.noteBtn.classList.toggle('active', this.isNoteMode);
  }

  saveToHistory() {
    this.history.push({
      board: this.boardState.map(row => [...row]),
      notes: this.notes.map(row => row.map(set => new Set(set)))
    });
    if (this.history.length > 30) this.history.shift();
  }

  undo() {
    if (this.history.length === 0) return;
    const prev = this.history.pop();
    this.boardState = prev.board;
    this.notes = prev.notes;
    this.renderBoard();
    if (this.selected.r !== -1) this.selectCell(this.selected.r, this.selected.c);
  }

  checkWin() {
    for (let r = 0; r < 9; r++)
      for (let c = 0; c < 9; c++)
        if (this.boardState[r][c] !== this.solution[r][c]) return;

    clearInterval(this.timerInterval);
    document.getElementById('win-time').textContent = `Completed in ${this.timerEl.textContent}`;
    document.getElementById('modal-win').style.display = 'flex';
  }

  resetTimer() {
    clearInterval(this.timerInterval);
    this.timer = 0;
    this.timerEl.textContent = '00:00';
    this.timerInterval = setInterval(() => {
      this.timer++;
      const m = String(Math.floor(this.timer / 60)).padStart(2, '0');
      const s = String(this.timer % 60).padStart(2, '0');
      this.timerEl.textContent = `${m}:${s}`;
    }, 1000);
  }

  setupEventListeners() {
    document.addEventListener('keydown', e => {
      if (['ArrowUp', 'w', 'W'].includes(e.key)) { e.preventDefault(); this.moveSelection(-1, 0); }
      else if (['ArrowDown', 's', 'S'].includes(e.key)) { e.preventDefault(); this.moveSelection(1, 0); }
      else if (['ArrowLeft', 'a', 'A'].includes(e.key)) { e.preventDefault(); this.moveSelection(0, -1); }
      else if (['ArrowRight', 'd', 'D'].includes(e.key)) { e.preventDefault(); this.moveSelection(0, 1); }
      else if (['Backspace', 'Delete'].includes(e.key)) this.clearCell();
      else if (e.key.toLowerCase() === 'n') this.toggleNoteMode();
      else if (e.key.toLowerCase() === 'u') this.undo();
      else if (/^[1-9]$/.test(e.key)) this.handleInput(parseInt(e.key, 10));
    });

    document.getElementById('btn-note').onclick = () => this.toggleNoteMode();
    document.getElementById('btn-undo').onclick = () => this.undo();
    document.getElementById('btn-erase').onclick = () => this.clearCell();
    document.getElementById('btn-new').onclick = () => this.startNewGame();
    document.getElementById('btn-settings').onclick = () => document.getElementById('modal-settings').style.display = 'flex';
    document.getElementById('btn-save-settings').onclick = () => {
      const diff = document.getElementById('set-difficulty').value;
      document.getElementById('modal-settings').style.display = 'none';
      this.startNewGame(diff);
    };
    document.getElementById('btn-play-again').onclick = () => {
      document.getElementById('modal-win').style.display = 'none';
      this.startNewGame();
    };
  }
}

const game = new Game();
game.startNewGame();
</script>
</body>
</html>
<% } %>

