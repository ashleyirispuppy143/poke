      border: none;
      transition: transform 0.12s, filter 0.15s;
    }

    .btn:active { transform: scale(0.97); }
    .btn-tonal { background: var(--md-surface-high); color: var(--md-text); }
    .btn-primary { background: var(--md-primary); color: var(--md-on-primary); }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
