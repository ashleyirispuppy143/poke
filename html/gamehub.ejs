    .c.o { background: var(--md-surface); cursor: default; }
    .c.mine-hit { background: #93000a !important; color: #ffdad6; }
    .c.wrong-flag { background: #5c1f1f; }

    .n1 { color: #8ab4f8; }
    .n2 { color: #81c995; }
