      background-size: 150px 180px;
      animation: crimsonFall 6s linear infinite;
    }

    @keyframes oceanCaustics {
      0% { background-position: 0% 0%; }
      100% { background-position: 100% 35%; }
    }
    @keyframes bubblesRise {
      0% { transform: translateY(45%); }
      100% { transform: translateY(0%); }
    }
    @keyframes forestCanopy {
      0% { opacity: 0.78; transform: scale(1); }
      100% { opacity: 1; transform: scale(1.06); }
    }
    @keyframes fireflyDrift {
      0% { transform: translate(-16px, 12px) rotate(-3deg); }
      100% { transform: translate(18px, -18px) rotate(3deg); }
    }
    @keyframes magmaPulse {
      0% { filter: brightness(0.92); }
      100% { filter: brightness(1.22); }
    }
    @keyframes embersShoot {
      0% { transform: translateY(48%); }
      100% { transform: translateY(0%); }
    }
    @keyframes voidSingularity {
      0% { transform: scale(0.86) rotate(0deg); }
      100% { transform: scale(1.14) rotate(25deg); }
    }
    @keyframes eclipseCorona {
      0% { transform: scale(0.94); box-shadow: 0 0 0 3px #ff1744, 0 0 24px #ff4081, 0 0 50px #880e4f; }
      100% { transform: scale(1.06); box-shadow: 0 0 0 5px #ff80ab, 0 0 42px #ff1744, 0 0 80px #ad1457; }
    }
    @keyframes crimsonFall {
      0% { transform: translateY(0%); }
      100% { transform: translateY(45%); }
    }

    .path-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 6px;
      position: relative;
      z-index: 2;
    }
    .path-header h2 {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--map-accent);
      transition: color 0.4s ease;
    }
    .path-header-actions {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .lore-btn {
      background: var(--map-surf);
      color: var(--text);
      border: 1px solid rgba(255, 255, 255, 0.14);
      padding: 6px 11px;
      border-radius: 14px;
      font-family: inherit;
      font-size: 0.74rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }
    .lore-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .close-drawer-btn {
      display: none;
      background: var(--surface-3);
      color: var(--text);
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      font-size: 1.1rem;
      font-weight: 800;
      cursor: pointer;
      align-items: center;
      justify-content: center;
    }
    .path-scroll {
      flex: 1;
      overflow-y: auto;
      padding: 16px 8px;
      display: flex;
      flex-direction: column-reverse;
      gap: 16px;
      position: relative;
      scroll-behavior: smooth;
      z-index: 2;
    }

    .realm-divider {
      text-align: center;
      padding: 8px 14px;
      border-radius: 16px;
      background: var(--map-surf);
      color: var(--map-accent);
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin: 6px 0;
      backdrop-filter: blur(6px);
      transition: color 0.4s ease, background 0.4s ease;
    }
    .realm-divider.extras-div {
      background: var(--primary-container);
      color: var(--on-primary-container);
      border: 1px solid var(--primary);
    }

    .stage-row {
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }
    .stage-row:nth-of-type(4n+2):not(.has-side-path) { transform: translateX(-38px); }
    .stage-row:nth-of-type(4n+4):not(.has-side-path) { transform: translateX(38px); }

    .stage-node {
      width: 60px;
      height: 62px;
      border-radius: 20px;
      border: none;
      background: rgba(255, 255, 255, 0.06);
      color: var(--muted);
      font-family: inherit;
      font-size: 0.96rem;
      font-weight: 800;
      cursor: not-allowed;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1px;
      position: relative;
      backdrop-filter: blur(4px);
      transition: transform 0.15s ease, background 0.15s ease;
    }
    .stage-node.unlocked {
      background: var(--map-surf);
      color: var(--text);
      border: 1px solid rgba(255, 255, 255, 0.12);
      cursor: pointer;
    }
    .stage-node.unlocked:hover {
      transform: scale(1.06);
      background: var(--primary-container);
    }
    .stage-node.current {
      background: var(--map-accent);
      color: #0b1116;
      transform: scale(1.12);
      box-shadow: 0 0 16px var(--map-accent);
    }
    .stage-node.hard {
      border: 2.5px solid var(--danger);
    }
    .stage-node.extra-stage {
      border: 2px dashed var(--primary);
    }
    .stage-node.hard.current {
      background: var(--danger);
      color: var(--on-danger);
    }
    .hard-tag {
      font-size: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      line-height: 1;
    }
    .node-stars {
      font-size: 0.56rem;
      line-height: 1;
      letter-spacing: 1px;
      color: #ffd54f;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.75);
    }
    .stage-node.current .node-stars {
      color: #1a1200;
      text-shadow: none;
    }

    .side-path-wrap {
      display: flex;
      align-items: center;
      margin-left: 6px;
    }
    .side-branch-line {
      width: 22px;
      height: 3px;
      background: repeating-linear-gradient(
        90deg,
        var(--map-accent) 0px,
        var(--map-accent) 4px,
        transparent 4px,
        transparent 8px
      );
      opacity: 0.7;
    }
    .stage-node.timed-node {
      width: 54px;
      height: 54px;
      border-radius: 18px;
      border: 2px dashed #ffd54f;
      font-size: 0.78rem;
    }
    .stage-node.timed-node.unlocked {
      background: rgba(255, 213, 79, 0.14);
      color: #ffe082;
    }
    .stage-node.timed-node.current {
      background: #ffd54f;
      color: #261900;
      box-shadow: 0 0 16px #ffd54f;
    }

    .board-panel {
      background: var(--surface-1);
      border-radius: 32px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      position: relative;
      width: 100%;
    }

    .hud-strip {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    .hud-card {
      background: var(--surface-2);
      padding: 10px 12px;
      border-radius: 20px;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .hud-label {
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .hud-val {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--primary);
      margin-top: 2px;
    }

    .hazard-banner {
      width: 100%;
      max-width: 440px;
      background: var(--surface-2);
      color: var(--primary);
      padding: 6px 12px;
      border-radius: 14px;
      font-size: 0.72rem;
      font-weight: 700;
      text-align: center;
    }

    .progress-track {
      width: 100%;
      height: 10px;
      background: var(--surface-2);
      border-radius: 99px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      width: 0%;
      background: var(--primary);
      border-radius: 99px;
      transition: width 0.25s ease;
    }

    #gem-grid {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 6px;
      width: 100%;
      max-width: 440px;
      aspect-ratio: 1 / 1;
      background: var(--bg);
      padding: 10px;
      border-radius: 24px;
      touch-action: none;
    }

    .gem-cell {
      background: var(--surface-2);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: clamp(1.25rem, 4.4vw, 1.8rem);
      cursor: pointer;
      position: relative;
      transition: transform 0.15s cubic-bezier(0.2, 0, 0, 1), background 0.15s ease, opacity 0.18s ease;
    }
    .gem-cell:hover { background: var(--surface-3); }
    .gem-cell.selected {
      background: var(--primary);
      color: var(--on-primary);
      transform: scale(1.08);
      z-index: 2;
    }

    .gem-cell[data-hz="ice"] {
      background: rgba(127, 216, 235, 0.22);
      box-shadow: inset 0 0 0 2.5px #7fd8eb;
    }
    .gem-cell[data-hz="vine"] {
      background: rgba(156, 214, 157, 0.22);
      box-shadow: inset 0 0 0 2.5px #81c784;
    }
    .gem-cell[data-hz="cinder"] {
      background: rgba(255, 87, 34, 0.26);
      box-shadow: inset 0 0 0 2.5px #ff7043;
    }
    .gem-cell[data-hz="void"] {
      background: #05020a;
      box-shadow: inset 0 0 0 2.5px #a855f7;
    }
    .gem-cell[data-hz="eclipse"] {
      background: rgba(136, 14, 79, 0.45);
      box-shadow: inset 0 0 0 2.5px #ff4081;
    }

    .hz-badge {
      position: absolute;
      top: 2px;
      left: 3px;
      font-size: 0.62rem;
      line-height: 1;
      background: rgba(0, 0, 0, 0.72);
      padding: 2px 3px;
      border-radius: 5px;
      pointer-events: none;
    }

    .gem-cell.match-highlight {
      background: var(--primary) !important;
      color: var(--on-primary) !important;
      box-shadow: 0 0 16px var(--primary), inset 0 0 0 2.5px #ffffff;
      transform: scale(1.1);
      z-index: 5;
      animation: matchFlash 0.26s ease-in-out infinite alternate;
    }
    @keyframes matchFlash {
      from { filter: brightness(1.05); transform: scale(1.05); }
      to   { filter: brightness(1.3); transform: scale(1.12); }
    }

    .gem-cell.clearing {
      transform: scale(0.1);
      opacity: 0;
    }
    .gem-cell.hint-glow {
      outline: 3px solid var(--primary);
      animation: hintPulse 0.85s ease-in-out infinite alternate;
      z-index: 3;
    }
    @keyframes hintPulse {
      from { transform: scale(0.95); background: var(--surface-3); }
      to { transform: scale(1.08); background: var(--primary-container); }
    }

    .gem-cell[data-pw] {
      background: var(--primary-container);
      box-shadow: inset 0 0 0 2px var(--primary);
    }
    .pw-badge {
      position: absolute;
      bottom: 2px;
      right: 3px;
      font-size: 0.65rem;
      line-height: 1;
      background: rgba(0, 0, 0, 0.65);
      padding: 2px 4px;
      border-radius: 6px;
      pointer-events: none;
    }

    .boosters-wrap {
      width: 100%;
      max-width: 440px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .boosters-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--muted);
      padding: 0 4px;
    }
    .boosters-bar {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 6px;
    }
    .booster-btn {
      background: var(--surface-2);
      border: 2px solid transparent;
      border-radius: 16px;
      padding: 7px 4px;
      color: var(--text);
      font-family: inherit;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      position: relative;
      transition: transform 0.12s ease, background 0.15s ease, border-color 0.15s ease;
    }
    .booster-btn:hover:not(.locked):not(:disabled) {
      background: var(--surface-3);
      transform: translateY(-2px);
    }
    .booster-btn.active {
      border-color: var(--primary);
      background: var(--primary-container);
    }
    .booster-btn.locked {
      opacity: 0.42;
      cursor: not-allowed;
    }
    .booster-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }
    .b-icon { font-size: 1.2rem; line-height: 1; }
    .b-name { font-size: 0.6rem; font-weight: 800; color: var(--muted); white-space: nowrap; }
    .b-qty {
      font-size: 0.64rem;
      font-weight: 800;
      background: var(--surface-3);
      color: var(--primary);
      padding: 1px 6px;
      border-radius: 99px;
    }

    .powerup-legend {
      width: 100%;
      max-width: 440px;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 6px;
      background: var(--surface-2);
      padding: 9px 12px;
      border-radius: 16px;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--muted);
    }

    .overlay-box {
      position: absolute;
      inset: 0;
      background: rgba(16, 10, 14, 0.92);
      backdrop-filter: blur(10px);
      border-radius: 32px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 28px;
      text-align: center;
      z-index: 20;
    }
    .hidden { display: none !important; }
    .overlay-box h3 {
      font-size: 2rem;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 6px;
    }
    .ov-stars {
      font-size: 2rem;
      color: #ffd54f;
      letter-spacing: 6px;
      margin-bottom: 8px;
      text-shadow: 0 2px 10px rgba(255, 213, 79, 0.45);
    }
    .overlay-box p {
      color: var(--muted);
      margin-bottom: 12px;
      font-size: 1rem;
      font-weight: 600;
    }
    .reward-pill {
      background: var(--primary-container);
      color: var(--on-primary-container);
      padding: 8px 16px;
      border-radius: 16px;
      font-size: 0.82rem;
      font-weight: 800;
      margin-bottom: 18px;
    }
    .action-btn {
      background: var(--primary);
      color: var(--on-primary);
      border: none;
      padding: 14px 28px;
      border-radius: 22px;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
    }

    .story-modal {
      position: fixed;
      inset: 0;
      background: rgba(6, 4, 10, 0.86);
      backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px;
      z-index: 200;
    }
    .story-card {
      background: var(--surface-1);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 30px;
      max-width: 480px;
      width: 100%;
      padding: 26px 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.75);
      animation: storyPop 0.28s cubic-bezier(0.2, 0, 0, 1);
    }
    @keyframes storyPop {
      from { transform: translateY(16px) scale(0.95); opacity: 0; }
      to   { transform: translateY(0) scale(1); opacity: 1; }
    }
    .story-title {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--primary);
      line-height: 1.2;
    }
    .story-body {
      display: flex;
      flex-direction: column;
      gap: 10px;
      color: var(--text);
      font-size: 0.94rem;
      line-height: 1.58;
      font-weight: 500;
      max-height: 52vh;
      overflow-y: auto;
      padding-right: 4px;
    }
    .story-body p {
      color: var(--text);
      opacity: 0.92;
    }

    body.is-mobile {
      padding: 8px 8px env(safe-area-inset-bottom, 10px);
      justify-content: flex-start;
    }

    body.is-mobile .app-wrap {
      gap: 8px;
      width: 100%;
      max-width: 460px;
    }

    body.is-mobile header.desktop-header {
      display: none !important;
    }

    body.is-mobile .mobile-topbar {
      display: flex;
    }

    body.is-mobile .layout-grid {
      grid-template-columns: 1fr !important;
      gap: 0;
      width: 100%;
    }

    body.is-mobile .path-panel {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(85vw, 330px);
      height: 100dvh;
      border-radius: 0 28px 28px 0;
      padding: 18px 14px;
      box-shadow: 16px 0 44px rgba(0, 0, 0, 0.75);
      transform: translateX(-105%);
      transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1), background 0.55s ease;
      display: flex !important; /* stays in DOM for slide animation */
    }

    body.is-mobile .path-panel.drawer-open {
      transform: translateX(0);
    }

    body.is-mobile .close-drawer-btn {
      display: inline-flex;
    }

    body.is-mobile .board-panel {
      padding: 10px;
      border-radius: 24px;
      gap: 8px;
      background: var(--surface-1);
    }

    body.is-mobile .hud-strip {
      gap: 6px;
    }

    body.is-mobile .hud-card {
      padding: 8px 6px;
      border-radius: 16px;
    }

    body.is-mobile .hud-label {
      font-size: 0.6rem;
    }

    body.is-mobile .hud-val {
      font-size: 1.05rem;
    }

    body.is-mobile .hazard-banner {
      font-size: 0.65rem;
      padding: 5px 8px;
    }

    body.is-mobile .progress-track {
      height: 8px;
    }

    body.is-mobile #gem-grid {
      padding: 6px;
      gap: 4px;
      border-radius: 18px;
      max-width: 100%;
    }

    body.is-mobile .gem-cell {
      border-radius: 11px;
      font-size: clamp(1.3rem, 6.2vw, 1.85rem);
    }

    body.is-mobile .boosters-bar {
      gap: 5px;
    }

    body.is-mobile .booster-btn {
      padding: 6px 2px;
      border-radius: 14px;
    }

    body.is-mobile .b-icon {
      font-size: 1.1rem;
    }

    body.is-mobile .b-name {
      font-size: 0.55rem;
    }

    body.is-mobile .powerup-legend {
      padding: 7px 8px;
      font-size: 0.62rem;
      border-radius: 14px;
      justify-content: space-around;
    }
  </style>
</head>
<body data-theme="endless">

  <div class="drawer-backdrop" id="drawer-backdrop"></div>

  <div class="story-modal hidden" id="story-modal">
    <div class="story-card">
      <h3 class="story-title" id="story-title">The Drowned Bell of Pelagos</h3>
      <div class="story-body" id="story-body"></div>
      <button class="action-btn" id="story-close-btn">Continue Journey</button>
    </div>
  </div>

  <div class="app-wrap">
    <header class="desktop-header">
      <div class="brand-title">
        <h1>poke!match</h1>
        <span class="theme-badge" id="theme-badge">Endless Mode</span>
      </div>
      <div class="mode-tabs">
        <button class="tab-btn" id="tab-forever">Endless Mode</button>
        <button class="tab-btn" id="tab-adventure">Realm Map</button>
      </div>
    </header>

    <div class="mobile-topbar" id="mobile-topbar">
      <button class="map-drawer-btn hidden" id="btn-open-map">
        <span>🗺️</span>
        <span id="mobile-realm-label">Map</span>
      </button>
      <div class="mobile-mode-pill">
        <button class="tab-btn" id="mob-tab-forever">Endless</button>
        <button class="tab-btn" id="mob-tab-adventure">Adventure</button>
      </div>
    </div>

    <div class="layout-grid single" id="main-layout">
      <aside class="path-panel hidden" id="path-panel" data-map-realm="ocean">
        <div class="realm-bg-anim" aria-hidden="true">
          <div class="bg-layer bg-ocean"></div>
          <div class="bg-layer bg-forest"></div>
          <div class="bg-layer bg-magma"></div>
          <div class="bg-layer bg-astral"></div>
          <div class="bg-layer bg-extras"></div>
        </div>
        <div class="path-header">
          <div>
            <h2 id="map-header-title">Ocean Abyss</h2>
            <span id="unlocked-label" style="font-size:0.76rem;font-weight:700;color:var(--muted);">1 / 110 Unlocked</span>
          </div>
          <div class="path-header-actions">
            <button class="lore-btn" id="btn-read-lore" title="Read Realm Chronicle">📖 Lore</button>
            <button class="close-drawer-btn" id="btn-close-map" aria-label="Close Realm Map">✕</button>
          </div>
        </div>
        <div class="path-scroll" id="path-scroll"></div>
      </aside>

      <section class="board-panel">
        <div class="hud-strip">
          <div class="hud-card">
            <div class="hud-label" id="lbl-left">Mode</div>
            <div class="hud-val" id="val-left">Endless</div>
          </div>
          <div class="hud-card">
            <div class="hud-label">Score</div>
            <div class="hud-val" id="val-score">0</div>
          </div>
          <div class="hud-card">
            <div class="hud-label" id="lbl-right">Possible Moves</div>
            <div class="hud-val" id="val-right">0</div>
          </div>
        </div>

        <div class="hazard-banner hidden" id="hazard-banner"></div>

        <div class="progress-track">
          <div class="progress-fill" id="progress-fill"></div>
        </div>

        <div id="gem-grid"></div>

        <div class="boosters-wrap" id="boosters-wrap">
          <div class="boosters-header">
            <span>BOOSTERS (+1 per level beat!)</span>
            <span id="booster-status">Tap a booster to use</span>
          </div>
          <div class="boosters-bar" id="boosters-bar"></div>
        </div>

        <div class="powerup-legend">
          <span>⚡4 Row: H-Beam</span>
          <span>🔱4 Col: V-Beam</span>
          <span>💥L/T: Nova</span>
          <span>🌀5 Line: Prism</span>
          <span>🌩️6+: Storm</span>
        </div>

        <div class="overlay-box hidden" id="end-overlay">
          <h3 id="ov-title">No More Moves!</h3>
          <div class="ov-stars hidden" id="ov-stars">★★★</div>
          <p id="ov-desc">Final Score: 0</p>
          <div class="reward-pill hidden" id="ov-reward">🎁 +1 Charge to all unlocked boosters!</div>
          <button class="action-btn" id="ov-btn">Play Again</button>
        </div>
      </section>
    </div>
  </div>

<script>
const AC = new (window.AudioContext || window.webkitAudioContext)();
function playTone(freq, dur = 0.09, type = 'sine') {
  try {
    if (AC.state === 'suspended') AC.resume();
    const o = AC.createOscillator(), g = AC.createGain();
    o.type = type;
    o.frequency.setValueAtTime(freq, AC.currentTime);
    g.gain.setValueAtTime(0.08, AC.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, AC.currentTime + dur);
    o.connect(g).connect(AC.destination);
    o.start();
    o.stop(AC.currentTime + dur);
  } catch (e) {}
}

function checkIsMobile() {
  const uaMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent || '');
  const iPadOS = (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const coarsePointer = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
  const narrowScreen = window.innerWidth <= 820;
  return Boolean(uaMobile || iPadOS || (coarsePointer && narrowScreen) || narrowScreen);
}

