    }

    .cell.taken { cursor: default; }

    .cell span {
      animation: popIn 0.2s cubic-bezier(0.2, 0, 0, 1) forwards;
    }

    .x-mark { color: var(--x-color); }
    .o-mark { color: var(--o-color); }

    @keyframes popIn {
      from { opacity: 0; transform: scale(0.5); }
