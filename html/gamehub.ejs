      font-family: inherit;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
      transition: background 0.2s, transform 0.15s;
    }

    .icon-btn:hover {
      background: var(--md-surface-highest);
      transform: translateY(-2px);
    }

    .screen {
      position: absolute;
      inset: 0;
      background: rgba(14, 20, 16, 0.78);
