<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Poke! Games Hub</title>
  <link href="https://fonts.bunny.net/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --md-bg: #111318;
      --md-surface: #1d2026;
      --md-surface-high: #282a31;
      --md-surface-highest: #33353c;
      --md-primary: #a8c7fa;
      --md-on-primary: #062e6f;
      --md-primary-container: #284777;
      --md-on-primary-container: #d6e3ff;
      --md-secondary-container: #3e4759;
      --md-on-secondary-container: #dae2f9;
      --md-text: #e2e2e9;
      --md-text-muted: #c4c6d0;
      --md-outline: #44474e;
      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius-pill: 9999px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    html, body { min-height: 100%; }
    body {
      background-color: var(--md-bg);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      color: var(--md-text);
      -webkit-font-smoothing: antialiased;
      padding: 2rem 1rem 4rem;
    }

    .wrapper {
      max-width: 1040px;
      margin: 0 auto;
    }

    .top-bar {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 2.25rem;
      padding: 0 0.5rem;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      background: var(--md-primary-container);
      color: var(--md-on-primary-container);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-pill);
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(2rem, 4vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--md-text);
    }

    p.lead {
      font-size: 1rem;
      color: var(--md-text-muted);
      font-weight: 500;
    }

    .game-container {
      display: grid;
      gap: 1.25rem;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }

    .game {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.25rem;
      background: var(--md-surface);
      border-radius: var(--radius-xl);
      padding: 1.5rem;
      text-decoration: none;
      color: var(--md-text);
      min-height: 210px;
      transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1), background-color 0.2s ease;
      outline: none;
    }

    .game:hover {
      background: var(--md-surface-high);
      transform: translateY(-4px);
    }

    .game:active {
      transform: scale(0.98);
    }

    .game:focus-visible {
      box-shadow: 0 0 0 3px var(--md-primary);
    }

    .row-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .icon-box {
      width: 56px;
      height: 56px;
      border-radius: 20px;
      background: var(--md-surface-highest);
      display: grid;
      place-items: center;
      font-size: 1.75rem;
    }

    .info-btn {
      height: 40px;
      padding: 0 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--md-surface-highest);
      border: none;
      border-radius: var(--radius-pill);
      color: var(--md-text-muted);
      font-family: inherit;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .info-btn:hover {
      background: var(--md-primary);
      color: var(--md-on-primary);
    }

    .card-body {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .title {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .subtitle {
      color: var(--md-text-muted);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .play-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      width: fit-content;
      background: var(--md-primary);
      color: var(--md-on-primary);
      font-size: 0.85rem;
      font-weight: 700;
      padding: 0.55rem 1.1rem;
      border-radius: var(--radius-pill);
    }

    .dialog-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(6px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      z-index: 100;
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    .hidden {
      display: none !important;
    }

    .dialog-box {
      background: var(--md-surface-high);
      border-radius: var(--radius-xl);
      padding: 1.75rem;
      max-width: 420px;
      width: 100%;
      box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }

    .dialog-box h3 {
      font-size: 1.35rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }

    .dialog-box p {
      color: var(--md-text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
    }

    .btn-filled {
      border: none;
      background: var(--md-primary);
      color: var(--md-on-primary);
      padding: 0.7rem 1.35rem;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 700;
      border-radius: var(--radius-pill);
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <header class="top-bar">
      <span class="badge">PokeTube Arcade</span>
      <h1>Games Hub</h1>
      <p class="lead">Select a game to play right in your browser.</p>
    </header>

    <div class="game-container">
      <a class="game" href="?game=snake" data-title="Snake" data-desc="Guide the snake across the board, collect apples, and avoid running into the walls or your own tail. Includes sandbox level selection, wall-wrapping, and assist options.">
        <div class="row-top">
          <div class="icon-box" aria-hidden="true">🐍</div>
          <button class="info-btn" type="button">Details</button>
        </div>
        <div class="card-body">
          <div class="title">Snake</div>
          <div class="subtitle">Eat apples, grow longer, and avoid collisions in fullscreen mode.</div>
        </div>
        <div class="play-chip">Play Now</div>
      </a>

      <a class="game" href="?game=tic-tac-toe" data-title="Tic-Tac-Toe" data-desc="Play X and O on a 3x3 grid against a friend locally or test yourself against three AI difficulty tiers powered by minimax search.">
        <div class="row-top">
          <div class="icon-box" aria-hidden="true">⭕</div>
          <button class="info-btn" type="button">Details</button>
        </div>
        <div class="card-body">
          <div class="title">Tic-Tac-Toe</div>
          <div class="subtitle">Classic 3x3 strategy against an unbeatable AI or a second player.</div>
        </div>
        <div class="play-chip">Play Now</div>
      </a>

      <a class="game" href="?game=sudoku" data-title="Sudoku" data-desc="Fill every row, column, and 3x3 block with the numbers 1 through 9 without repeating. Features candidate note-taking, undo history, and cell highlighting.">
        <div class="row-top">
          <div class="icon-box" aria-hidden="true">🧩</div>
          <button class="info-btn" type="button">Details</button>
        </div>
        <div class="card-body">
          <div class="title">Sudoku</div>
          <div class="subtitle">Complete the 9x9 number puzzle with candidate notes and smart highlights.</div>
        </div>
        <div class="play-chip">Play Now</div>
      </a>

      <a class="game" href="?game=pong" data-title="Ping-Pong" data-desc="Fast-paced table tennis. Deflect the ball at sharp angles and add spin with your paddle velocity to outscore the CPU or a second player.">
        <div class="row-top">
          <div class="icon-box" aria-hidden="true">🏓</div>
          <button class="info-btn" type="button">Details</button>
        </div>
        <div class="card-body">
          <div class="title">Ping-Pong</div>
          <div class="subtitle">Table tennis with directional spin, smashes, and 1P or 2P modes.</div>
        </div>
        <div class="play-chip">Play Now</div>
      </a>

      <a class="game" href="?game=minesweeper" data-title="Minesweeper" data-desc="Clear the board using numerical clues about neighboring mines. Supports chord-clicking on satisfied numbers, safe first clicks, and an optional strict flag mode.">
        <div class="row-top">
          <div class="icon-box" aria-hidden="true">💣</div>
          <button class="info-btn" type="button">Details</button>
        </div>
        <div class="card-body">
          <div class="title">Minesweeper</div>
          <div class="subtitle">Deduce mine locations, flag hazards, and chord-clear safe tiles.</div>
        </div>
        <div class="play-chip">Play Now</div>
      </a>

      <a class="game" href="?game=breakout" data-title="Breakout" data-desc="Bounce the ball to clear rows of bricks while catching falling power-ups including multi-ball, wide paddle, laser cannons, and slow-mo.">
        <div class="row-top">
          <div class="icon-box" aria-hidden="true">🧱</div>
          <button class="info-btn" type="button">Details</button>
        </div>
        <div class="card-body">
          <div class="title">Breakout</div>
          <div class="subtitle">Shatter brick formations and collect paddle power-ups across levels.</div>
        </div>
        <div class="play-chip">Play Now</div>
      </a>
    </div>
  </div>

  <div id="infoDialog" class="dialog-backdrop hidden" role="dialog" aria-modal="true">
    <div class="dialog-box">
      <h3 id="dialogTitle">Game Info</h3>
      <p id="dialogDesc"></p>
      <div class="dialog-actions">
        <button id="closeDialog" class="btn-filled" type="button">Got it</button>
      </div>
    </div>
  </div>

  <script>
    (function(){
      const dialog = document.getElementById('infoDialog');
      const titleEl = document.getElementById('dialogTitle');
      const descEl = document.getElementById('dialogDesc');
      const closeBtn = document.getElementById('closeDialog');

      document.querySelectorAll('.game').forEach(card => {
        const btn = card.querySelector('.info-btn');
        btn.addEventListener('click', e => {
          e.preventDefault();
          e.stopPropagation();
          titleEl.textContent = card.dataset.title;
          descEl.textContent = card.dataset.desc;
          dialog.classList.remove('hidden');
          closeBtn.focus();
        });
      });

      closeBtn.addEventListener('click', () => dialog.classList.add('hidden'));
      dialog.addEventListener('click', e => {
        if (e.target === dialog) dialog.classList.add('hidden');
      });
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') dialog.classList.add('hidden');
      });
    })();
  </script>
</body>
</html>
<% } %>

<% if (game === "snake") { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Poke Snake</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <link href="https://fonts.bunny.net/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --md-bg: #0e1410;
      --md-surface: #19211c;
      --md-surface-high: #232d27;
      --md-surface-highest: #2e3932;
      --md-primary: #85f8b2;
      --md-on-primary: #00391c;
      --md-primary-container: #00522b;
      --md-on-primary-container: #a1ffca;
