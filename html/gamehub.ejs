      white-space: pre;
      z-index: 300;
      display: none;
      pointer-events: none;
    }
  </style>
</head>
<body>
  <div id="game-container">
    <div class="hud-bar">
      <div class="hud-chips">
        <div class="stat-pill">Score <span id="scoreVal">0</span></div>
        <div class="stat-pill">Best <span id="highVal">0</span></div>
        <div class="stat-pill">Lvl <span id="lvlVal">1</span></div>
      </div>
      <div class="hud-actions" id="topRightControls">
        <a href="?" class="icon-btn">Hub</a>
        <button id="openLevelBtn" class="icon-btn" type="button">Levels</button>
        <button id="settingsBtn" class="icon-btn" type="button">Settings</button>
      </div>
    </div>

    <canvas id="snakeCanvas"></canvas>

    <div id="startPrompt" class="hidden">Press an Arrow Key, WASD, or Swipe to begin</div>

    <div id="titleScreen" class="screen">
      <div class="hero-card">
        <span class="hero-badge" id="splashText">Material Arcade</span>
        <h1 class="logo-text">Snake</h1>
        <p class="hero-sub">Smooth controls, level progression, and customizable rules.</p>
        <div class="title-menu" id="titleMenu">
          <button id="btnPlayTitle" class="md-btn btn-primary" type="button">Start Game</button>
          <button id="btnLevelTitle" class="md-btn btn-tonal" type="button">Sandbox Levels</button>
          <button id="btnSettingsTitle" class="md-btn btn-tonal" type="button">Game Settings</button>
          <a href="?" style="text-decoration:none;"><button class="md-btn btn-tonal" type="button">Back to Hub</button></a>
        </div>
      </div>
    </div>

    <div id="gameOverScreen" class="screen hidden">
      <div class="hero-card">
        <span class="hero-badge" style="background:#93000a;color:#ffdad6;">Run Ended</span>
        <h1 id="gameOverText" class="logo-text" style="font-size:2rem;margin-top:6px;">Game Over</h1>
        <p id="finalScoreText" class="hero-sub">Score: 0</p>
        <div class="title-menu">
          <button id="btnRetry" class="md-btn btn-primary" type="button">Play Again (R)</button>
          <button id="backToTitle" class="md-btn btn-tonal" type="button">Main Menu</button>
        </div>
      </div>
    </div>

    <div id="levelModal" class="modal-backdrop">
      <div class="modal-sheet">
        <h2 id="levelModalTitle">Select Level</h2>
        <div id="levelGrid"></div>
        <div class="modal-footer">
          <button id="closeLevelModal" class="md-btn btn-tonal" type="button">Close</button>
        </div>
      </div>
    </div>

    <div id="settingsModal" class="modal-backdrop">
      <div class="modal-sheet">
        <h2>Settings</h2>
        <div class="settings-group">
          <div class="setting-item">
            <div class="setting-label">
              <strong>Game Speed</strong>
              <span>Base movement interval</span>
            </div>
            <select id="paramSpeed">
              <option value="135">Relaxed</option>
              <option value="95" selected>Standard</option>
              <option value="65">Fast</option>
              <option value="42">Intense</option>
            </select>
          </div>

          <div class="setting-item">
            <div class="setting-label">
              <strong>Wall Behavior</strong>
              <span>Solid borders or screen wrap</span>
            </div>
            <select id="paramWallMode">
              <option value="kill" selected>Solid Walls</option>
              <option value="wrap">Wrap Around</option>
            </select>
          </div>

          <div class="setting-item">
            <div class="setting-label">
              <strong>Assist Mode</strong>
              <span>Auto-turn before fatal collisions</span>
            </div>
            <select id="paramAssist">
              <option value="off" selected>Off</option>
              <option value="on">On</option>
            </select>
          </div>

          <div class="setting-item">
            <div class="setting-label">
              <strong>Starting Length</strong>
              <span>Initial segments (1 to 20)</span>
            </div>
            <input type="number" id="paramStartLength" min="1" max="20" value="4">
          </div>

          <div class="setting-item">
            <div class="setting-label">
              <strong>Snake Colors</strong>
              <span>Head and body appearance</span>
            </div>
            <div style="display:flex;gap:10px;">
              <input type="color" id="paramHeadColor" value="#85f8b2">
              <input type="color" id="paramBodyColor" value="#38b87c">
            </div>
          </div>

          <div class="setting-item">
            <div class="setting-label">
              <strong>Sound Effects</strong>
              <span>Synthesized audio feedback</span>
            </div>
            <div style="display:flex;align-items:center;gap:12px;">
              <select id="paramSfx">
                <option value="on" selected>On</option>
                <option value="off">Off</option>
              </select>
              <input type="range" id="paramSfxVolume" min="0" max="1" step="0.1" value="0.6">
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button id="closeSettings" class="md-btn btn-tonal" type="button">Cancel</button>
          <button id="saveSettings" class="md-btn btn-primary" type="button">Apply</button>
        </div>
      </div>
    </div>

    <div id="debugMenu"></div>
  </div>

  <script>
    const canvas = document.getElementById('snakeCanvas');
    const ctx = canvas.getContext('2d');
    const titleScreen = document.getElementById('titleScreen');
    const startPrompt = document.getElementById('startPrompt');
    const splashText = document.getElementById('splashText');
    const gameOverScreen = document.getElementById('gameOverScreen');
    const gameOverText = document.getElementById('gameOverText');
    const finalScoreText = document.getElementById('finalScoreText');
    const scoreVal = document.getElementById('scoreVal');
    const highVal = document.getElementById('highVal');
    const lvlVal = document.getElementById('lvlVal');
    const levelModal = document.getElementById('levelModal');
    const levelModalTitle = document.getElementById('levelModalTitle');
    const settingsModal = document.getElementById('settingsModal');
    const debugMenu = document.getElementById('debugMenu');

    const CELL = 24;
    const splashes = ["Smooth 60FPS", "Swipe or WASD", "Try Wrap Mode", "Material You Edition"];
    splashText.textContent = splashes[Math.floor(Math.random() * splashes.length)];

    let params = {
      speed: 95,
      sfx: true,
      startLength: 4,
      wallMode: 'kill',
      assistMode: false,
      sfxVolume: 0.6,
      headColor: '#85f8b2',
      bodyColor: '#38b87c'
    };

    let snake = [], dir = {x: 0, y: -1}, food = {x: 5, y: 5};
    let score = 0, highScore = parseInt(localStorage.getItem('pokeSnakeHigh')) || 0, level = 1;
    let state = 'start', startTime = 0;
    const endMessages = ["Wall Impact", "Tangled Up", "Out of Bounds", "Run Complete"];
    let fps = 0, frameCount = 0, lastFpsTime = Date.now();
    let movesCount = 0;
    let hasStartedMoving = false;
    let maxUnlockedLevel = parseInt(localStorage.getItem('pokeSnakeMaxLevel')) || 1;
    let selectedStartingLevel = 1;

    let reqAnimFrameId;
    let lastTime = 0;
    let accumulator = 0;
    let currentTickRate = params.speed;
    let inputQueue = [];
    let lastProcessedDir = {x: 0, y: -1};
    let audioCtx = null;

    function resizeCanvas() {
      const availW = window.innerWidth - 32;
      const availH = window.innerHeight - 32;
      canvas.width = Math.max(CELL * 10, Math.floor(availW / CELL) * CELL);
      canvas.height = Math.max(CELL * 10, Math.floor(availH / CELL) * CELL);
      if (food) {
        const cols = canvas.width / CELL, rows = canvas.height / CELL;
        if (food.x >= cols || food.y >= rows) pickFood();
      }
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function buildLevelGrid(isSandbox) {
      const grid = document.getElementById('levelGrid');
      grid.innerHTML = '';
      levelModalTitle.textContent = isSandbox ? "Sandbox Levels (Unlocked)" : "Select Starting Level";

      for (let i = 1; i <= 20; i++) {
        const btn = document.createElement('button');
        btn.className = 'lvl-btn';
        btn.textContent = i;
        if (isSandbox || i <= maxUnlockedLevel) {
          btn.classList.add('unlocked');
          if (i === selectedStartingLevel) btn.classList.add('selected');
          btn.addEventListener('click', () => {
            selectedStartingLevel = i;
            levelModal.classList.remove('open');
            startGame();
          });
        }
        grid.appendChild(btn);
      }
    }

    function pickFood() {
      const cols = Math.floor(canvas.width / CELL);
      const rows = Math.floor(canvas.height / CELL);
      let valid = false;
      while (!valid) {
        food = {
          x: Math.floor(Math.random() * cols),
          y: Math.floor(Math.random() * rows)
        };
        valid = !snake.some(seg => seg.x === food.x && seg.y === food.y);
      }
    }

    function showMainMenu() {
      gameOverScreen.classList.add('hidden');
      titleScreen.classList.remove('hidden');
      startPrompt.classList.add('hidden');
      state = 'start';
    }

    function startGame() {
      titleScreen.classList.add('hidden');
      gameOverScreen.classList.add('hidden');
      state = 'playing';
      initGame();
    }

    function initGame() {
      const cols = Math.floor(canvas.width / CELL);
      const rows = Math.floor(canvas.height / CELL);
      const startX = Math.floor(cols / 2);
      const startY = Math.floor(rows / 2);

      snake = [];
      for (let i = 0; i < params.startLength; i++) {
        snake.push({x: startX, y: startY + i});
      }

      dir = {x: 0, y: -1};
      lastProcessedDir = {x: 0, y: -1};
      inputQueue = [];
      pickFood();
      score = 0;
      level = selectedStartingLevel;
      movesCount = 0;
      hasStartedMoving = false;
      startPrompt.classList.remove('hidden');

      currentTickRate = Math.max(35, params.speed * Math.pow(0.96, level - 1));
      updateScoreboard();

      if (reqAnimFrameId) cancelAnimationFrame(reqAnimFrameId);
      lastTime = performance.now();
      accumulator = 0;
      reqAnimFrameId = requestAnimationFrame(gameLoop);
    }

    function drawRoundedRect(x, y, w, h, r) {
      ctx.beginPath();
      ctx.roundRect(x, y, w, h, r);
      ctx.fill();
    }

    function draw() {
      ctx.fillStyle = '#131b16';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Subtle dot grid
      ctx.fillStyle = 'rgba(255, 255, 255, 0.03)';
      const cols = canvas.width / CELL;
      const rows = canvas.height / CELL;
      for (let c = 0; c < cols; c++) {
        for (let r = 0; r < rows; r++) {
          ctx.fillRect(c * CELL + CELL / 2 - 1, r * CELL + CELL / 2 - 1, 2, 2);
        }
      }

      // Apple
      const pulse = 1 + Math.sin(performance.now() / 180) * 0.08;
      const fx = food.x * CELL + CELL / 2;
      const fy = food.y * CELL + CELL / 2;
      ctx.fillStyle = '#ff6b6b';
      ctx.beginPath();
      ctx.arc(fx, fy, (CELL * 0.4) * pulse, 0, Math.PI * 2);
      ctx.fill();

      // Snake segments
      snake.forEach((seg, i) => {
        ctx.fillStyle = i === 0 ? params.headColor : params.bodyColor;
        const pad = i === 0 ? 1 : 2;
        const radius = i === 0 ? 9 : 7;
        drawRoundedRect(seg.x * CELL + pad, seg.y * CELL + pad, CELL - pad * 2, CELL - pad * 2, radius);

        if (i === 0) {
          ctx.fillStyle = '#00210f';
          const cx = seg.x * CELL + CELL / 2;
          const cy = seg.y * CELL + CELL / 2;
          const ex = lastProcessedDir.y !== 0 ? 4 : lastProcessedDir.x * 4;
          const ey = lastProcessedDir.x !== 0 ? 4 : lastProcessedDir.y * 4;
          ctx.beginPath();
          ctx.arc(cx - ex, cy - ey, 2.2, 0, Math.PI * 2);
          ctx.arc(cx + (lastProcessedDir.y !== 0 ? 4 : lastProcessedDir.x * 4), cy + (lastProcessedDir.x !== 0 ? 4 : lastProcessedDir.y * 4), 2.2, 0, Math.PI * 2);
          ctx.fill();
        }
      });
    }

    function update() {
      if (!hasStartedMoving) return;

      if (inputQueue.length > 0) {
        dir = inputQueue.shift();
        lastProcessedDir = dir;
      }

      const cols = canvas.width / CELL;
      const rows = canvas.height / CELL;

      if (params.assistMode) {
        let danger = false;
        let nx = snake[0].x + dir.x;
        let ny = snake[0].y + dir.y;
        if (params.wallMode === 'kill') {
          if (nx < 0 || nx >= cols || ny < 0 || ny >= rows) danger = true;
        } else {
          nx = (nx + cols) % cols;
          ny = (ny + rows) % rows;
        }
        if (snake.some((s, idx) => idx > 0 && s.x === nx && s.y === ny)) danger = true;

        if (danger) {
          const turns = dir.x === 0 ? [{x: -1, y: 0}, {x: 1, y: 0}] : [{x: 0, y: -1}, {x: 0, y: 1}];
          for (const t of turns) {
            let tx = snake[0].x + t.x;
            let ty = snake[0].y + t.y;
            let safe = true;
            if (params.wallMode === 'kill') {
              if (tx < 0 || tx >= cols || ty < 0 || ty >= rows) safe = false;
            } else {
              tx = (tx + cols) % cols;
              ty = (ty + rows) % rows;
            }
            if (snake.some((s, idx) => idx > 0 && s.x === tx && s.y === ty)) safe = false;
            if (safe) {
              dir = t;
              lastProcessedDir = t;
              break;
            }
          }
        }
      }

      const head = {x: snake[0].x + dir.x, y: snake[0].y + dir.y};

      if (params.wallMode === 'wrap') {
        head.x = (head.x + cols) % cols;
        head.y = (head.y + rows) % rows;
      } else if (head.x < 0 || head.x >= cols || head.y < 0 || head.y >= rows) {
        return endGame();
      }

      if (snake.some((s, i) => i > 0 && s.x === head.x && s.y === head.y)) {
        return endGame();
      }

      snake.unshift(head);
      movesCount++;

      if (head.x === food.x && head.y === food.y) {
        score++;
        if (score % 5 === 0) {
          level++;
          if (level > maxUnlockedLevel) {
            maxUnlockedLevel = level;
            localStorage.setItem('pokeSnakeMaxLevel', maxUnlockedLevel);
          }
          currentTickRate = Math.max(32, currentTickRate * 0.96);
        }
        updateScoreboard();
        pickFood();
        if (params.sfx) playBeep(520, 0.08);
      } else {
        snake.pop();
      }
    }

    function gameLoop(time) {
      if (!lastTime) lastTime = time;
      const dt = time - lastTime;
      lastTime = time;

      if (state === 'playing') {
        accumulator += dt;
        while (accumulator >= currentTickRate) {
          if (hasStartedMoving) update();
          accumulator -= currentTickRate;
        }
        draw();
        frameCount++;
        if (Date.now() - lastFpsTime >= 1000) {
          fps = frameCount;
          frameCount = 0;
          lastFpsTime = Date.now();
        }
        if (debugMenu.style.display === 'block') {
          debugMenu.textContent = `FPS: ${fps}\nTick: ${Math.round(currentTickRate)}ms\nLen: ${snake.length}\nMoves: ${movesCount}`;
        }
        reqAnimFrameId = requestAnimationFrame(gameLoop);
      }
    }

    function endGame() {
      cancelAnimationFrame(reqAnimFrameId);
      state = 'gameover';
      if (params.sfx) playBeep(180, 0.22);
      gameOverText.textContent = endMessages[Math.floor(Math.random() * endMessages.length)];
      finalScoreText.textContent = `Final Score: ${score} • Best: ${highScore}`;
      gameOverScreen.classList.remove('hidden');
      startPrompt.classList.add('hidden');
    }

    function updateScoreboard() {
      if (score > highScore) {
        highScore = score;
        localStorage.setItem('pokeSnakeHigh', highScore);
      }
      scoreVal.textContent = score;
      highVal.textContent = highScore;
      lvlVal.textContent = level;
    }

    function playBeep(freq, dur) {
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const gain = audioCtx.createGain();
        const osc = audioCtx.createOscillator();
        osc.type = 'sine';
        gain.gain.setValueAtTime(params.sfxVolume * 0.25, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        osc.connect(gain).connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + dur);
      } catch (e) {}
    }

    function queueDirection(nx, ny) {
      if (state !== 'playing') return;
      if (!hasStartedMoving) {
        if (params.startLength > 1 && nx === 0 && ny === 1) return;
        hasStartedMoving = true;
        startPrompt.classList.add('hidden');
        dir = {x: nx, y: ny};
        lastProcessedDir = dir;
        startTime = Date.now();
        return;
      }
      const lastDir = inputQueue.length > 0 ? inputQueue[inputQueue.length - 1] : lastProcessedDir;
      if ((nx !== -lastDir.x || ny !== -lastDir.y) && (nx !== lastDir.x || ny !== lastDir.y)) {
        if (inputQueue.length < 3) inputQueue.push({x: nx, y: ny});
      }
    }

    // Touch swipe support
    let touchStartX = 0, touchStartY = 0;
    window.addEventListener('touchstart', e => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, {passive: true});

    window.addEventListener('touchend', e => {
      if (state !== 'playing') return;
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.max(Math.abs(dx), Math.abs(dy)) < 24) return;
      if (Math.abs(dx) > Math.abs(dy)) queueDirection(dx > 0 ? 1 : -1, 0);
      else queueDirection(0, dy > 0 ? 1 : -1);
    }, {passive: true});

    document.addEventListener('keydown', e => {
      if (e.key === 'F3') {
        e.preventDefault();
        debugMenu.style.display = debugMenu.style.display === 'block' ? 'none' : 'block';
        return;
      }
      if (settingsModal.classList.contains('open') || levelModal.classList.contains('open')) return;

      const map = {
        ArrowUp: [0, -1], ArrowDown: [0, 1], ArrowLeft: [-1, 0], ArrowRight: [1, 0],
        w: [0, -1], s: [0, 1], a: [-1, 0], d: [1, 0],
        W: [0, -1], S: [0, 1], A: [-1, 0], D: [1, 0]
      };
      if (map[e.key] && state === 'playing') {
        e.preventDefault();
        queueDirection(map[e.key][0], map[e.key][1]);
      } else if (state === 'gameover' && e.key.toLowerCase() === 'r') {
        startGame();
      }
    });

    document.getElementById('btnPlayTitle').addEventListener('click', startGame);
    document.getElementById('btnRetry').addEventListener('click', startGame);
    document.getElementById('backToTitle').addEventListener('click', showMainMenu);

    document.getElementById('btnLevelTitle').addEventListener('click', () => {
      buildLevelGrid(true);
      levelModal.classList.add('open');
    });

    document.getElementById('openLevelBtn').addEventListener('click', () => {
      if (state === 'playing') cancelAnimationFrame(reqAnimFrameId);
      buildLevelGrid(false);
      levelModal.classList.add('open');
    });

    document.getElementById('closeLevelModal').addEventListener('click', () => {
      levelModal.classList.remove('open');
      if (state === 'playing') {
        lastTime = performance.now();
        reqAnimFrameId = requestAnimationFrame(gameLoop);
      }
    });

    function openSettings() {
      if (state === 'playing') cancelAnimationFrame(reqAnimFrameId);
      document.getElementById('paramSpeed').value = params.speed;
      document.getElementById('paramSfx').value = params.sfx ? 'on' : 'off';
      document.getElementById('paramAssist').value = params.assistMode ? 'on' : 'off';
      document.getElementById('paramWallMode').value = params.wallMode;
      document.getElementById('paramStartLength').value = params.startLength;
      document.getElementById('paramSfxVolume').value = params.sfxVolume;
      document.getElementById('paramHeadColor').value = params.headColor;
      document.getElementById('paramBodyColor').value = params.bodyColor;
      settingsModal.classList.add('open');
    }

    document.getElementById('btnSettingsTitle').addEventListener('click', openSettings);
    document.getElementById('settingsBtn').addEventListener('click', openSettings);

    document.getElementById('closeSettings').addEventListener('click', () => {
      settingsModal.classList.remove('open');
      if (state === 'playing') {
        lastTime = performance.now();
        reqAnimFrameId = requestAnimationFrame(gameLoop);
      }
    });

    document.getElementById('saveSettings').addEventListener('click', () => {
      params.speed = parseInt(document.getElementById('paramSpeed').value, 10);
      params.sfx = document.getElementById('paramSfx').value === 'on';
      params.assistMode = document.getElementById('paramAssist').value === 'on';
      params.wallMode = document.getElementById('paramWallMode').value;
      params.startLength = Math.max(1, Math.min(20, parseInt(document.getElementById('paramStartLength').value, 10) || 4));
      params.sfxVolume = parseFloat(document.getElementById('paramSfxVolume').value);
      params.headColor = document.getElementById('paramHeadColor').value;
      params.bodyColor = document.getElementById('paramBodyColor').value;
      settingsModal.classList.remove('open');
      if (state === 'playing') initGame();
    });

    updateScoreboard();
    showMainMenu();
  </script>
</body>
</html>
<% } %>

<% if (game === "tic-tac-toe") { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Poke Tic-Tac-Toe</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <link href="https://fonts.bunny.net/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --md-bg: #111318;
      --md-surface: #1d2026;
      --md-surface-high: #282a31;
      --md-surface-highest: #33353c;
      --md-primary: #a8c7fa;
      --md-on-primary: #062e6f;
      --md-secondary-container: #3e4759;
      --md-text: #e2e2e9;
      --md-text-muted: #c4c6d0;
      --x-color: #ffb4ab;
      --o-color: #85f8b2;
      --radius-xl: 32px;
      --radius-pill: 9999px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-tap-highlight-color: transparent; }

    body {
      background-color: var(--md-bg);
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      color: var(--md-text);
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 20px 16px;
    }

    header {
      width: 100%;
      max-width: 420px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .title-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .back-pill {
      text-decoration: none;
      color: var(--md-text);
      background: var(--md-surface-high);
      padding: 10px 16px;
      border-radius: var(--radius-pill);
      font-size: 0.85rem;
      font-weight: 700;
    }

    h1 {
      font-size: 1.35rem;
      font-weight: 800;
    }

    .icon-btn {
      background: var(--md-surface-high);
      border: none;
      color: var(--md-text);
      height: 42px;
      padding: 0 16px;
      border-radius: var(--radius-pill);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .score-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      width: 100%;
      max-width: 420px;
      margin-bottom: 16px;
    }

    .score-card {
      background: var(--md-surface);
      padding: 14px;
      border-radius: 22px;
      text-align: center;
    }

    .score-card span {
      display: block;
      font-size: 0.78rem;
      color: var(--md-text-muted);
      font-weight: 600;
      margin-bottom: 4px;
    }

    .score-card strong {
      font-size: 1.35rem;
      font-weight: 800;
    }

    .turn-banner {
      background: var(--md-surface-high);
      color: var(--md-primary);
