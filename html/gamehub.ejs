<script>
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playSound(type) {
  if (audioCtx.state === 'suspended') audioCtx.resume();
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  const now = audioCtx.currentTime;

  if (type === 'move') {
    osc.type = 'sine';
    osc.frequency.setValueAtTime(320, now);
    osc.frequency.exponentialRampToValueAtTime(640, now + 0.08);
    gain.gain.setValueAtTime(0.08, now);
    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
    osc.start(now); osc.stop(now + 0.08);
  } else if (type === 'win') {
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(440, now);
    osc.frequency.setValueAtTime(554, now + 0.1);
    osc.frequency.setValueAtTime(659, now + 0.2);
    gain.gain.setValueAtTime(0.1, now);
    gain.gain.linearRampToValueAtTime(0, now + 0.5);
    osc.start(now); osc.stop(now + 0.5);
  } else if (type === 'draw') {
    osc.type = 'sine';
    osc.frequency.setValueAtTime(240, now);
    osc.frequency.linearRampToValueAtTime(140, now + 0.25);
    gain.gain.setValueAtTime(0.08, now);
    gain.gain.linearRampToValueAtTime(0, now + 0.25);
    osc.start(now); osc.stop(now + 0.25);
  }
}

class TicTacToe {
  constructor() {
    this.settings = {
      mode: 'pvc',
      difficulty: 'hard',
      playerStart: 'X',
      theme: '#ffb0cd',
      size: 3,
      winLen: 3,
      symX: 'X',
      symO: 'O'
    };

    this.scores = { X: 0, O: 0 };
    this.gridEl = document.getElementById('game-grid');
    this.statusEl = document.getElementById('status-msg');
    this.scoreEl = document.getElementById('score-display');
    this.canvas = document.getElementById('overlay-canvas');
    this.ctx = this.canvas.getContext('2d');

    this.resizeCanvas();
    window.addEventListener('resize', () => this.resizeCanvas());

    this.startNewGame();
  }

  generateWinCombos(n, k) {
    const combos = [];
    for (let r = 0; r < n; r++) {
      for (let c = 0; c <= n - k; c++) {
        const line = [];
        for (let i = 0; i < k; i++) line.push(r * n + (c + i));
        combos.push(line);
      }
    }
    for (let c = 0; c < n; c++) {
      for (let r = 0; r <= n - k; r++) {
        const line = [];
        for (let i = 0; i < k; i++) line.push((r + i) * n + c);
        combos.push(line);
      }
    }
    for (let r = 0; r <= n - k; r++) {
      for (let c = 0; c <= n - k; c++) {
        const line1 = [], line2 = [];
        for (let i = 0; i < k; i++) {
          line1.push((r + i) * n + (c + i));
          line2.push((r + i) * n + (c + k - 1 - i));
        }
        combos.push(line1, line2);
      }
    }
    return combos;
  }

  resizeCanvas() {
    const rect = document.getElementById('board-container').getBoundingClientRect();
    this.canvas.width = rect.width - 32;
    this.canvas.height = rect.height - 32;
    if (!this.gameActive && this.lastWinCombo) this.drawWinLine(this.lastWinCombo);
  }

  initBoard() {
    const n = this.settings.size;
    this.gridEl.style.gridTemplateColumns = `repeat(${n}, 1fr)`;
    this.gridEl.style.gridTemplateRows = `repeat(${n}, 1fr)`;
    this.gridEl.innerHTML = '';
    for (let i = 0; i < n * n; i++) {
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.style.fontSize = n === 3 ? '2.8rem' : n === 4 ? '2.1rem' : '1.6rem';
      cell.onclick = () => this.handleCellClick(i);
      this.gridEl.appendChild(cell);
    }
  }

  labelFor(p) {
    return p === 'X' ? this.settings.symX : this.settings.symO;
  }

  startNewGame() {
    const n = this.settings.size;
    this.winCombos = this.generateWinCombos(n, this.settings.winLen);
    this.board = Array(n * n).fill('');
    this.history = [];
    this.gameActive = true;
    this.currentPlayer = 'X';
    this.lastWinCombo = null;
    this.isAiThinking = false;
    if (this.aiTimeout) clearTimeout(this.aiTimeout);

    this.initBoard();
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    this.updateScoreboard();
    this.statusEl.innerText = `Player ${this.labelFor(this.currentPlayer)} Turn`;

    if (this.settings.mode === 'pvc') {
      this.humanPlayer = this.settings.playerStart;
      this.aiPlayer = this.humanPlayer === 'X' ? 'O' : 'X';

      if (this.currentPlayer === this.aiPlayer) {
        this.isAiThinking = true;
        this.aiTimeout = setTimeout(() => this.makeAiMove(), 400);
      }
    }
  }

  handleCellClick(index) {
    if (!this.gameActive || this.board[index] !== '' || this.isAiThinking) return;
    if (this.settings.mode === 'pvc' && this.currentPlayer !== this.humanPlayer) return;

    this.makeMove(index, this.currentPlayer);

    if (this.gameActive && this.settings.mode === 'pvc') {
      this.isAiThinking = true;
      this.aiTimeout = setTimeout(() => this.makeAiMove(), 420);
    }
  }

  makeMove(index, player) {
    this.history.push({ board: [...this.board], player: this.currentPlayer });
    this.board[index] = player;

    const cell = this.gridEl.children[index];
    cell.classList.add('taken');
    const span = document.createElement('span');
    span.innerText = this.labelFor(player);
    span.className = player === 'X' ? 'x-mark' : 'o-mark';
    cell.appendChild(span);

    playSound('move');

    const winCombo = this.findWinCombo(this.board);
    if (winCombo) {
      this.gameActive = false;
      this.scores[player]++;
      this.updateScoreboard();
      this.statusEl.innerText = `Player ${this.labelFor(player)} Wins!`;
      this.drawWinLine(winCombo);
      playSound('win');
      confettiExplosion();
      this.isAiThinking = false;
      return;
    }

    if (!this.board.includes('')) {
      this.gameActive = false;
      this.statusEl.innerText = "It's a Draw!";
      playSound('draw');
      this.isAiThinking = false;
      return;
    }

    this.currentPlayer = player === 'X' ? 'O' : 'X';
    this.statusEl.innerText = `Player ${this.labelFor(this.currentPlayer)} Turn`;
  }

  findWinCombo(b) {
    for (const combo of this.winCombos) {
      const first = b[combo[0]];
      if (first && combo.every(idx => b[idx] === first)) return combo;
    }
    return null;
  }

  evaluateHeuristic(b, aiP, huP) {
    let score = 0;
    for (const combo of this.winCombos) {
      let aiCount = 0, huCount = 0;
      for (const idx of combo) {
        if (b[idx] === aiP) aiCount++;
        else if (b[idx] === huP) huCount++;
      }
      if (aiCount > 0 && huCount === 0) score += Math.pow(10, aiCount);
      else if (huCount > 0 && aiCount === 0) score -= Math.pow(10, huCount);
    }
    return score;
  }

  makeAiMove() {
    if (!this.gameActive) return;
    const moveIndex = this.computeBestMove([...this.board], this.settings.difficulty, this.aiPlayer, this.humanPlayer);
    if (moveIndex !== -1) {
      this.makeMove(moveIndex, this.aiPlayer);
    }
    this.isAiThinking = false;
  }

  computeBestMove(b, diff, aiP, huP) {
    const empty = [];
    for (let i = 0; i < b.length; i++) if (b[i] === '') empty.push(i);
    if (empty.length === 0) return -1;

    for (const idx of empty) {
      b[idx] = aiP;
      if (this.findWinCombo(b)) { b[idx] = ''; return idx; }
      b[idx] = '';
    }
    for (const idx of empty) {
      b[idx] = huP;
      if (this.findWinCombo(b)) { b[idx] = ''; return idx; }
      b[idx] = '';
    }

    if (diff === 'easy' && Math.random() < 0.7) {
      return empty[Math.floor(Math.random() * empty.length)];
    }
    if (diff === 'medium' && Math.random() < 0.3) {
      return empty[Math.floor(Math.random() * empty.length)];
    }

    const maxDepth = this.settings.size === 3 ? 9 : 3;
    let bestScore = -Infinity;
    let bestMoves = [empty[0]];

    for (const idx of empty) {
      b[idx] = aiP;
      const score = this.minimax(b, 0, false, aiP, huP, -Infinity, Infinity, maxDepth);
      b[idx] = '';
      if (score > bestScore) {
        bestScore = score;
        bestMoves = [idx];
      } else if (score === bestScore) {
        bestMoves.push(idx);
      }
    }
    return bestMoves[Math.floor(Math.random() * bestMoves.length)];
  }

  minimax(b, depth, isMax, aiP, huP, alpha, beta, maxDepth) {
    const win = this.findWinCombo(b);
    if (win) return b[win[0]] === aiP ? (10000 - depth) : (depth - 10000);
    if (!b.includes('')) return 0;
    if (depth >= maxDepth) return this.evaluateHeuristic(b, aiP, huP);

    if (isMax) {
      let best = -Infinity;
      for (let i = 0; i < b.length; i++) {
        if (b[i] !== '') continue;
        b[i] = aiP;
        best = Math.max(best, this.minimax(b, depth + 1, false, aiP, huP, alpha, beta, maxDepth));
        b[i] = '';
        alpha = Math.max(alpha, best);
        if (beta <= alpha) break;
      }
      return best;
    } else {
      let best = Infinity;
      for (let i = 0; i < b.length; i++) {
        if (b[i] !== '') continue;
        b[i] = huP;
        best = Math.min(best, this.minimax(b, depth + 1, true, aiP, huP, alpha, beta, maxDepth));
        b[i] = '';
        beta = Math.min(beta, best);
        if (beta <= alpha) break;
      }
      return best;
    }
  }

  undo() {
    if (this.history.length === 0 || !this.gameActive) return;
    if (this.aiTimeout) clearTimeout(this.aiTimeout);
    this.isAiThinking = false;

    let steps = 1;
    if (this.settings.mode === 'pvc' && this.currentPlayer === this.humanPlayer && this.history.length >= 2) {
      steps = 2;
    }

    const prevState = this.history[this.history.length - steps];
    this.history = this.history.slice(0, this.history.length - steps);
    this.board = [...prevState.board];
    this.currentPlayer = prevState.player;

    Array.from(this.gridEl.children).forEach((cell, i) => {
      cell.innerHTML = '';
      cell.classList.remove('taken');
      const val = this.board[i];
      if (val) {
        cell.classList.add('taken');
        const span = document.createElement('span');
        span.innerText = this.labelFor(val);
        span.className = val === 'X' ? 'x-mark' : 'o-mark';
        cell.appendChild(span);
      }
    });

    this.statusEl.innerText = `Player ${this.labelFor(this.currentPlayer)} Turn`;
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    this.gameActive = true;
    this.lastWinCombo = null;
  }

  drawWinLine(combo) {
    if (!combo) return;
    this.lastWinCombo = combo;
    const n = this.settings.size;
    const a = combo[0], c = combo[combo.length - 1];
    const cellW = this.canvas.width / n;
    const cellH = this.canvas.height / n;
    const getCenter = (idx) => ({
      x: (idx % n) * cellW + cellW / 2,
      y: Math.floor(idx / n) * cellH + cellH / 2
    });
    const start = getCenter(a);
    const end = getCenter(c);

    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    this.ctx.beginPath();
    this.ctx.strokeStyle = this.settings.theme;
    this.ctx.lineWidth = 10;
    this.ctx.lineCap = 'round';
    this.ctx.moveTo(start.x, start.y);
    this.ctx.lineTo(end.x, end.y);
    this.ctx.stroke();
  }

  updateScoreboard() {
    this.scoreEl.innerText = `${this.labelFor('X')}: ${this.scores.X} | ${this.labelFor('O')}: ${this.scores.O}`;
  }
}

const game = new TicTacToe();

document.getElementById('btn-reset').onclick = () => game.startNewGame();
document.getElementById('btn-undo').onclick = () => game.undo();
document.getElementById('settings-btn').onclick = () => document.getElementById('settings-modal').style.display = 'flex';
document.getElementById('btn-cancel').onclick = () => document.getElementById('settings-modal').style.display = 'none';

document.getElementById('btn-save').onclick = () => {
  game.settings.mode = document.getElementById('set-mode').value;
  game.settings.difficulty = document.getElementById('set-difficulty').value;
  game.settings.playerStart = document.getElementById('set-starter').value;
  game.settings.theme = document.getElementById('set-color').value;
  const [sz, wl] = document.getElementById('set-size').value.split('-').map(Number);
  game.settings.size = sz;
  game.settings.winLen = wl;
  game.settings.symX = document.getElementById('set-sym-x').value.trim() || 'X';
  game.settings.symO = document.getElementById('set-sym-o').value.trim() || 'O';

  document.documentElement.style.setProperty('--primary', game.settings.theme);

  game.scores = { X: 0, O: 0 };
  game.startNewGame();
  document.getElementById('settings-modal').style.display = 'none';
};

window.onclick = (e) => {
  if (e.target.className === 'modal') e.target.style.display = 'none';
};

function confettiExplosion() {
  const canvas = document.getElementById('confetti-canvas');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  const particles = [];
  const colors = [game.settings.theme, '#fff', '#ffdf9e', '#ff80ab'];
  for (let i = 0; i < 90; i++) {
    particles.push({
      x: canvas.width / 2, y: canvas.height / 2,
      vx: (Math.random() - 0.5) * 14, vy: (Math.random() - 0.5) * 14,
      life: 90,
      color: colors[Math.floor(Math.random() * colors.length)],
      size: Math.random() * 6 + 3
    });
  }
  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    let active = false;
    particles.forEach(p => {
      if (p.life > 0) {
        p.x += p.vx; p.y += p.vy; p.vy += 0.2; p.life--;
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size / 2, 0, Math.PI * 2);
        ctx.fill();
        active = true;
      }
    });
    if (active) requestAnimationFrame(animate);
  }
  animate();
}
</script>
</body>
</html>
<% } %>


