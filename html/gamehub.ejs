<script>
class SudokuToolbox {
  static isValid(board, row, col, num) {
    for (let x = 0; x < 9; x++) {
      if (board[row][x] === num || board[x][col] === num) return false;
      const boxRow = 3 * Math.floor(row / 3) + Math.floor(x / 3);
      const boxCol = 3 * Math.floor(col / 3) + x % 3;
      if (board[boxRow][boxCol] === num) return false;
    }
    return true;
  }

  static solve(board) {
    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        if (board[r][c] === 0) {
          for (let n = 1; n <= 9; n++) {
            if (this.isValid(board, r, c, n)) {
              board[r][c] = n;
              if (this.solve(board)) return true;
              board[r][c] = 0;
            }
          }
          return false;
        }
      }
    }
    return true;
  }

  static generate(difficulty) {
    let board = Array.from({ length: 9 }, () => Array(9).fill(0));
    for (let i = 0; i < 9; i += 3) this.fillBox(board, i, i);
    this.solve(board);
    const solution = board.map(row => [...row]);

    let attempts = difficulty === 'easy' ? 32 : difficulty === 'medium' ? 44 : 54;
    while (attempts > 0) {
      let r = Math.floor(Math.random() * 9);
      let c = Math.floor(Math.random() * 9);
      if (board[r][c] !== 0) {
        board[r][c] = 0;
        attempts--;
      }
    }
    return { initial: board, solution: solution };
  }

  static fillBox(board, row, col) {
    let num;
    for (let i = 0; i < 3; i++) {
      for (let j = 0; j < 3; j++) {
        do {
          num = Math.floor(Math.random() * 9) + 1;
        } while (!this.isSafeInBox(board, row, col, num));
        board[row + i][col + j] = num;
      }
    }
  }

  static isSafeInBox(board, row, col, num) {
    for (let i = 0; i < 3; i++)
      for (let j = 0; j < 3; j++)
        if (board[row + i][col + j] === num) return false;
    return true;
  }
}

class Game {
  constructor() {
    this.boardState = [];
    this.solution = [];
    this.initialState = [];
    this.notes = [];
    this.history = [];

    this.selected = { r: -1, c: -1 };
    this.isNoteMode = false;
    this.hintsRemaining = 3;
    this.timer = 0;
    this.timerInterval = null;
    this.difficulty = 'medium';
    this.settings = { showTimer: true, color: '#ffb0cd' };

    this.gridEl = document.getElementById('sudoku-grid');
    this.timerEl = document.getElementById('timer');
    this.noteBtn = document.getElementById('btn-note');
    this.hintBtn = document.getElementById('btn-hint');
    this.numpadEl = document.getElementById('numpad');

    this.initNumpad();
    this.setupEventListeners();
  }

  initNumpad() {
    this.numpadEl.innerHTML = '';
    for (let n = 1; n <= 9; n++) {
      const btn = document.createElement('button');
      btn.className = 'num-btn';
      btn.innerHTML = `<span>${n}</span><span class="num-rem" id="rem-${n}">9</span>`;
      btn.onclick = () => this.handleInput(n);
      this.numpadEl.appendChild(btn);
    }
  }

  startNewGame(difficulty = this.difficulty) {
    this.difficulty = difficulty;
    document.getElementById('difficulty-display').innerText = difficulty === 'medium' ? 'Normal' : difficulty;

    const data = SudokuToolbox.generate(difficulty);
    this.initialState = data.initial.map(row => [...row]);
    this.boardState = data.initial.map(row => [...row]);
    this.solution = data.solution;

    this.notes = Array.from({length: 9}, () => Array.from({length: 9}, () => new Set()));
    this.history = [];
    this.hintsRemaining = 3;
    this.updateHintButton();

    this.selected = { r: 0, c: 0 };
    this.resetTimer();
    this.renderBoard();
    this.selectCell(0, 0);
  }

  updateHintButton() {
    this.hintBtn.textContent = `💡 Hint (${this.hintsRemaining})`;
    this.hintBtn.disabled = this.hintsRemaining <= 0;
  }

  useHint() {
    if (this.hintsRemaining <= 0) return;

    let targetR = this.selected.r;
    let targetC = this.selected.c;

    if (targetR === -1 || this.boardState[targetR][targetC] === this.solution[targetR][targetC]) {
      const unfilled = [];
      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (this.boardState[r][c] !== this.solution[r][c]) unfilled.push({ r, c });
        }
      }
      if (unfilled.length === 0) return;
      const pick = unfilled[Math.floor(Math.random() * unfilled.length)];
      targetR = pick.r;
      targetC = pick.c;
    }

    this.saveToHistory();
    const correctNum = this.solution[targetR][targetC];
    this.boardState[targetR][targetC] = correctNum;
    this.notes[targetR][targetC].clear();
    this.prunePeerNotes(targetR, targetC, correctNum);

    this.hintsRemaining--;
    this.updateHintButton();
    this.renderBoard();
    this.selectCell(targetR, targetC);
    this.checkWin();
  }

  renderBoard() {
    this.gridEl.innerHTML = '';
    const counts = Array(10).fill(0);

    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        const cell = document.createElement('div');
        const val = this.boardState[r][c];
        const isGiven = this.initialState[r][c] !== 0;

        cell.className = 'cell';
        if (isGiven) cell.classList.add('given');
        else if (val !== 0) cell.classList.add('user-val');

        if (val !== 0) {
          cell.textContent = val;
          if (val === this.solution[r][c]) counts[val]++;
          else cell.classList.add('error');
        } else {
          const noteContainer = document.createElement('div');
          noteContainer.className = 'notes-grid';
          const cellNotes = this.notes[r][c];
          if(cellNotes.size > 0) {
            for(let n = 1; n <= 9; n++) {
              const span = document.createElement('span');
              span.className = 'note-num';
              span.textContent = cellNotes.has(n) ? n : '';
              noteContainer.appendChild(span);
            }
          }
          cell.appendChild(noteContainer);
        }

        cell.onclick = () => this.selectCell(r, c);
        this.gridEl.appendChild(cell);
      }
    }

    for (let n = 1; n <= 9; n++) {
      const rem = Math.max(0, 9 - counts[n]);
      const remEl = document.getElementById(`rem-${n}`);
      if (remEl) {
        remEl.textContent = rem;
        remEl.parentElement.classList.toggle('completed', rem === 0);
      }
    }
  }

  selectCell(r, c) {
    this.selected = { r, c };
    this.highlightBoard();
  }

  highlightBoard() {
    const cells = Array.from(this.gridEl.children);
    const { r, c } = this.selected;
    const selectedVal = (r !== -1 && this.boardState[r][c]) ? this.boardState[r][c] : null;

    cells.forEach((cell, idx) => {
      const cr = Math.floor(idx / 9);
      const cc = idx % 9;

      cell.classList.remove('selected', 'highlighted', 'same-number');

      if (cr === r && cc === c) {
        cell.classList.add('selected');
      } else if (r !== -1 && (cr === r || cc === c ||
               (Math.floor(cr/3) === Math.floor(r/3) && Math.floor(cc/3) === Math.floor(c/3)))) {
        cell.classList.add('highlighted');
      }

      if (selectedVal && this.boardState[cr][cc] === selectedVal && !(cr === r && cc === c)) {
        cell.classList.add('same-number');
      }
    });
  }

  prunePeerNotes(r, c, num) {
    for (let i = 0; i < 9; i++) {
      this.notes[r][i].delete(num);
      this.notes[i][c].delete(num);
      const br = 3 * Math.floor(r / 3) + Math.floor(i / 3);
      const bc = 3 * Math.floor(c / 3) + (i % 3);
      this.notes[br][bc].delete(num);
    }
  }

  handleInput(num) {
    if (this.selected.r === -1) return;
    const { r, c } = this.selected;

    if (this.initialState[r][c] !== 0) return;

    this.saveToHistory();

    if (this.isNoteMode) {
      const cellNotes = this.notes[r][c];
      if (cellNotes.has(num)) cellNotes.delete(num);
      else cellNotes.add(num);
      this.renderBoard();
      this.selectCell(r, c);
    } else {
      if (this.boardState[r][c] === num) return;

      this.boardState[r][c] = num;
      if (num === this.solution[r][c]) {
        this.notes[r][c].clear();
        this.prunePeerNotes(r, c, num);
      }

      this.renderBoard();
      this.selectCell(r, c);
      this.checkWin();
    }
  }

  clearCell() {
    if (this.selected.r === -1) return;
    const { r, c } = this.selected;
    if (this.initialState[r][c] !== 0) return;

    this.saveToHistory();
    this.boardState[r][c] = 0;
    this.notes[r][c].clear();
    this.renderBoard();
    this.selectCell(r, c);
  }

  moveSelection(dr, dc) {
    let { r, c } = this.selected;
    if (r === -1) { r = 0; c = 0; }
    else {
      r = Math.max(0, Math.min(8, r + dr));
      c = Math.max(0, Math.min(8, c + dc));
    }
    this.selectCell(r, c);
  }

  toggleNoteMode() {
    this.isNoteMode = !this.isNoteMode;
    this.noteBtn.textContent = this.isNoteMode ? "✎ Note: ON" : "✎ Note: OFF";
    this.noteBtn.classList.toggle('active', this.isNoteMode);
  }

  saveToHistory() {
    const state = {
      board: this.boardState.map(row => [...row]),
      notes: this.notes.map(row => row.map(set => new Set(set)))
    };
    this.history.push(state);
    if(this.history.length > 30) this.history.shift();
  }

  undo() {
    if (this.history.length === 0) return;
    const prev = this.history.pop();
    this.boardState = prev.board;
    this.notes = prev.notes;
    this.renderBoard();
    if (this.selected.r !== -1) this.selectCell(this.selected.r, this.selected.c);
  }

  checkWin() {
    for(let r = 0; r < 9; r++)
      for(let c = 0; c < 9; c++)
        if(this.boardState[r][c] !== this.solution[r][c]) return;

    clearInterval(this.timerInterval);
    document.getElementById('win-time').textContent = `Time: ${this.timerEl.textContent}`;
    document.getElementById('modal-win').style.display = 'flex';
    confettiExplosion();
  }

  resetTimer() {
    clearInterval(this.timerInterval);
    this.timer = 0;
    this.timerEl.textContent = "00:00";
    if (this.settings.showTimer) {
      this.timerInterval = setInterval(() => {
        this.timer++;
        const m = String(Math.floor(this.timer / 60)).padStart(2, '0');
        const s = String(this.timer % 60).padStart(2, '0');
        this.timerEl.textContent = `${m}:${s}`;
      }, 1000);
    }
  }

  updateSettings() {
    const color = document.getElementById('set-color').value;
    const showTimer = document.getElementById('set-timer').checked;
    const diff = document.getElementById('set-difficulty').value;

    document.documentElement.style.setProperty('--primary', color);
    document.documentElement.style.setProperty('--selected', color);

    this.settings.showTimer = showTimer;
    if (!showTimer) {
      clearInterval(this.timerInterval);
      this.timerInterval = null;
      this.timerEl.textContent = "--:--";
    } else if (!this.timerInterval) {
      this.resetTimer();
    }

    if(diff !== this.difficulty) {
      this.startNewGame(diff);
    }
  }

  setupEventListeners() {
    document.addEventListener('keydown', (e) => {
      if (['ArrowUp', 'w'].includes(e.key)) { e.preventDefault(); this.moveSelection(-1, 0); }
      else if (['ArrowDown', 's'].includes(e.key)) { e.preventDefault(); this.moveSelection(1, 0); }
      else if (['ArrowLeft', 'a'].includes(e.key)) { e.preventDefault(); this.moveSelection(0, -1); }
      else if (['ArrowRight', 'd'].includes(e.key)) { e.preventDefault(); this.moveSelection(0, 1); }
      else if (['Backspace', 'Delete'].includes(e.key)) this.clearCell();
      else if (['n', 'N'].includes(e.key)) this.toggleNoteMode();
      else if (['h', 'H'].includes(e.key)) this.useHint();
      else if (['u', 'U'].includes(e.key)) this.undo();
      else if (!isNaN(parseInt(e.key)) && e.key !== '0') this.handleInput(parseInt(e.key));
    });

    document.getElementById('btn-note').onclick = () => this.toggleNoteMode();
    document.getElementById('btn-hint').onclick = () => this.useHint();
    document.getElementById('btn-undo').onclick = () => this.undo();
    document.getElementById('btn-erase').onclick = () => this.clearCell();
    document.getElementById('btn-new').onclick = () => this.startNewGame();

    document.getElementById('btn-settings').onclick = () => document.getElementById('modal-settings').style.display = 'flex';
    document.getElementById('btn-save-settings').onclick = () => {
      this.updateSettings();
      document.getElementById('modal-settings').style.display = 'none';
    };

    document.getElementById('btn-help').onclick = () => document.getElementById('modal-help').style.display = 'flex';

    document.getElementById('btn-play-again').onclick = () => {
      document.getElementById('modal-win').style.display = 'none';
      this.startNewGame();
    };

    window.onclick = (e) => {
      if (e.target.classList.contains('modal')) e.target.style.display = 'none';
    };
  }
}

function confettiExplosion() {
  const canvas = document.getElementById('confetti');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  const particles = [];
  const colors = ['#ffb0cd', '#ffdf9e', '#fff', '#ff80ab'];

  for(let i = 0; i < 120; i++) {
    particles.push({
      x: canvas.width / 2,
      y: canvas.height / 2,
      r: Math.random() * 5 + 2,
      dx: Math.random() * 10 - 5,
      dy: Math.random() * 10 - 5,
      color: colors[Math.floor(Math.random() * colors.length)],
      life: 100
    });
  }

  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach((p, index) => {
      p.x += p.dx;
      p.y += p.dy;
      p.life--;
      p.dy += 0.12;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
      if(p.life <= 0) particles.splice(index, 1);
    });
    if(particles.length > 0) requestAnimationFrame(animate);
  }
  animate();
}

const game = new Game();
game.startNewGame();
</script>
</body>
</html>
<% } %>


