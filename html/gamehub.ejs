  <script>
    (function initLibrary(){
      const cards = document.querySelectorAll('.game');
      const navBtns = document.querySelectorAll('.nav-item');
      const searchInput = document.getElementById('gameSearch');
      let currentCat = 'all';

      const slides = document.querySelectorAll('.overview-slide');
      const dots = document.querySelectorAll('.slider-dot');
      let activeSlide = 0;
      let slideTimer = null;

      function showSlide(idx) {
        activeSlide = (idx + slides.length) % slides.length;
        slides.forEach((s, i) => s.classList.toggle('active', i === activeSlide));
        dots.forEach((d, i) => d.classList.toggle('active', i === activeSlide));
      }

      function resetSlideTimer() {
        clearInterval(slideTimer);
        slideTimer = setInterval(() => showSlide(activeSlide + 1), 6000);
      }

      document.getElementById('prevSlide').addEventListener('click', () => {
        showSlide(activeSlide - 1);
        resetSlideTimer();
      });
      document.getElementById('nextSlide').addEventListener('click', () => {
        showSlide(activeSlide + 1);
        resetSlideTimer();
      });
      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          showSlide(parseInt(dot.dataset.goto, 10));
          resetSlideTimer();
        });
      });
      resetSlideTimer();

      function filterGames() {
        const q = searchInput.value.toLowerCase().trim();
        cards.forEach(card => {
          const cat = card.dataset.cat;
          const title = card.querySelector('.title').textContent.toLowerCase();
          const sub = card.querySelector('.subtitle').textContent.toLowerCase();
          const matchCat = currentCat === 'all' || cat === currentCat;
          const matchQ = !q || title.includes(q) || sub.includes(q);
          card.style.display = (matchCat && matchQ) ? 'flex' : 'none';
        });
      }

      navBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          navBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentCat = btn.dataset.filter;
          filterGames();
        });
      });

      searchInput.addEventListener('input', filterGames);

      function openModal(modal){
        modal.classList.remove('hidden');
        modal.querySelector('.close-info')?.focus();
      }
      function closeModal(modal){
        modal.classList.add('hidden');
      }

      cards.forEach(card => {
        const infoBtn = card.querySelector('.info-btn');
        const modal  = card.querySelector('.info-modal');
        const closeBtn = card.querySelector('.close-info');

        infoBtn.addEventListener('click', (e)=>{
          e.preventDefault();
          e.stopPropagation();
          openModal(modal);
        }, { passive:false });

        closeBtn.addEventListener('click', (e)=>{
          e.preventDefault();
          e.stopPropagation();
          closeModal(modal);
          infoBtn.focus();
        });

        modal.addEventListener('click', (e)=>{
          if(e.target === modal){
            e.preventDefault();
            e.stopPropagation();
            closeModal(modal);
            infoBtn.focus();
          }
        });

        document.addEventListener('keydown', (e)=>{
          if(e.key === 'Escape' && !modal.classList.contains('hidden')){
            closeModal(modal);
            infoBtn.focus();
          }
        });

        card.addEventListener('keydown', (e)=>{
          if(!modal.classList.contains('hidden')) return;
          if(e.code === 'Enter' || e.code === 'Space'){
            e.preventDefault();
            const href = card.getAttribute('href');
            if(href) window.location.assign(href);
          }
        });
      });
    })();
  </script>
</body>
</html>
<% } %>


