    <div class="overlay" id="ovStart">
      <h2>Ping-Pong</h2>
      <p>Deflect the ball and angle shots with paddle motion. Fast edge hits trigger a high-speed smash.</p>
      <div class="pill-group">
        <button class="btn btn-primary" id="btnStart">Start Match</button>
      </div>
    </div>

    <div class="overlay hidden" id="ovOver">
      <h2 id="winnerTitle">Player 1 Wins</h2>
      <p id="winnerSub">Final Score: 11 - 0</p>
      <button class="btn btn-primary" id="btnRematch">Play Again</button>
    </div>
  </div>

  <div class="hint">Left Paddle: W / S or Mouse / Touch &bull; Right Paddle (2P): Up / Down Arrows</div>

  <script>
    const cv = document.getElementById('canvas');
    const cx = cv.getContext('2d');
    const W = 800, H = 600;

    let state = 'menu';
    let keys = {};
    let pointerLeftY = null;
    let pointerRightY = null;
    let p1 = { x: 26, y: 250, w: 12, h: 96, vy: 0, prevY: 250, score: 0 };
    let p2 = { x: 762, y: 250, w: 12, h: 96, vy: 0, prevY: 250, score: 0 };
    let ball = { x: 400, y: 300, vx: 6, vy: 2, r: 7, speed: 6.5, smash: false };
    let trail = [];
    let serveFreeze = 0;
    let audioCtx = null;

    function beep(freq, dur, type = 'sine') {
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const o = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        o.type = type;
        o.frequency.setValueAtTime(freq, audioCtx.currentTime);
        g.gain.setValueAtTime(0.06, audioCtx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
        o.connect(g).connect(audioCtx.destination);
        o.start();
        o.stop(audioCtx.currentTime + dur);
      } catch (e) {}
    }

    function serve(dir) {
      ball.x = W / 2;
      ball.y = H / 2;
      ball.speed = 6.5;
      ball.smash = false;
      const angle = (Math.random() - 0.5) * 0.6;
      ball.vx = dir * ball.speed * Math.cos(angle);
      ball.vy = ball.speed * Math.sin(angle);
      if (Math.abs(ball.vy) < 1.5) ball.vy = (ball.vy >= 0 ? 1 : -1) * 1.6;
      trail = [];
      serveFreeze = 32;
    }

    function startMatch() {
      p1.score = 0;
      p2.score = 0;
      p1.y = 252;
      p2.y = 252;
      serve(1);
      document.getElementById('ovStart').classList.add('hidden');
      document.getElementById('ovOver').classList.add('hidden');
      state = 'playing';
    }

    function checkPaddle(pad, dir) {
      if (dir === 1 && ball.vx > 0) return;
      if (dir === -1 && ball.vx < 0) return;

      if (ball.x - ball.r < pad.x + pad.w &&
          ball.x + ball.r > pad.x &&
          ball.y + ball.r > pad.y &&
          ball.y - ball.r < pad.y + pad.h) {
        const rel = (ball.y - (pad.y + pad.h / 2)) / (pad.h / 2);
        const clamped = Math.max(-1, Math.min(1, rel));
        let angle = clamped * (Math.PI / 3.2) + pad.vy * 0.025;
        angle = Math.max(-Math.PI / 2.8, Math.min(Math.PI / 2.8, angle));

        const smash = Math.abs(pad.vy) > 4.5 && Math.abs(clamped) > 0.35;
        ball.speed = Math.min(13.5, ball.speed + (smash ? 1.2 : 0.35));
        ball.smash = smash;

        ball.vx = dir * ball.speed * Math.cos(angle);
        ball.vy = ball.speed * Math.sin(angle);
        ball.x = dir === 1 ? pad.x + pad.w + ball.r : pad.x - ball.r;
        beep(smash ? 660 : 440, 0.07, smash ? 'sawtooth' : 'triangle');
      }
    }

    function updateAI() {
      const diff = document.getElementById('selDiff').value;
      const maxSpeed = diff === 'easy' ? 4.2 : diff === 'medium' ? 6.0 : 8.2;
      const center = p2.y + p2.h / 2;
      let target = H / 2;

      if (ball.vx > 0) {
        let sx = ball.x, sy = ball.y, svy = ball.vy;
        let steps = 0;
        while (sx < p2.x && steps < 180) {
          sx += ball.vx;
          sy += svy;
          if (sy <= ball.r || sy >= H - ball.r) svy *= -1;
          steps++;
        }
        target = diff === 'easy' ? ball.y : sy;
      }

      const delta = target - center;
      if (Math.abs(delta) > 6) {
        p2.y += Math.sign(delta) * Math.min(Math.abs(delta), maxSpeed);
      }
    }

    function update() {
      if (state !== 'playing') return;

      const speed = 7.5;
      if (keys['w'] || keys['W']) p1.y -= speed;
      else if (keys['s'] || keys['S']) p1.y += speed;
      else if (pointerLeftY !== null) {
        const d = pointerLeftY - (p1.y + p1.h / 2);
        p1.y += Math.sign(d) * Math.min(Math.abs(d), speed + 2);
      }

      const mode = document.getElementById('selMode').value;
      if (mode === 'pvp') {
        if (keys['ArrowUp']) p2.y -= speed;
        else if (keys['ArrowDown']) p2.y += speed;
        else if (pointerRightY !== null) {
          const d = pointerRightY - (p2.y + p2.h / 2);
          p2.y += Math.sign(d) * Math.min(Math.abs(d), speed + 2);
        }
      } else {
        updateAI();
      }

      p1.y = Math.max(10, Math.min(H - p1.h - 10, p1.y));
      p2.y = Math.max(10, Math.min(H - p2.h - 10, p2.y));

      p1.vy = p1.y - p1.prevY;
      p2.vy = p2.y - p2.prevY;
      p1.prevY = p1.y;
      p2.prevY = p2.y;

      if (serveFreeze > 0) {
        serveFreeze--;
        return;
      }

      ball.x += ball.vx;
      ball.y += ball.vy;

      if (ball.y - ball.r <= 0) {
        ball.y = ball.r;
        ball.vy = Math.abs(ball.vy);
        beep(260, 0.04);
      } else if (ball.y + ball.r >= H) {
        ball.y = H - ball.r;
        ball.vy = -Math.abs(ball.vy);
        beep(260, 0.04);
      }

      checkPaddle(p1, 1);
      checkPaddle(p2, -1);

      trail.push({ x: ball.x, y: ball.y });
      if (trail.length > 12) trail.shift();

      const targetScore = parseInt(document.getElementById('selTarget').value, 10);
      if (ball.x < -20) {
        p2.score++;
        beep(320, 0.15);
        if (p2.score >= targetScore) endMatch(mode === 'pvc' ? 'CPU Wins' : 'Player 2 Wins');
        else serve(-1);
      } else if (ball.x > W + 20) {
        p1.score++;
        beep(520, 0.15);
        if (p1.score >= targetScore) endMatch('Player 1 Wins');
        else serve(1);
      }
    }

    function endMatch(title) {
      state = 'over';
      document.getElementById('winnerTitle').textContent = title;
      document.getElementById('winnerSub').textContent = `Final Score: ${p1.score} - ${p2.score}`;
      document.getElementById('ovOver').classList.remove('hidden');
    }

    function draw() {
      cx.fillStyle = '#0d1016';
      cx.fillRect(0, 0, W, H);

      // Court markings
      cx.strokeStyle = '#1e2430';
      cx.lineWidth = 2;
      cx.setLineDash([10, 12]);
      cx.beginPath();
      cx.moveTo(W / 2, 16);
      cx.lineTo(W / 2, H - 16);
      cx.stroke();
      cx.setLineDash([]);

      // Scores
      cx.fillStyle = '#2d3548';
      cx.font = '700 64px "JetBrains Mono", monospace';
      cx.textAlign = 'center';
      cx.fillText(p1.score, W / 2 - 90, 82);
      cx.fillText(p2.score, W / 2 + 90, 82);

      // Ball trail
      for (let i = 0; i < trail.length; i++) {
        const t = trail[i];
        const ratio = (i + 1) / trail.length;
        cx.fillStyle = ball.smash
          ? `rgba(245, 158, 11, ${ratio * 0.35})`
          : `rgba(56, 189, 248, ${ratio * 0.25})`;
        cx.beginPath();
        cx.arc(t.x, t.y, ball.r * ratio * 0.85, 0, Math.PI * 2);
        cx.fill();
      }

      // Paddles
      cx.fillStyle = '#06b6d4';
      cx.beginPath();
      cx.roundRect(p1.x, p1.y, p1.w, p1.h, 6);
      cx.roundRect(p2.x, p2.y, p2.w, p2.h, 6);
      cx.fill();

      // Ball
      cx.fillStyle = ball.smash ? '#fbbf24' : '#f8fafc';
      cx.beginPath();
      cx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);
      cx.fill();
    }

    function frame() {
      update();
      draw();
      requestAnimationFrame(frame);
    }

    window.addEventListener('keydown', e => {
      keys[e.key] = true;
      if (['ArrowUp', 'ArrowDown', 'w', 's', 'W', 'S'].includes(e.key)) e.preventDefault();
    });
    window.addEventListener('keyup', e => { keys[e.key] = false; });

    cv.addEventListener('mousemove', e => {
      const rect = cv.getBoundingClientRect();
      pointerLeftY = ((e.clientY - rect.top) / rect.height) * H;
    });

    cv.addEventListener('touchmove', e => {
      e.preventDefault();
      const rect = cv.getBoundingClientRect();
      for (const t of e.touches) {
        const x = ((t.clientX - rect.left) / rect.width) * W;
        const y = ((t.clientY - rect.top) / rect.height) * H;
        if (x < W / 2) pointerLeftY = y;
        else pointerRightY = y;
      }
    }, { passive: false });

    cv.addEventListener('touchend', () => {
      pointerLeftY = null;
      pointerRightY = null;
    });

    document.getElementById('btnStart').onclick = startMatch;
    document.getElementById('btnRematch').onclick = startMatch;
    document.getElementById('btnRestart').onclick = startMatch;
    document.getElementById('btnPause').onclick = () => {
      if (state === 'playing') {
        state = 'paused';
        document.getElementById('btnPause').textContent = 'Resume';
      } else if (state === 'paused') {
        state = 'playing';
        document.getElementById('btnPause').textContent = 'Pause';
      }
    };

    requestAnimationFrame(frame);
  </script>
</body>
</html>
<% } %>


<% if (game === "minesweeper") { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Minesweeper &mdash; Poke! Games</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
  <link href="https://fonts.bunny.net/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0b0c0e;
      --surface: #131519;
      --surface-2: #1c2028;
      --revealed: #101216;
      --border: #252932;
      --text: #f1f3f5;
      --muted: #8b92a5;
      --accent: #f59e0b;
      --cell: 30px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-tap-highlight-color: transparent; }
    body {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-bottom: 2rem;
    }
    .topbar {
      width: 100%;
      max-width: 960px;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    .back-link {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      padding: 0.4rem 0.65rem;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--surface);
    }
    .back-link:hover { color: var(--text); border-color: #3b4252; }
    .game-title { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.1rem; }

    .hud-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      width: 100%;
      max-width: 960px;
      padding: 0.9rem 1.25rem;
    }
    .hud-group { display: flex; align-items: center; gap: 0.5rem; }
    select, .btn {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 0.45rem 0.75rem;
      border-radius: 6px;
      font-family: inherit;
      font-size: 0.8rem;
      cursor: pointer;
    }
    .btn.active { background: var(--accent); color: #1c1917; border-color: var(--accent); font-weight: 600; }
    .counter {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.95rem;
      font-weight: 700;
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 0.4rem 0.75rem;
      border-radius: 6px;
      min-width: 72px;
      text-align: center;
    }

    .board-scroll {
      max-width: 96vw;
      overflow: auto;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px;
      box-shadow: 0 12px 32px rgba(0,0,0,0.35);
    }
    #grid {
      display: grid;
      gap: 2px;
      background: #0b0c0e;
      border: 1px solid var(--border);
    }
    .c {
      width: var(--cell);
      height: var(--cell);
      background: var(--surface-2);
      display: grid;
      place-items: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      border-radius: 3px;
      transition: background 0.08s;
    }
    .c:hover:not(.open) { background: #262b36; }
    .c.open { background: var(--revealed); cursor: default; }
    .c.flagged { color: var(--accent); }
    .c.mine-hit { background: rgba(244, 63, 94, 0.35) !important; color: #fda4af; }
    .c.mine-reveal { background: rgba(244, 63, 94, 0.14); }

    .n1 { color: #38bdf8; }
    .n2 { color: #34d399; }
    .n3 { color: #fb7185; }
    .n4 { color: #a78bfa; }
    .n5 { color: #f59e0b; }
    .n6 { color: #2dd4bf; }
    .n7 { color: #e2e8f0; }
    .n8 { color: #94a3b8; }

    .status-msg {
      margin-top: 0.85rem;
      font-size: 0.85rem;
      color: var(--muted);
    }
  </style>
</head>
<body>
  <div class="topbar">
    <a class="back-link" href="?">&larr; Hub</a>
    <div class="game-title">Minesweeper</div>
    <button class="btn" id="btnNew">New Board</button>
  </div>

  <div class="hud-bar">
    <div class="hud-group">
      <select id="selDiff">
        <option value="easy">Beginner (9&times;9 &bull; 10)</option>
        <option value="medium" selected>Intermediate (16&times;16 &bull; 40)</option>
        <option value="hard">Expert (30&times;16 &bull; 99)</option>
      </select>
      <button class="btn" id="btnFlagMode">Mode: Dig</button>
    </div>
    <div class="hud-group">
      <div class="counter" id="valMines">040</div>
      <div class="counter" id="valTimer">000</div>
    </div>
  </div>

  <div class="board-scroll">
    <div id="grid"></div>
  </div>

  <div class="status-msg" id="statusMsg">Left-click to reveal &bull; Right-click to flag &bull; Click revealed numbers to chord</div>

  <script>
    const CONFIGS = {
      easy: { rows: 9, cols: 9, mines: 10 },
      medium: { rows: 16, cols: 16, mines: 40 },
      hard: { rows: 16, cols: 30, mines: 99 }
    };

    const FLAG_SVG = `<svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b"><path d="M5 3v18h2v-7h12l-2.5-4.5L19 5H7V3H5z"/></svg>`;
    const MINE_SVG = `<svg width="15" height="15" viewBox="0 0 24 24" fill="#f43f5e"><circle cx="12" cy="12" r="6"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4" stroke="#f43f5e" stroke-width="2"/></svg>`;

    let rows = 16, cols = 16, totalMines = 40;
    let cells = [];
    let firstClick = true;
    let gameOver = false;
    let flagMode = false;
    let flagsPlaced = 0;
    let sec = 0;
    let timer = null;

    const gridEl = document.getElementById('grid');
    const statusEl = document.getElementById('statusMsg');

    function neighbors(idx) {
      const r = Math.floor(idx / cols);
      const c = idx % cols;
      const list = [];
      for (let dr = -1; dr <= 1; dr++) {
        for (let dc = -1; dc <= 1; dc++) {
          if (!dr && !dc) continue;
          const nr = r + dr, nc = c + dc;
          if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) list.push(nr * cols + nc);
        }
      }
      return list;
    }

    function initBoard() {
      const diff = document.getElementById('selDiff').value;
      ({ rows, cols, mines: totalMines } = CONFIGS[diff]);
      cells = Array.from({ length: rows * cols }, () => ({
        mine: false,
        open: false,
        flag: false,
        count: 0
      }));
      firstClick = true;
      gameOver = false;
      flagsPlaced = 0;
      sec = 0;
      clearInterval(timer);
      updateCounters();
      statusEl.textContent = 'First click is always guaranteed safe.';

      gridEl.style.gridTemplateColumns = `repeat(${cols}, var(--cell))`;
      gridEl.innerHTML = '';

      for (let i = 0; i < cells.length; i++) {
        const el = document.createElement('div');
        el.className = 'c';
        el.addEventListener('click', () => handlePrimary(i));
        el.addEventListener('contextmenu', e => {
          e.preventDefault();
          toggleFlag(i);
        });
        gridEl.appendChild(el);
      }
    }

    function placeMines(safeIdx) {
      const safeSet = new Set([safeIdx, ...neighbors(safeIdx)]);
      let placed = 0;
      while (placed < totalMines) {
        const idx = Math.floor(Math.random() * cells.length);
        if (safeSet.has(idx) || cells[idx].mine) continue;
        cells[idx].mine = true;
        placed++;
      }
      for (let i = 0; i < cells.length; i++) {
        if (!cells[i].mine) {
          cells[i].count = neighbors(i).filter(n => cells[n].mine).length;
        }
      }
    }

    function updateCounters() {
      const rem = totalMines - flagsPlaced;
      document.getElementById('valMines').textContent = String(rem).padStart(3, '0');
      document.getElementById('valTimer').textContent = String(Math.min(999, sec)).padStart(3, '0');
    }

    function handlePrimary(idx) {
      if (gameOver) return;
      const cell = cells[idx];
      if (flagMode && !cell.open) {
        toggleFlag(idx);
        return;
      }
      if (cell.flag) return;
      if (cell.open) {
        chord(idx);
        return;
      }
      reveal(idx);
    }

    function toggleFlag(idx) {
      if (gameOver) return;
      const cell = cells[idx];
      if (cell.open) return;
      cell.flag = !cell.flag;
      flagsPlaced += cell.flag ? 1 : -1;
      const el = gridEl.children[idx];
      el.classList.toggle('flagged', cell.flag);
      el.innerHTML = cell.flag ? FLAG_SVG : '';
      updateCounters();
    }

    function reveal(idx) {
      if (firstClick) {
        firstClick = false;
        placeMines(idx);
        timer = setInterval(() => { sec++; updateCounters(); }, 1000);
      }

      const cell = cells[idx];
      if (cell.open || cell.flag) return;
      cell.open = true;

      const el = gridEl.children[idx];
      el.classList.add('open');

      if (cell.mine) {
        finishGame(false, idx);
        return;
      }

      if (cell.count > 0) {
        el.textContent = cell.count;
        el.classList.add('n' + cell.count);
      } else {
        neighbors(idx).forEach(n => {
          if (!cells[n].open) reveal(n);
        });
      }

      checkWin();
    }

    function chord(idx) {
      const cell = cells[idx];
      if (!cell.open || cell.count === 0) return;
      const nbs = neighbors(idx);
      const flagged = nbs.filter(n => cells[n].flag).length;
      if (flagged === cell.count) {
        nbs.forEach(n => {
          if (!cells[n].open && !cells[n].flag) reveal(n);
        });
      }
    }

    function checkWin() {
      const opened = cells.filter(c => c.open).length;
      if (opened === cells.length - totalMines) {
        finishGame(true, -1);
      }
    }

    function finishGame(won, hitIdx) {
      gameOver = true;
      clearInterval(timer);

      if (won) {
        const diff = document.getElementById('selDiff').value;
        try {
          const bests = JSON.parse(localStorage.getItem('poke_mines_best') || '{}');
          if (!bests[diff] || sec < bests[diff]) {
            bests[diff] = sec;
            localStorage.setItem('poke_mines_best', JSON.stringify(bests));
          }
        } catch (e) {}
        statusEl.textContent = `Board cleared in ${sec}s!`;
        cells.forEach((c, i) => {
          if (c.mine && !c.flag) {
            gridEl.children[i].innerHTML = FLAG_SVG;
          }
        });
      } else {
        statusEl.textContent = 'Mine detonated. Click New Board to try again.';
        cells.forEach((c, i) => {
          const el = gridEl.children[i];
          if (c.mine) {
            el.classList.add(i === hitIdx ? 'mine-hit' : 'mine-reveal');
            el.innerHTML = MINE_SVG;
          }
        });
      }
    }

    document.getElementById('btnNew').onclick = initBoard;
    document.getElementById('selDiff').onchange = initBoard;
    document.getElementById('btnFlagMode').onclick = e => {
      flagMode = !flagMode;
      e.currentTarget.textContent = `Mode: ${flagMode ? 'Flag' : 'Dig'}`;
      e.currentTarget.classList.toggle('active', flagMode);
    };

    initBoard();
  </script>
</body>
</html>
<% } %>


<% if (game === "breakout") { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Breakout &mdash; Poke! Games</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
  <link href="https://fonts.bunny.net/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0b0c0e;
      --surface: #131519;
      --surface-2: #1c2028;
      --border: #252932;
      --text: #f1f3f5;
      --muted: #8b92a5;
      --accent: #ec4899;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-tap-highlight-color: transparent; }
    body {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .topbar {
      width: 100%;
      max-width: 820px;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    .back-link {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      padding: 0.4rem 0.65rem;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--surface);
    }
    .back-link:hover { color: var(--text); border-color: #3b4252; }
    .game-title { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.1rem; }

    .hud {
      width: 100%;
      max-width: 820px;
      padding: 0.85rem 1.25rem;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
    }
    .stat-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.55rem 0.8rem;
    }
    .stat-label { font-size: 0.7rem; color: var(--muted); text-transform: uppercase; }
    .stat-val { font-family: 'JetBrains Mono', monospace; font-size: 1.1rem; font-weight: 700; margin-top: 0.15rem; }

    .stage-wrap {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px;
      width: min(95vw, 800px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.35);
    }
    canvas {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      background: #0d1016;
      border-radius: 6px;
      touch-action: none;
    }
    .overlay {
      position: absolute;
      inset: 10px;
      background: rgba(11, 12, 14, 0.86);
      backdrop-filter: blur(4px);
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      text-align: center;
      padding: 1.5rem;
    }
    .hidden { display: none !important; }
    .overlay h2 { font-family: 'Space Grotesk', sans-serif; font-size: 1.85rem; }
    .overlay p { color: var(--muted); font-size: 0.88rem; max-width: 340px; line-height: 1.5; }
    .btn {
      background: var(--surface-2);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 0.55rem 1rem;
      border-radius: 6px;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .hint { margin-top: 0.75rem; color: var(--muted); font-size: 0.78rem; }
  </style>
</head>
<body>
  <div class="topbar">
    <a class="back-link" href="?">&larr; Hub</a>
    <div class="game-title">Breakout</div>
    <button class="btn" id="btnPause" style="padding:0.4rem 0.75rem;">Pause</button>
  </div>

  <div class="hud">
    <div class="stat-box">
      <div class="stat-label">Score</div>
      <div class="stat-val" id="valScore">0</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">Best</div>
      <div class="stat-val" id="valHigh">0</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">Level</div>
      <div class="stat-val" id="valLevel">1</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">Lives</div>
      <div class="stat-val" id="valLives">3</div>
    </div>
  </div>

  <div class="stage-wrap">
    <canvas id="canvas" width="800" height="600"></canvas>

    <div class="overlay" id="ovStart">
      <h2>Breakout</h2>
      <p>Destroy all bricks to advance. Silver bricks require 2 hits. Collect falling capsules for Multi-ball, Wide Paddle, and Dual Lasers.</p>
      <button class="btn btn-primary" id="btnStart">Start Game</button>
    </div>

    <div class="overlay hidden" id="ovOver">
      <h2 id="overTitle">Game Over</h2>
      <p id="overSummary">Final Score: 0</p>
      <button class="btn btn-primary" id="btnRetry">Play Again</button>
    </div>
  </div>

  <div class="hint">Mouse / Touch or Left / Right Arrows to steer &bull; Space to launch ball</div>

  <script>
    const cv = document.getElementById('canvas');
    const cx = cv.getContext('2d');
    const W = 800, H = 600;

    let highScore = parseInt(localStorage.getItem('poke_breakout_high') || '0', 10);
    document.getElementById('valHigh').textContent = highScore;

    let state = 'menu';
    let score = 0;
    let level = 1;
    let lives = 3;
    let combo = 0;
    let keys = {};

    const paddle = { x: 340, y: 555, w: 120, h: 14, targetX: 400, wideTimer: 0, laserTimer: 0 };
    let balls = [];
    let bricks = [];
    let powerups = [];
    let lasers = [];
    let particles = [];
    let audioCtx = null;

    function sfx(freq, dur, type = 'triangle') {
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const o = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        o.type = type;
        o.frequency.setValueAtTime(freq, audioCtx.currentTime);
        g.gain.setValueAtTime(0.05, audioCtx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
        o.connect(g).connect(audioCtx.destination);
        o.start();
        o.stop(audioCtx.currentTime + dur);
      } catch (e) {}
    }

    function buildLevel() {
      bricks = [];
      const rows = Math.min(8, 4 + level);
      const cols = 10;
      const pad = 8;
      const offsetTop = 56;
      const bw = (W - pad * (cols + 1)) / cols;
      const bh = 22;
      const palette = ['#f43f5e', '#fb923c', '#facc15', '#34d399', '#38bdf8', '#a78bfa'];

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const armored = r === 0 && level > 1;
          bricks.push({
            x: pad + c * (bw + pad),
            y: offsetTop + r * (bh + pad),
            w: bw,
            h: bh,
            hp: armored ? 2 : 1,
            color: armored ? '#94a3b8' : palette[r % palette.length],
            points: (rows - r) * 15
          });
        }
      }
      resetBalls();
      powerups = [];
      lasers = [];
    }

    function resetBalls() {
      balls = [{
        x: paddle.x + paddle.w / 2,
        y: paddle.y - 8,
        vx: 4.5 * (Math.random() > 0.5 ? 1 : -1),
        vy: -5.5,
        r: 7,
        stuck: true
      }];
      combo = 0;
    }

    function startGame() {
      score = 0;
      level = 1;
      lives = 3;
      paddle.w = 120;
      paddle.wideTimer = 0;
      paddle.laserTimer = 0;
      buildLevel();
      updateHUD();
      document.getElementById('ovStart').classList.add('hidden');
      document.getElementById('ovOver').classList.add('hidden');
      state = 'playing';
    }

    function updateHUD() {
      if (score > highScore) {
        highScore = score;
        localStorage.setItem('poke_breakout_high', String(highScore));
      }
      document.getElementById('valScore').textContent = score;
      document.getElementById('valHigh').textContent = highScore;
      document.getElementById('valLevel').textContent = level;
      document.getElementById('valLives').textContent = lives;
    }

    function hitBrick(b) {
      b.hp--;
      if (b.hp > 0) {
        b.color = '#cbd5e1';
        sfx(320, 0.05, 'square');
        return;
      }
      combo++;
      score += b.points + combo * 5;
      updateHUD();
      sfx(520 + Math.min(combo * 20, 300), 0.07);

      for (let i = 0; i < 8; i++) {
        particles.push({
          x: b.x + b.w / 2,
          y: b.y + b.h / 2,
          vx: (Math.random() - 0.5) * 6,
          vy: (Math.random() - 0.5) * 6,
          life: 1,
          color: b.color
        });
      }

      if (Math.random() < 0.16) {
        const types = [
          { id: 'wide', label: 'W', color: '#34d399' },
          { id: 'multi', label: 'M', color: '#38bdf8' },
          { id: 'laser', label: 'L', color: '#f43f5e' }
        ];
        const pick = types[Math.floor(Math.random() * types.length)];
        powerups.push({ x: b.x + b.w / 2, y: b.y + b.h / 2, vy: 2.8, ...pick });
      }
    }

    function update() {
      if (state !== 'playing') return;

      if (keys['ArrowLeft'] || keys['a'] || keys['A']) paddle.targetX -= 9;
      if (keys['ArrowRight'] || keys['d'] || keys['D']) paddle.targetX += 9;
      paddle.targetX = Math.max(paddle.w / 2, Math.min(W - paddle.w / 2, paddle.targetX));
      paddle.x += (paddle.targetX - paddle.w / 2 - paddle.x) * 0.35;

      if (paddle.wideTimer > 0) {
        paddle.wideTimer--;
        if (paddle.wideTimer === 0) paddle.w = 120;
      }
      if (paddle.laserTimer > 0) {
        paddle.laserTimer--;
        if (paddle.laserTimer % 18 === 0) {
          lasers.push({ x: paddle.x + 10, y: paddle.y });
          lasers.push({ x: paddle.x + paddle.w - 10, y: paddle.y });
          sfx(700, 0.04, 'sawtooth');
        }
      }

      // Lasers
      for (let i = lasers.length - 1; i >= 0; i--) {
        const l = lasers[i];
        l.y -= 9;
        let removed = l.y < 0;
        for (const br of bricks) {
          if (br.hp > 0 && l.x >= br.x && l.x <= br.x + br.w && l.y >= br.y && l.y <= br.y + br.h) {
            hitBrick(br);
            removed = true;
            break;
          }
        }
        if (removed) lasers.splice(i, 1);
      }

      // Balls
      for (let i = balls.length - 1; i >= 0; i--) {
        const ball = balls[i];
        if (ball.stuck) {
          ball.x = paddle.x + paddle.w / 2;
          ball.y = paddle.y - ball.r - 1;
          continue;
        }

        ball.x += ball.vx;
        ball.y += ball.vy;

        if (ball.x - ball.r <= 0) { ball.x = ball.r; ball.vx = Math.abs(ball.vx); }
        if (ball.x + ball.r >= W) { ball.x = W - ball.r; ball.vx = -Math.abs(ball.vx); }
        if (ball.y - ball.r <= 0) { ball.y = ball.r; ball.vy = Math.abs(ball.vy); }

        // Paddle bounce
        if (ball.vy > 0 &&
            ball.y + ball.r >= paddle.y &&
            ball.y - ball.r <= paddle.y + paddle.h &&
            ball.x >= paddle.x &&
            ball.x <= paddle.x + paddle.w) {
          const hit = (ball.x - (paddle.x + paddle.w / 2)) / (paddle.w / 2);
          const speed = Math.hypot(ball.vx, ball.vy);
          const angle = hit * (Math.PI / 3);
          ball.vx = speed * Math.sin(angle);
          ball.vy = -Math.abs(speed * Math.cos(angle));
          ball.y = paddle.y - ball.r;
          combo = 0;
          sfx(380, 0.05);
        }

        // Swept brick collision
        for (const br of bricks) {
          if (br.hp <= 0) continue;
          const closestX = Math.max(br.x, Math.min(ball.x, br.x + br.w));
          const closestY = Math.max(br.y, Math.min(ball.y, br.y + br.h));
          const dx = ball.x - closestX;
          const dy = ball.y - closestY;
          if (dx * dx + dy * dy <= ball.r * ball.r) {
            if (Math.abs(dx) > Math.abs(dy)) ball.vx *= -1;
            else ball.vy *= -1;
            hitBrick(br);
            break;
          }
        }

        if (ball.y - ball.r > H) {
          balls.splice(i, 1);
        }
      }

      if (balls.length === 0) {
        lives--;
        updateHUD();
        sfx(160, 0.25, 'sawtooth');
        if (lives <= 0) {
          state = 'over';
          document.getElementById('overSummary').textContent = `Final Score: ${score}  •  Level ${level}`;
          document.getElementById('ovOver').classList.remove('hidden');
        } else {
          resetBalls();
        }
      }

      // Powerups
      for (let i = powerups.length - 1; i >= 0; i--) {
        const p = powerups[i];
        p.y += p.vy;
        if (p.y + 10 >= paddle.y && p.y - 10 <= paddle.y + paddle.h &&
            p.x >= paddle.x && p.x <= paddle.x + paddle.w) {
          if (p.id === 'wide') {
            paddle.w = 180;
            paddle.wideTimer = 600;
          } else if (p.id === 'laser') {
            paddle.laserTimer = 360;
          } else if (p.id === 'multi') {
            const base = balls[0];
            if (base) {
              base.stuck = false;
              balls.push({ ...base, vx: -base.vx, stuck: false });
              balls.push({ ...base, vx: base.vx * 0.5, vy: -6, stuck: false });
            }
          }
          sfx(680, 0.12, 'sine');
          powerups.splice(i, 1);
        } else if (p.y > H + 20) {
          powerups.splice(i, 1);
        }
      }

      // Level complete
      if (bricks.every(b => b.hp <= 0)) {
        level++;
        score += 500;
        updateHUD();
        buildLevel();
      }

      // Particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const pt = particles[i];
        pt.x += pt.vx;
        pt.y += pt.vy;
        pt.life -= 0.04;
        if (pt.life <= 0) particles.splice(i, 1);
      }
    }

    function draw() {
      cx.fillStyle = '#0d1016';
      cx.fillRect(0, 0, W, H);

      // Bricks
      for (const b of bricks) {
        if (b.hp <= 0) continue;
        cx.fillStyle = b.color;
        cx.beginPath();
        cx.roundRect(b.x, b.y, b.w, b.h, 4);
        cx.fill();
      }

      // Paddle
      cx.fillStyle = paddle.laserTimer > 0 ? '#f43f5e' : '#ec4899';
      cx.beginPath();
      cx.roundRect(paddle.x, paddle.y, paddle.w, paddle.h, 6);
      cx.fill();

      // Lasers
      cx.fillStyle = '#fda4af';
      for (const l of lasers) {
        cx.fillRect(l.x - 1.5, l.y, 3, 12);
      }

      // Balls
      cx.fillStyle = '#f8fafc';
      for (const ball of balls) {
        cx.beginPath();
        cx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);
        cx.fill();
      }

      // Powerups
      for (const p of powerups) {
        cx.fillStyle = p.color;
        cx.beginPath();
        cx.roundRect(p.x - 12, p.y - 10, 24, 20, 5);
        cx.fill();
        cx.fillStyle = '#0b0c0e';
        cx.font = '700 11px "JetBrains Mono", monospace';
        cx.textAlign = 'center';
        cx.fillText(p.label, p.x, p.y + 4);
      }

      // Particles
      for (const pt of particles) {
        cx.fillStyle = pt.color;
        cx.globalAlpha = pt.life;
        cx.fillRect(pt.x, pt.y, 4, 4);
      }
      cx.globalAlpha = 1;
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    function releaseBalls() {
      balls.forEach(b => { b.stuck = false; });
    }

    cv.addEventListener('mousemove', e => {
      const rect = cv.getBoundingClientRect();
      paddle.targetX = ((e.clientX - rect.left) / rect.width) * W;
    });
    cv.addEventListener('click', () => {
      if (state === 'playing') releaseBalls();
    });
    cv.addEventListener('touchmove', e => {
      e.preventDefault();
      const rect = cv.getBoundingClientRect();
      paddle.targetX = ((e.touches[0].clientX - rect.left) / rect.width) * W;
      releaseBalls();
    }, { passive: false });

    window.addEventListener('keydown', e => {
      keys[e.key] = true;
      if (e.code === 'Space' && state === 'playing') {
        e.preventDefault();
        releaseBalls();
      }
    });
    window.addEventListener('keyup', e => { keys[e.key] = false; });

    document.getElementById('btnStart').onclick = startGame;
    document.getElementById('btnRetry').onclick = startGame;
    document.getElementById('btnPause').onclick = () => {
      if (state === 'playing') {
        state = 'paused';
        document.getElementById('btnPause').textContent = 'Resume';
      } else if (state === 'paused') {
        state = 'playing';
        document.getElementById('btnPause').textContent = 'Pause';
      }
    };

    requestAnimationFrame(loop);
  </script>
</body>
</html>
<% } %>