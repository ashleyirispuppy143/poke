      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 24px;
    }

    .hidden { display: none !important; }

    .hero-card {
      background: var(--md-surface);
      padding: 36px 32px;
      border-radius: var(--radius-xl);
