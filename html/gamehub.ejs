  </style>
</head>
<body>
  <div class="topbar">
    <a class="back-link" href="?">&larr; Hub</a>
    <div class="game-title">Sudoku</div>
    <button class="btn" id="btnNewTop" style="padding:0.4rem 0.75rem;">New Puzzle</button>
  </div>

  <div class="meta-bar">
    <select class="meta-pill" id="selDiff">
      <option value="easy">Easy</option>
      <option value="medium" selected>Normal</option>
      <option value="hard">Hard</option>
    </select>
    <span>Mistakes: <strong class="meta-pill" id="valMistakes">0</strong></span>
    <span class="meta-pill" id="valTimer">00:00</span>
  </div>

  <div class="grid-frame" id="grid"></div>

  <div class="controls">
    <div class="tool-row">
      <button class="btn" id="btnUndo">Undo</button>
      <button class="btn" id="btnErase">Erase</button>
      <button class="btn" id="btnNotes">Notes: Off</button>
      <button class="btn" id="btnHint">Hint</button>
    </div>
    <div class="numpad" id="numpad"></div>
  </div>

  <div class="modal-backdrop hidden" id="modalWin">
    <div class="modal">
      <h2>Puzzle Solved!</h2>
      <p id="winSummary">Completed in 00:00</p>
      <button class="btn active" id="btnPlayAgain" style="width:100%;padding:0.7rem;">Play Another</button>
    </div>
  </div>

  <script>
    function isValid(board, r, c, n) {
      for (let i = 0; i < 9; i++) {
        if (board[r][i] === n || board[i][c] === n) return false;
        const br = 3 * Math.floor(r / 3) + Math.floor(i / 3);
        const bc = 3 * Math.floor(c / 3) + (i % 3);
        if (board[br][bc] === n) return false;
      }
      return true;
    }

    function solveGrid(board) {
      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (board[r][c] === 0) {
            const nums = [1,2,3,4,5,6,7,8,9].sort(() => Math.random() - 0.5);
            for (const n of nums) {
              if (isValid(board, r, c, n)) {
                board[r][c] = n;
                if (solveGrid(board)) return true;
                board[r][c] = 0;
              }
            }
            return false;
          }
        }
      }
      return true;
    }

    function generateSudoku(diff) {
      const board = Array.from({ length: 9 }, () => Array(9).fill(0));
      solveGrid(board);
      const solution = board.map(row => [...row]);
      let removeCount = diff === 'easy' ? 34 : diff === 'medium' ? 44 : 54;
      while (removeCount > 0) {
        const r = Math.floor(Math.random() * 9);
        const c = Math.floor(Math.random() * 9);
        if (board[r][c] !== 0) {
          board[r][c] = 0;
          removeCount--;
        }
      }
      return { initial: board, solution };
    }

    let initial = [];
    let state = [];
    let solution = [];
    let notes = [];
    let history = [];
    let sel = { r: 0, c: 0 };
    let noteMode = false;
    let mistakes = 0;
    let seconds = 0;
    let timerId = null;

    const gridEl = document.getElementById('grid');
    const numpadEl = document.getElementById('numpad');

    function startPuzzle() {
      const diff = document.getElementById('selDiff').value;
      const data = generateSudoku(diff);
      initial = data.initial.map(r => [...r]);
      state = data.initial.map(r => [...r]);
      solution = data.solution;
      notes = Array.from({ length: 9 }, () => Array.from({ length: 9 }, () => new Set()));
      history = [];
      mistakes = 0;
      seconds = 0;
      document.getElementById('valMistakes').textContent = '0';
      document.getElementById('modalWin').classList.add('hidden');
      clearInterval(timerId);
      timerId = setInterval(() => {
        seconds++;
        const m = String(Math.floor(seconds / 60)).padStart(2, '0');
        const s = String(seconds % 60).padStart(2, '0');
        document.getElementById('valTimer').textContent = `${m}:${s}`;
      }, 1000);
      render();
    }

    function saveHistory() {
      history.push({
        state: state.map(r => [...r]),
        notes: notes.map(r => r.map(s => new Set(s)))
      });
      if (history.length > 30) history.shift();
    }

    function clearPeerNotes(r, c, num) {
      for (let i = 0; i < 9; i++) {
        notes[r][i].delete(num);
        notes[i][c].delete(num);
        const br = 3 * Math.floor(r / 3) + Math.floor(i / 3);
        const bc = 3 * Math.floor(c / 3) + (i % 3);
        notes[br][bc].delete(num);
      }
    }

    function render() {
      gridEl.innerHTML = '';
      const selVal = state[sel.r]?.[sel.c] || 0;

      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          const el = document.createElement('div');
          const v = state[r][c];
          const isGiven = initial[r][c] !== 0;
          el.className = 'cell' + (isGiven ? ' given' : '');

          const sameBox = Math.floor(r / 3) === Math.floor(sel.r / 3) && Math.floor(c / 3) === Math.floor(sel.c / 3);
          if (r === sel.r && c === sel.c) el.classList.add('selected');
          else if (r === sel.r || c === sel.c || sameBox) el.classList.add('peer');

          if (v !== 0 && v === selVal) el.classList.add('same');
          if (v !== 0 && v !== solution[r][c]) el.classList.add('error');

          if (v !== 0) {
            el.textContent = v;
          } else if (notes[r][c].size > 0) {
            const nGrid = document.createElement('div');
            nGrid.className = 'notes';
            for (let n = 1; n <= 9; n++) {
              const sp = document.createElement('span');
              sp.textContent = notes[r][c].has(n) ? n : '';
              nGrid.appendChild(sp);
            }
            el.appendChild(nGrid);
          }

          el.onclick = () => { sel = { r, c }; render(); };
          gridEl.appendChild(el);
        }
      }

      // Render numpad with remaining counts
      const counts = Array(10).fill(0);
      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (state[r][c] === solution[r][c]) counts[state[r][c]]++;
        }
      }
      numpadEl.innerHTML = '';
      for (let n = 1; n <= 9; n++) {
        const rem = Math.max(0, 9 - counts[n]);
        const btn = document.createElement('button');
        btn.className = 'num-btn' + (rem === 0 ? ' done' : '');
        btn.innerHTML = `<span>${n}</span><span class="num-rem">${rem}</span>`;
        btn.onclick = () => inputNumber(n);
        numpadEl.appendChild(btn);
      }
    }

    function inputNumber(num) {
      const { r, c } = sel;
      if (initial[r][c] !== 0) return;

      saveHistory();

      if (noteMode) {
        if (state[r][c] !== 0) state[r][c] = 0;
        if (notes[r][c].has(num)) notes[r][c].delete(num);
        else notes[r][c].add(num);
        render();
        return;
      }

      if (state[r][c] === num) return;
      state[r][c] = num;
      notes[r][c].clear();

      if (num !== solution[r][c]) {
        mistakes++;
        document.getElementById('valMistakes').textContent = mistakes;
      } else {
        clearPeerNotes(r, c, num);
        checkCompleted();
      }
      render();
    }

    function checkCompleted() {
      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (state[r][c] !== solution[r][c]) return;
        }
      }
      clearInterval(timerId);
      const wins = parseInt(localStorage.getItem('poke_sudoku_wins') || '0', 10) + 1;
      localStorage.setItem('poke_sudoku_wins', String(wins));
      document.getElementById('winSummary').textContent =
        `Time: ${document.getElementById('valTimer').textContent}  •  Mistakes: ${mistakes}`;
      document.getElementById('modalWin').classList.remove('hidden');
    }

    document.getElementById('btnNotes').onclick = () => {
      noteMode = !noteMode;
      const b = document.getElementById('btnNotes');
      b.textContent = `Notes: ${noteMode ? 'On' : 'Off'}`;
      b.classList.toggle('active', noteMode);
    };

    document.getElementById('btnErase').onclick = () => {
      const { r, c } = sel;
      if (initial[r][c] !== 0) return;
      saveHistory();
      state[r][c] = 0;
      notes[r][c].clear();
      render();
    };

    document.getElementById('btnUndo').onclick = () => {
      if (!history.length) return;
      const prev = history.pop();
      state = prev.state;
      notes = prev.notes;
      render();
    };

    document.getElementById('btnHint').onclick = () => {
      const { r, c } = sel;
      if (state[r][c] === solution[r][c]) return;
      saveHistory();
      state[r][c] = solution[r][c];
      notes[r][c].clear();
      clearPeerNotes(r, c, solution[r][c]);
      render();
      checkCompleted();
    };

    document.getElementById('btnNewTop').onclick = startPuzzle;
    document.getElementById('btnPlayAgain').onclick = startPuzzle;
    document.getElementById('selDiff').onchange = startPuzzle;

    window.addEventListener('keydown', e => {
      if (['ArrowUp', 'w', 'W'].includes(e.key)) { e.preventDefault(); sel.r = (sel.r + 8) % 9; render(); }
      else if (['ArrowDown', 's', 'S'].includes(e.key)) { e.preventDefault(); sel.r = (sel.r + 1) % 9; render(); }
      else if (['ArrowLeft', 'a', 'A'].includes(e.key)) { e.preventDefault(); sel.c = (sel.c + 8) % 9; render(); }
      else if (['ArrowRight', 'd', 'D'].includes(e.key)) { e.preventDefault(); sel.c = (sel.c + 1) % 9; render(); }
      else if (e.key === 'Backspace' || e.key === 'Delete') document.getElementById('btnErase').click();
      else if (e.key === 'n' || e.key === 'N') document.getElementById('btnNotes').click();
      else if (e.key === 'u' || e.key === 'U') document.getElementById('btnUndo').click();
      else if (/^[1-9]$/.test(e.key)) inputNumber(parseInt(e.key, 10));
    });

    startPuzzle();
  </script>
</body>
</html>
<% } %>


